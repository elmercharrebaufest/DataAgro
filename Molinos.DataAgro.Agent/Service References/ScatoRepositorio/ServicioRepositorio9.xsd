<?xml version="1.0" encoding="utf-8"?>
<xs:schema xmlns:tns="http://schemas.datacontract.org/2004/07/Microsoft.ApplicationServer.StoreManagement.Query" elementFormDefault="qualified" targetNamespace="http://schemas.datacontract.org/2004/07/Microsoft.ApplicationServer.StoreManagement.Query" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:simpleType name="InstanceCondition">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Active" />
      <xs:enumeration value="Idle" />
      <xs:enumeration value="Exception" />
      <xs:enumeration value="UserSuspension" />
      <xs:enumeration value="Successful" />
      <xs:enumeration value="Canceled" />
      <xs:enumeration value="Terminated" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="InstanceCondition" nillable="true" type="tns:InstanceCondition" />
  <xs:simpleType name="InstanceStatus">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Running" />
      <xs:enumeration value="Suspended" />
      <xs:enumeration value="Completed" />
    </xs:restriction>
  </xs:simpleType>
  <xs:element name="InstanceStatus" nillable="true" type="tns:InstanceStatus" />
</xs:schema>