@{
    Layout = null;
}

<!DOCTYPE html>

<style>
    body {
        background-color: #017940;
    }

    .error {
        padding: 25px;
        background-color: rgba(255, 255, 255, 0.36);
        width: 600px;
        margin: 0 auto;
        border: 1px solid #000;
        border-radius: 10px;
        font-size: 30px;
        color: #000;
        display: inline-block;
        vertical-align: middle;
    }

    .body-error {
        padding: 35px;
        text-align: center;
    }

    .error-logo {
        width: 200px;
        margin: 0 auto;
        float: none;
        display: inline-block;
        vertical-align: middle;
    }

    .body-error > .empresa-logo {
        display: block;
    }

    #content_wrapper {
        margin-top: 25%;
        transform: translateY(-50%);
    }

    .boton-volver {
        width: 200px;
        margin: 0 auto;
        border: 1px solid #000000;
        border-radius: 10px;
        padding: 5px;
        text-align: center;
        color: #000;
        text-decoration: none;
        cursor: pointer;
    }

        .boton-volver:hover {
            background-color: #5da985;
        }
</style>

<html>
<head>
    <meta name="viewport" content="width=device-width" />

    <title>Error de Permisos</title>
</head>
<body class="external-page sb-l-c sb-r-c">

    <div id="main" class="animated fadeIn">
        <section id="content_wrapper">
            <div class="body-error">
                <img class="error-logo" src="~/Content/Images/construccion.png" />
                <div class="error">
                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger">
                            @ViewBag.Error
                        </div>
                    }

                </div>
            </div>
            @*<div onclick="window.location.href = '../Home'" class="boton-volver">
                    Volver
                </div>*@

        </section>

    </div>
</body>


</html>
