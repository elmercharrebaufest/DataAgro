<div class="modal fade" id="objetivo-modal" tabindex="-1" role="dialog" aria-labelledby="modalLabelSmall" aria-hidden="true">
    <div class="modal-dialog modal-sm">
        <div class="modal-content">

            <div class="modal-header">
                <div class="alert alert-danger alert-dismissible" role="alert" hidden>
                    <a href="#" class="close" data-hide="alert" aria-label="close">&times;</a>
                    <span id="error-alert"></span>
                </div>

                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span><span class="sr-only">Close</span></button>
                <div class="modal-header" style="margin-left: -1%;padding-right: 2px;">
                    <h1 class="modal-title-confirmado" id="lineModalLabel"></h1>
                    <div class="status confirmado-modal">
                        <div>Agregar Objetivo</div>
                    </div>
                </div>
                @*<h4 class="modal-title" id="modalLabelSmall">Agregar Objetivo</h4>*@
            </div>

            <div class="modal-body">
                <div id="form-objetivo">
                    <div class="row">
                        <div class="col-xs-4">
                            Material
                        </div>
                        <div class="col-xs-8">
                            <select id="MaterialId" data-bind="source: materialCombo, value: Parametros.materialId"></select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xs-4">
                            Campaña
                        </div>
                        <div class="col-xs-8">
                            <select id="CampaniaId" data-bind="source: campaniaCombo, value: Parametros.campaniaId"></select>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xs-4">
                            Toneladas
                        </div>
                        <div class="col-xs-8">
                            <input id="Toneladas" data-bind="value: Parametros.toneladas" style="width:100%" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-xs-6 noPadding">
                            <button type="button" id="GrabarObjetivo" class="myBtn btnSubmit" onclick="AgregarObjetivo()">Guardar</button>
                        </div>
                        <div class="col-xs-6 noPaddingRight">
                            <button type="button" id="CancelarObjetivo" class="myBtn" data-dismiss="modal">Cancelar</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

