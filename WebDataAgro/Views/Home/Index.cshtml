<div class="contenedor-segundo">
    <div class="contenedor-segundo-titulos">
        <div class="col-lg-3">
            <span class="contenedor-segundo-titulo">Filtrar por</span>
        </div>
        <div class="col-lg-4">
            <span class="contenedor-segundo-titulo">Lista de contactos</span>
        </div>
        <div class="col-lg-5" style="text-align:right;min-height: 22px;">
            <a id="exportarPDF" class="exportar-contactos @(PermisosHelper.Is(PermisosDataAgro.DescargaPdf)?"":"hide") "><img src="~/Content/Images/descargar-pdf-excel.png" /> <span>Exportar como PDF</span></a>
            <a id="exportarExcel" class="exportar-contactos @(PermisosHelper.Is(PermisosDataAgro.DescargaExcel)?"":"hide") "><img src="~/Content/Images/descargar-pdf-excel.png" /> <span>Exportar a Excel</span></a>

            <a id="exportarAll" class="exportar-contactos @(PermisosHelper.Is(PermisosDataAgro.DescargaExportAllComercial) || PermisosHelper.Is(PermisosDataAgro.DescargaExportAllVisualizador)?"":"hide")"><img src="~/Content/Images/descargar-pdf-excel.png" /> <span>Export All</span></a>
        </div>
    </div>
    <div class="row r-relative">
        <div class="col-md-3 absoluto-mt20">
            <div class="col-lg-12 mostrar-filtro puntero">
                <span class="puntero">Ocultar filtro -</span>
            </div>
            <div id="form-filtro">
                <div class="contenedor-segundo-filtro-grupo col-lg-12 ">
                    <div class="contenedor-segundo-filtro-titulo color-titulo">
                        Comercial
                    </div>
                    <div class="contenedor-segundo-filtro-campo filtro-comercial"></div>
                </div>
                <div class="contenedor-segundo-filtro-grupo col-lg-12 ">
                    <div class="contenedor-segundo-filtro-titulo color-titulo">
                        Zona
                    </div>
                    <div class="contenedor-segundo-filtro-campo filtro-zona"></div>
                </div>
                <div class="contenedor-segundo-filtro-grupo col-lg-12 ">
                    <div class="contenedor-segundo-filtro-titulo color-titulo">
                        Grano
                    </div>
                    <div class="contenedor-segundo-filtro-campo material-granos"></div>
                </div>
                <div class="contenedor-segundo-filtro-grupo col-lg-12">
                    <div class="contenedor-segundo-filtro-titulo color-titulo">
                        Período de tiempo
                    </div>
                    <div class="contenedor-segundo-filtro-campo periodo-tiempo"></div>
                </div>
                <div class="contenedor-segundo-filtro-grupo col-lg-12">
                    <div class="contenedor-segundo-filtro-titulo color-titulo">
                        Segmentación
                    </div>
                    <div class="contenedor-segundo-filtro-campo campo-segmentacion"></div>
                </div>
                <div class="contenedor-segundo-filtro-grupo col-lg-12">
                    <div class="contenedor-segundo-filtro-titulo color-titulo">
                        Condicion Preferentes
                    </div>
                    <div class="contenedor-segundo-filtro-campo campo-condicion"></div>
                </div>

                <div class="contenedor-segundo-filtro-grupo col-lg-12">
                    <div class="contenedor-segundo-filtro-titulo color-titulo">
                        Hectareas (Has)
                    </div>
                    <div class="contenedor-segundo-filtro-campo">
                        <label for="has-Indistinto"><input type="checkbox" value="null" name="Indistinto" id="has-Indistinto" /> <b>Indistinto</b></label>
                        <label for="has-unoados"><input type="checkbox" value="1" name="unoados" id="has-unoados" /> 1 a 500</label>
                        <label for="has-dosacinco"><input type="checkbox" value="2" name="dosacinco" id="has-dosacinco" /> 501 a 1.000</label>
                        <label for="has-masdecinco"><input type="checkbox" value="3" name="masdecinco" id="has-masdecinco" /> Más de 1.000</label>
                    </div>
                </div>
                <div class="contenedor-segundo-filtro-grupo col-lg-12">
                    <div class="contenedor-segundo-filtro-titulo color-titulo">
                        Toneladas (TNs)
                    </div>
                    <div class="contenedor-segundo-filtro-campo">
                        <label for="tns-Indistinto"><input type="checkbox" value="null" name="Indistinto" id="tns-Indistinto" /> <b>Indistinto</b></label>
                        <label for="tns-unoados"><input type="checkbox" value="1" name="unoados" id="tns-unoados" /> 1 a 2.500</label>
                        <label for="tns-dosacinco"><input type="checkbox" value="2" name="dosacinco" id="tns-dosacinco" /> 2.501 a 5.000</label>
                        <label for="tns-masdecinco"><input type="checkbox" value="3" name="masdecinco" id="tns-masdecinco" /> Más de 5.000</label>
                    </div>
                </div>
                <div class="contenedor-segundo-filtro-grupo col-lg-12">
                    <div class="contenedor-segundo-filtro-titulo color-titulo">
                        Calificación
                    </div>
                    <div class="contenedor-segundo-filtro-campo">
                        <label for="cal-Indistinto"><input type="checkbox" value="null" name="Indistinto" id="cal-Indistinto" /> <b>Indistinto</b></label>
                        <label for="cal-cinco"><input type="checkbox" value="5" name="cinco" id="cal-cinco" /><img src="~/Content/Images/estrellacalificacion.png" /><img src="~/Content/Images/estrellacalificacion.png" /><img src="~/Content/Images/estrellacalificacion.png" /><img src="~/Content/Images/estrellacalificacion.png" /><img src="~/Content/Images/estrellacalificacion.png" /></label>
                        <label for="cal-cuatro"><input type="checkbox" value="4" name="cuatro" id="cal-cuatro" /><img src="~/Content/Images/estrellacalificacion.png" /><img src="~/Content/Images/estrellacalificacion.png" /><img src="~/Content/Images/estrellacalificacion.png" /><img src="~/Content/Images/estrellacalificacion.png" /></label>
                        <label for="cal-tres"><input type="checkbox" value="3" name="tres" id="cal-tres" /><img src="~/Content/Images/estrellacalificacion.png" /><img src="~/Content/Images/estrellacalificacion.png" /><img src="~/Content/Images/estrellacalificacion.png" /></label>
                        <label for="cal-dos"><input type="checkbox" value="2" name="dos" id="cal-dos" /><img src="~/Content/Images/estrellacalificacion.png" /><img src="~/Content/Images/estrellacalificacion.png" /></label>
                        <label for="cal-uno"><input type="checkbox" value="1" name="uno" id="cal-uno" /><img src="~/Content/Images/estrellacalificacion.png" /></label>
                    </div>
                </div>
            </div>
            <div>
                <br /><br />
                <button class="k-button" onclick="BorrarCookies()" type="button" style="border-color: #017940; border-radius: 7px !important">
                    <i class="fa fa-refresh"></i> Borrar Cookies y Recargar Página
                </button>
            </div>
        </div>
        <div class="col-md-7 contactosHome ">
            <div class="lista-contactos-general "></div>
            <div class="text-center">
                <button id="verMasContactos" onclick="TraerSiguiente()" class="k-button k-button-icontext" type="button" style="display:none">Ver Más </button>
                <div id="cargandoContactos" class="lds-roller" style="display:none"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div>
            </div>
        </div>
    </div>

    <button class="chatbot-button" onclick="toggleChatbot()">
        <img src="https://s3-symbol-logo.tradingview.com/molinos-agro--big.svg">
        Habla con nuestro Agente
    </button>

    <div id="chatbot-modal" class="chatbot-modal">
        <div class="chatbot-container">
            <button class="chatbot-close-btn" onclick="toggleChatbot()">X</button>
            <iframe id="chatbot-iframe"
                    class="chatbot-iframe"
                    src="https://copilotstudio.microsoft.com/environments/Default-790c9737-0b8e-4138-a0f4-819cdc1eb64b/bots/cra54_wikiMoa/webchat?__version__=2">
            </iframe>
        </div>
    </div>
</div>

<style>
    td {
        font-size: 10px !important;
    }

    th {
        text-align: center !important;
        font-size: 10px !important;
    }

    #sojaCampania, #trigoCampania, #girCampania, #maizCampania, #sorgoCampania {
        font-weight: bold;
    }
