                            <td>#: DirectoAcopiador.FasonFas#</td>
                            <td>#: DirectoProductor.FasonFas#</td>
                        </tr>
                    </script>
                </div>
            </div>
            <div id="Trigo" class="tab-pane fade in">
                <div class="">
                    <table class="table table-bordered table-responsive-md table-striped text-center tabla" id="tablaTrigo">
