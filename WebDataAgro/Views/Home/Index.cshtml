            </div>
            <div id="Girasol" class="tab-pane fade in">
                <div class="">
                    <table class="table table-bordered table-responsive-md table-striped text-center tabla" id="tablaGi">
                        <thead>
                            <tr class="encabezado">
                                <th>Situación</th>
