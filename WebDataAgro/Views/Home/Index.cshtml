@{
    ViewBag.Title = "Data Agro";
}

<link rel="stylesheet" href="~/Content/home.css" />
<link rel="stylesheet" href="~/Content/homeResponsive.css" />
<script type="text/javascript" src="~/Scripts/App/home.js"></script>
@{
    var visualiza = PermisosHelper.Is(PermisosDataAgro.VisualizarDatosProveedor);
}
<script>visualiza = '@visualiza'</script>
<div class="row contenedor-principal">
    <div class="col-lg-3 contenedor-principal-widget"></div>

    <div class="col-lg-6 contenedor-principal-miscontactos">
        <div class="contenedor-principal-miscontactos-titulo">
            <div class="col-lg-7" style="padding-left: 0px;">
                Mis Contactos
            </div>
            <div class="col-lg-5" style="text-align:right;min-height: 22px;">
                <a id="abrirModalInformesFaltantes" class="exportar-contactos" style="display: inline-flex;">
                    <img src="/Content/Images/Reporte.png">
                    <span>Abrir Informes Comerciales faltantes</span>
                </a>
            </div>
        </div>
        <div class="contenedor-principal-miscontactos-subtitulo">
            Estado de mi agenda de proveedores
        </div>
        <div class="contenedor-principal-miscontactos-grupo">
            <a class="cont-agend-det">
                <div class="contenedor-principal-miscontactos-detalle miscontactos-selected">
                    <div class="contenedor-principal-miscontactos-detalle-titulo">
                        <img src="~/Content/Images/contprinc-cont1.png" />
                        <span class="contenedor-principal-miscontactos-detalle-cantidad verde cont-agend">

                        </span>
                    </div>
                    <div class="contenedor-principal-miscontactos-detalle-descripcion">
                        <b>Total de contactos agendados</b>
                    </div>
                </div>
            </a>
            <a class="cont-habilitado-det">
                <div class="contenedor-principal-miscontactos-detalle con-alta" style="background: #16BB50;">
                    <div class="contenedor-principal-miscontactos-detalle-titulo">
                        <img src="~/Content/Images/contprinc-cont23.png" />
                        <span class="contenedor-principal-miscontactos-detalle-cantidad cont-habilitado">

                        </span>
                    </div>
                    <div class="contenedor-principal-miscontactos-detalle-descripcion">
                        <b>Habilitado</b>
                    </div>
                </div>
            </a>
            <a class="cont-legajo-irregular-det">
                <div class="contenedor-principal-miscontactos-detalle con-alta" style="background: yellow;">
                    <div class="contenedor-principal-miscontactos-detalle-titulo">
                        <img src="~/Content/Images/contprinc-cont23.png" />
                        <span class="contenedor-principal-miscontactos-detalle-cantidad cont-legajo-irregular">

                        </span>
                    </div>
                    <div class="contenedor-principal-miscontactos-detalle-descripcion">
                        <b>Legajo irregular</b>
                    </div>
                </div>
            </a>
            <a class="cont-no-habilitado-det">
                <div class="contenedor-principal-miscontactos-detalle con-alta" style="background: #ff2d2d; ">
                    <div class="contenedor-principal-miscontactos-detalle-titulo">
                        <img src="~/Content/Images/contprinc-cont23.png" />
                        <span class="contenedor-principal-miscontactos-detalle-cantidad cont-no-habilitado">

                        </span>
                    </div>
                    <div class="contenedor-principal-miscontactos-detalle-descripcion">
                        <b>No habilitado</b>
                    </div>
                </div>
            </a>
        </div>
    </div>
    <div class="col-lg-3 contenedor-principal-campanas">
        <ul class="nav nav-tabs">
            <li class="active"><a data-toggle="pill" href="#Compras" class="contenedor-principal-campanas-titulo">Compras</a></li>
            <li><a data-toggle="pill" href="#Objetivos" class="contenedor-principal-campanas-titulo">Objetivos</a></li>
            <li class="dropdown">
                <a href="#" class="dropdown-toggle" data-toggle="dropdown">
                    <strong>Detalle</strong><b class="caret"></b>
                </a>
                <ul class="dropdown-menu">
                    <li hidden id="mostrarSoja"><a data-toggle="pill" href="#Soja">Soja  <strong id="sojaCampania"></strong></a></li>
                    <li hidden id="mostrarMaiz"><a data-toggle="pill" href="#Maiz">Maíz <strong id="maizCampania"></strong></a></li>
                    <li hidden id="mostrarTrigo"><a data-toggle="pill" href="#Trigo">Trigo <strong id="trigoCampania"></strong></a></li>
                    <li hidden id="mostrarGir"><a data-toggle="pill" href="#Girasol">Girasol <strong id="girCampania"></strong></a></li>
                    <li hidden id="mostrarSorgo"><a data-toggle="pill" href="#Sorgo">Sorgo <strong id="sorgoCampania"></strong></a></li>
                </ul>
            </li>
        </ul>
        <div class="tab-content">
            <div id="Compras" class="tab-pane fade in active">
                <div class="contenedor-principal-campanas-subtitulo">
                    Total granos comprados (TNs)
                </div>
                <div class="contenedor-principal-campanas-grupo">
                    <div class="contenedor-principal-campanas-detalle">

                    </div>
                </div>
            </div>
            <div id="Objetivos" class="tab-pane fade in">
                <div class="contenedor-principal-campanas-subtitulo">
                    Objetivo granos (TNs)
                    <button class="ajax-editar-link fa fa-plus btn btn-color col-12 col-md abrirModalLimite links-grid @(PermisosHelper.Is(PermisosDataAgro.VisualizarHedge) ? "" : "hide")" data-toggle="modal" data-target="#objetivo-modal"></button>
                    <button class="ajax-editar-link fa fa-eye btn btn-color col-12 col-md abrirModalLimite links-grid" data-toggle="modal" data-target="#objetivo-detalle-modal"></button>
                    <div class="contenedor-principal-objetivo-detalle"></div>
                </div>
            </div>

            <div id="Soja" class="tab-pane fade in">
                <div class="table-editable table-responsive">
                    <table class="table table-bordered table-responsive-md table-striped text-center tabla" id="tablaSoja">
                        <thead>
                            <tr class="encabezado">
                                <th>Situación</th>
                                <th>Con Corredor</th>
                                <th>Directo Acopiador</th>
                                <th>Directo Productor</th>
                            </tr>
                        </thead>
                        <tbody id="tabla-soja" data-template="div-tabla-soja" data-bind="source:Soja" type="text/x-kendo-template">
                        </tbody>
                    </table>
                    <script id="div-tabla-soja" type="text/x-kendo-template">
                        <tr>
                            <td>Compras con Precio</td>
                            <td>#: ConCorredor.ComprasConPrecio#</td>
                            <td>#: DirectoAcopiador.ComprasConPrecio#</td>
                            <td>#: DirectoProductor.ComprasConPrecio#</td>
                        </tr>
                        <tr>
                            <td>Recibido Sin Precio</td>
                            <td>#: ConCorredor.RecibidoSinPrecio#</td>
                            <td>#: DirectoAcopiador.RecibidoSinPrecio#</td>
                            <td>#: DirectoProductor.RecibidoSinPrecio#</td>
                        </tr>
                        <tr>
