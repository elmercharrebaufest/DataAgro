@{
    Layout = null;
}

<div class="modal fade" id="modalInformesComercialesPendientes" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="cerrar close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h1 class="modal-title" id="CargaCupos"></h1>
                <div class="status confirmado-modal">
                    <div>Informes Comerciales faltantes</div>
                </div>
                <div class="status confirmado-modal">
                    <a href="/Home/ExportarCapProdDesactualizadas" class="btn btn-primary">Descargar Excel</a>
                </div>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table id="carga-cupos-table" class="table table-striped">
                        <thead>
                            <tr>
                                <th>Razón Social</th>
                                <th>CUIT</th>
                                <th>Cosecha</th>
                                <th>Comercial</th>
                            </tr>
                        </thead>
                        <tbody id="cuerpo-carga-cupos"></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .modal-body {
        max-height: 70vh;
        overflow-y: auto;
    }
</style>