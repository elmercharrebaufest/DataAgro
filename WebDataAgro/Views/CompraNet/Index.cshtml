@using Molinos.DataAgro.Entities.Common.Enums

@{
    ViewBag.Title = "CompraNet";
}

@section Scripts {
    @Scripts.Render("~/bundles/CompraNetIndex")
}

@section Styles {
    <link href="~/Content/compraNet.css" rel="stylesheet" />
}

@if (global_asax.GlobalVariables.Perfil != EnumPerfil.Administrativo && global_asax.GlobalVariables.Perfil != EnumPerfil.Visualizador)
{

    <input type="hidden" id="perfil" value="@ViewBag.perfil" />
    <input type="hidden" id="TieneEmpleadosACargo" value="@(ViewBag.TieneEmpleadosACargo.ToString())" />
    <!--container-->
    <div class="panelflotante">
        <div class="row">
            <div class="float-left">
                <span id="crearContrato" class="btnAzul btn-block" type="button">
                    <i class="fa fa-file-o"></i>
                    Crear Nuevo Negocio
                </span>

            </div>
            <div class="autoRecarga" style="float:right">
                Autorecargar: <input type="checkbox" id="checkRecarga" name="autoRecarga" value="Autorecarga" checked>
            </div>
            <div class="autoRecarga" style="float:right">
                Notificaciones: <input type="checkbox" id="suscribirNotificacion" name="suscribirNotificacion" value="suscribirNotificacion" >
            </div>
        </div>
    </div>
    <div>
        <div>
            <div id="CompraNet">
                <br />
                @if (global_asax.GlobalVariables.Perfil == EnumPerfil.Mesa)
                {
                    <div id="contratos-pendientes" hidden>
                        <span>Contratos Pendientes. Por favor finalizar</span>
                        <table id="tabla-contratos-pendientes" class="table">
                            <thead>
                                <tr>
                                    <th>Proveedor</th>
                                    <th>Cantidad</th>
                                    <th>Precio</th>
                                    <th>Fecha</th>
                                    <th>Comercial</th>
                                </tr>
                            </thead>
                            <tbody id="tabla-pendientes" data-template="div-pendientes" data-bind="source:ContratosPendientes">
                                <tr>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>
                        <script id="div-pendientes" type="text/x-kendo-template">
                            <tr>
                                <td> &bull; #: RazonSocial#</td>
                                <td>#: Cantidad#</td>
                                <td>#: Precio# #: Moneda# </td>
                                <td>#: Fecha#</td>
                                <td>#: NombreApellido# </td>
                            </tr>
                        </script>
                    </div>
                }
                    <div class="row no-margin">
                        <div id="variosDiv" class="col-xs-12 col-md-4 col-md-offset-8">
                            <div id="confirmarVariosDiv" class="col-xs-5 col-md-5" data-toggle="tooltip" onclick="ModalConfirmadoVarios()">
                                <span class="botonVarios">
                                    <i class="fa fa-check varios" aria-hidden="true"></i>
                                </span>
                                <span>Confirmar</span>
                            </div>
                            <div id="finalizarVariosDiv" class="col-xs-5 col-md-5" data-toggle="tooltip" onclick="ModalFinalizarVarios()">
                                <span class="botonVarios">
                                    <i class="fa fa-flag-checkered varios" aria-hidden="true"></i>
                                </span>
                                <span>Finalizar </span>
                            </div>
                        </div>
                    </div>
                    <div class="row" id="nuevotab">
                        <div class="col-xs-12">
                            <div id="gridInformeCompraNet"></div>
                        </div>
                    </div>
                </div>
        </div>
    </div>

    <!-- Modal pendiente-->
    @Html.Partial("ModalPendiente")

    <!-- Modal finalizado-->
    @Html.Partial("ModalFinalizado")

    <!-- Modal Confirmado-->
    @Html.Partial("ModalConfirmado")

    <!-- Modal ConError-->
    @Html.Partial("ModalConError")

    <!-- Modal ConfirmadoTilde-->
    @Html.Partial("ModalConfirmadoTilde")

    <!-- Modal Ampliaciones-->
    @Html.Partial("ModalAmpliaciones")

    <!-- Modal Visualizar-->
    @Html.Partial("ModalVisualizar")

    <!-- Modal Borrar-->
    @Html.Partial("ModalBorrar")

    <!-- Modal Confirmar Varios-->
    @Html.Partial("_ModalConfirmarVarios")

    <!-- Modal Finalizar Varios-->
    @Html.Partial("_ModalFinalizarVarios")
}