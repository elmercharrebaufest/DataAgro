@{
    Layout = null;
}

<div class="modal fade" id="modalVisualizar" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header ">
                <button type="button" class="close" data-dismiss="modal">
                    <span aria-hidden="true">×</span>
                    <span class="sr-only">Close</span>
                </button>
                <div id="contrato" hidden></div>
                <h1 class="modal-title-visualizar" id="lineModalLabel"></h1>
                <button id="mostrar" hidden onclick="compararReconfirmacion()">Visualizar Modificación</button>
                <button id="ocultar" onclick="mostrarDetalles()" hidden>Ocultar Modificación</button>
                <div class="status pendiente-modal"><div>PENDIENTE</div></div>
                <div class="status confirmado-modal"><div>CONFIRMADO</div></div>
                <div class="status oferta-modal"><div>OFERTA</div></div>
                <div class="status conerror-modal"><div>CON ERROR</div></div>
                <div class="status finalizado-modal"><div>FINALIZADO</div></div>
                <div class="status borrado-modal"><div>RECHAZADO</div></div>
                <div class="status reconfirmar-modal"><div>RECONFIRMAR</div></div>
            </div>
            <div class="modal-body clearfix" id="datosContrato">
                <div id="DivVisualizar" class="row">
                    <div id="proveedorDivVisualizar" class="row campo marginCero noAgente clearfix">
                        <strong style="float:left">Proveedor:</strong>
                        <span id="visualizar_proveedor"></span>
                    </div>
                    <div id="corredorDivVisualizar" class="row campo marginCero clearfix" hidden>
                        <strong style="float:left">Corredor:</strong>
                        <span id="visualizar_corredor"></span>
                    </div>
                    <div id="agenteDeCompraDivVisualizar" class="row campo marginCero clearfix" hidden>
                        <strong style="float:left">Agente de Compra:</strong>
                        <span id="visualizar_agenteDeCompra"></span>
                    </div>
                    <div id="fechaDivVisualizar" class="row campo marginCero noAgente clearfix">
                        <strong style="float:left">Fecha de Operación:</strong>
                        <span id="fechacontrato"></span>
                    </div>
                    <div id="MotivoOperacionAnteriorDivVisualizar" class="row campo marginCero clearfix" hidden>
                        <strong style="float:left">Motivo Operacion Fecha Anterior:</strong>
                        <span id="visualizar_MotivoOperacionAnterior"></span>
                    </div>
                    <div id="fechaDesdeHastaDivVisualizar" class="row campo marginCero noFason noAgente clearfix noFijacion">
                        <strong style="float:left">Fecha Desde - Fecha Hasta (Entrega):</strong>
                        <span id="visualizar_desdeHasta"></span>
                    </div>
                    <div class="row campo marginCero clearfix noFason noAgente noFijacion">
                        <div id="clasificacionDivVisualizar ">
                            <strong style="float:left">Clasificación:</strong>
                            <span id="visualizar_clasificacion"></span>
                            <span id="visualizar_consignatario" style="margin:0"></span>
                        </div>
                    </div>
                    <div class="row marginCero">
                        <div id="materialDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Material:</strong>
                            <span id="visualizar_material"></span>
                        </div>
                        <div id="campanaDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <div>
                                <strong style="float:left">Campaña:</strong>
                                <span id="visualizar_campana"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row marginCero">
                        <div id="cantidadDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">KG:</strong>
                            <span id="visualizar_cantidad"></span>
                        </div>
                        <div id="cantidadDeCamionesDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Cantidad de Camiones:</strong>
                            <span id="visualizar_cantidadDeCamiones"></span>
                        </div>
                    </div>
                    <div class="row marginCero clearfix">
                        <div id="precioDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix ">
                            <strong style="float:left">Precio:</strong>
                            <span id="visualizar_precio"></span>
                        </div>
                        <div id="comercialDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Comercial:</strong>
                            <span id="visualizar_comercial"></span>
                        </div>
                    </div>
                    <div class="row marginCero clearfix">
                        <div id="porcentajeDePagoDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix ">
                            <strong style="float:left">Porcentaje de Pago:</strong>
                            <span id="visualizar_porcentajeDePago"></span>
                        </div>
                        @*<div id="comercialDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                <strong style="float:left">Comercial:</strong>
                <span id="visualizar_comercial"></span>
            </div>*@
                    </div>

                    <div id="aperturaDiv" class="bordeSeccionVisualizar">

                        <div id="aperturaDePrecioVisualizarDiv" class="row marginCero clearfix campo col-xs-12 noPadding campoAdicionales noFason noAgente aperturaPrecio">
                            <strong style="float:left">Apertura precio: </strong>
                            <span id="visualizar_aperturaPrecio"></span>
                        </div>
                        <div class="row marginCero clearfix noFason noAgente" id="aperturaDePrecioVisualizarDivPrecioNeto">
                            <div class="dobleColumna col-sm-12 col-xs-12 noPadding clearfix " id="dobleAperturaPrecioNeto">
                                <strong style="float:left">Precio neto:</strong>
                                <span id="visualizar_aperturaFinancieroPrecioNeto"></span>
                            </div>

                        </div>
                        <div class="row marginCero clearfix noFason noAgente">
                            <div id="aperturaFinancieroDivVisualizar" class="dobleColumna col-sm-6 col-xs-12 noPadding clearfix ">
                                <strong style="float:left">Financiero:</strong>
                                <span id="visualizar_aperturaFinanciero"></span>
                            </div>
                            <div id="aperturaRedespachoDivVisualizar" class="dobleColumna col-sm-6 col-xs-12 noPadding clearfix">
                                <strong style="float:left">Redespacho:</strong>
                                <span id="visualizar_aperturaRedespacho"></span>
                            </div>
                        </div>
                        <div class="row marginCero clearfix noFason noAgente">
                            <div id="aperturaComisionesDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix ">
                                <strong style="float:left">Comisiones:</strong>
                                <span id="visualizar_aperturaComisiones"></span>
                            </div>
                            <div id="aperturaBonificacionesDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                                <strong style="float:left">Bonificaciones:</strong>
                                <span id="visualizar_aperturaBonificaciones"></span>
                            </div>
                        </div>

                    </div>
                    <div class="row marginCero clearfix" id="fleteDivVisualizar">
                        <div class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Nivel Tarifa:</strong>
                            <span id="visualizar_nivelFlete"></span>
                        </div>
                        <div class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Tarifa Flete:</strong>
                            <span id="visualizar_tarifaFlete"></span>
                        </div>
                    </div>
                    <div class="row marginCero">
                        <div id="tipoDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Tipo:</strong>
                            <span id="visualizar_tipo"></span>
                        </div>
                        <div id="destinoDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding noFason noAgente clearfix">
                            <strong style="float:left">Destino:</strong>
                            <span id="visualizar_destino"></span>
                        </div>
                    </div>
                    <div class="row marginCero fason agente" hidden>
                        <div id="tipoFasonDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix noAgente">
                            <strong style="float:left">Tipo de Fasón:</strong>
                            <span id="visualizar_tipofason"></span>
                        </div>
                        <div id="operadorDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix noFason">
                            <strong style="float:left">Operador:</strong>
                            <span id="visualizar_operador"></span>
                        </div>
                        <div id="posicionDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Posicion:</strong>
                            <span id="visualizar_posicion"></span>
                        </div>
                    </div>
                    <div class="row marginCero">
                        <div id="planCanjeDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Plan Canje:</strong>
                            <span id="visualizar_planCanje"></span>
                        </div>
                        <div id="establecimientoDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Establecimiento:</strong>
                            <span id="visualizar_establecimiento"></span>
                        </div>
                    </div>
                    <div id="procedenciaDivVisualizar" class="row campo marginCero clearfix noFason noAgente noPadding noFijacion">
                        <strong style="float:left">Procedencia:</strong>
                        <span id="visualizar_procedencia"></span>
                    </div>
                    <div class="row marginCero">
                        <div id="sustentableDivVisualizar" class="campo campoAdicionales col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Sustentable (Bonificaci&oacute;n):</strong>
                            <span id="visualizar_sustentablePrecio"></span>
                        </div>
                        <div id="dolarizadoFechaDivVisualizar" class="campo campoAdicionales col-sm-6 col-xs-12 noPadding noFason noAgente clearfix">
                            <strong style="float:left">Dolarizado (Fecha l&iacute;mite):</strong>
                            <span id="visualizar_dolarizadoFecha"></span>
                        </div>
                    </div>
                    <div class="row marginCero">
                        <div id="pesificadoDiasDivVisualizar" class="campo campoAdicionales col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Pesificado (D&iacute;as diferimiento):</strong>
                            <span id="visualizar_pesificadoDias"></span>
                        </div>
                        <div id="informaSIODivVisualizar" class="campo campoAdicionales col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">NO Informa SIO:</strong>
                            <span id="visualizar_informaSIO"></span>
                        </div>
                    </div>
                    <div class="row marginCero">
                        <div id="pagoDivVisualizar" class="campo campoAdicionales col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Pago:</strong>
                            <span id="visualizar_pago"></span>
                        </div>
                        <div id="mercsDepositoDivVisualizar" class="campo campoAdicionales col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Mercaderías en Depósito:</strong>
                            <span id="visualizar_mercsDeposito"></span>
                        </div>
                    </div>
                    <div class="row marginCero">
                        <div id="boletoDivVisualizar" class="campo campoAdicionales col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Boleto:</strong>
                            <span id="visualizar_boleto"></span>
                        </div>
                        <div id="bolsaDivVisualizar" class="campo campoAdicionales col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Bolsa:</strong>
                            <span id="visualizar_bolsa"></span>
                        </div>
                    </div>
                    <div class="row marginCero clearfix col-xs-12 noPadding noFijacion" id="descuentos">
                        <div id="descuentosDivVisualizar">
                            <div id="tabla-descuentos-visualizar" data-template="div-template-visualizar" data-bind="source:DescuentosVisualizar">
                                <span></span>
                                <span></span>
                                <span></span>
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                            <script id="div-template-visualizar" type="text/x-kendo-template">
                                <div class="row marginCero campo campoAdicionales">
                                    <span style="margin:0"><strong> Desc. y Bon. #: TipoPeriodoDBDesc#:</strong></span>
                                    <span style="margin:0">#: TipoDBDesc#</span>
                                    <span data-bind="visible: TipoPeriodoDBId!=1"><strong>Desde:</strong> #: FechaDesde#&nbsp; </span>
                                    <span style="margin-right:10px;" data-bind="visible: TipoPeriodoDBId!=1"><strong>Hasta:</strong> #:FechaHasta#</span>
                                    <span style="display:inline-block;" data-bind="visible: Importe!=0"><strong>Importe: </strong>#:Importe# #:MonedaId#</span>
                                    <span style="display:inline-block; margin-left:10px;" data-bind="visible: Porcentaje!=0"><strong>Porc:</strong> #:Porcentaje#%</span>
                                </div>
                            </script>
                        </div>
                    </div>
                    <div id="desdeHastaFijacionDivVisualizar" class="row marginCero clearfix campo col-xs-12 noPadding campoAdicionales noFijacion">
                        <strong>Fecha Desde - Fecha Hasta (Fijacion):</strong>
                        <span id="visualizar_desdeHastaFijacion" class="centrar"></span>
                    </div>
                    <div id="condicionFijacionDivVisualisar" class="row marginCero clearfix  col-xs-12 noPadding campo campoAdicionales noFijacion">
                        <strong>Condición Fijacion:</strong>
                        <span id="visualizar_condicionFijacion" class="centrar"></span>
                    </div>

                    <div id="tipoCalidadDiv" class="row campo campoAdicionales marginCero clearfix noFason noAgente noPadding noFijacion">
                        <strong style="float:left">Calidad:</strong>
                        <span id="visualizar_calidad"></span>
                        <span id="visualizar-zona-girasol"></span>
                    </div>

                    <div id="calidadesDivVisualizar" class="row campo marginCero clearfix noFason noAgente noPadding noFijacion">
                        <div id="tabla-calidades-visualizar" data-template="div-calidades-visualizar-template" data-bind="source:CalidadesVisualizar">
                            <div></div>
                            <div></div>
                            <div></div>
                        </div>
                        <script id="div-calidades-visualizar-template" type="text/x-kendo-template">
                            <div>
                                <div class="noPadding col-xs-12 col-md-3">
                                    <strong>
                                        <span id="TipoCalidad" style="margin:0"> #: CalidadEspecialDesc#</span>
                                    </strong>
                                </div>
                                <div class="col-xs-4 col-md-3"><strong>Valor: </strong>#: Valor#</div>
                                <div class="col-xs-4 col-md-6" data-bind="visible: PorcentajeDesde!=null">
                                    <strong> Desde: </strong>#: PorcentajeDesde#% -
                                    <strong> Hasta: </strong>#: PorcentajeHasta#%
                                </div>
                            </div>
                        </script>
                    </div>

                    <div id="pactadosDivVisualizar" class="row campo marginCero clearfix noFason noAgente noPadding noFijacion">
                        <strong style="float:left">Precios Pactados:</strong>
                        <table id="tabla-precios-pactados" class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Fecha Desde</th>
                                    <th>Fecha Hasta</th>
                                    <th>Precio</th>
                                    <th>Importe</th>
                                    <th>Porcentaje</th>
                                </tr>
                            </thead>
                            <tbody data-template="precio-pactado-template" data-bind="source:PreciosVisualizar"></tbody>
                        </table>
                        <script id="precio-pactado-template" type="text/x-kendo-template">
                            <tr>
                                <td>#: FechaDesde #</td>
                                <td>#: FechaHasta #</td>
                                <td>#: Precio # #: MonedaPactadoDesc #</td>
                                @*<td>#: ImportePactado # #: MonedaImportePactadoDesc #</td>*@
                                <td># if(ImportePactado>0){ # #: ImportePactado # #: MonedaImportePactadoDesc # #}#</td>
                                <td>#: Porcentaje #</td>
                            </tr>
                        </script>
                    </div>
                    <div class="row marginCero">
                        <div id="contratoCorredorVisualizar" class="campo campoAdicionales col-sm-6 col-xs-12 noPadding clearfix">
