@{
    Layout = null;
}

<div class="modal fade" id="modalVisualizar" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content datosContrato">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">
                    <span aria-hidden="true">×</span>
                    <span class="sr-only">Close</span>
                </button>
                <div id="contrato" hidden></div>
                <div class="noCopiarDatos">
                    <div class="row">
                        <strong><label style="font-weight: bolder; font-size: 16px;" class="modal-title-visualizar" id="lineModalLabel"></label></strong>
                        <button type="button" style="width: 30px;border: none;font-size: 18px;" class="myBtn" onclick="copiarImagen()"><i class="fa fa-copy"></i></button>
                    </div>
                    <button id="mostrar" class="boton" hidden onclick="compararReconfirmacion()">
                        Ver Modificación
                    </button>
                </div>
                <button id="ocultar" class="boton" onclick="mostrarDetalles()" hidden>Ocultar Modificación</button>
                <div class="status pendiente-modal row"><div class="col-md-9 col-sm-9">PENDIENTE</div><div class="noCopiarDatos" id="botoneriaPendDiv" style="text-align: right"></div></div>
                <div class="status confirmado-modal row"><div class="col-md-9 col-sm-9">CONFIRMADO</div><div class="noCopiarDatos" id="botoneriaConfDiv" style="text-align: right"></div></div>
                <div class="status oferta-modal row"><div class="col-md-8 col-sm-9">OFERTA</div><div class="noCopiarDatos" id="botoneriaOferDiv" style="text-align: right"></div></div>
                <div class="status conerror-modal row"><div class="col-md-8 col-sm-9">CON ERROR</div><div class="noCopiarDatos" id="botoneriaErroDiv" style="text-align: right"></div></div>
                <div class="status finalizado-modal row"><div class="col-md-8 col-sm-9">FINALIZADO</div><div class="noCopiarDatos" id="botoneriaFinaDiv" style="text-align: right"></div></div>
                <div class="status borrado-modal"><div>RECHAZADO</div><div class="noCopiarDatos" id="botoneriaRechDiv" style="text-align: right" hidden></div></div>
                <div class="status reconfirmar-modal row"><div class="col-md-8 col-sm-9">RECONFIRMAR</div><div class="noCopiarDatos" id="botoneriaRecoDiv" style="text-align: right"></div></div>
                <div id="botoneriaDiv"></div>
            </div>
            <div class="modal-body clearfix datosContrato" id="datosContrato">
                <label hidden style="font-weight: bolder; font-size: 16px;" class="modal-title-visualizar" id="lineModalLabelCopiar"></label>
                <div id="DivVisualizar" class="row tamanioModal">
                    <div id="proveedorDivVisualizar" class="row campo marginCero noAgente clearfix">
                        <strong style="float:left">Proveedor:</strong>
                        <span id="visualizar_proveedor"></span>
                    </div>
                    <div id="comisionistaProveedorDivVisualizar" class="row campo marginCero noAgente clearfix">
                        <strong style="float:left">Comisionista:</strong>
                        <span id="visualizar_comisionistaProveedor"></span>
                    </div>
                    <div id="corredorDivVisualizar" class="row campo marginCero clearfix" hidden>
                        <strong style="float:left">Corredor:</strong>
                        <span id="visualizar_corredor"></span>
                    </div>
                    <div id="agenteDeCompraDivVisualizar" class="row campo marginCero clearfix" hidden>
                        <strong style="float:left">Agente de Compra:</strong>
                        <span id="visualizar_agenteDeCompra"></span>
                    </div>
                    <div id="fechaDivVisualizar" class="row campo marginCero noAgente clearfix">
                        <strong style="float:left">Fecha de Operación:</strong>
                        <span id="fechacontrato"></span>
                    </div>
                    <div id="MotivoOperacionAnteriorDivVisualizar" class="row campo marginCero clearfix" hidden>
                        <strong style="float:left">Motivo Operación Fecha Anterior:</strong>
                        <span id="visualizar_MotivoOperacionAnterior"></span>
                    </div>
                    <div id="fechaDesdeHastaDivVisualizar" class="row campo marginCero noFason noAgente clearfix noFijacion">
                        <strong style="float:left">Fecha Desde - Fecha Hasta (Entrega):</strong>
                        <span id="visualizar_desdeHasta"></span>
                    </div>
                    <div id="fechaDesdeHastaOriginalDivVisualizar" class="row campo marginCero noFason noAgente clearfix noFijacion">
                        <strong style="float:left">Fecha Hasta Original (Entrega):</strong>
                        <span id="visualizar_desdeHastaOriginal"></span>
                    </div>
                    <div class="row campo marginCero clearfix noFason noAgente noFijacion" id="clasificacionDivVisualizar">
                        <div id="clasificacionDivVisualizar ">
                            <strong style="float:left">Clasificación:</strong>
                            <span id="visualizar_clasificacion"></span>
                            <span id="visualizar_consignatario" style="margin:0"></span>
                        </div>
                    </div>
                    <div class="row marginCero">
                        <div id="materialDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Material:</strong>
                            <span id="visualizar_material"></span>
                        </div>
                        <div id="campanaDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <div>
                                <strong style="float:left">Campaña:</strong>
                                <span id="visualizar_campana"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row marginCero">
                        <div id="cantidadDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
