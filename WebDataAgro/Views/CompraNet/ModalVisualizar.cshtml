                        <div class="row marginCero clearfix campo col-xs-12 noPadding" id="visualizar_datosTercero">
                            
                        </div>
                        <div class="row marginCero clearfix campo col-xs-12 noPadding">
                            <strong style="float:left">Observaci&oacute;n: </strong>
                            <span id="visualizar_observacionTercero"></span>
                        </div>
                    </div>

                </div>
            </div>

            <div id="tablaModificacion" class="text-xs-center table-responsive">
                <table hidden id="tablaComparar" class="table table-striped"  style="width:100%">
                </table>
            </div>
        </div>
        </div>
</div>