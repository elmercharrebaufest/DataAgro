                            <strong style="float:left">Fijación Mínimo(Kg):</strong>
                            <span id="minimoId"></span>
                        </div>
                        <div class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Fijación Máximo(Kg):</strong>
                            <span id="maximoId"></span>
                        </div>
                    </div>
                    <div class="row marginCero clearfix">
                        <div id="precioDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix ">
                            <strong style="float:left">Precio:</strong>
                            <span id="visualizar_precio"></span>
                        </div>
                        <div id="comercialDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Comercial:</strong>
                            <span id="visualizar_comercial"></span>
                        </div>
                    </div>
                    <div class="row marginCero clearfix">
                        <div id="porcentajeDePagoDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix ">
                            <strong style="float:left">Porcentaje de Pago:</strong>
                            <span id="visualizar_porcentajeDePago"></span>
                        </div>
                        <div id="conDescargaDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix" hidden>
                            <strong style="float:left">Con Descarga</strong>
                            <button id="btnConDescarga" style="margin-left: 20px;">Ver Cupos</button>
                        </div>
                    </div>

                    <div id="aperturaDiv" class="bordeSeccionVisualizar">

                        <div id="aperturaDePrecioVisualizarDiv" class="row marginCero clearfix campo col-xs-12 noPadding campoAdicionales noFason noAgente aperturaPrecio">
                            <strong style="float:left">Apertura precio: </strong>
                            <span id="visualizar_aperturaPrecio"></span>
                        </div>
                        <div class="row marginCero clearfix noFason noAgente" id="aperturaDePrecioVisualizarDivPrecioNeto">
                            <div class="dobleColumna col-sm-12 col-xs-12 noPadding clearfix " id="dobleAperturaPrecioNeto">
                                <strong style="float:left">Precio neto:</strong>
                                <span id="visualizar_aperturaFinancieroPrecioNeto"></span>
                            </div>

                        </div>
                        <div class="row marginCero clearfix noFason noAgente">
                            <div id="aperturaFinancieroDivVisualizar" class="dobleColumna col-sm-6 col-xs-12 noPadding clearfix ">
                                <strong style="float:left">Financiero:</strong>
                                <span id="visualizar_aperturaFinanciero"></span>
                            </div>
                            <div id="aperturaRedespachoDivVisualizar" class="dobleColumna col-sm-6 col-xs-12 noPadding clearfix">
                                <strong style="float:left">Redespacho:</strong>
                                <span id="visualizar_aperturaRedespacho"></span>
                            </div>
                        </div>
                        <div class="row marginCero clearfix noFason noAgente">
                            <div id="aperturaComisionesDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix ">
                                <strong style="float:left">Comisiones:</strong>
                                <span id="visualizar_aperturaComisiones"></span>
                            </div>
                            <div id="aperturaBonificacionesDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                                <strong style="float:left" id="condicional">Bonificaciones:</strong>
                                <span id="visualizar_aperturaBonificaciones"></span>
                            </div>
                        </div>
                        <div class="row marginCero clearfix noFason noAgente" id="aperturaBasisDivVisualizar">
                            <div class="campo col-sm-6 col-xs-12 noPadding clearfix">
                                <strong style="float:left">Basis:</strong>
                                <span id="visualizar_aperturaBasis"></span>
                            </div>
                        </div>
                        <div class="campo col-sm-6 col-xs-12 noPadding clearfix" id="divPosicionCBOT">
                            <strong style="float:left">Posicion:</strong>
                            <span id="visualizar_PosicionCBOT"></span>
                        </div>

                    </div>
                    <div class="row marginCero clearfix" id="fleteDivVisualizar">
                        <div class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Nivel Tarifa:</strong>
                            <span id="visualizar_nivelFlete"></span>
                        </div>
                        <div class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Tarifa Flete:</strong>
                            <span id="visualizar_tarifaFlete"></span>
                        </div>
                    </div>
                    <div class="row marginCero">
                        <div id="tipoDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Tipo:</strong>
                            <span id="visualizar_tipo"></span>
