                    </div>
                    <div class="row marginCero">
                        <div id="FechaCiertaVisualizar" class="campo campoAdicionales col-xs-12 noPadding clearfix">
                            <strong style="float:left">Fecha Cierta </strong>
                            <span id="visualizar_FechaCierta"></span>
                        </div>
                    </div>
                    <div class="row marginCero clearfix campo col-xs-12 noPadding campoAdicionales noFason noAgente observacion">
                        <strong style="float:left">Observaci&oacute;n: </strong>
                        <span id="visualizar_observacion"></span>
                    </div>
                    <div class="row marginCero clearfix campo col-xs-12 noPadding campoAdicionales rechazo">
                        <strong style="float:left">Motivo Rechazo: </strong>
                        <span id="visualizar_rechazo"></span>
                    </div>
                    <div id="datosCargaTercero" style="border:2px solid red; display:none;">
