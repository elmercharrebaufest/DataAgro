                            <span id="visualizar_cantidad"></span>
                        </div>
                        <div id="cantidadDeCamionesDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Cantidad de Camiones:</strong>
                            <span id="visualizar_cantidadDeCamiones"></span>
                        </div>
                    </div>
                    <div class="row marginCero rangos" id="">
