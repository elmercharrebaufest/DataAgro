@{
    Layout = null;
}

<div class="modal fade" id="modalVisualizar" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header ">
                <button type="button" class="close" data-dismiss="modal">
                    <span aria-hidden="true">×</span>
                    <span class="sr-only">Close</span>
                </button>
                <h1 class="modal-title-visualizar" id="lineModalLabel"></h1>
                <div class="status pendiente-modal"><div>PENDIENTE</div></div>
                <div class="status confirmado-modal"><div>CONFIRMADO</div></div>
                <div class="status oferta-modal"><div>OFERTA</div></div>
                <div class="status conerror-modal"><div>CON ERROR</div></div>
                <div class="status finalizado-modal"><div>FINALIZADO</div></div>
                <div class="status borrado-modal"><div>RECHAZADO</div></div>
            </div>
            <div class="modal-body clearfix ">
                <div id="DivVisualizar" class="row">
                    <div id="proveedorDivVisualizar" class="row campo marginCero clearfix">
                        <strong style="float:left">Proveedor:</strong>
                        <span id="visualizar_proveedor"></span>
                    </div>
                    <div id="fechaDivVisualizar" class="row campo marginCero clearfix">
                        <strong style="float:left">Fecha de Operación:</strong>
                        <span id="fechacontrato"></span>
                    </div>
                    <div id="fechaDesdeHastaDivVisualizar" class="row campo marginCero clearfix noFijacion">
                        <strong style="float:left">Fecha Desde - Fecha Hasta (Entrega):</strong>
                        <span id="visualizar_desdeHasta"></span>
                    </div>
                    <div class="row campo marginCero clearfix noFijacion">
                        <div id="clasificacionDivVisualizar">
                            <strong style="float:left">Clasificación:</strong>
                            <span id="visualizar_clasificacion"></span>
                        </div>
                    </div>
                    <div class="row marginCero">
                        <div id="materialDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Material:</strong>
                            <span id="visualizar_material"></span>
                        </div>
                        <div id="campanaDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <div>
                                <strong style="float:left">Campaña:</strong>
                                <span id="visualizar_campana"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row marginCero">
                        <div id="cantidadDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">                           
                                <strong style="float:left">KG:</strong>
                                <span id="visualizar_cantidad"></span>                            
                        </div>
                        <div id="cantidadDeCamionesDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Cantidad de Camiones:</strong>
                            <span id="visualizar_cantidadDeCamiones"></span>
                        </div>
                    </div>
                    <div class="row marginCero clearfix">
                        <div class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <div id="precioDivVisualizar">
                                <strong style="float:left">Precio:</strong>
                                <span id="visualizar_precio"></span>
                            </div>
                        </div>
                        <div class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <div id="comercialDivVisualizar">
                                <strong style="float:left">Comercial:</strong>
                                <span id="visualizar_comercial"></span>
                            </div>
                        </div>
                    </div>
                    <div class="row marginCero">
                        <div id="tipoDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Tipo:</strong>
                            <span id="visualizar_tipo"></span>
                        </div>
                        <div id="establecimientoDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Establecimiento:</strong>
                            <span id="visualizar_establecimiento"></span>
                        </div>
                    </div>
                    <div class="row marginCero">
                        <div id="planCanjeDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Plan Canje:</strong>
                            <span id="visualizar_planCanje"></span>
                        </div>
                        <div id="consignatarioDivVisualizar" class="campo col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Consignatario:</strong>
                            <span id="visualizar_consignatario"></span>
                        </div>
                    </div>
                    <div id="procedenciaDivVisualizar" class="row campo marginCero clearfix noPadding noFijacion">
                        <strong style="float:left">Procedencia:</strong>
                        <span id="visualizar_procedencia"></span>
                    </div>
                    <div class="row marginCero clearfix campo col-xs-12 noPadding noFijacion">
                        <div id="destinoDivVisualizar">
                            <strong style="float:left">Destino:</strong>
                            <span id="visualizar_destino"></span>
                        </div>
                    </div>
                    <div class="row marginCero">
                        <div id="sustentableDivVisualizar" class="campo campoAdicionales col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Sustentable (Bonificaci&oacute;n):</strong>
                            <span id="visualizar_sustentablePrecio"></span>
                        </div>
                        <div id="dolarizadoFechaDivVisualizar" class="campo campoAdicionales col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Dolarizado (Fecha l&iacute;mite):</strong>
                            <span id="visualizar_dolarizadoFecha"></span>
                        </div>
                    </div>
                    <div class="row marginCero">
                        <div id="pesificadoDiasDivVisualizar" class="campo campoAdicionales col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Pesificado (D&iacute;as diferimiento):</strong>
                            <span id="visualizar_pesificadoDias"></span>
                        </div>
                        <div id="informaSIODivVisualizar" class="campo campoAdicionales col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Informa SIO:</strong>
                            <span id="visualizar_informaSIO"></span>
                        </div>
                    </div>
                    <div class="row marginCero">
                        <div id="pagoDivVisualizar" class="campo campoAdicionales col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Pago:</strong>
                            <span id="visualizar_pago"></span>
                        </div>
                        <div id="mercsDepositoDivVisualizar" class="campo campoAdicionales col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Mercaderías en Depósito:</strong>
                            <span id="visualizar_mercsDeposito"></span>
                        </div>
                    </div>
                    <div class="row marginCero">
                        <div id="boletoDivVisualizar" class="campo campoAdicionales col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Boleto:</strong>
                            <span id="visualizar_boleto"></span>
                        </div>
                        <div id="bolsaDivVisualizar" class="campo campoAdicionales col-sm-6 col-xs-12 noPadding clearfix">
                            <strong style="float:left">Bolsa:</strong>
                            <span id="visualizar_bolsa"></span>
                        </div>
                    </div>
                    <div class="row marginCero clearfix col-xs-12 noPadding noFijacion">
                        <div id="descuentosDivVisualizar">
                            <div id="tabla-descuentos-visualizar" data-template="div-template-visualizar" data-bind="source:DescuentosVisualizar">
                                <span></span>
                                <span></span>
                                <span></span>
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                            <script id="div-template-visualizar" type="text/x-kendo-template">
                                <div class="row marginCero campo campoAdicionales">
                                    <span style="margin:0"><strong> Descuentos y Bonificaciones #: TipoPeriodoDBDesc#:</strong></span>
                                    <span>#: TipoDBDesc#</span><br />
                                    <span data-bind="visible: TipoPeriodoDBId!=1"><strong>Desde:</strong> #: FechaDesde#&nbsp; </span>
                                    <span style="margin-right:10px;" data-bind="visible: TipoPeriodoDBId!=1"><strong>Hasta:</strong> #:FechaHasta#</span>
                                    <span style="display:inline-block;"data-bind="visible: Importe!=0"><strong>Importe: </strong>#:Importe# #:MonedaId#</span>
                                    <span style="display:inline-block; margin-left:10px;" data-bind="visible: Porcentaje!=0"><strong>Porc:</strong> #:Porcentaje#%</span>
                                </div>
                            </script>
                        </div>
                    </div>
                    <div id="desdeHastaFijacionDivVisualizar" class="row marginCero clearfix campo col-xs-12 noPadding campoAdicionales noFijacion">
                        <strong style="float:left">Fecha Desde - Fecha Hasta (Fijacion):</strong>
                        <span id="visualizar_desdeHastaFijacion" class="centrar"></span>
                    </div>
                    <div id="condicionFijacionDivVisualisar" class="row marginCero clearfix  col-xs-12 noPadding campo campoAdicionales noFijacion">
                        <strong style="float:left">Condición Fijacion:</strong>
                        <span id="visualizar_condicionFijacion" class="centrar"></span>
                    </div>
                    <div id="calidadesDivVisualizar" >
                        
                        <div id="tabla-calidades-visualizar" data-template="div-calidades-visualizar-template" data-bind="source:CalidadesVisualizar">
                            <div></div>
                            <div></div>
                            <div></div>
                        </div>
                        <script id="div-calidades-visualizar-template" type="text/x-kendo-template">
                            <div>
                                <div class="row marginCero campo campoAdicionales">
                                    <div class="noPadding col-xs-12 col-md-4">
                                        <strong>
                                            <span style="margin:0">Calidad:</span>
                                            <span id="TipoCalidad" style="margin:0"> #: CalidadEspecialDesc#</span>
                                        </strong>
                                    </div>
                                    <div class="col-xs-4 col-md-3"><strong>Valor: </strong>#: Valor#</div>
                                    <div class="col-xs-4 col-md-5" data-bind="visible: PorcentajeDesde!=null">
                                        <strong>Porcentaje Desde: </strong>#: PorcentajeDesde#% <br />
                                        <strong>Porcentaje Hasta: </strong>#: PorcentajeHasta#%
                                    </div>
                                </div>
                            </div>
                        </script>
                    </div>
                    <div class="row marginCero clearfix campo col-xs-12 noPadding campoAdicionales observacion">
                        <strong style="float:left">Observaci&oacute;n: </strong>
                        <p id="visualizar_observacion"></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>