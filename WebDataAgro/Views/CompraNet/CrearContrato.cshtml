                </div>
            </div>
        </div>
        <div class="row acuerdo ampliar">
            <div class="contratoAFijar noFason noAgente ampliar acuerdoSinPrecio">
                <div class="col-sm-2 ">
                    <label>Condición fijación</label>
                </div>
                <div class="col-sm-10 col-md-4">
                    <select id="condicionFijacionId" data-bind="source:CondicionFijacionCombo, value: Parametros.CondicionFijacionId, disabled: isControlDisabled"></select>
                    <img id="errcondicionFijacionId" src="~/Content/Images/error.png" style="display:none" />
