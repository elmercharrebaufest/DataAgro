            </div>
            <div class="contratoAFijar acuerdoSinPrecio">
                <div class="col-sm-5 col-md-2">
                    <span id="fechaHastaTopeDiv">
                        <input id="fechaHastaTopeId" type="date" style="width: 100%" />
                        <img id="errfechaHastaTopeId" src="~/Content/Images/error.png" style="display:none" />
                    </span>
                </div>
            </div>
            <div class="col-sm-5 col-md-2 contratoAFijar ampliar">
                <div class="madreDiv " style="padding-right:0">
                    <label style="width:60px">Convenio</label>
                    <input id="madreId" class="campo-input-input" data-bind="checked:Parametros.Madre, disabled: isControlDisabled" type="checkbox" />
                    <img id="errmadreId" src="~/Content/Images/error.png" style="display:none" />
                </div>
            </div>
            <div class="col-sm-5 col-md-3 contratoAFijar ampliar">
