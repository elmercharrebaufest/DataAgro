            <label>Tipo</label>
        </div>
        <div class="col-md-4 col-sm-5">
            <div>
                <select id="tipoId" class="required-box" data-bind="source: TipoCombo, value: Parametros.tipoId, disabled: isControlDisabled" required="required"></select>
                <img id="errtipoId" src="~/Content/Images/error.png" style="display:none" />
            </div>
        </div>

        <div id="destinoDiv" class="noFason noAgente">
            <div class="col-sm-1">
                <label>Destino</label>
            </div>
            <div class="col-md-4 col-sm-4">
                <select id="destinoId" data-bind="source: DestinoCombo, value: Parametros.Destino, disabled: isControlDisabled"></select>
                <img id="errDestinoId" src="~/Content/Images/error.png" style="display:none" />
            </div>
        </div>
        <div id="tipoFasonDiv" class="fason" hidden>
            <div class="col-sm-1">
                <label>Tipo Fasón</label>
            </div>
            <div class="col-md-4 col-sm-4">
