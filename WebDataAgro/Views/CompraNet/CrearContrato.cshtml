        <div class="col-sm-2">
            <label>Agente de Compra</label>
        </div>
        <div class="col-md-4 col-sm-5">
            <select id="AgenteCompraId" data-bind="source: tipoAgenteCompraCombo, value: Parametros.TipoAgenteCompra"></select>
        </div>
    </div>*@

