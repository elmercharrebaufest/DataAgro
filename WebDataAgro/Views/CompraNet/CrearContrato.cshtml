@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "CompraNet";
}

@section Scripts {
    @Scripts.Render("~/bundles/CompraNetContrato")
}

@section Styles {
    <link href="~/Content/compraNet.css" rel="stylesheet" />
}    
    <div id="CrearContrato">
        <br />

        <div class="row">
            <div class="col-md-2">
                <label>Proveedor</label>
            </div>
            <div class="col-md-10">
                <input id="buscadorProveedor" class="k-textbox" type="text" placeholder="Buscar por CUIT, razón social" style="max-width: 550px" />
                <div id="buscadorResult"></div>
            </div>
        </div>

        <div class="row">
            <div class="col-md-2">
                <label>Tipo</label>
            </div>
            <div class="col-md-10">
                <select id="tipoId" data-bind="source: TipoCombo, value: Parametros.tipoId, disabled: isControlDisabled" style="max-width:550px"></select>
                <img id="errtipoId" src="~/Content/Images/error.png" style="display:none" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-2">
                <label>Material</label>
            </div>
            <div class="col-md-10">
                <select id="material" data-bind="source: MaterialCombo, value: Parametros.material, disabled: isControlDisabled" style="max-width:550px"></select>
                <img id="errmaterial" src="~/Content/Images/error.png" style="display:none" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-2">
                <label>Cantidad (Kg.)</label>
            </div>
            <div class="col-md-10">
                <input id="cantidadId" style="width:550px" />
                <img id="errcantidadId" src="~/Content/Images/error.png" style="display:none" />
            </div>
        </div>

        <div class="row">
            <div class="col-md-2">
                <label>Precio</label>
            </div>
            <div class="col-md-10">
                <input id="precioId" style="width:380px" />
                <img id="errprecioId" src="~/Content/Images/error.png" style="display:none" />
                <select id="precioMonedaId" data-bind="source: PrecioMonedaCombo, value: Parametros.precioMonedaId, disabled: isControlDisabled" style="max-width:100px"></select>
                <img id="errprecioMonedaId" src="~/Content/Images/error.png" style="display:none" />
                <span id="baseDiv">
                    <label>Base</label>
                    <input id="baseId" class="campo-input-input" data-bind="checked:Parametros.baseId, disabled: isControlDisabled" type="checkbox" />
                </span>
            </div>
        </div>

        <div id="clasificacionDiv" class="row">
            <div class="col-md-2">
                <label>Clasificación</label>
            </div>
            <div class="col-md-10">
                <select id="clasificacion" data-bind="source: ClasificacionCombo, value: Parametros.Clasificacion, disabled: isControlDisabled" style="max-width:550px"></select>
                <img id="errclasificacion" src="~/Content/Images/error.png" style="display:none" />
            </div>
        </div>

        <div id="destinoDiv" class="row">
            <div class="col-md-2">
                <label>Destino</label>
            </div>
            <div class="col-md-10">
                <select id="destinoId" data-bind="source: DestinoCombo, value: Parametros.Destino, disabled: isControlDisabled" style="max-width:550px"></select>
                <img id="errDestinoId" src="~/Content/Images/error.png" style="display:none" />
            </div>
        </div>

        <div id="procedenciaDiv" class="row">
            <div class="col-md-2">
                <label>Procedencia</label>
            </div>
            <div class="col-md-10">
                <select id="provinciaId" data-bind="source: ProvinciaCombo, value: Parametros.provinciaId, disabled: isControlDisabled" style="max-width:550px"></select>
                <img id="errprovinciaId" src="~/Content/Images/error.png" style="display:none" />
            </div>
            <div class="col-md-10 col-md-offset-2">
                <select id="LocalidadId" data-bind="source: LocalidadCombo, value: Parametros.LocalidadId, disabled: isControlDisabled" style="max-width:550px"></select>
                <img id="errLocalidadId" src="~/Content/Images/error.png" style="display:none" />
            </div>
        </div>

        <div id="campanaDiv" class="row">
            <div class="col-md-2">
                <label>Campaña</label>
            </div>
            <div class="col-md-10">
                <select id="campanaId" data-bind="source: CampanaCombo, value: Parametros.campanaId, disabled: isControlDisabled" style="max-width:550px"></select>
                <img id="errcampanaId" src="~/Content/Images/error.png" style="display:none" />
            </div>
        </div>

        <div class="row">
            <div id="planCanjeConsignatarioIdDiv"style="display:flex">
                <div class="col-md-2">
                    <label style="padding-top: 0px;">Plan canje</label>
                </div>
                <div class="col-md-2 checks-adicionales">
                    <input id="planCanjeId" class="campo-input-input" type="checkbox" />
                    <img id="errplanCanjeId" src="~/Content/Images/error.png" style="display:none" />
                </div>

                <div class="col-md-2">
                    <label style="padding-top: 0px;">Consignatario</label>
                </div>
                <div class="col-md-4 checks-adicionales">
                    <input id="consignatarioId" class="campo-input-input" type="checkbox" />
                    <img id="errConsignatarioId" src="~/Content/Images/error.png" style="display:none" />
                </div>
            </div>
        </div>

        <div id="fechasDiv" class="row">
            <div>
                <div class="col-md-2">
                    <label>Fecha Desde - Fecha Hasta</label>
                </div>
                <div class="col-md-10">
                    <span id="fechaDesdeDiv">
                        <input id="fechaDesdeId" type="date" data-bind="value: Parametros.fechaDesdeId" style="width: 271px" />
                        <img id="errfechaDesdeId" src="~/Content/Images/error.png" style="display:none" />
                    </span>
                    <span id="fechaHastaDiv">
                        <input id="fechaHastaId" type="date" data-bind="value: Parametros.fechaHastaId" style="width: 271px" />
                        <img id="errfechaHastaId" src="~/Content/Images/error.png" style="display:none" />
                    </span>
                </div>
            </div>
        </div>
        <div id="ContratoDiv" hidden class="row">
            <div class="col-md-2">
                <label>Contrato</label>
            </div>
            <div class="col-md-4">
                <input type="text" class="campo-input-text k-textbox" id="contratoId" style="max-width:550px" />
                <img id="contratoId" src="~/Content/Images/error.png" style="display:none" />
            </div>
            <div class="col-md-6">
            </div>
        </div>

        <div id="CantidadCamionesDiv" class="row">
            <div class="col-md-2">
                <label>Cantidad de Camiones</label>
            </div>
            <div class="col-md-10">
                <input id="cantidadCamionesId" style="width:550px" />
                <img id="errcantidadCamionesId" src="~/Content/Images/error.png" style="display:none" />
            </div>
        </div>

        <div id="ContratoDiv" class="row">
            <div class="col-md-2">
                <label>Comercial</label>
            </div>
            <div class="col-md-10">
                <select id="comercialId" data-bind="source: ComercialCombo, value: Parametros.comercialId, disabled: isControlDisabled" style="max-width:550px"></select>
                <img id="errcomercialId" src="~/Content/Images/error.png" style="display:none" />
            </div>
        </div>
        <div class="row">
            <div class="col-md-2">
                <label>Observaci&oacute;n</label>
            </div>
            <div class="col-md-10">
                <textarea type="text" class="campo-input-text k-textbox" id="observacionId" rows="3" maxlength="100" style="max-width:550px"></textarea>
                <img id="errobservacionId" src="~/Content/Images/error.png" style="display:none" />
            </div>
        </div>

        <div id="DatosAdicionales" class="btnagregar btnDestacado btnAzul" type="button" style="max-width: 785px">
            <i class="fa fa-plus"></i> Datos adicionales
        </div>
        <div class="datos-adicionales" display="block">
            <br />
            <div class="row">
                <div class="col-md-2">
                    <label>Sustentable</label>
                </div>
                <div class="col-md-4 checks-adicionales">
                    <input id="sustentableId" class="campo-input-input" data-bind="checked:Parametros.sustentableId, disabled: isControlDisabled" type="checkbox" />
                    <img id="errsustentableId" src="~/Content/Images/error.png" style="display:none" />
                    <span id="sustentableDiv" hidden>
                        <input id="sustentablePrecioId" placeholder="Importe" style="width:380px" />
                        <img id="errsustentableprecioId" src="~/Content/Images/error.png" style="display:none" />
                        <select id="sustentableMonedaId" data-bind="source: SustentableMonedaCombo, value: Parametros.sustentableMonedaId, disabled: isControlDisabled" style="max-width:150px"></select>
                        <img id="errsustentableMonedaId" src="~/Content/Images/error.png" style="display:none" />
                    </span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-2">
                    <label>Doralizado</label>
                </div>
                <div class="col-md-4 checks-adicionales">
                    <input id="dolarizadoId" class="campo-input-input" data-bind="checked:Parametros.dolarizadoId, disabled: isControlDisabled" type="checkbox" />
                    <img id="errdolarizadoId" src="~/Content/Images/error.png" style="display:none" />
                    <span id="dolarizadoDiv" hidden>
                        <input id="dolarizadoFechaId" type="date" data-bind="value: Parametros.dolarizadoFechaId" style="max-width: 550px" />
                        <img id="errdolarizadoFechaId" src="~/Content/Images/error.png" style="display:none" />
                    </span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-2">
                    <label>Pesificado</label>
                </div>
                <div class="col-md-4 checks-adicionales">
                    <input id="pesificadoId" class="campo-input-input" data-bind="checked:Parametros.pesificadoId, disabled: isControlDisabled" type="checkbox" />
                    <img id="errpesificadoId" src="~/Content/Images/error.png" style="display:none" />
                    <span id="pesificadoDiv" hidden>
                        <input id="pesificadoDiasId" placeholder="Días" style="width:500px" />
                        <img id="errpesificadoDiasId" src="~/Content/Images/error.png" style="display:none" />
                    </span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-2">
                    <label>No Informa SIO</label>
                </div>
                <div class="col-md-4 checks-adicionales">
                    <input id="noInformaSioId" class="campo-input-input" data-bind="checked:Parametros.noInformaSioId, disabled: isControlDisabled" type="checkbox" />
                    <img id="errnoInformaSioId" src="~/Content/Images/error.png" style="display:none" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-2">
                    <label>Trigo Especial</label>
                </div>
                <div class="col-md-4 checks-adicionales">
                    <input id="trigoEspecialId" class="campo-input-input" data-bind="checked:Parametros.trigoEspecialId, disabled: isControlDisabled" type="checkbox" />
                    <img id="errtrigoEspecialId" src="~/Content/Images/error.png" style="display:none" />
                </div>
            </div>
        </div>

        <div id="DatosBoleto" class="btnagregar btnDestacado btnAzul" type="button" style="max-width: 785px">
            <i class="fa fa-plus"></i> Boleto
        </div>
        <div class="datos-boleto" display="block">
            <br />
            <div class="row">
                <div class="col-md-2">
                    <label>Confirma</label>
                </div>
                <div class="col-md-4 checks-adicionales">
                    <input id="boletoConfirmaId" class="campo-input-input" data-bind="checked:Parametros.boletoConfirmaId, disabled: isControlDisabled" type="checkbox" />
                    <img id="errBoletoConfirmaId" src="~/Content/Images/error.png" style="display:none" />
                    <span id="BolsaConfirmaDiv" hidden>
                        <select id="bolsaConfirmaId" data-bind="source: BolsaCombo, value: Parametros.bolsaConfirmaId, disabled: isControlDisabled" style="max-width:550px"></select>
                        <img id="errBolsaConfirmaId" src="~/Content/Images/error.png" style="display:none" />
                    </span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-2">
                    <label>Físico</label>
                </div>
                <div class="col-md-4 checks-adicionales">
                    <input id="boletoFisicoId" class="campo-input-input" data-bind="checked:Parametros.boletoFisicoId  , disabled: isControlDisabled" type="checkbox" />
                    <img id="errBoletoFisicoId" src="~/Content/Images/error.png" style="display:none" />
                    <span id="BolsaFisicoDiv" hidden>
                        <select id="bolsaFisicoId" data-bind="source: BolsaCombo, value: Parametros.bolsaFisicoId, disabled: isControlDisabled" style="max-width:550px"></select>
                        <img id="errbolsaFisicoId" src="~/Content/Images/error.png" style="display:none" />
                    </span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-2">
                    <label>Ninguno</label>
                </div>
                <div class="col-md-4 checks-adicionales">
                    <input id="boletoNingunoId" class="campo-input-input" data-bind="checked:Parametros.boletoNingunoId  , disabled: isControlDisabled" type="checkbox" />
                    <img id="errBoletoNingunoId" src="~/Content/Images/error.png" style="display:none" />
                </div>
            </div>
        </div>

        <div id="DatosTopesPlazos" class="btnagregar btnDestacado btnAzul" type="button" style="max-width: 785px">
            <i class="fa fa-plus"></i> Plazos y Topes de Fijación
        </div>
        <div class="datos-topesplazos" display="block">
            <br />
            <div class="row">
                <div class="col-md-2">
                    <label>Fecha Desde-Hasta Fijación</label>
                </div>
                <div class="col-md-10">
                    <span id="fechaDesdeTopeDiv">
                        <input id="fechaDesdeTopeId" type="date" style="width: 271px" />
                        <img id="errfechaDesdeTopeId" src="~/Content/Images/error.png" style="display:none" />
                    </span>
                    <span id="fechaHastaTopeDiv">
                        <input id="fechaHastaTopeId" type="date" style="width: 271px" />
                        <img id="errfechaHastaTopeId" src="~/Content/Images/error.png" style="display:none" />
                    </span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-2">
                    <label>Condición fijación</label>
                </div>
                <div class="col-md-10">
                    <select id="condicionFijacionId" data-bind="source:CondicionFijacionCombo, value: Parametros.CondicionFijacionId, disabled: isControlDisabled" style="max-width:550px"></select>
                    <img id="errcondicionFijacionId" src="~/Content/Images/error.png" style="display:none" />
                </div>
            </div>
        </div>

        <div id="DatosPago" class="btnagregar btnDestacado btnAzul" type="button" style="max-width: 785px">
            <i class="fa fa-plus"></i> Pago
        </div>
        <div class="datos-pago" display="block">
            <br />
            <div class="row">
                <div class="col-md-2">
                    <label>CD</label>
                </div>
                <div class="col-md-4 checks-adicionales">
                    <input id="CDId" class="campo-input-input" data-bind="checked:Parametros.CD, disabled: isControlDisabled" type="checkbox" />
                    <img id="errCDId" src="~/Content/Images/error.png" style="display:none" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-2">
                    <label>Warrant</label>
                </div>
                <div class="col-md-4 checks-adicionales">
                    <input id="WarrantId" class="campo-input-input" data-bind="checked:Parametros.Warrant, disabled: isControlDisabled" type="checkbox" />
                    <img id="errWarrantId" src="~/Content/Images/error.png" style="display:none" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-2">
                    <label>Pago directo al vendedor</label>
                </div>
                <div class="col-md-4 checks-adicionales">
                    <input id="pagoDirectoId" class="campo-input-input" data-bind="checked:Parametros.pagoDirecto, disabled: isControlDisabled" type="checkbox" />
                    <img id="errpagoDirectoId" src="~/Content/Images/error.png" style="display:none" />
                </div>
            </div>
        </div>

        <div id="DatosDescuentos" class="btnagregar btnDestacado btnAzul" type="button" style="max-width: 785px">
            <i class="fa fa-plus"></i> Descuentos y Bonificaciones
        </div>

        <div class="datos-descuentos" display="block" style="max-width: 785px">
            <br />
            <div id="descuento-datos">

                <select id="tipoPeriodoDBId" data-bind="source: TipoPeriodoDBCombo, value: Parametros.TipoPeriodoDBId, disabled: isControlDisabled" style="max-width:200px"></select>
                <img id="errtipoPeriodoDBId" src="~/Content/Images/error.png" style="display:none" />
                <select id="TipoDBId" data-bind="source: TipoDBCombo, value: Parametros.TipoDBId, disabled: isControlDisabled" style="max-width:200px"></select>
                <img id="errTipoDBId" src="~/Content/Images/error.png" style="display:none" />
                <div class="fecha-descuento">
                    <span id="fechaDesdeDiv">
                        <input id="fechaDesdeDescuentoId" placeholder="DESDE" type="date" data-bind="value: Parametros.fechaDesdeDescuentoId" style="width: 150px" />
                        <img id="errfechaDesdeDescuentoId" src="~/Content/Images/error.png" style="display:none" />
                    </span>
                    <span id="fechaHastaDiv">
                        <input id="fechaHastaDescuentoId" placeholder="HASTA" type="date" data-bind="value: Parametros.fechaHastaDescuentoId" style="width: 150px" />
                        <img id="errfechaHastaDescuentoId" src="~/Content/Images/error.png" style="display:none" />
                    </span>
                </div>
            </div>
            <div>
                <input id="ImporteDescuentoId" type="text" placeholder="IMPORTE" style="width:200px" />
                <img id="errImporteDescuentoId" src="~/Content/Images/error.png" style="display:none" />
                <select id="descuentoMonedaId" data-bind="source: DescuentoMonedaCombo, value: Parametros.descuentoMonedaId, disabled: isControlDisabled" style="max-width:100px"></select>
                <img id="errdescuentoMonedaId" src="~/Content/Images/error.png" style="display:none" />
                <input id="PorcentajeDescuentoId" type="text" placeholder="PORCENTAJE" style="width:200px" />
                <img id="errPorcentajeDescuentoId" src="~/Content/Images/error.png" style="display:none" />
                <span id="IngresarDescuento" class="k-button k-button-icontext" type="button">Ingresar</span>
            </div><br />
            <div id="tabla-descuentos" data-template="div-template" data-bind="source:Descuentos">
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
                <span></span>
            </div>

            <script id="div-template" type="text/x-kendo-template">
                <div>
                    <span id="eliminar-descuento" data-bind="click: Borrar"><i class="fa fa-trash" aria-hidden="true"></i></span>
                    <span><strong> Descuentos #: TipoPeriodoDBDesc#</strong></span><br />
                    <span>#: TipoDBDesc#</span>
                    <span data-bind="visible: TipoPeriodoDBId!=1"><br />Desde #: FechaDesde#  </span>
                    <span data-bind="visible: TipoPeriodoDBId!=1">Hasta #:FechaHasta#</span><br />
                    <span>Importe #:Importe#</span>
                    <span>#:MonedaId#</span>
                    <span>Porc #:Porcentaje#</span>
                    <br /><br />
                </div>
            </script>
        </div>

        <div id="DatosCalidades" class="btnagregar btnDestacado btnAzul" type="button" style="max-width: 785px">
            <i class="fa fa-plus"></i> Calidad
        </div>
        <div class="datos-calidades" display="block">
            <br />
            <div class="row">
                <div class="col-md-2">
                    <label>Standard de calidad</label>
                </div>
                <div class="col-md-10">
                    <select id="standardCalidadId" data-bind="source: StandardCombo, value: Parametros.standardCalidadId, disabled: isControlDisabled" style="max-width:550px"></select>
                    <img id="errstandardCalidadId" src="~/Content/Images/error.png" style="display:none" />
                </div>
            </div>
            <div id="especialesId" class="row" hidden>
                <div class="col-md-2">
                    <label>Calidades Especiales </label>
                </div>
                <div class="col-md-10 calidad">
                    <select id="calidadesEspecialesId" data-bind="source: EspecialesCombo, value: Parametros.calidadesEspecialesId, disabled: isControlDisabled" style="max-width:200px"></select>
                    <img id="errcalidadesEspecialesId" src="~/Content/Images/error.png" style="display:none" />
                    <span id="pesificadoDiv">
                        <input id="valorEspecialesId" placeholder="VALOR DE CALIDAD" style="width:347px" />
                        <img id="errvalorEspecialesId" src="~/Content/Images/error.png" style="display:none" />
                    </span>
                </div>

            </div>
        </div>

        <div id="DatosEstablecimiento" class="btnagregar btnDestacado btnAzul" type="button" style="max-width: 785px">
            <i class="fa fa-plus"></i> Establecimiento
        </div>
        <div class="datos-establecimiento" display="block">
            <br />
            <div class="row">
                <div class="col-md-2">
                    <label>Propio</label>
                </div>
                <div class="col-md-4 checks-adicionales">
                    <input id="establecimientoId" name="establecimiento" value="Propio" type="radio" />
                    <img id="errEstablecimientoPropioId" src="~/Content/Images/error.png" style="display:none" />
                </div>
            </div>
            <div class="row">
                <div class="col-md-2">
                    <label>Arrendado </label>
                </div>
                <div class="col-md-4 checks-adicionales">
                    <input id="establecimientoId" name="establecimiento" value="Arrendado" type="radio" />
                    <img id="errEstablecimientoPropioId" src="~/Content/Images/error.png" style="display:none" />
                </div>
            </div>
        </div>

        <br />
        <div class="row">
            <div class="col-md-offset-2 col-md-4">
                <span id="guardarBtn" class="formulario-footer-guardar-contrato k-button k-button-icontext" type="button">
                    Generar Negocio
                </span>
                <span class="formulario-footer-cancelar k-button k-button-icontext" type="button">
                    Volver
                </span>
            </div>
        </div>
</div>
