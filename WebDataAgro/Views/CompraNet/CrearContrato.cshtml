    <div class="row">
        <div class="col-sm-2 ">
            <label>Material</label>
        </div>
        <div class="col-sm-5 col-md-4">
            <div>
                <select id="material" class="required-box" data-bind="source: MaterialCombo, value: Parametros.material, disabled: isControlDisabled"></select>
