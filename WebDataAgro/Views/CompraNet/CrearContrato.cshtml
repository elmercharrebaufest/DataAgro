@{
    ViewBag.Title = "CompraNet";
}

<script>
    Id = '@ViewBag.Id';
    TipoId = '@ViewBag.TipoId';
    Siguientes = '@ViewBag.Siguientes';
    AperturaPrecioPorcentajeDeComision = '@ViewBag.ContratoAperturaPrecioPorcentajeDeComisionMaximo';
    comercialId = '@ViewBag.ComercialId';
    BlockUi("Cargando...");
</script>

@section Scripts {
    @Scripts.Render("~/bundles/CompraNetContrato")
}

@section Styles {
    <link href="~/Content/compraNet.css" rel="stylesheet" />
}

<input type="hidden" id="comercialCreador" value="@ViewBag.ComercialId" />

<div id="CrearContrato" class="container">
    <br />

    <div class="row">
        <div>
            <div class="col-sm-2">
                <span class="k-button k-button-icontext" id="boton-ampliar" type="button">+ AMPLIAR</span>
            </div>
            <div class="col-md-4 col-sm-5">

            </div>
        </div>

    </div>

    <div class="copia-contratos">
        <div class="row ampliar">
            <div class="col-sm-2">
                <label>Copiar Contrato</label>
            </div>
            <div class="col-md-4 col-sm-5">
                <input type="text" class="k-textbox" style="width:100%" id="contratoACopiarId" />
            </div>
            <div class="col-sm-1 ">
                <label>Acuerdo</label>
            </div>
            <div class="col-sm-4">
                <input type="text" class="k-textbox" style="width:100%" id="contratoAcuerdoId" />
            </div>
        </div>
        <input type="hidden" id="estado" />
    </div>

    <br />
    <div id="contrato-modificado"></div>
    <br />
    <div class="proveedores row no-gutter noAgente">
        <div id="corredorDiv" class="noFason">
            <div class="col-sm-2">
                <label>Corredor</label>
            </div>
            <div class="col-md-4 col-sm-5">
                <input id="buscadorCorredor" class="k-textbox" style="width:100%" type="text" placeholder="Buscar por CUIT..." required="required" />
                <div id="buscadorCorredorResult"></div>
            </div>
        </div>
        <div>
            <div class="col-sm-1 fasonero" id="proveedorLabelId">
                <label id="proveedorLabel">Proveedor</label>
            </div>
            <div class="col-sm-4">
                <input id="buscadorProveedor" class="k-textbox required-box required-box-parent" style="width:100%" type="text" placeholder="Buscar por CUIT, razón social" required="required" />
                <div id="buscadorResult"></div>
            </div>
        </div>
    </div>

