@{
    Layout = null;
}

<div class="modal fade" id="modalAprobar" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header ">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span><span class="sr-only">Close</span></button>
                <h1 class="modal-title-aprobado" id="lineModalLabel"></h1>
                <div class="status aprobacion-modal">
                    <div>APROBACION PENDIENTE</div>
                </div>
            </div>           
            <input type="hidden" id="contratoModalAprobar" />
            <input type="hidden" id="tipoNegocioModalAprobar" />
            <div class="modal-footer clearfix ">
                <div class="col-xs-6 noPaddingLeft text-center">
                    <button type="button" id="aprobar-contrato" class="myBtn btnSubmit">Aprobar</button>
                </div>
                <div class="col-xs-6 noPaddingRight">
                    <button type="button" class="myBtn btnCancelar" data-dismiss="modal">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
</div>
