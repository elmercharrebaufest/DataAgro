    var prestamoDevolucion = PermisosHelper.Is(PermisosDataAgro.ModificarPrestamoDevolucion);
    ViewBag.Title = "CompraNet";
}

<script>
    Id = '@ViewBag.Id';
    TipoId = '@ViewBag.TipoId';
    Siguientes = '@ViewBag.Siguientes';
    comercialId = '@ViewBag.ComercialId';
    sap = '@ViewBag.Sap';
    esEdicion = '@ViewBag.esEdicion';
    BlockUi("Cargando...");
    cargaFijacionAyer = '@cargaFijacionAyer';
</script>



<script src="~/Scripts/umd/popper.js"></script>

@section Scripts {
    @Scripts.Render("~/bundles/CompraNetContratoAFijar")
    @if (ViewBag.Obj != null)
    {
        <script>
            var model;
            $(document).ready(function () {
                model = '@Html.Raw(Json.Encode(ViewBag.Obj))';
                var negocioCargado = JSON.parse(model);
                console.log(negocioCargado);
                CargarDatosEditar(negocioCargado);
            });

        </script>
    }
}



