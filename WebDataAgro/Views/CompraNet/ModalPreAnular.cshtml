@{
    Layout = null;
}

<div class="modal fade" id="modalPreAnular" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header ">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span><span class="sr-only">Close</span></button>
            </div>
            <div class="campo clearfix">
                <div class="espaciolineas">¿Está seguro que desea preanular el contrato con <span id="proveedor_a_borrar"></span>?</div>
            </div>
            <input type="hidden" id="contratoModalAnular" />
            <div class="modal-footer clearfix ">
            <br/>
                <div class="col-xs-6 noPaddingRight">
                    <button type="button" id="preAnular" class="myBtn btnSubmit" data-dismiss="modal">Si</button>
                </div>

                <div class="col-xs-6 noPaddingRight">
                    <button type="button" id="cancelarBorrar" class="myBtn " data-dismiss="modal">No</button>
                </div>
            </div>
        </div>
        </div>
</div>