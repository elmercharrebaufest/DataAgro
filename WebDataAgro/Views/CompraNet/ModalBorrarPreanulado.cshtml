@{
    Layout = null;
}

<div class="modal fade" id="modalBorrarPreanulado" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header ">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span><span class="sr-only">Close</span></button>
            </div>
            <div id="proveedorBorrarDivVisualizar" class="campo clearfix">
                <div class="espaciolineas">¿Está seguro que desea eliminar el contrato con <span id="proveedor_a_borrarPreanular"></span>?</div>
            </div>
            <textarea rows="2" id="motivo-rechazoPreanular" placeholder="Indique motivo de rechazo..." style="width:100%" hidden></textarea>
            <input type="hidden" id="contratoModalBorrar" />
            <input type="hidden" id="tipoNegocioModalBorrar" />
            <input type="hidden" id="estadoModalBorrar" />
            <div class="modal-footer clearfix ">
                <br />
                <div class="col-xs-6 noPaddingRight">
                    <button type="button" id="AnularContrato" class="myBtn btnSubmit" data-dismiss="modal" onclick="AnularContratoPreAnulado()">Si</button>
                </div>
                <div class="col-xs-6 noPaddingRight">
                    <button type="button" id="rechazarPreanular" class="myBtn btnSubmit" data-dismiss="modal">Rechazar Preanulación</button>
                </div>
            </div>
        </div>
        </div>
</div>