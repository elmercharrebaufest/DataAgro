@{
    Layout = null;
}

<div class="modal fade" id="ModalModificarVarios" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header ">
                <button type="button" class="cerrar close" data-dismiss="modal"><span aria-hidden="true">×</span><span class="sr-only">Close</span></button>
                <h1 class="modal-title-confirmado" id="lineModalLabel"></h1>
                <div class="status pendiente-modal">
                    <div>MODIFICAR</div>
                </div>
            </div>
            <div class="modal-body clearfix ">
                <div id="DivModificar" class="col-xs-12 noPadding">
                    <div id="spanModificar" class="campo clearfix">
                        <span>Se modificaran los siguientes negocios:</span>
                    </div>
                    <div id="negocioModificar-modal" class="campo clearfix">
                    </div>
                </div>
            </div>
            <br />
            <div class="modal-footer clearfix ">
                <div class="col-xs-6 noPaddingLeft">
                    <button id="modificarVarios" onclick="ModificarVariosContratos()" class="myBtn">Modificar</button>
                </div>
                <div class="col-xs-6 noPaddingRight">
                    <button id="cancelarVariosModificar" type="button" class="myBtn btnCancelar" data-dismiss="modal">Cancelar</button>
                </div>
                <div class="col-xs-12 noPaddingLeft">
                    <button id="cerrarVariosModificar" class="myBtn" hidden>Cerrar</button>
                </div>
            </div>
        </div>
    </div>
</div>