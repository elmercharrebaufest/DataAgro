
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "CompraNet";
}

@section Scripts {
    @Scripts.Render("~/bundles/CompraNetFijacion")
}

@section Styles {
    <link href="~/Content/compraNet.css" rel="stylesheet" />
}

<!DOCTYPE html>

<html>
<head> 
    <meta name="viewport" content="width=device-width" />
    <title>CrearFijacion</title>
</head>
<body> 
    <div id="CrearFijacion">

        @*<div class="row">
            <div class="col-md-2">
                <label>Proveedor</label>
            </div>
            <div class="col-md-4">
                <select id="proveedorId" data-bind="source: ProveedorCombo, value: Parametros.proveedorId, disabled: isControlDisabled" style="max-width:310px"></select>
                <img id="errproveedorId" src="~/Content/Images/error.png" style="display:none" />
            </div>
            <div class="col-md-6">
            </div>
        </div>*@

        <div class="row">
            <div class="col-md-2">
                <label>Proveedor</label>
            </div>
            <div class="col-md-4">
                <input id="buscadorProveedor" class="k-textbox" type="text" placeholder="Buscar por CUIT, razón social" style="max-width: 310px" />
                <div id="buscadorResult"></div>
            </div>
            <div class="col-md-6">
            </div>
        </div>

        <div class="row">
            <div class="col-md-2">
                <label>Material</label>
            </div>
            <div class="col-md-4">
                <select id="material" data-bind="source: MaterialCombo, value: Parametros.material, disabled: isControlDisabled" style="max-width:310px"></select>
                <img id="errmaterial" src="~/Content/Images/error.png" style="display:none" />
            </div>
            <div class="col-md-6">
            </div>
        </div>

        <div class="row">
            <div class="col-md-2">
                <label>Cantidad (Kg.)</label>
            </div>
            <div class="col-md-4">
                <input type="text" class="campo-input-text k-textbox" id="cantidadId" style="max-width:310px"/>
                <img id="errcantidadId" src="~/Content/Images/error.png" style="display:none" />
            </div>
            <div class="col-md-6">
            </div>
        </div>

        <div class="row">
            <div class="col-md-2">
                <label>Precio</label>
            </div>
            <div class="col-md-4">
                <input type="text" class="campo-input-text k-textbox" id="precioId" style="max-width:202px"/>
                <img id="errprecioId" src="~/Content/Images/error.png" style="display:none" />
                <select id="precioMonedaId" data-bind="source: PrecioMonedaCombo, value: Parametros.precioMonedaId, disabled: isControlDisabled" style="max-width:100px"></select>
                <img id="errprecioMonedaId" src="~/Content/Images/error.png" style="display:none" />
            </div>
            <div class="col-md-6">
            </div>
        </div>

        <div class="row">
            <div class="col-md-2">
                <label>Comercial</label>
            </div>
            <div class="col-md-4">
                <select id="comercialId" data-bind="source: ComercialCombo, value: Parametros.comercialId, disabled: isControlDisabled" style="max-width:310px"></select>
                <img id="errcomercialId" src="~/Content/Images/error.png" style="display:none" />
            </div>
            <div class="col-md-6">
            </div>
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-offset-2 col-md-4">
            <span class="formulario-footer-guardar-fijacion k-button k-button-icontext" type="button">
                Guardar Fijacion
            </span>
            <span class="formulario-footer-cancelar k-button k-button-icontext" type="button">
                Cancelar
            </span>
        </div>
    </div>
</body>
</html>

