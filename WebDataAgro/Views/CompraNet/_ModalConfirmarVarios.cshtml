@{
    Layout = null;
}

<div class="modal fade bd-example-modal-lg" id="ModalConfirmarVarios" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header ">
                <button type="button" class="cerrar close " data-dismiss="modal"><span aria-hidden="true">×</span><span class="sr-only">Close</span></button>
                <h1 class="modal-title-confirmado" id="lineModalLabel"></h1>
                <div class="status confirmado-modal">
                    <div>CONFIRMAR</div>
                </div>
                <div class="calidadModificada" hidden>
                    <div class="alert alert-warning" role="alert">
                        <strong><i class="fa fa-exclamation-triangle" aria-hidden="true"></i></strong> Uno o mas contratos seleccionados tiene Calidad/Servicio  modificado.
                        <span class="mensajeServicio" hidden>Ningun cambio realizado</span>
                    </div>
                </div>
             
            </div>
            <div class="modal-body clearfix ">
                <div id="DivConfirmado" class="col-xs-12 noPadding">
                    <div id="negocioConfirmado-modal" class="campo clearfix">
                    </div>
                </div>
            </div>
            <br />
            <div class="modal-footer clearfix ">
                <div class="col-xs-4 noPaddingLeft">
                    <button id="confirmarVarios" onclick="ConfirmarVariosContratos(false)" class="myBtn">Confirmar Todos</button>
                </div>
                <div class="col-xs-4 noPaddingLeft calidadModificada" hidden>
                    <button id="confirmarVariosSinCalidad" onclick="ConfirmarVariosContratos(true)" class="myBtn">Confirmar sin Calidad Modificada</button>
                </div>
                <div class="col-xs-4 noPaddingRight">
                    <button id="cancelarVarios" type="button" class="myBtn btnCancelar" data-dismiss="modal">Cancelar</button>
                </div>
                <div class="col-xs-12 noPaddingLeft">
                    <button id="cerrarVarios" class="myBtn" hidden>Cerrar</button>
                </div>
            </div>
        </div>
    </div>
</div>