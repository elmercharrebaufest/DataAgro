@{
    Layout = null;
}

<div class="modal fade" id="modalAperturaPrecio" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header ">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span><span class="sr-only">Close</span></button>
                <h1 class="modal-title-ampliaciones" id="lineModalLabel"></h1>
                <div class="status confirmado-modal">
                    <div>APERTURA DE PRECIO</div>
                </div>
            </div>
            <div class="modal-body clearfix ">
                <div class="col-xs-12 noPadding">
                    <table id="tablaApertura" class="table table-bordered">
                        <thead>
                            <tr>
                                <td colspan="2"></td>

                                <td class="fuente600" >Precio:</td>
                                <td class="aperturaPrecioTd fuente600"> <span id="precioAperturaOriginal" class="aperturaPrecioInput"> </span></td>
                            </tr>
                            <tr>
                                <td class="fuente600">Concepto</td>
                                <td class="fuente600">Importe</td>
                                <td class="fuente600">Moneda</td>
                                <td class="fuente600">Porcentaje</td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Financiero</td>
                                <td class="aperturaPrecioTd"><input id="aperturaPrecioImporteFinancieroId" class="aperturaPrecioInput" value="0" type="number" /></td>
                                <td class="aperturaPrecioTd"><span class="aperturaPrecioInput aperturaprecioMoneda" readonly></span></td>
                                <td></td>
                            </tr>
                            <tr>
                                <td>Redespacho</td>
                                <td class="aperturaPrecioTd"><input id="aperturaPrecioImporteRedespachoId" class="aperturaPrecioInput" value="0" type="number" max="0" /></td>
                                <td class="aperturaPrecioTd"><span class="aperturaPrecioInput aperturaprecioMoneda" readonly></span></td>
                                <td></td>
                            </tr>
                            <tr>
                                <td>Comisiones</td>
                                <td class="aperturaPrecioTd"><input id="aperturaPrecioImporteComisionesId" class="aperturaPrecioInput" value="0" type="number"/></td>
                                <td class="aperturaPrecioTd"><span class="aperturaPrecioInput aperturaprecioMoneda" readonly></span></td>
                                <td class="aperturaPrecioTd"><input id="aperturaPrecioPorcentajeComisionesId" class="aperturaPrecioInput" value="0" type="number"/></td>
                            </tr>
                            <tr>
                                <td>Bonificaciones</td>
                                <td class="aperturaPrecioTd"><input id="aperturaPrecioImporteBonificacionesId" class="aperturaPrecioInput" value="0" type="number" /></td>
                                <td class="aperturaPrecioTd"><span class="aperturaPrecioInput aperturaprecioMoneda" readonly></span></td>
                                <td class="aperturaPrecioTd"><input id="aperturaPrecioPorcentajeBonificacionesId" class="aperturaPrecioInput" value="0" type="number"/></td>
                            </tr>
                        </tbody>
                        <tfoot>
                            <tr>
                                <td colspan="2"></td>
                                <td>Total:</td>
                                <td class="aperturaPrecioTd"> <span id="totalApertura" class="aperturaPrecioInput" type="number"></span></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            <div class="modal-footer clearfix ">
                <div class="col-xs-6 noPaddingLeft">
                    <button type="button" id="guardarAperturaPrecio" class="myBtn btnSubmit" data-dismiss="modal">Guardar</button>
                </div>
                <div class="col-xs-6 noPaddingRight">
                    <button type="button" id="cancelarAperturaPrecio" class="myBtn btnCancelar" data-dismiss="modal">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
</div>