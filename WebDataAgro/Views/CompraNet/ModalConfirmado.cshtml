@{
    Layout = null;
}

<div class="modal fade" id="modalConfirmado" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header ">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span><span class="sr-only">Close</span></button>
                <h1 class="modal-title-confirmado" id="lineModalLabel"></h1>
                <div class="status confirmado-modal">
                    <div>CONFIRMADO</div>
                </div>
            </div>
            <div class="modal-body clearfix ">
                <div id="DivConfirmado" class="col-xs-12 noPadding">
                    <div id="
                         " class="campo clearfix">
                        <h3>Proveedor:</h3>
                    </div>
                    <div id="fechaDesdeHastaDivConfirmado" class="campo clearfix">
                        <h3>Fecha:</h3>
                    </div>
                    <div id="tipoDiConfirmado" class="campo clearfix">
                        <h3>Tipo:</h3>
                    </div>
                    <div id="materialDivConfirmado" class="campo clearfix">
                        <h3>Material:</h3>
                    </div>
                    <div id="cantidadDivConfirmado" class="campo clearfix">
                        <h3>KG:</h3>
                    </div>
                    <div id="precioDivConfirmado" class="campo clearfix">
                        <h3>Precio:</h3>
                        <strong id="monedaStrongConfirmado"></strong>
                    </div>
                    <div id="campanaDivConfirmado" class="campo clearfix">
                        <h3>Campaña:</h3>
                    </div>
                    <div id="procedenciaDivConfirmado" class="campo clearfix">
                        <h3>Procedencia:</h3>
                    </div>
                    <div id="sustentableDivConfirmado" class="campo campoAdicionales clearfix">
                        <h3>Sustentable:</h3>
                        <strong id="sustentableMonedaStrongConfirmado"></strong>
                    </div>
                    <div id="dolarizadoFechaDivConfirmado" class="campo campoAdicionales clearfix">
                        <h3>Dolarizado:</h3>
                    </div>
                    <div id="pesificadoDiasDivConfirmado" class="campo campoAdicionales clearfix">
                        <h3>Pesificado:</h3>
                    </div>
                    <div id="informaSIODivConfirmado" class="campo campoAdicionales clearfix">
                        <h3>Informa SIO:</h3>
                    </div>
                    <div id="trigoEspecialDivConfirmado" class="campo campoAdicionales clearfix">
                        <h3>Trigo Especial:</h3>
                    </div>
                    <input type="hidden" id="contratoModalConfirmado" />
                </div>
            </div>
            <div class="modal-footer clearfix ">
                <div class="col-xs-12 noPadding" style="margin-bottom:15px;">
                    <button type="button" id="finalizarConfirmado" class="myBtn btnSubmit" data-dismiss="modal">Finalizar</button>
                </div>
                <div class="col-xs-6 noPaddingRight">
                    <button type="button" id="cancelarContratoPendiente" class="myBtn btnCancelar" data-dismiss="modal">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
</div>