@{
    Layout = null;
}

<div class="modal fade" id="modalContratosPendientes" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog" style="width:84%;">
        <div class="modal-content" style="position: absolute;">
            <div class="modal-header ">
                <button type="button" class="cerrar close blancoCerrarModalFinalizar" data-dismiss="modal"><span aria-hidden="true">×</span><span class="sr-only">Close</span></button>
                <h1 class="modal-title-confirmado" id="lineModalLabel"></h1>
                <div class="status finalizado-modal">
                    <div style="background:#76ae7e !important; padding: 4px !important; font-size: 11px !important">Contratos Pendientes</div>
                </div>
            </div>

            <div class="modal-body clearfix " style="padding:0;">

                <div id="div1">
                    <div id="grid"></div>
                </div>
                <script id="template" type="text/x-kendo-template">

                    <span class="k-textbox k-grid-search k-display-flex">
                        <input autocomplete="off" placeholder="Buscar..." title="Buscar..." class="k-input">
                      <span class="k-input-icon">
                        <span class="k-icon k-i-search"></span>
                      </span>
                      </span>
                </script>
            </div>
        </div>
    </div>
</div>

<style>


        #div1 {
            width: 100%;
            min-width: 1000px;
        }
    .k-grid {
        font-size: 11px;
    }

        .k-grid td {
            line-height: 1.1em;
            text-align:center;
        }
    .k-grid-header th.k-header {
        line-height: 2em;
        text-align: center;
        background: aliceblue
    }
    .k-grid .k-grid-search {
        margin-left: auto;
        margin-right: 0;
    }
    .k-textbox .k-icon {
        top: 50%;
        margin: -9px 101px -1px;
        position: absolute;
    }

    .k-grid tr td {
        border-width: 0;
        border-style: solid;
    }
    div.k-grid-header {
        background: aliceblue
    }

    .colorCalidad {
        background: #14b6b7
    }

    .k-grid td.k-state-selected:hover, .k-grid tr:hover td label {
        color: white !important;
    }

</style>
