@model WebDataAgro.Models.LogModel

@{
    ViewBag.Title = "Log";
}

@section Scripts{
    @Scripts.Render("~/bundles/Log")
    <script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
    <!-- Kendo desde CDN -->
    <script src="https://kendo.cdn.telerik.com/2019.3.1023/js/kendo.all.min.js"></script>
    <script type="text/javascript" src="~/Scripts/Chart.js"></script>
    <script type="text/javascript" src="~/Scripts/log.js"></script>
}

<div class="Titulo">

    @*@using (Ajax.BeginForm("ListaLogPartial", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "Log" }, null))
    {*@
        <div class="container-log">
            <div id="fecha-buscador-log" class="row">
                <div class="col-sm-1 noRightPadding">
                    <label>Fecha</label>
                </div>
                <div class="col-sm-4 col-md-2">
                    <span id="fechaLog">
                        <input id="fecha" name="fechaString" type="date" style="width: 100%" />
                    </span>
                </div>
                <button type="button" id="buscar" class="k-button k-button-icontext sideMargin-15" onclick="Buscar()">Buscar</button>
            </div>

        </div>
    @*}*@

    <div id="Log" class="container-log">
        @*@Html.Action("ListaLogPartial", new { fechaString = DateTime.Now.Date.ToString("dd-MM-yyyy")})*@
        <div id="gridLog"></div>
    </div>
    <script id="templateLog" type="text/x-kendo-template">

        <span class="k-textbox k-grid-search k-display-flex">
            <input autocomplete="off" placeholder="Buscar..." title="Buscar..." class="k-input">
          </span>
    </script>
</div>

<style>
    #gridLog .k-grid-content tr {
        height: 50px;
        white-space: nowrap; /* Evita el salto de línea */
        overflow: hidden; /* Oculta el contenido que excede el ancho de la celda */
        text-overflow: ellipsis; /* Muestra puntos suspensivos cuando el texto sigue */
    }
</style>