@{
    ViewBag.Title = "Rango de Confirmacion Automatica";
}

@section Scripts {
    @Scripts.Render("~/bundles/AbmRangoConfirmacionAutomatica")
}
<style>
    .k-i-warning {
        display: none;
    }
</style>

<h3>Rango de Confirmacion Automática</h3>
<br />
<div id="rootwizard">

    <div id="Abm">

        <ul>
            <li style="display:none"><a href="#tab1" data-toggle="tab"></a></li>
            <li style="display:none"><a href="#tab2" data-toggle="tab"></a></li>
        </ul>

        <div class="tab-content">

            <div class="tab-pane" id="tab1">

                <div class="row">
                    <div class="col-md-12">
                        <div id="gridIniRango" class="table-responsive" data-bind="source: Resultados" style="height:227px;"></div>
                    </div>
                </div>

                <br />

                <div class="row">
                    <div class="col-md-12">
                        <button id="butAgregar" class="k-button" type="button" data-role="button" data-bind="disabled: isAddNewDisabled">Agregar</button>
                        <button id="butModificar" class="k-button" type="button" data-role="button" data-bind="disabled: isDeleteDisabled" style="margin-left:15px;">Modificar</button>
                        <button id="butEliminar" class="k-button" type="button" data-role="button" data-bind="disabled: isDeleteDisabled" style="margin-left:15px;">Eliminar</button>
                    </div>
                </div>

            </div>

            <div class="tab-pane" id="tab2">

                <div class="row">
                    <div class="col-md-2">
                        <label> Rango de Confirmacion Automatica </label>
                    </div>
                    <div class="col-md-2">
                        <input id="precioMinimo" data-bind="value: RangoConfirmacionAutomatica.PrecioMinimo, disabled: isControlDisabled" style="width:100%" />
                        <img id="errPrecio" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-2">
                        <input id="precioMaximo" data-bind="value: RangoConfirmacionAutomatica.PrecioMaximo, disabled: isControlDisabled" style="width:100%" />
                        <img id="errPrecio" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-2">
                        <label>Material</label>
                    </div>
                    <div class="col-md-4">
                        <select id="material" data-bind="source: MaterialCombo, value: RangoConfirmacionAutomatica.MaterialId, disabled: isControlDisabled"></select>
                        <img id="errMaterial" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2">
                        <label>Moneda</label>
                    </div>
                    <div class="col-md-4">
                        <select id="moneda" data-bind="source: MonedaCombo, value: RangoConfirmacionAutomatica.MonedaId, disabled: isControlDisabled"></select>
                        <img id="errMoneda" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-2">
                        <label> Validez </label>
                    </div>
                    <div class="col-md-2">
                        <input id="FechaDesde" type="text" data-bind="value: RangoConfirmacionAutomatica.FechaDesde, disabled: isControlDisabled" style="width:100%" />
                        <img id="errFecha" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-2">
                        <input id="FechaHasta" type="text" data-bind="value: RangoConfirmacionAutomatica.FechaHasta, disabled: isControlDisabled" style="width:100%" />
                        <img id="errFecha" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2">
                        <label>Zona</label>
                    </div>
                    <div class="col-md-4">
                        <select id="zona" data-bind="source: ZonaCombo, value: RangoConfirmacionAutomatica.ZonaId, disabled: isControlDisabled"></select>
                    </div>
                    <div class="col-md-2">
                        <label> Cantidad </label>
                    </div>
                    <div class="col-md-4">
                        <input id="cantidad" data-bind="value: RangoConfirmacionAutomatica.Cantidad, disabled: isControlDisabled" style="width:100%" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2">
                        <label> Mes Desde-Hasta </label>
                    </div>
                    <div class="col-md-2">
                        <input id="desdeMes" data-bind="value: RangoConfirmacionAutomatica.DesdeMes, disabled: isControlDisabled" style="width:100%" />
                    </div>
                    <div class="col-md-2">
                        <input id="hastaMes" data-bind="value: RangoConfirmacionAutomatica.HastaMes, disabled: isControlDisabled" style="width:100%" />
                    </div>
                    <div class="col-md-2">
                        <label> Año Desde-Hasta </label>
                    </div>
                    <div class="col-md-2">
                        <input id="desdeAnio" data-bind="value: RangoConfirmacionAutomatica.DesdeAnio, disabled: isControlDisabled" style="width:100%" />
                    </div>
                    <div class="col-md-2">
                        <input id="hastaAnio" data-bind="value: RangoConfirmacionAutomatica.HastaAnio, disabled: isControlDisabled" style="width:100%" />
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-md-12">
                        <button id="butAceptar" class="k-button" type="button" data-role="button">Aceptar</button>
                        <button id="butCancelar" class="k-button" type="button" data-role="button" style="margin-left:15px;">Cancelar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
