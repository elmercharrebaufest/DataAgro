@model WebDataAgro.Models.ConfiguracionModel
@{
    ViewBag.Title = "Configuracion";
}
@section Styles {

    <link href="~/Content/compraNet.css" rel="stylesheet" />
    <link href="~/Content/configuracion.css" rel="stylesheet" />
}
@section Scripts{
    @Scripts.Render("~/bundles/Configuracion")
    <script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
}
<h3 class="padding">Configuración</h3>
@if (!Html.ViewData.ModelState.IsValid)
{
    <div id="errorModal">
        <div class="alert alert-danger alert-dismissible" role="alert">
            <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
            @Html.ValidationSummary()
        </div>
    </div>}
@using (Html.BeginForm("GuardarPesificacionDolarizado", "Configuracion", FormMethod.Post))
{
    <div id="form">
        <div class="container">
            <div>
                <h4>CompraNet</h4>

            </div>
            <div class="row-botones-material row padding">
                <div class="col-md-2">
                    <label>Cantidad de días</label>
                </div>
                <div class="col-md-2" id="CantidadDiasId">
                    @Html.TextBoxFor(m => m.CantidadDias, new { @class = "CantidadDeDias number-input" })
                </div>
                <div class="col-md-2">
                    <label>Validación Sustentable</label>
                </div>
                <div class="col-md-2" id="CantidadDiasId">
                    @Html.TextBoxFor(m => m.ImporteSustentable, new { @class = "CantidadDeDias number" })
                </div>
                <div class="col-md-2">
                    <label>Apertura de Precio Porcentaje de Comisión Máximo</label>
                </div>
                <div class="col-md-2">
                    @Html.TextBoxFor(m => m.ContratoAperturaPrecioPorcentajeDeComisionMaximo, new { @class = "number" })
                </div>
            </div>
            <h4>Stop</h4>

            <div class="row-botones-material row padding">
                <div class="col-md-2">
                    <label>Clave Stop</label>
                </div>
                <div class="col-md-4">
                    @Html.TextBoxFor(m => m.ClaveStop, new { @class = "CantidadDeDias k-input" })
                </div>
                <div class="col-md-offset-2 col-md-2">
                    <label>ABM STOP</label>
                    @Html.CheckBoxFor(m => m.ConexionABMStop)
                </div>
                <div class="col-md-2">
                    <label>Consulta STOP</label>
                    @Html.CheckBoxFor(m => m.ConexionConsultaStop)
                </div>
            </div>

            <div class="row-botones-material row padding">
                <div class="col-md-2">
                    <label>Terminal Stop</label>
                </div>
                <div class="col-md-2">
                    @Html.TextBoxFor(m => m.TerminalStopId, new { @class = "CantidadDeDias number-input" })
                </div>
                <div class="col-md-2">
                    <label>CUIT Destinatario</label>
                </div>
                <div class="col-md-2">
                    @Html.TextBoxFor(m => m.CuitDestinoStop, new { @class = "CantidadDeDias number-input" })
                </div>
                <div class="col-md-2">
                    <label>Codigo Localidad</label>
                </div>
                <div class="col-md-2">
                    @Html.TextBoxFor(m => m.CodigoLocalidadStop, new { @class = "CantidadDeDias number-input" })
                </div>
            </div>
        <div class="row">
            <div class="col-md-3">
                <button type="submit" class="formulario-footer-cancelar k-button k-button-icontext">Guardar</button>
            </div>
        </div>
        </div>
    </div>

}


