@{
    var Cupos_Acopios = PermisosHelper.Is(PermisosDataAgro.Cupos_Acopios_SolicitudExtraordinaria);
}
<script>
    Cupos_Acopios = '@Cupos_Acopios';
</script>

@*<script src="~/Scripts/html2canvas.js"></script>*@
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" integrity="sha512-BNaRQnYJYiPSqHHDb58B0yaPfCu+Wgds8Gp/gU33kqBtgNS4tSPHuGibyoeqMV/TJlSKda6FXzoEyYGjTe+vXA==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

<div class="modal fade" id="modalSolicitudExtraordinaria" tabindex="-1" role="dialog" aria-labelledby="CargaCuposLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-SE" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="cerrar close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h1 class="modal-title" id="sugerencia"></h1>
                <div class="status confirmado-modal">
                    <div>Solicitud Extraordinaria de Cupos</div>
                </div>
            </div>
            <div class="modal-body">
                <div id="boton-carga-masiva" class="margen-15" hidden>
                    <span class="btnVarios" onclick="MostrarCarga()">
                        Carga Masiva
                    </span>
                </div>
                <br />
                <div class="row">
                    <div class="col-xs-2">
                        <span>Proveedor</span>
                    </div>
                    <div class="col-sm-4">
                        <input id="buscadorProveedorSE" class="k-textbox required-box required-box-parent w100" type="text" placeholder="Buscar por CUIT o razón social" required="required" />
                        @Html.Hidden("ProveedorIdSE")

                    </div>
                    <div class="col-xs-2">
                        <span>Comercial</span>
                    </div>
                    <div class="col-sm-4">
                        @Html.DropDownList("ComercialIdSE", ViewBag.Comercial as SelectList, "Seleccionar", new { @class = "form-control" })
                    </div>
                    <div id="buscadorResult"></div>
                </div>
                <div class="row">

                    <div class="col-xs-2">
                        <span>Fecha</span>
                    </div>
                    <div class="col-sm-4">
                        @Html.TextBox("FechaSE", "", "{0:yyyy-MM-dd}", new { @class = "w100" })
                    </div>
                    <div class="col-xs-2">
                        <span>Hasta</span>
                    </div>
                    <div class="col-sm-4">
                        @Html.TextBox("FechaHastaSE", "", "{0:yyyy-MM-dd}", new { @class = "w100" })
                    </div>
                </div>
                <div class="row" style="padding-top:8px !important;">
                    <div class="col-sm-2">
                        <span>Cantidad de Cupos</span>
                    </div>
                    <div class="col-sm-4">
                        @Html.TextBox("CantidadCupoSE", "Cantidad cupo", new { @class = "w100" })
                    </div>
                    <div class="col-xs-2">
                        <span>Destino</span>
                    </div>
                    <div class="col-sm-4">
                        @Html.DropDownList("CentroIdSE", ViewBag.CenLista as SelectList, "Seleccionar", new { @class = "form-control" })

                    </div>
                </div>
                <div class="row">
                    <div class="col-xs-2">
                        <span>Material</span>
                    </div>
                    <div class="col-sm-4">
                        @Html.DropDownList("MaterialIdSE", ViewBag.MatLista as SelectList, "Seleccionar", new { @class = "form-control" })
                    </div>
                    <div id="calidadDivSE" hidden>
                        <div class="col-xs-2">
                            <span>Calidad</span>
                        </div>
                        <div class="col-sm-4">
                            @Html.DropDownList("CalidadIdSE", ViewBag.Calidad as SelectList, "Seleccionar", new { @class = "form-control" })
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div id="sustentableDivSE" hidden>
                        <div class="col-xs-10 col-lg-2">
                            <label style="margin-left: 0px !important">Sustentable</label>
                        </div>
                        <div class="col-xs-2 col-lg-1" style="padding-top:8px;" title="Soja sustentable">
                            @Html.CheckBox("Sustentable")
                        </div>
                    </div>
                    <div id="EPADivSE" hidden>
                        <div class="col-xs-10 col-lg-2">
                            <label style="margin-left: 0px !important">EPA</label>
                        </div>
                        <div class="col-xs-2 col-lg-1" style="padding-top:8px;" title="Soja EPA">
                            @Html.CheckBox("EPA")
                        </div>
                    </div>
                    <div id="EUDRDivSE" hidden>
                        <div class="col-xs-10 col-lg-2">
                            <label style="margin-left: 0px !important">EUDR</label>
                        </div>
                        <div class="col-xs-2 col-lg-1" style="padding-top:8px;" title="Soja EUDR">
                            @Html.CheckBox("EUDR")
                        </div>
                    </div>
                </div>
                <div class="row" style="padding-top:8px !important;">
                    <div id="stock" style="padding-top:8px;">
                        <div class="col-sm-2">
                            <span>Establecimiento</span>
                        </div>
                        <div class="col-sm-4">
                            <button class="k-button k-button-icontext" type="button" onclick="VisualizarStock()" style="width: 100%">Visualizar Stock</button>
                        </div>
                    </div>
                </div>
                <div class="row" style="padding-top:8px !important;">
                    <div class="col-xs-12 col-sm-2">
                        <span>N° de Contrato</span>
                    </div>
                    <div class="col-sm-4 input-group">
                        @Html.TextBox("ContratoSE", "", new { @class = "form-control", @maxlength = "10" })
                        <span class="input-group-addon" onclick="buscarContratoSE()">
                            <i class="fa fa-search"></i>
                        </span>
                    </div>
                    <div class="col-sm-6">
                        <label class="radio-inline">
                            <input type="radio" name="estadoContrato" value="5" onchange="buscarContratoSE()" checked> Finalizado
                        </label>
                        <label class="radio-inline">
                            <input type="radio" name="estadoContrato" value="2" onchange="buscarContratoSE()"> Confirmado
                        </label>
                        <label class="radio-inline">
                            <input type="radio" name="estadoContrato" value="0" onchange="buscarContratoSE()"> Ambos
                        </label>
                    </div>
                </div>

                <div id="gridContainer" style="display: none;">
                    <div id="grid"></div>
                </div>
                <div id="noResultsMessage" style="display: none; margin-top: 15px;">
                    No se encontraron resultados
                </div>
                <br>
                <div class="row">
                    <div class="col-xs-10 col-lg-2">
                        <label style="margin-left: 0px !important">Con Descarga</label>
                    </div>
                    <div class="col-xs-1">
                        @Html.CheckBox("ConDescarga")
                    </div>
                    <div class="col-xs-10 col-lg-4">
                        <label style="margin-left: 0px !important">Flete procedencia - Acarreo</label>
                    </div>
                    <div class="col-xs-1">
                        @Html.CheckBox("FleteAcarreoES")
                    </div>
                    <div class="col-xs-10 col-lg-3">
                        <label>Fasón - Préstamo devolución</label>
                    </div>
                    <div class="col-xs-1">
                        @Html.CheckBox("FasonES")
                    </div>
                </div>
                <div class="row">
                    <div class="col-lg-8"></div>
                    <div class="col-lg-4">
                        @Html.TextBox("CuitES", "", new { @class = "form-control", @style = "display:none; width: 90%;" })
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-md-2 col-xs-12">
                        <span>Observaciones</span>
                    </div>
                    <div class="col-sm-10">
                        @Html.TextArea("ObservacionSE", "", new { @class = "k-textbox", @style = "height:70px;" })
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="myBtn btn" onclick="grabarSolicitudExtraordinaria()">Aceptar</button>
                <button type="button" class="myBtn btn" onclick="OcultarCargaMasiva()" id="cancelar-carga" data-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="modalEstablecimientos" tabindex="-1" role="dialog" aria-labelledby="establecimiento" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="table table-striped table-responsive modal-body tabla">
                <table id="cargarDatosEstablecimiento" style="width:100%"></table>
            </div>
            <div class="modal-footer">
                <button type="button" class="myBtn btn" data-dismiss="modal">Aceptar</button>
                <button type="button" title="Copiar como imagen" class="myBtn btn" id="copy_btn" onclick="copiarTablaEstablecimiento()"><i class="fa fa-copy"></i> Copiar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="CargarCupos" tabindex="-1" role="dialog" aria-labelledby="CargaCuposLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="cerrar close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h1 class="modal-title" id="CargaCupos"></h1>
                <div class="status confirmado-modal">
                    <div>Carga de Cupos</div>
                </div>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table id="cargaMasiva-cupos-table" class="table table-striped">
                        <tr>
                            <th>Día</th>
                            <th>Cantidad</th>
                        </tr>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="myBtn btn" data-dismiss="modal">Aceptar</button>
                <button type="button" class="myBtn btn" id="cancelar-carga-cupos" data-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

<style>
    .tabla {
        width: 100%;
        max-height: 335px;
        overflow-y: auto;
    }

    #modalSolicitudExtraordinaria {
        z-index: 1040;
    }

    .input-group-addon {
        cursor: pointer;
        background-color: white;
        border: 1px solid #ccc;
        border-left: none;
    }

        .input-group-addon i {
            color: #555;
        }

    #gridContainer {
        margin-top: 20px;
        height: 150px;
        position: relative;
    }

    #noResultsMessage {
        display: flex;
        justify-content: center;
        align-items: center;
        height: 30px;
        font-size: 1em;
        border: ridge;
        text-align: center;
        padding: 50px;
    }

    .k-grid td {
        font-size: 12px;
    }

    .loading-message {
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
        font-size: 16px;
        padding: 20px;
    }
</style>
