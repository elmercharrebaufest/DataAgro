@using Molinos.DataAgro.Entities.Dto


<link href="~/Content/Sugerencia.css" rel="stylesheet" />
<script>
    var cupos = cuposAsignadosPorDia.length;
    for (var i = 0; i < cupos; i++) {
        cuposAsignadosPorDia.pop();
    }
    cupos = cuposAsignados.length;
    for (var i = 0; i < cupos; i++) {
        cuposAsignados.pop();
    }
    $(document).ready(function () {
       
            setTimeout(function () {
                $.unblockUI();
            }, 250);
      
    });

</script>

@{
    ViewBag.Title = "PartialTabla";
    var lista = (List<SugerenciaCupoDto>)ViewBag.Lista;
    var sugerencia = (List<SugerenciaPorComercialDto>)ViewBag.Sugerencia;
}

<div class="card">
    <div class="card-body">
        <div id="table-scroll" class="table-scroll" style="overflow-x:auto;">
            <div id="tabla" class="table-editable table-responsive">
                <table class="table-bordered  tabla" id="tabla">
                    <thead>
                        <tr class="encabezado">
                            <th class="text-center">Proveedor</th>
                            @{var i = 1;

                                foreach (var r in ViewBag.Fechas)
                                {
                                    var cant = sugerencia.Where(x => x.Fecha == r).Sum(x => x.Total);
                                    var fecha = r.ToString("dd/MM/yyyy");

                                    <th class="text-center @("col" + i)">
                                        <div class="ck-button">
                                            <label>
                                                <input type="checkbox" class="@(i)" onclick="MarcarColumna(this)" hidden>
                                                <div class="popover-cabecera">
                                                    <span class="@("fecha" + i)">@fecha</span>
                                                    <br data-toggle="popover" data-placement="top" data-trigger="manual" id="popover@("col" + i)" data-container="body" data-content="" /><strong>Sugerencias pendientes por día: @cant</strong>
                                                </div>
                                            </label>
                                        </div>
                                    </th>
                                    <script>
                                  cuposAsignadosPorDia.push(@cant);
                                    </script>
                                    i++;
                                }
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{ var j = 1; var c = 1;}
                        @foreach (var k in lista.GroupBy(x => x.ProveedorDesc))
                        {
                            i = 1;
                            <tr class="detalle  @("fila" + j)">
                                <td class="pt-3-half">
                                    <div class="ck-button">
                                        <label>
                                            <input type="checkbox" class="@(j)" onclick="MarcarFila(this)" hidden>
                                            <div>
                                                <label data-row="@(j)" data-proveedor="@k.Select(x => x.Id).FirstOrDefault()" hidden></label>
                                                <label hidden data-rowComercial="@(j)" data-comercial="@k.Select(x => x.ComercialId).FirstOrDefault()"></label>
                                                <label class="aca" data-proveedordesc="@(j)" style="text-overflow: ellipsis; overflow: hidden;white-space: nowrap;" data-proveedorDescripcion="@k.Key">@k.Key</label>
                                                <br data-toggle="popover" data-placement="top" data-trigger="manual" id="popoverFila@("fila" + j)" data-content="" /><strong>Sugerencias pendientes: @k.Sum(x => x.CantidadDeCupos)</strong>
                                            </div>
                                        </label>
                                    </div>
                                </td>
                                <script>
                                 cuposAsignados.push(@k.Sum(x => x.CantidadDeCupos));
                                </script>
                                @foreach (var r in ViewBag.Fechas)
                                {
                                    var haySugerencia = false;
                                    foreach (var sugerenciaPorDia in k)
                                    {
                                        if (sugerenciaPorDia.FechaSugerida == r)
                                        {
                                            <td class="pt-3-half @("col" + i)" id="celda@(i)" data-column="@i" data-row="@j">
                                                <div class="row">
                                                    <label class="col-sm-9 borde @("labelFila" + i)" id="@("label" + i) cargarSugerencia" onblur="CalcularTotal(this)" contenteditable="true" data-column="@i" data-row="@j">@sugerenciaPorDia.CantidadDeCupos</label>
                                                    <span class="col-sm-2 @("reestablecerCelda" + i)" data-mostrarCruzColumna="@i" data-mostrarCruzFila="@j" hidden style="margin-top:7px;"><i class="fa fa-times @("reestablecerCelda" + i)" aria-hidden="true" data-reestablecerColumna="@i" data-reestablecerFila="@j" onclick="Reestablecer(this)"></i></span>
                                                </div>
                                                <span hidden class="@("contenidoFila" + i)" id="@("contenidolabel" + i)" data-columnContenido="@i" data-rowContenido="@j">@sugerenciaPorDia.CantidadDeCupos</span>
                                                <div class="checkbox" data-column="@i" data-row="@j">
                                                    <label style="font-size: 1em">
                                                        <input type="checkbox" onclick="BloquearCelda(this)" id="@("check" + i)" class="@("checkFila" + j) @("checkCelda" + c)" data-column="@i" data-row="@j">
                                                        <span class="cr"><i class="cr-icon fa fa-check"></i> </span>
                                                    </label>
                                                </div>
                                            </td>
                                            haySugerencia = true;
                                        }

                                    }
                                    if (!haySugerencia)
                                    {
                                        <td class="pt-3-half @("col" + i)" id="celda@(i)" data-column="@i" data-row="@j">
                                            <div class="row">
                                                <label class="col-sm-9 borde @("labelFila" + i)" id="@("label" + i)" onblur="CalcularTotal(this)" contenteditable="true" data-column="@i" data-row="@j">0</label>
                                                <span hidden class="col-sm-2 @("reestablecerCelda" + i)" data-mostrarCruzColumna="@i" data-mostrarCruzFila="@j" style="margin-top:7px"><i class="fa fa-times" data-reestablecerColumna="@i" data-reestablecerFila="@j" aria-hidden="true" onclick="Reestablecer(this)"></i></span>
                                            </div>
                                            <span hidden class="@("contenidoFila" + i)" id="@("contenidolabel" + i)" data-columnContenido="@i" data-rowContenido="@j">0</span>
                                            <div class="form-check" contenteditable="false" data-column="@i" data-row="@j">
                                                <div class="checkbox">
                                                    <label style="font-size: 1em">
                                                        <input type="checkbox" onclick="BloquearCelda(this)" id="@("check" + i)" class="@("checkFila" + j) @("checkCelda" + c)" data-column="@i" data-row="@j">
                                                        <span class="cr"><i class="cr-icon fa fa-check"></i></span>
                                                    </label>
                                                </div>
                                            </div>
                                        </td>
                                    }
                                    i++;
                                    c++;
                                }
                            </tr>
                            j++;
                        }

                    </tbody>
                    @*<tfoot>

                        <tr class="detalle encabezado">
                            <td class="text-center">Devolución de Sugerencias</td>
                            @{
                                i = 1;
                                foreach (var r in ViewBag.Fechas)
                                {
                                    <td class="pt-3-half">
                                        <div class="row">
                                            <label class="col-sm-9 borde @("devuelto" + i)" contenteditable="true"></label>
                                        </div>
                                    </td>
                                    i++;
                                }

                            }
                        </tr>

                    </tfoot>*@
                </table>
            </div>
        </div>
    </div>
</div>

<script>
    $("td").on("keydown", function (event) {
        if (event.which != 8 && event.which != 46 && isNaN(String.fromCharCode(event.which))) {
            event.preventDefault();
        }
    });
</script>

