
@{
    ViewBag.Title = "Sugerencia de Cupos";
}
@section Styles {
    @**@
}
<style>
    #GridID .k-grid-content {
        min-height: 100px;
        max-height: 400px;
    }
    /*  .kNumeric{
        width:80px !important;
    }*/
    .k-grid tr td {
        border-width: 0;
    }

    .k-grid td {
        font-size: 11px;
        line-height: 1em;
        padding-top: 0.4em;
        padding-right: 0.6em;
        padding-bottom: 0;
        padding-left: 0.6em;
    }

    .k-grid-header th.k-header > .k-link {
        text-overflow: initial;
    }

    #menu > ul {
        display: none;
        list-style-type: none;
    }

        #menu > ul > li {
            list-style: none;
        }

    #menu > li {
        list-style: none;
        font-weight: bold;
    }

    ul > .multi::after {
        content: ' +'
    }

    ul > .multi-opened::after {
        content: ' -'
    }

    .cabecera {
        top: 225px;
        left: 22px;
        width: 1277px;
        height: 81px;
        background: #767676 0% 0% no-repeat padding-box;
        opacity: 1;
        color: white;
    }

    .cabecera-dia {
        top: 306px;
        left: 22px;
        width: 1278px;
        height: 37px;
        background: #D6D6D6 0% 0% no-repeat padding-box;
        border: 1px solid #DEE2E6;
        opacity: 1;
    }

    .cabecera-sugerencia {
        top: 342px;
        left: 22px;
        width: 1278px;
        height: 37px;
        background: #F5F5F5 0% 0% no-repeat padding-box;
        border: 1px solid #DEE2E6;
        opacity: 1;
    }

    .table thead > tr > th, .table tbody > tr > th, .table tfoot > tr > th, .table thead > tr > td, .table tbody > tr > td, .table tfoot > tr > td {
        vertical-align: middle;
    }

    .material1 {
        border-left: 12px rgb(255, 204, 153) solid !important;
        border-collapse: separate !important;
        height: 45px;
        vertical-align: middle;
        line-height: 45px;
    }

    .material2 {
        border-left: 12px rgb(153, 153, 255) solid !important;
        border-collapse: separate !important;
        height: 45px;
        vertical-align: middle;
        line-height: 45px;
    }

    .material3 {
        border-left: 12px rgb(153, 204, 0) solid !important;
        border-collapse: separate !important;
        height: 45px;
        vertical-align: middle;
        line-height: 45px;
    }

    .material4, .material5 {
        border-left: 12px rgb(211, 96, 212) solid !important;
        border-collapse: separate !important;
        height: 45px;
        vertical-align: middle;
        line-height: 45px;
    }

    .collapse.in {
        display: table-row;
    }

    .fa-caret-square-o-down, .fa-caret-square-o-right {
        font-size: x-large;
        cursor: pointer;
    }

    .sugerencia {
        padding: 20px;
    }

    .linkVerde {
        color: #28A745;
    }

    .linkCeleste {
        color: #1C7CD5;
    }

    .form-check-inline {
        display: inline-flex;
    }

    .borde-cheks {
        background: var(--unnamed-color-ffffff) 0% 0% no-repeat padding-box;
        background: #FFFFFF 0% 0% no-repeat padding-box;
        border: 1px solid #DDDDDD;
        border-radius: 4px;
        opacity: 1;
        padding-right: 15px;
    }

    .border-0 {
        border: none !important;
    }
</style>
<script src="~/Scripts/KendoExtensions.js"></script>
<script src="~/Scripts/kendo/messages/kendo.messages.es-AR.min.js"></script>

<script src="~/Scripts/App/SugerenciaCupo.js"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
<script src="~/Scripts/App/SolicitudCupo.js"></script>

@{
    var cierre = ViewBag.Cierre;
    var fechas = (List<DateTime>)ViewBag.Fechas;
    var lista = (List<Molinos.DataAgro.Entities.Dto.SugerenciaCupoDto>)ViewBag.Lista;
    var sugerenciaPorComercial = (List<Molinos.DataAgro.Entities.Dto.SugerenciaPorComercialDto>)ViewBag.Sugerencia;
    var materialId = (int)ViewBag.Material;
}

<link href="~/Content/cupo.css" rel="stylesheet" />

@*<div class="alert alert-warning @(cierre ? "": "hide")">La Cupera se encuentra momentáneamente bloqueada. Por cualquier duda o inconveniente comunicarse con el administrador de la Cupera.</div>*@
<div class="container-fluid ">
    <ul class="nav nav-tabs" id="myTab">
        @*<li><a data-target="#payment" data-toggle="tab">Sugerencia de cupos pendientes</a></li>*@
        <li class="active"><a data-target="#method" data-toggle="tab">Sugerencia de cupos pendientes detalles</a></li>
        <li><a data-target="#solicitudes" data-toggle="tab">Solicitudes Realizadas</a></li>
        <li>
            <a onclick="AbrirModalSolicitudExtraordinaria();" style="background: #1C7CD5 0% 0% no-repeat padding-box;border-radius: 4px !important;opacity: 1;color: white;">
                <i class="fa fa-plus-circle"></i>
                Solicitud Extraordinaria
            </a>
        </li>
    </ul>
    <div class="tab-content">
        @*<div class="tab-pane active" id="payment">
                <div class="row">
                    <div class="col-xs-12" style="padding:0;">
                        @Html.Partial("TablaSugerenciaCupo")
                    </div>
                </div>
            </div>*@
        <div class="tab-pane active" id="method">
            <div class="alert alert-warning @(cierre ? "": "hide")">La cupera se encuentra momentáneamente bloqueada. Por cualquier duda o inconveniente comunicarse con el administrador de la cupera.</div>

            @*filtros*@
            <div class="panelflotante @(cierre ? "hide": "")">
                <div class="row">

                    @*<div class="float-left margen-15">
                            <button style="border: none; margin-top:4px" class="btnSolicitudExtraordinaria" onclick="AbrirModalSolicitudExtraordinaria();">
                                <span class="btnVarios">
                                    <i class="fa fa-plus-circle"></i>
                                    Solicitud Extraordinaria
                                </span>
                            </button>
                        </div>*@

                    @*<div class="float-right margen-15">
                            <span id="btnRechazar" class="btnVarios">
                                <i class="fa fa-trash"></i>
                                Devolver
                            </span>
                        </div>
                        <div class="float-right margen-15">
                            <span id="btnAceptar" class="btnVarios">
                                <i class="fa fa-check"></i>
                                Aceptar
                            </span>
                        </div>*@
                    <div class="float-left margen-15">
                        @Html.DropDownList("ComercialSeleccionado1", ViewBag.ComercialSeleccionado as SelectList, new { @class = "form-control ComercialSeleccionado", @id = "ComercialSeleccionado1" })
                    </div>
                    <div class="col-md-2 col-xs-6 hide">
                        @Html.DropDownList("CentroId", ViewBag.CenLista as SelectList, "Seleccione Destino", new { @class = "form-control disabled", @id = "CentroId" })
                    </div>
                    <div class="float-left margen-15 borde-cheks">
                        <div class="form-check-inline">
                            <label class="form-check-label">
                                <input type="radio" class="form-check-input" name="materialId" @(materialId == 1 ? "checked" : "") value="1"> Maiz
                            </label>
                        </div>
                        <div class="form-check-inline">
                            <label class="form-check-label">
                                <input type="radio" class="form-check-input" name="materialId" @(materialId == 2 ? "checked" : "") value="2" disabled> Trigo
                            </label>
                        </div>
                        <div class="form-check-inline">
                            <label class="form-check-label">
                                <input type="radio" class="form-check-input" name="materialId" @(materialId == 3 ? "checked" : "") value="3"> Soja
                            </label>
                        </div>
                        <div class="form-check-inline">
                            <label class="form-check-label">
                                <input type="radio" class="form-check-input" name="materialId" @(materialId == 4 ? "checked" : "") value="4" disabled> Girasol
                            </label>
                        </div>
                        <div class="form-check-inline">
                            <label class="form-check-label">
                                <input type="radio" class="form-check-input" name="materialId" @(materialId == 5 ? "checked" : "") value="5" disabled> Girasol AO
                            </label>
                        </div>

                    </div>
                    <div class="float-left margen-15">
                        <input id="buscadorProveedor" class="k-textbox required-box required-box-parent" style="width:240px" type="text" placeholder="Buscar por CUIT, razón social" required="required" />
                        <input type="hidden" id="proveedorCUIT" />
                    </div>

                </div>
            </div>
            <div class="row @(cierre ? "hide": "")">
                <div class="col-xs-12" style="padding:0;">
                    @*<div id="gridSugerenciaCupo" class="table-responsive"> </div>*@

                    @if (lista == null || lista.Where(a => a.MaterialId == materialId).Count() == 0)
                    {
                        <label>No hay sugerencias disponibles</label>
                    }
                    else
                    {

                <div class="table-responsive">
                    <table class="table table-striped">
                    <thead>
                        <tr class="cabecera">
                            <th colspan="3">Dia y Material</th>
                            <th colspan="3">Proveedor</th>
                            <th colspan="1">Sugerencias<br />Pendientes<br />por proveedor</th>
                            <th colspan="3">Sugerencias de cupos<br />que quiero aceptar</th>
                            <th colspan="2"><button type="button" class="k-button" onclick="DevolverSugerencias()">Devolver Sugerencias</button></th>
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var dia in lista.GroupBy(x => x.FechaSugerida).OrderBy(x => x.Key).ToList())
                        {
                        <thead>
                            <tr class="cabecera-dia">
                                <td colspan="6">
                                    <label class="fa fa-caret-square-o-down" aria-hidden="true" onclick="verOcultar(this,'@dia.Key.ToString("ddMMyyyy")',false)"></label>
                                    <b>@dia.Key.ToString("dd/MM/yyyy")</b> &nbsp;
                                    Sugerencias del día:<b> @(@sugerenciaPorComercial.Where(x => x.Fecha == dia.Key && x.MaterialId == materialId).SingleOrDefault() != null ? sugerenciaPorComercial.Where(x => x.Fecha == dia.Key && x.MaterialId == materialId).SingleOrDefault().Total : 0)</b>
                                </td>
                                @*<td>Originales</td>*@
                                <td>Quedan @dia.Where(a => a.MaterialId == materialId).Sum(a => a.CantidadDeCupos)</td>
                                <td colspan="3"></td>
                                <td colspan="2">Devoluciones del día</td>
                            </tr>
                        </thead>
                        //proveedores del dia
                        foreach (var proveedor in dia.Where(a => a.MaterialId == materialId).GroupBy(x => x.ProveedorDesc).OrderBy(a => a.Key).ToList())
                        {
                            <tr class="cabecera-proveedor @dia.Key.ToString("ddMMyyyy") p@(proveedor.First().ProveedorCUIT) pall todo" hidden>
                                <td colspan="3" style="padding:0 8px 0 0;">
                                    <div class="material@(proveedor.First().MaterialId)">
                                        @proveedor.First().MaterialDesc
                                    </div>
                                </td>
                                <td colspan="3">
                                    <label class="fa fa-caret-square-o-down" name="p@(dia.Key.ToString("ddMMyyyy"))" aria-hidden="true" onclick="verOcultar(this,'@dia.Key.ToString("ddMMyyyy")@proveedor.First().ProveedorCUIT',true)"></label>
                                    @proveedor.First().ProveedorDesc
                                </td>
                                <td>@proveedor.Sum(x => x.CantidadDeCupos)</td>
                                <td><input type="text" class="kNumeric" max="@proveedor.Sum(x => x.CantidadDeCupos)" id="p@(proveedor.First().ProveedorId)_@(dia.Key.ToString("ddMMyyyy"))" style="width:70px;" /></td>
                                <td><a class="linkVerde" href="javascript:void(0);" onclick="AceptarSugerenciaProvDia('p@(proveedor.First().ProveedorId)_@(dia.Key.ToString("ddMMyyyy"))','@(dia.Key.ToString("dd/MM/yyyy"))','@(dia.First().MaterialId)','@(proveedor.First().ProveedorId)','@(proveedor.First().ProveedorDesc.Replace("'",""))', '@(proveedor.Sum(a=>a.CantidadDeCupos))')">Aceptar Sugerencias</a></td>
                                <td><a class="linkCeleste" href="javascript:void(0);" onclick='ModificarSugerenciaProv("p@(proveedor.First().ProveedorId)_@(dia.Key.ToString("ddMMyyyy"))", "@(dia.Key.ToString("dd/MM/yyyy"))", "@(proveedor.First().ProveedorId)", "@(proveedor.First().ProveedorDesc.Replace("'",""))", "@(proveedor.First().MaterialId)", "@(proveedor.First().MaterialDesc)","@(string.Join(",",lista.Where(a => a.ProveedorId == proveedor.First().ProveedorId).GroupBy(a => a.FechaSugerida).Select(a => a.Key.ToString("ddMMyyyy") +"-"+ a.Sum(x=>x.CantidadDeCupos))))")'>Modificar Grilla</a></td>

                                            <td colspan="2"></td>
                                        </tr>

                            <tr class="cabecera-sugerencia sugerencia @dia.Key.ToString("ddMMyyyy") @dia.Key.ToString("ddMMyyyy")@proveedor.First().ProveedorCUIT todo" hidden>
                                <th>Punt.</th>
                                <th>Contrato SAP</th>
                                <th>Kg</th>
                                @*<th>Pendiente <br /> de Entrega</th>*@
                                <th>Negocio</th>
                                <th>Moneda</th>
                                <th>Precio</th>
                                <th>Cantidad<br/>sugerida</th>
                                <th colspan="2">Sugerencias de cupos que quiero aceptar</th>
                            </tr>

                            foreach (var sugerencia in proveedor.OrderByDescending(x => x.PuntuacionTotal))
                            {
                                <tr class="sugerencia @dia.Key.ToString("ddMMyyyy") @dia.Key.ToString("ddMMyyyy")@proveedor.First().ProveedorCUIT todo" hidden>
                                    <td>@sugerencia.PuntuacionTotal</td>
                                    <td>
                                        @sugerencia.ContratoSAP
                                        
                                        @if (sugerencia.Sustentable)
                                        {
                                            <i class='fa fa-solid fa-leaf'></i>
                                        }
                                    </td>
                                    <td>@sugerencia.KgNegocio.ToString("N0")</td>
                                    @*<td>@sugerencia.KgPendienteAplicar.ToString("N0")</td>*@
                                    <td>@sugerencia.TipoNegocioDesc</td>
                                    <td>@sugerencia.MonedaDesc</td>
                                    <td>@(sugerencia.Precio == null ? "" : sugerencia.Precio.Value.ToString("N"))</td>
                                    @*<td>@sugerencia.CantidadCupoOriginal</td>*@
                                    <td>@sugerencia.CantidadDeCupos</td>
                                    <td><input type="text" class="kNumeric" max="@sugerencia.CantidadDeCupos" style="width:70px;" id="s@(sugerencia.Id)" /></td>
                                    <td><a class="linkVerde" href="javascript:void(0);" onclick="AceptarSugerencia('s@(sugerencia.Id)','@(sugerencia.FechaSugerida.ToString("dd/MM/yyyy"))','@(sugerencia.ProveedorId)','@(sugerencia.ProveedorDesc.Replace("'",""))', '@(sugerencia.CantidadDeCupos)')">Aceptar Sugerencia</a></td>
                                    <td><a class="linkCeleste" href="javascript:void(0);" onclick="ModificarSugerencia('@(sugerencia.Id)','@(sugerencia.FechaSugerida.ToString("dd/MM/yyyy"))','@(sugerencia.ProveedorId)','@(sugerencia.ProveedorDesc.Replace("'",""))','@(sugerencia.CantidadDeCupos)','@(sugerencia.MaterialId)','@(sugerencia.MaterialDesc)')">Modificar Sugerencia</a></td>
                                    <td><input type="text" class="kNumeric sugerenciaDevuelta" max="@sugerencia.CantidadDeCupos" style="width:70px;" id="@(sugerencia.Id)-@(sugerencia.ProveedorDesc.Replace("'",""))-@(sugerencia.MaterialDesc)-@sugerencia.ContratoSAP-@(sugerencia.CantidadDeCupos)-@(sugerencia.FechaSugerida.ToString("dd/MM/yyyy"))"/></td>
                                    <td>@*<a class="linkCeleste" href="javascript:void(0);" onclick="DevolverSugerencia('d@(sugerencia.Id)')">Devolver Sugerencia</a>*@Cantidad a Devolver</td>
                                </tr>
                            }
                            <tr class="sugerencia @dia.Key.ToString("ddMMyyyy") @dia.Key.ToString("ddMMyyyy")@proveedor.First().ProveedorCUIT todo" hidden>
                                <td colspan="14">&nbsp;</td>
                            </tr>

                                    }

                                }

                                    </tbody>
                                </table>
                                </div>
                        }
                </div>
            </div>
        </div>
        <div class="tab-pane" id="solicitudes">
            <div id="panel">
                @Html.Partial("PartialSolicitud")
            </div>

        </div>
    </div>
</div>


<div class="modal fade" id="fleteProcedenciaModal" tabindex="-1" role="dialog" aria-labelledby="resultadoCupoLabel" aria-hidden="true" data-keyboard='false'>
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="cerrar close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="status confirmado-modal">
                    <div>¿Desea reasignar un cupo con flete procedencia?</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="myBtn btn" id="boton-no">No</button>
                <button type="button" class="myBtn btn" id="boton-si">Si</button>
                <button type="button" class="myBtn btn" data-dismiss="modal" id="boton-cancelar">Cancelar</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="CargaCupos" tabindex="-1" role="dialog" aria-labelledby="CargaCuposLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="cerrar close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h1 class="modal-title" id="sugerencia"></h1>
                <div class="status confirmado-modal">
                    <div>Flete Procedencia</div>
                </div>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table id="carga-cupos-table" class="table table-striped">
                        <thead>
                            <tr>
                                <th>Proveedor</th>
                                <th>Fecha Original</th>
                                <th>Fecha Elegida</th>
                                <th>Cantidad de Cupos</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="cuerpo-carga-cupos">
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="myBtn btn aceptar" id="aceptar">Aceptar</button>
                <button type="button" class="myBtn btn" id="cancelar-carga" data-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ModalRechazo" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-mio mod">
        <div class="modal-content">
            <div class="alert alert-danger alert-dismissible" role="alert" hidden>
                <a href="javascript:void(0);" class="close" data-hide="alert" aria-label="close">&times;</a>
                <span id="error-alert"></span>
            </div>

            <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span><span class="sr-only">Close</span></button>
            <div class="modal-header" style="margin-left: -1%;padding-right: 2px;">
                <h1 class="modal-title-confirmado" id="lineModalLabel"></h1>
                <div class="status confirmado-modal">
                    <div id="tituloAgente" class="tituloPosicion">Motivo de Rechazo</div>
                </div>
            </div>

            <textarea id="motivoRechazo" rows="5" cols="30" class="k-textbox" style="height:120px;"></textarea>
            <button class="btn k-button" type="button" id="btnAceptarRechazar">Rechazar</button>
            <button type="button" id="cancelar" class="btn k-button" data-dismiss="modal">Cancelar</button>
        </div>
    </div>
</div>

<div class="modal fade" id="resultadoCupo" tabindex="-1" role="dialog" aria-labelledby="resultadoCupoLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="cerrar close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h1 class="modal-title" id="resultadoCupoTitle"></h1>
                <div class="status confirmado-modal">
                    <div>Cupos Creados</div>
                </div>
            </div>
            <div class="modal-body">
                <div id="error-modal" hidden></div>
                <div id="cupos-generados-modal"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn k-button" data-dismiss="modal">Aceptar</button>
                <button type="button" class="btn k-button" onclick="copiarGenerados('cupos-generados-modal')"><i class="fa fa-copy"></i> Copiar</button>
            </div>
        </div>
    </div>
</div>
<div class="modal fade" id="resultadoCupoSolicitud" tabindex="-1" role="dialog" aria-labelledby="resultadoCupoLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="cerrar close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h1 class="modal-title"></h1>
                <div class="status confirmado-modal">
                    <div>Resultado Solicitud</div>
                </div>
            </div>
            <div class="modal-body">
                <div id="error-modal" hidden></div>
                <div id="cupos-generados-modal-solicitud"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn k-button" data-dismiss="modal">Aceptar</button>
                <button type="button" class="btn k-button" onclick="copiarGenerados('cupos-generados-modal-solicitud')"><i class="fa fa-copy"></i> Copiar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modificarSugerenciaProveedorModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog" role="document" style="width:auto;">
        <div class="modal-content" style="width:auto;">
            <div class="modal-header">
                <button type="button" class="cerrar close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h1 class="modal-title" id=""></h1>
                <div class="status confirmado-modal">
                    <div>Modificar Sugerencia</div>
                </div>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <input type="hidden" id="modSugerenciaId" />
                    <input type="hidden" id="modMaterialId" />
                    <input type="hidden" id="modProveedorId" />
                    <table id="carga-cupos-table" class="table">
                        <tbody id="">
                            <tr style="height:48px;">
                                <td class="border-0">Material</td>
                                <td class="border-0">Proveedor</td>
                                <td class="border-0">Fecha</td>
                                <td class="border-0" style="border-right:1px solid #dddddd !important;">Cantidad</td>
                                @foreach (var fecha in fechas)
                                {
                                    <td class="border-0">@fecha.ToString("dd MMM").Replace(".", "") <br /> (<b>@(sugerenciaPorComercial.Any(a => a.Fecha == fecha) ? sugerenciaPorComercial.First(a => a.Fecha == fecha).Total.ToString() : "0")</b>)</td>
                                }
                            </tr>
                            @foreach (var dia in lista.GroupBy(x => x.FechaSugerida).OrderBy(x => x.Key).ToList())
                            {
                                <tr class="filaProv" id="fila@(dia.Key.ToString("ddMMyyyy"))" style="height:48px;">
                                    @*<td><b></b>@dia.Where(a => a.MaterialId == materialId).First().MaterialDesc</td>*@
                                    <td><b class="modMaterial"></b></td>
                                    <td><b class="modProveedor"></b></td>
                                    <td><b>@dia.Key.ToString("dd/MM/yyyy")</b></td>
                                    <td style="border-right:1px solid #dddddd;"><b id="modCantidad@(dia.Key.ToString("ddMMyyyy"))"></b></td>
                                    @foreach (var fecha in fechas)
                                    {
                                        <td>
                                            <input type="text" id="mod@(dia.Key.ToString("ddMMyyyy")+"_"+fecha.ToString("ddMMyyyy"))" class="kNumeric diaProv" style="width:70px;" />
                                        </td>
                                    }
                                </tr>
                            }


                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="myBtn btn" id="aceptarModificarPorProveedor">Aceptar</button>
                <button type="button" class="myBtn btn" data-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

