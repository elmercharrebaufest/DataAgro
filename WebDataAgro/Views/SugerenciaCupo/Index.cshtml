
@{
    ViewBag.Title = "Index";
}
@section Styles {
    @**@
}
<style>
    #GridID .k-grid-content {
        min-height: 100px;
        max-height: 400px;
    }

    .k-grid tr td {
        border-width: 0;
    }

    .k-grid td {
        font-size: 11px;
        line-height: 1em;
        padding-top: 0.4em;
        padding-right: 0.6em;
        padding-bottom: 0;
        padding-left: 0.6em;
    }

    .k-grid-header th.k-header > .k-link {
        text-overflow: initial;
    }

    #menu > ul {
        display: none;
        list-style-type: none;
    }

        #menu > ul > li {
            list-style: none;
        }

    #menu > li {
        list-style: none;
        font-weight: bold;
    }

    ul > .multi::after {
        content: ' +'
    }

    ul > .multi-opened::after {
        content: ' -'
    }
</style>
<script src="~/Scripts/KendoExtensions.js"></script>
<script src="~/Scripts/kendo/messages/kendo.messages.es-AR.min.js"></script>
<script src="~/Scripts/App/SugerenciaCupo.js"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>

@*<link href="~/Content/compraNet.css" rel="stylesheet" />*@
<link href="~/Content/cupo.css" rel="stylesheet" />

<div class="container-fluid">
    <div class="container-fluid">
        <ul class="nav nav-tabs" id="myTab">
            <li class="active"><a data-target="#payment" data-toggle="tab">Sugerencia de cupos pendientes</a></li>
            <li><a data-target="#method" data-toggle="tab">Sugerencia de cupos pendientes detalles</a></li>
        </ul>
        <div class="tab-content">
            <div class="tab-pane active" id="payment">
                <div class="row">
                    <div class="col-xs-12" style="padding:0;">
                        @Html.Partial("TablaSugerenciaCupo")
                    </div>
                </div>
            </div>
            <div class="tab-pane" id="method">
                <div class="panelflotante">
                    <div class="row">
                        <div class="float-right margen-15">
                            <span id="btnRechazar" class="btnVarios">
                                <i class="fa fa-mail-forward"></i>
                                Rechazar
                            </span>
                        </div>
                        <div class="float-right margen-15">
                            <span id="btnAceptar" class="btnVarios">
                                <i class="fa fa-copy"></i>
                                Aceptar
                            </span>
                        </div>
                    </div>
                </div>
                <div class="row">
                    <div class="col-xs-12" style="padding:0;">
                        <div id="gridSugerenciaCupo" class="table-responsive">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
<div class="modal fade" id="fleteProcedenciaModal" tabindex="-1" role="dialog" aria-labelledby="resultadoCupoLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="cerrar close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="status confirmado-modal">
                    <div>¿Desea reasignar un cupo con flete procedencia?</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="myBtn btn" id="boton-si">Si</button>
                <button type="button" class="myBtn btn" id="boton-no">No</button>
                <button type="button" class="myBtn btn" data-dismiss="modal" id="boton-cancelar">Cancelar</button>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="CargaCupos" tabindex="-1" role="dialog" aria-labelledby="CargaCuposLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="cerrar close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h1 class="modal-title" id="sugerencia"></h1>
                <div class="status confirmado-modal">
                    <div>Flete Procedencia</div>
                </div>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table id="carga-cupos-table" class="table table-striped">
                        <thead>
                            <tr>
                                <th>Proveedor</th>
                                <th>Fecha</th>
                                <th>Cantidad de Cupos</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="cuerpo-carga-cupos">
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="myBtn btn" data-dismiss="modal" id="aceptar">Aceptar</button>
                <button type="button" class="myBtn btn" id="cancelar-carga" data-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="ModalRechazo" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-mio mod">
        <div class="modal-content">
            <div class="alert alert-danger alert-dismissible" role="alert" hidden>
                <a href="#" class="close" data-hide="alert" aria-label="close">&times;</a>
                <span id="error-alert"></span>
            </div>

                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span><span class="sr-only">Close</span></button>
                <div class="modal-header" style="margin-left: -1%;padding-right: 2px;">
                    <h1 class="modal-title-confirmado" id="lineModalLabel"></h1>
                    <div class="status confirmado-modal">
                        <div id="tituloAgente" class="tituloPosicion">Motivo de Rechazo</div>
                    </div>
                </div>

            <textarea id="motivoRechazo" rows="5" cols="30" class="k-textbox" style="height:120px;"></textarea>
            <button class="btn k-button" type="button" id="btnAceptarRechazar">Rechazar</button>
            <button type="button" id="cancelar" class="btn k-button" data-dismiss="modal">Cancelar</button>
        </div>
    </div>
</div>

    <div class="modal fade" id="resultadoCupo" tabindex="-1" role="dialog" aria-labelledby="resultadoCupoLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="cerrar close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h1 class="modal-title" id="resultadoCupoTitle"></h1>
                    <div class="status confirmado-modal">
                        <div>Cupos Creados</div>
                    </div>
                </div>
                <div class="modal-body">
                    <div id="error-modal" hidden></div>
                    <div id="cupos-generados-modal"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn k-button" data-dismiss="modal">Aceptar</button>
                    <button type="button" class="btn k-button" onclick="copiarGenerados()"><i class="fa fa-copy"></i> Copiar</button>
                </div>
            </div>
        </div>
    </div>
