<script>
    $("#CantidadCupoSE").kendoNumericTextBox({// al pasasrlo al js de solicitudCupo.js se rompe por mas que se ejecute en el document ready
        optionLabel: "SELECCIONE CANTIDAD DE CUPOS...",
        culture: "es-AR",
        format: "n0",
        spinners: false,
        min: 0,
    });
    $("#FasonES").click(function () {
        checkFason();
    });
    $("#buscadorProveedorSE").click(function () {
        $("#ProveedorIdSE").val("");
        $("#buscadorProveedorSE").data("kendoAutoComplete").value("");
        $("#buscadorProveedorSE").data("kendoAutoComplete").trigger("change");
    });
    $("#buscadorProveedorSE").kendoAutoComplete({
        template: '<img class="buscar-cont" src="..' + MSGetUrl("/Content/Images/usuario-busqueda.png") + '" /> ' +
            '<p class="#:data.Corredor# buscar-nomb" value="#:data.RazonSocial#" >#: data.RazonSocial#(#: data.Cuit#)</p>',
        minLength: 3,
        enforceMinLength: true,
        dataTextField: "Filtro",
        dataValueField: "Id",
        autoWidth: true,
        filter: "contains",
        change: function () {
            if ($("#buscadorProveedorSE").val().split('|').length > 1) {
                $("#buscadorProveedorSE").val($("#buscadorProveedorSE").val().split('|')[1]);
            }
            MostrarVisualizarStock();
        },
        select: function (e) {

            if ($("#FasonES").is(":checked")) {
                $("#CuitES").val(e.dataItem.Cuit);
            }

            $("#ProveedorIdSE").val(e.dataItem.Id);
        },
        dataSource: {
            severFiltering: true,
            serverPaging: true,
            transport: {
                read: {
                    type: 'post',
                    dataType: 'json',
                    url: "/Cupo/BuscarProveedor"
                },
                parameterMap: function (data, type) {
                    return { filtroProveedor: $('#buscadorProveedorSE').val() };
                }
            }

        },
        filtering: function (e) {
            if (!e.filter.value) {
                e.preventDefault();
            }
        }
    });
    $(".ComercialSeleccionado").css("width", "200px").kendoDropDownList({
        dataTextField: "Text",
        dataValueField: "Value",
        filter: "contains"
    });
</script>
<style>
    .aceptar {
        width: 13% !important;
    }
</style>

