@model WebDataAgro.Models.SugerenciaModel

@using Molinos.DataAgro.Entities.Dto
@{
    ViewBag.Title = "TablaSugerenciaCupo";
    var mensajes = (List<MensajeCupoDto>)ViewBag.Mensajes;
}
<script src="~/Scripts/App/TablaSugerenciaCupo.js"></script>
<script src="~/Scripts/Mastersoft.js"></script>
<script>
    var cuposAsignadosPorDia = [];
    var cuposAsignados = [];
</script>



<div class="row-fluid">
    <div class="col-md-4 col-xs-6 margin-bottom-10">
        <button style="border: none; margin-top:4px" id="confirmarSugerencia" class="btnConfirmar">
            <span class="btnVarios">
                <i class="fa fa-check"></i>
                Confirmar
            </span>
        </button>
        <button style="border: none; margin-top:4px" class="btnSolicitudExtraordinaria" onclick="AbrirModalSolicitudExtraordinaria();">
            <span class="btnVarios">
                <i class="fa fa-plus-circle"></i>
                Solicitud Extraordinaria
            </span>
        </button>
        @if (mensajes.Count() >= 1)
        {
            <span class="" style="vertical-align: text-top" onclick="MostrarMensaje()">
                <i style="font-size: 40px; line-height: 24px" class="fa fa-list-alt"></i>
            </span>
        }
    </div>
    @using (Ajax.BeginForm("PartialTabla", "SugerenciaCupo", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "Tabla" }, null))
    {
        <div class="col-md-2 col-lg-offset-2 col-xs-6">
            @Html.DropDownList("ComercialSeleccionado2", ViewBag.ComercialSeleccionado as SelectList, new { @class = "form-control ComercialSeleccionado", @id = "ComercialSeleccionado2" })
        </div>
        <div class="col-md-2 col-xs-6">
            @Html.DropDownList("MaterialId", ViewBag.MatLista as SelectList, new { @class = "form-control", @id = "MaterialId" })
        </div>
        <div class="col-md-2 col-xs-6 hide">
            @Html.DropDownList("CentroId", ViewBag.CenLista as SelectList, "Seleccione Destino", new { @class = "form-control disabled", @id = "CentroId" })
        </div>
        <div lass="col-md-2 col-xs-6">
            <label>Limpiar valores</label>
            <input id="cargaValorSugerenciaId" class="campo-input-input" data-bind="" type="checkbox" onclick="CargarValorSugerencia()" />
        </div>
        <button type="submit" id="filtrarMaterial" hidden class="k-button k-button-icontext sideMargin-15" style="display:none;">Buscar</button>
    }
</div>

<div id="Tabla">
    @Html.Partial("PartialTabla")
</div>

<div class="modal fade in" id="CargaCuposTabla" tabindex="-1" role="dialog" aria-labelledby="CargaCuposLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="cerrar close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h1 class="modal-title"></h1>
                <div class="status confirmado-modal">
                    <div>Flete Procedencia</div>
                </div>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table id="carga-cupos-table" class="table table-striped">
                        <thead>
                            <tr>
                                <th>Proveedor</th>
                                <th>Fecha</th>
                                <th>Cantidad de Cupos</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="cuerpo-carga-cupos-tabla">
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="myBtn btn" data-dismiss="modal" id="aceptarTabla">Aceptar</button>
                <button type="button" class="myBtn btn" id="cancelar" data-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="fleteProcedenciaTabla" tabindex="-1" role="dialog" aria-labelledby="resultadoCupoLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="cerrar close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <div class="status confirmado-modal">
                    <div>¿El cupo no tiene flete procedencia, desea mantener esta condición?</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="myBtn btn" id="boton-noTabla">Si</button>
                <button type="button" class="myBtn btn" id="boton-siTabla">No</button>
                <button type="button" class="myBtn btn" data-dismiss="modal" id="boton-cancelarTabla">Cancelar</button>
            </div>
        </div>
    </div>
</div>


<style>
    .blockPage {
        opacity: 1 !important;
    }
</style>