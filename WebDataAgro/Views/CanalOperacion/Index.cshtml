@{
    ViewBag.Title = "Canales de operación";
}

@section Scripts {
    @Scripts.Render("~/bundles/AbmCanalOperacion")
}


<h3>Canales de operación</h3>
<br />

<div id="Abm">

    <div class="row">
        <div class="col-md-6">
            <div id="gridIniCanalOperacion" data-bind="source: Resultados" style="height:200px;"></div>
        </div>
        <div class="col-md-6">
        </div>
    </div>

    <br />

    <div class="row">
        <div class="col-md-2">
            <label>Descripción</label>
        </div>
        <div class="col-md-4">
            <input id="Descripcion" type="text" class="k-textbox" data-bind="value: CanalOperacion.Descripcion, disabled: isControlDisabled" maxlength="50" style="max-width:311px" />
            <img id="errDescripcion" src="~/Content/Images/error.png" style="display:none" />
        </div>
        
    </div>
    <div class="row">
        <div class="col-md-2">
            <label>Inhabilitado</label>
        </div>
        <div class="col-md-4">
            <input id="Inhabilitado" class="campo-input-input" data-bind="checked:CanalOperacion.Inhabilitado, disabled: isControlDisabled" type="checkbox" />
        </div>        
    </div>
    


    <br />

    <div class="row">
        <div class="col-md-12">
            <button id="butAgregar" class="k-button ms-marginTop" type="button" data-role="button" data-bind="disabled: isAddDisabled">Agregar</button>
            <button id="butGrabar" class="k-button ms-marginTop" type="button" data-role="button" data-bind="disabled: isControlDisabled" style="margin-left:15px;">Grabar</button>
            <button id="butEliminar" class="k-button ms-marginTop" type="button" data-role="button" data-bind="disabled: isDeleteDisabled" style="margin-left:15px;">Eliminar</button>
            <button id="butCancelar" class="k-button ms-marginTop" type="button" data-role="button" data-bind="disabled: isControlDisabled" style="margin-left:15px;">Cancelar</button>
        </div>
    </div>
</div>
