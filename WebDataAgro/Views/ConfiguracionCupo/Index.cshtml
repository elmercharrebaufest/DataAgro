@model WebDataAgro.Models.ConfiguracionCupoModel
@{
    ViewBag.Title = "Administración de Cupos";
}

@section Styles {
    <link href="~/Content/compraNet.css" rel="stylesheet" />
    <link href="~/Content/cupo.css" rel="stylesheet" />
    <link href="~/Content/configuracionCupo.css" rel="stylesheet" />
}

@section Scripts {
    @Scripts.Render("~/bundles/ConfiguracionCupo")
}
@*<script src="~/Scripts/KendoExtensions.js"></script>
    <script src="~/Scripts/App/ConfiguracionCupo.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>*@

<div class="container">

    <h3>Administración de Cupos</h3>
    <br />
    @if (!Html.ViewData.ModelState.IsValid)
    {
        <div id="errorModal">
            <div class="alert alert-danger alert-dismissible" role="alert">
                <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                @Html.ValidationSummary()
            </div>
        </div>
    }
    else
    {
        <script>$(document).ready(LimpiarConfiguracion)</script>
    }
    <div class="alert alert-success alert-dismissible" role="alert" hidden>
        <a href="#" class="close" data-hide="alert" aria-label="close">&times;</a>
        <span>Grabación Correcta</span>
    </div>
</div>
<div class="row">
    <div class="col-xs-12">
        <div class="desplegable" id="desplegable">
            <span class="historial">Alta</span>
        </div>
    </div>
</div>
<div class="container">
    <div class="row">
        <div class="col-xs-10">
            @*<div class="desplegable" id="desplegable">
                    <span class="historial">Alta</span>
                </div>*@

            @using (Html.BeginForm("GrabarCupos", null, FormMethod.Post, new { id = "formGrabarCupos" }))
            {

                <div class="row">
                    @Html.HiddenFor(x => x.Id)
                    <div class="col-xs-2" id="Centros" data-value="@Json.Encode(ViewBag.CentrosTodos)">
                        <span>Centro</span>
                    </div>
                    <div class="col-sm-4">
                        @Html.DropDownListFor(x => x.CentroId, new SelectList(ViewBag.Centro, "Value", "Text"), new { @class = "form-control" })
                        @Html.HiddenFor(x => x.CentroId, new { @id = "centro" })
                    </div>
                    <div class="col-xs-2">
                        <span>Material</span>
                    </div>
                    <div class="col-sm-4">
                        @Html.DropDownListFor(x => x.MaterialId, new SelectList(ViewBag.Material, "Value", "Text"), "Seleccione Material", new { @class = "form-control" })
                        @Html.HiddenFor(x => x.MaterialId, new { @id = "material" })
                    </div>
                </div>
                <div class="row">
                    <div class="col-xs-2">
                        <span>Fecha Desde</span>
                    </div>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(x => x.Fecha, new { @class = "w100" })
                    </div>
                    <div class="col-xs-2">
                        <span>Fecha Hasta</span>
                    </div>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(x => x.FechaHasta, new { @class = "w100" })
                    </div>
                </div>
                <div class="row" style="padding-top:5px;">
                    <div class="col-xs-2">
                        <span>Límite Cupo</span>
                    </div>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(x => x.CantidadCupo, new { @class = "w100", @onchange = "SetearEnCero()" })
                    </div>
                    <div class="col-xs-2">
                        <span>Límite Algoritmo</span>
                    </div>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(x => x.CantidadAlgoritmo, new { @class = "w100", @onchange = "SetearEnCero()" })
                    </div>
                    <div class="col-xs-2">
                        <span>Límite con Descarga</span>
                    </div>
                    <div class="col-sm-4">
                        @Html.TextBoxFor(x => x.CantidadDescarga, new { @class = "w100", @onchange = "SetearEnCero()" })
                    </div>
                    <div hidden>
                        <div class="col-xs-2">
                            <span>Cerrar Cupera</span>
                        </div>
                        <div class="col-sm-4">
                            <input id="CierreCupera" name="CierreCupera" type="checkbox" value="true">
                        </div>
                    </div>
                    <div>
                        <div class="col-xs-2" style="padding-top:10px;">
                            <span>Liberar Cupera</span>
                        </div>
                        <div class="col-sm-4" style="padding-top:10px;">
                            <input id="LiberarCupera" name="LiberarCupera" type="checkbox" value="true">
                        </div>
                    </div>
                </div>


                <br />
                <div class="row" style="padding-top:5px;">

                    <div class="col-sm-2">
                        <button class="btn btnSubmit cancelar" type="button" onclick="Cancelar()">Cancelar</button>
                    </div>
                    <div class="col-sm-2">
                        <button class="btn btnSubmit guardar" type="submit">Grabar</button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
<div id="tablaCupos">

    @Html.Action("TablaCuposPartial", "ConfiguracionCupo")
</div>
<!-- Modal Limite-->
@Html.Partial("ModalLimite")

<style>
    .line {
        border-bottom: 5px solid #d21515 !important;
    }

    .maiz {
        background: rgb(255, 204, 153, 0.5) !important;
    }

    .soja {
        background: rgb(153, 204, 0, 0.5) !important;
    }

    .girasol {
        background: rgb(211, 96, 212, 0.5) !important;
    }

    .trigo {
        background: rgb(106, 230, 190, 0.5) !important;
    }

    .girasolAO {
        background: rgb(153, 153, 255, 0.5) !important;
    }

    .btn {
        margin-left: 0px !important;
        width: 100% !important;
    }

    .container {
        margin-right: 0;
        margin-left: 0;
        max-width: 100%;
    }

    .cancelar {
        background: red;
        color: white;
        border-radius: 5px !important
    }

    .guardar {
        background: green;
        color: white;
        border-radius: 5px !important
    }

    .finalizarVariosDiv {
        border: 1px solid #bdbdbd;
    }
</style>
