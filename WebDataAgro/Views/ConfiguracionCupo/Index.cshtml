@model WebDataAgro.Models.ConfiguracionCupoModel
@{
    ViewBag.Title = "Configuración Cupos";
}

@section Styles {
    <link href="~/Content/compraNet.css" rel="stylesheet" />
    <link href="~/Content/cupo.css" rel="stylesheet" />
    <link href="~/Content/configuracionCupo.css" rel="stylesheet" />
}

    <script src="~/Scripts/KendoExtensions.js"></script>
    <script src="~/Scripts/App/ConfiguracionCupo.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>

    <div class="container">

        <h3>Configuración de Cupos</h3>
        <br />
        @if (!Html.ViewData.ModelState.IsValid)
        {
            <div id="errorModal">
                <div class="alert alert-danger alert-dismissible" role="alert">
                    <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                    @Html.ValidationSummary()
                </div>
            </div>
        }
        else
        {
            <script>$(document).ready(LimpiarConfiguracion)</script>
        }
        <div class="alert alert-success alert-dismissible" role="alert" hidden>
            <a href="#" class="close" data-hide="alert" aria-label="close">&times;</a>
            <span>Grabación Correcta</span>
        </div>
        <div class="row">
            <div class="col-xs-10 m-grid-col-xs-offset-1">
                <div class="desplegable" data-toggle="collapse" data-target="#alta" onclick="mostrarocultar('#mostrar')">
                    <span class="historial">Alta</span> <span id="mostrar" class="mostrar">Mostrar</span>
                </div>

                <div id="alta" class="collapse">

                    @using (Html.BeginForm("GrabarCupos", null, FormMethod.Post))
                    {
                       
                        <div class="row">
                            @Html.HiddenFor(x => x.Id)
                            <div class="col-xs-2">
                                <span>Centro</span>
                            </div>
                            <div class="col-sm-4">
                                @Html.DropDownListFor(x => x.CentroId, new SelectList(ViewBag.Centro, "Value", "Text"), new { @class = "form-control" })
                            </div>
                            <div class="col-xs-2">
                                <span>Material</span>
                            </div>
                            <div class="col-sm-4">
                                @Html.DropDownListFor(x => x.MaterialId, new SelectList(ViewBag.Material, "Value", "Text"), "Seleccione Material", new { @class = "form-control" })
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-xs-2">
                                <span>Fecha</span>
                            </div>
                            <div class="col-sm-4">
                                @Html.TextBoxFor(x => x.Fecha, new { @class = "w100" })
                            </div>
                            <div class="col-xs-2">
                                <span>Límite Cupo</span>
                            </div>
                            <div class="col-sm-4">
                                @Html.TextBoxFor(x => x.CantidadCupo, new { @class = "w100" })
                            </div>
                        </div>
                        <div class="row">
                            <button class="btn btnSubmit" type="submit">Grabar</button>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div id="tablaCupos">
            @Html.Action("TablaCuposPartial", "ConfiguracionCupo")
        </div>
    </div>

<!-- Modal Limite-->
@Html.Partial("ModalLimite")
