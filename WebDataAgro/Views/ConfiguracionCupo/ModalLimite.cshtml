@{
    Layout = null;
}
<div class="modal fade" id="ModalLimiteCupo" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-mio">
        <div class="modal-content">
            <div class="alert alert-danger alert-dismissible" role="alert" hidden>
                <a href="#" class="close" data-hide="alert" aria-label="close">&times;</a>
                <span id="error-alert"></span>
            </div>

                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span><span class="sr-only">Close</span></button>
            <div class="modal-header ">
                <h1 class="modal-title-confirmado" id="lineModalLabel"></h1>
                <div class="status confirmado-modal">
                    <div id="tituloAgente" class="tituloPosicion">Configuración Cupos</div>
                </div>
            </div>
            <div class="modal-body clearfix scrollInside">
                <input id="configuracionCupoId" hidden />
                <div class="row">
                    <div id="tabla-limite" class="table-responsive">
                        <table id="tablaLimite" class="table table-bordered table-striped ">
                        </table>
                    </div>
                </div>
            </div>
            <div class="modal-footer clearfix ">
                <div class="align-right">
                    <button type="button" id="grabarLimiteCupo" class="btn btnSubmit">Guardar</button>
                    <button type="button" id="cancelar" class="btn" data-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
    </div>
</div>
