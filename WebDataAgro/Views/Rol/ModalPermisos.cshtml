@model WebDataAgro.Models.RolModel
@{
    Layout = null;
}
<link href="~/Content/compraNet.css" rel="stylesheet" />



<div class="modal fade" id="ModalRolPermiso" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-mio mod">
        <div class="modal-content">
            <div class="alert alert-danger alert-dismissible" role="alert" hidden>
                <a href="#" class="close" data-hide="alert" aria-label="close">&times;</a>
                <span id="error-alert"></span>
            </div>

            <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span><span class="sr-only">Close</span></button>
            <div class="modal-header" style="margin-left: -1%;padding-right: 2px;">
                <h1 class="modal-title-confirmado" id="lineModalLabel"></h1>
                <div class="status confirmado-modal">
                    <div id="tituloAgente" class="tituloPosicion">Configuración de Roles</div>
                </div>
            </div>

            @Html.Hidden("Id", 0, new { id = "Id", data_bind = "value: id" })
            @Html.Hidden("permisos", "", new { id = "permisosFinales", data_bind = "value: permisos" })
            <div class="row">
                <div class="col-xs-3">
                    <label>Descripción</label>
                </div>
                <div class="col-xs-9">
                    @Html.TextBoxFor(m => m.Descripcion, new { @id = "descripcionRolId", @class = " required-box required-box-parent k-textbox", data_bind = "value: descripcionRol" })
                </div>
            </div>
            @*<div class="row">
                <div class="col-xs-3">
                    <label>Permisos</label>

                </div>
                <div class="col-xs-7">
                    @Html.DropDownList("Permisos", (IEnumerable<SelectListItem>)ViewBag.Permisos, "Seleccione Permiso", new { id = "permiso", @class = "form-control ancho k-dropdown-wrap k-state-default", data_bind = "value: newPermisoId" })
                </div>
                <div class="col-xs-2 form-group textoDerecha">
                    <button class="k-button k-button-icontext" type="button" data-bind="click: addPermiso" style="margin-left: -33.5%;">Agregar</button>
                </div>
            </div>*@
            <br />
            <table class="table-striped">
                <thead><tr><th colspan="2">Permisos</th></tr></thead>
                <tbody>
                    @{var numeroDeGrupo = 0;}
                    @foreach (var permiso in ViewBag.Permisos)
                    {
                        int grupo = int.Parse(permiso.Value)/100;
                        if (numeroDeGrupo != grupo)
                        {
                            switch (grupo)
                            {
                                case 1:
                                    <tr><th class="permisos">Proveedor</th><th></th></tr>
                                    numeroDeGrupo = grupo;
                                    break;
                                case 2:
                                    <tr><th class="permisos">Comercial</th><th></th></tr>
                                    numeroDeGrupo = grupo;
                                    break;
                                case 3:
                                    <tr><th class="permisos">CompraNet</th><th></th></tr>
                                    numeroDeGrupo = grupo;
                                    break;
                                case 4:
                                    <tr><th class="permisos">Reportes</th><th></th></tr>
                                    numeroDeGrupo = grupo;
                                    break;
                                case 5:
                                    <tr><th class="permisos">Configuración</th><th></th></tr>
                                    numeroDeGrupo = grupo;
                                    break;
                                case 6:
                                    <tr><th class="permisos">Research</th><th></th></tr>
                                    numeroDeGrupo = grupo;
                                    break;
                                case 7:
                                    <tr><th class="permisos">Cupos</th><th></th></tr>
                                    numeroDeGrupo = grupo;
                                    break;
                                case 8:
                                    <tr><th class="permisos">Externos</th><th></th></tr>
                                    numeroDeGrupo = grupo;
                                    break;
                                case 9:
                                    <tr><th class="permisos">Boletos</th><th></th></tr>
                                    numeroDeGrupo = grupo;
                                    break;
                                default:
                                    break;
                            }
                        }
                        <tr>
                            <td class="permisos">@permiso.Text</td>
                            <td class="text-center"><input type="checkbox" value="@permiso.Text" id="@permiso.Value" onclick="AgregarRemoverPermiso(this)"/></td>
                        </tr>
                    }
                </tbody>
            </table>
            @*<table id="lista-permisos" class="ancho">
                <thead>
                    <tr>
                        <th class="sinBorde">Descripción</th>
                        <th class="sinBorde"></th>
                    </tr>
                </thead>
                <tbody id="tabla-permisos" data-template="div-template" data-bind="source:permisos">
                </tbody>
            </table>

            <script id="div-template" type="text/x-kendo-template">
                <tr>
                    <td data-bind="text: Descripcion"></td>
                    <td class="alinearCentro"><a data-bind="click: removePermiso" class="ancho fuente"><i class="fa fa-trash" aria-hidden="true"></i></a></td>
                </tr>
            </script>*@
            <br />
            <div class="modal-footer clearfix ">
                <div class="align-right">
                    <button type="button" id="" class="btn btnSubmit" data-bind="click: guardar">Guardar</button>
                    <button type="button" id="cancelar" class="btn" data-dismiss="modal">Cerrar</button>
                </div>
            </div>
        </div>
        
    </div>
</div>

