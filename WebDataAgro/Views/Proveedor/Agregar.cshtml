                @Html.TextBox("Comisionista", "", new { @placeholder = "Buscar por CUIT, razón social", @id = "buscadorProveedor", @class = "k-textbox k-autocomplete w100 k-autocomplete-clearable k-state-default k-hidden", @style = "width:272px" })
