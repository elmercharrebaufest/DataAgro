    var modificarRazonSocial = PermisosHelper.Is(PermisosDataAgro.ModificarRazonSocial);
    var deshabilitarProveedor = PermisosHelper.Is(PermisosDataAgro.DeshabilitarProveedor);
    var ocultarCamposEditar = PermisosHelper.Is(PermisosDataAgro.OcultarCamposEditar);
