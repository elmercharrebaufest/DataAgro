                <span class="campo-estadoafip-span">
                    Estado Registro AFIP
                </span>
                <img id="imgOperable" src="" />
                <span class="campo-estadoafip-span-operable" id="Operable-agregar" onmouseover="mostrarTooltip(this)" onmouseout="ocultarTooltip(this)">

                </span>

                <div id="tooltip" class="lista-contacto-no-operable">
                    <div class="lista-contacto-no-operable-tooltip">
                        <span class="span-contacto-no-operable-tooltip"> </span>
                    </div>
                    <div class="lista-contacto-no-operable-tooltip-arrow"></div>
                </div>

            </div>
        </div>
        <div class="formulario-campo" style="height:38px;">
            <div class="campo-span">
                Sin interés de operar
            </div>
            <input id="nocliente" class="campo-input-text input-nocliente" type="checkbox" @(ocultarCamposEditar ? "disabled" : "") />
        </div>
        <div class="formulario-campo noCorredor" style="height:38px;">
            <div class="campo-span">
                Deshabilitar
            </div>
            <input id="deshabilitado" class="campo-input-text input-nocliente" @(deshabilitarProveedor ? "" : "disabled") type="checkbox" />
        </div>

        <div class="formulario-campo campo-comisionista" style="height:38px;">
            <div class="campo-span">
                Es Comisionista
            </div>
            <input id="comisionista" class="campo-input-text input-nocliente" type="checkbox" @(deshabilitarProveedor ? "" : "disabled") />
        </div>
        <div class="formulario-campo " style="height:38px;">
