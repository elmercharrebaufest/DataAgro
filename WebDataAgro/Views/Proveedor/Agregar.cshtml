    {
        modificarDatosCampos = false;
    }
}
<script>
    var ProveedorId = '@ViewBag.ProveedorId';
    var modificarDatosCampos = ConvertirStringABool('@modificarDatosCampos');
    var AmbientePruebas = '@System.Configuration.ConfigurationManager.AppSettings["AmbientePruebas"]';
