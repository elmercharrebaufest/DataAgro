        <div class="formulario-campo">
            <span class="campo-span">CUIT (*) </span>
            <input type="text" class="campo-input-text" onkeypress='return event.charCode >= 48 && event.charCode <= 57' @(ocultarCamposEditar ? "disabled" : "") id="cuit" />
        </div>
        <div class="formulario-campo campo-razonsocial">
            <span class="campo-span">Razón Social</span>
            <input type="text" class="campo-input-text" id="razonsocial" @(modificarRazonSocial ? "" : "disabled") />
            <br />
            <span class="campo-span">Alias</span>
            <input type="text" class="campo-input-text" id="Alias" @(ocultarCamposEditar ? "disabled" : "") />
