@{
    ViewBag.Title = "ABM de Contrato Acuerdo";
}

@section Scripts {
    @Scripts.Render("~/bundles/AbmContratoAcuerdo")
}
<script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>


@section Styles {
    <link href="~/Content/compraNet.css" rel="stylesheet" />
}

<h3>@ViewBag.Title</h3>

<br />
<input type="hidden" id="perfil" value="@ViewBag.perfil" />
<div id="rootwizard">

    <div id="Abm">

        <ul>
            <li style="display:none"><a href="#tab1" data-toggle="tab"></a></li>
            <li style="display:none"><a href="#tab2" data-toggle="tab"></a></li>
        </ul>

        <div class="tab-content">
            <div class="tab-pane" id="tab1">
                <div class="row">
                    <div class="col-md-12">
                        <button id="butAgregar" class="k-button" type="button" data-role="button" data-bind="disabled: isAddNewDisabled">Agregar</button>
                        <button id="butConfirmar" class="k-button" type="button" data-role="button" data-bind="disabled: isAddNewDisabled">Confirmar</button>
                        @*<button id="butModificar" class="k-button" type="button" data-role="button" data-bind="disabled: isDeleteDisabled" style="margin-left:15px;">Modificar</button>
                            <button id="butEliminar" class="k-button" type="button" data-role="button" data-bind="disabled: isDeleteDisabled" style="margin-left:15px;">Eliminar</button>*@
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <div id="gridIni" data-bind="source: Resultados"></div>
                    </div>
                </div>


            </div>

            <div class="tab-pane" id="tab2">
                <div class="row">
                    <div>
                        <div class="col-sm-2 fasonero" id="proveedorLabelId">
                            <label id="proveedorLabel">Proveedor</label>
                        </div>
                        <div class="col-sm-4">
                            <input id="buscadorProveedor" class="k-textbox" style="width:100%" type="text" placeholder="Buscar por CUIT, razón social" required="required" />
                            <div id="buscadorResult"></div>
                        </div>
                    </div>
                </div>
                <div class="row" style="margin-top:5px">
                    <div class="col-md-2">
                        <label>Cantidad</label>
                    </div>
                    <div class="col-md-4">
                        <input id="Cantidad" type="number" class="k-textbox  required-box required-box-parent" " data-bind="value: ContratoAcuerdo.Cantidad, disabled: isControlDisabled" maxlength="50" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-2 ">
                        <label>Moneda</label>
                    </div>
                    <div class="col-sm-5 col-md-4">
                        <div>
                            <select id="moneda" class="required-box" data-bind="source: MonedaCombo, value: Resultados.moneda, disabled: isControlDisabled"></select>
                            <img id="errmoneda" src="~/Content/Images/error.png" style="display:none" />
                        </div>
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2">
                        <label>Precio</label>
                    </div>
                    <div class="col-md-4">
                        <input id="Precio" type="number" class="k-textbox  required-box required-box-parent" data-bind="value: ContratoAcuerdo.Precio, disabled: isControlDisabled" maxlength="50" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-2 ">
                        <label>Material</label>
                    </div>
                    <div class="col-sm-5 col-md-4">
                        <div>
                            <select id="material" class="required-box" data-bind="source: MaterialCombo, value: Resultados.material, disabled: isControlDisabled"></select>
                            <img id="errmaterial" src="~/Content/Images/error.png" style="display:none" />
                        </div>
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>
                <div class="row">
                    <div class="col-sm-2">
                        <label>Destino</label>
                    </div>
                    <div class="col-sm-5 col-md-4">
                        <select id="destinoId" data-bind="source: DestinoCombo, value: Resultados.destinoId, disabled: isControlDisabled"></select>
                        <img id="errdestinoId" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                </div>
                <div class="row" style="margin-top:5px">
                    <div class="col-sm-2 noRightPadding">
                        <label>Fecha Entrega Desde</label>
                    </div>
                    <div class="col-sm-4 col-md-2">
                        <span id="fechaDesdeReporte">
                            <input id="fechaDesde" name="fechaDesdeString" type="date" style="width: 100%" />
                        </span>
                    </div>
                </div>
                <div class="row" style="margin-top:5px">
                    <div class="col-sm-2 noRightPadding">
                        <label>Fecha Entrega Hasta</label>
                    </div>
                    <div class="col-sm-4 col-md-2">
                        <span id="fechaHastaReporte">
                            <input id="fechaHasta" name="fechaHastaString" type="date" style="width: 100%" />
                        </span>
                    </div>
                </div>
                <div class="row" style="margin-top:5px">
                    <div class="col-sm-2">
                        <label>Comercial</label>
                    </div>
                    <div class="col-sm-5 col-md-4">
                        <select id="comercialId" data-bind="source: ComercialCombo, value: Resultados.comercialId, disabled: isControlDisabled"></select>
                        <img id="errcomercialId" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                </div>
                <div class="row" style="margin-top:10px;">
                    <div class="col-md-offset-2 col-md-10">
                        <button id="butAceptar" class="k-button" type="button" data-role="button">Aceptar</button>
                        <button id="butCancelar" class="k-button" type="button" data-role="button" style="margin-left:15px;">Cancelar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
