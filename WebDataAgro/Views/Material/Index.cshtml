@{
    ViewBag.Title = "ABM de Materiales";
}

@section Scripts {
    @Scripts.Render("~/bundles/AbmMaterial")
}

<h3>Materiales</h3>

<br />

<div id="rootwizard">

    <div id="Abm">

        <ul>
            <li style="display:none"><a href="#tab1" data-toggle="tab"></a></li>
            <li style="display:none"><a href="#tab2" data-toggle="tab"></a></li>
        </ul>

        <div class="tab-content">

            <div class="tab-pane" id="tab1">

                <div class="row">
                    <div class="col-md-12">
                        <div id="gridIni" data-bind="source: Resultados" style="height:320px;"></div>
                    </div>
                </div>

                <br />

                <div class="row">
                    <div class="col-md-12">
                        <button id="butAgregar" class="k-button" type="button" data-role="button" data-bind="disabled: isAddNewDisabled">Agregar</button>
                        <button id="butModificar" class="k-button" type="button" data-role="button" data-bind="disabled: isDeleteDisabled" style="margin-left:15px;">Modificar</button>
                        <button id="butEliminar" class="k-button" type="button" data-role="button" data-bind="disabled: isDeleteDisabled" style="margin-left:15px;">Eliminar</button>
                    </div>
                </div>

            </div>

            <div class="tab-pane" id="tab2">

                <div class="row">
                    <div class="col-md-2">
                        <label>Descripcion</label>
                    </div>
                    <div class="col-md-4">
                        <input id="Descripcion" type="text" class="k-textbox" data-bind="value: Material.Descripcion, disabled: isControlDisabled" maxlength="50" style="max-width:310px" />
                        <img id="errApellido" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-2">
                        <label>Codigo</label>
                    </div>
                    <div class="col-md-4">
                        <input id="Codigo" type="text" class="k-textbox" data-bind="value: Material.Codigo, disabled: isControlDisabled" maxlength="50" style="max-width:310px" />
                        <img id="errNombres" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-2">
                        <label>Campaña</label>
                    </div>
                    <div class="col-md-4">
                        <select id="CampaniaId" data-bind="source: CampaniaCombo, value: Material.CampaniaId, disabled: isControlDisabled" style="max-width:310px"></select>
                        <img id="errCampania" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-2">
                        <label>Campaña Tablero</label>
                    </div>
                    <div class="col-md-4">
                        <select id="CampaniaTableroId" data-bind="source: CampaniaTableroCombo, value: Material.CampaniaTableroId, disabled: isControlDisabled" style="max-width:310px"></select>
                        <img id="errCampaniaTablero" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-2">
                        <label>IVA</label>
                    </div>
                    <div class="col-md-4">
                        <input id="iva" class="number-input" data-bind="value: Material.IVA, disabled: isControlDisabled" maxlength="50" style="max-width:310px" />
                        <img id="errApellido" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>

                <br />
                <div class="row">
                    <div class="col-md-12">
                        <button id="butAceptar" class="k-button" type="button" data-role="button">Aceptar</button>
                        <button id="butCancelar" class="k-button" type="button" data-role="button" style="margin-left:15px;">Cancelar</button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
