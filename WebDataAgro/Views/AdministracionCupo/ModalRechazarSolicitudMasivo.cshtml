@{
    Layout = null;
}

<div class="modal fade" id="modalRechazarSolicitudMasivo" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header ">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span><span class="sr-only">Close</span></button>
            </div>
            <div class="campo clearfix">
                <div class="espaciolineas">¿Está seguro que desea rechazar las solicitudes?</div>
            </div>
            <div id="div-motivo-rechazoSolictud"><label><b>Motivo de Rechazo:&nbsp;</b></label><input class="form-control"  id="motivo"></div>
            <div id="solicitudId" hidden></div>
            <br />
            <div class="col-xs-6 noPaddingRight">
                <button type="button" id="aceptar" class="myBtn btnSubmit" onclick="RechazarMasivo()" data-dismiss="modal">Si</button>
            </div>
            <div class="col-xs-6 noPaddingRight">
                <button type="button" id="cancelarRechazar" class="myBtn" data-dismiss="modal">No</button>
            </div>
        </div>
        </div>
        </div>
</div>