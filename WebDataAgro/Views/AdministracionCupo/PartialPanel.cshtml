@model WebDataAgro.Models.ConfiguracionCupoModel
@using Molinos.DataAgro.Entities.Dto
@{
    ViewBag.Title = "PartialPanel";
    var panel = (List<DiaCupo>)ViewBag.Panel;
    var noAceptadas = (List<SugerenciaNoAceptada>)ViewBag.SugerenciasNoAceptadas;
    var fechas = (List<DateTime>)ViewBag.Fechas;
    var activo = panel.FirstOrDefault() != null ? panel.FirstOrDefault().Material.Replace(" ", "") : "";

}

<ul class="nav nav-tabs" id="myTab" style="margin-bottom:0 !important">
    @foreach (var m in panel.GroupBy(x => x.Material.Replace(" ", "")))
    {
        <li class="@(m.Key.Replace(" ","") == activo?"active":"")"><a data-target="#@m.Key.Replace(" ","")" data-toggle="tab"><strong>@m.Key.Replace(" ", "").ToUpper()</strong></a></li>
    }
</ul>

@*<div class="panel active" id="method">
        <div class="row-fluid" id="Tabla">
            <div class="col-xs-12">
                <div id="gridInformeCompraNet" class="table-responsive"></div>
            </div>
        </div>
    </div>*@
<script>
    $(document).ready(function () {
        $('#menuproveedor').hide();
        kendo.culture("es-AR");
        $(function () {
            $('[data-toggle="tooltip"]').tooltip()
        });
    });
</script>
<div class="tab-content">

    @foreach (var m in panel.GroupBy(x => x.Material.Replace(" ", "")))
    {
        <div class="tab-pane panel @(m.Key.Replace(" ","") == activo?" active":"")" id="@m.Key.Replace(" ","")">

            <div class="table-editable table-responsive">
                <table class="table table-bordered table-responsive-md text-center tabla" id="@(m.Key.Replace(" ","") + "tabla")">
                    <thead class="ColorBackgroundThead">
                        <tr>
                            <th style="width: 25%"></th>
                            @foreach (var r in m.GroupBy(x => x.Fecha))
                            {
                                var fecha = r.Key.ToString("dd/MM/yyyy");
                                <th class="text-center">
                                    <span>@fecha (@m.Where(x => x.Fecha == r.Key).DefaultIfEmpty(new DiaCupo { CantidadDisponibilidadPlanta = 0 }).Sum(x => x.CantidadDisponibilidadPlanta))</span>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @*Disponibilidad en Administrador*@
                        <tr class="ColorBackgroundTr">
                            <td style="text-align: initial">
                                <strong><span style="cursor: pointer" data-toggle="tooltip" data-placement="bottom" title="Es el Limite de cupos menos el Limite del Algoritmo y con descarga">Disponibilidad en Administrador</span></strong>
                                <i class="fa fa-chevron-right" style="font-size: 11px" aria-hidden="true"></i>
                            </td>
                            @foreach (var d in m.GroupBy(x => x.Fecha))
                            {
                                <td>@m.Where(x => x.Fecha == d.Key).DefaultIfEmpty(new DiaCupo { CantidadDisponibilidadDia = 0 }).Sum(x => x.CantidadDisponibilidadDia)</td>
                            }

                        </tr>
                        @*Consumidos*@
                        <tr>
                            <td style="text-align: end"><span style="cursor: pointer" data-toggle="tooltip" data-placement="bottom" title="Son los cupos generados manualmente o generados desde alguna solicitud">Consumidos</span></td>
                            @foreach (var d in m.GroupBy(x => x.Fecha))
                            {
                                <td>@m.Where(x => x.Fecha == d.Key).DefaultIfEmpty(new DiaCupo { ConsumidosFueraDelAlgoritmo = 0 }).Sum(x => x.ConsumidosFueraDelAlgoritmo)</td>
                            }

                        </tr>
                        @*Disponibles + Devoluciones*@
                        <tr>
                            <td style="text-align: end"><span style="cursor: pointer" data-toggle="tooltip" data-html="true" data-placement="bottom" title="Es la <strong>Disponibilidad en Administrador</strong> mas las <strong>Solicitudes Devueltas</strong> hechas por el comercial, menos los <strong>Cupos Consumidos</strong>">Disponibles</span></td>
                            @foreach (var d in m.GroupBy(x => x.Fecha))
                            {
                                <td>@m.Where(x => x.Fecha == d.Key).DefaultIfEmpty(new DiaCupo { DisponiblesYDevoluciones = 0 }).Sum(x => x.DisponiblesYDevoluciones)</td>
                            }

                        </tr>








                        @*Disponibilidad en Administrador con descarga*@
                        <tr class="ColorBackgroundTr">
                            <td style="text-align: initial">
                                <strong><span style="cursor: pointer" data-toggle="tooltip" data-placement="bottom" title="Es el Limite de cupos con descarga">Disponibilidad con Descarga</span></strong>
                                <i class="fa fa-chevron-right" style="font-size: 11px" aria-hidden="true"></i>
                            </td>
                            @foreach (var d in m.GroupBy(x => x.Fecha))
                            {
                                <td>@m.Where(x => x.Fecha == d.Key).DefaultIfEmpty(new DiaCupo { CantidadDescarga = 0 }).Sum(x => x.CantidadDescarga)</td>
                            }

                        </tr>
                        @*Consumidos*@
                        <tr>
                            <td style="text-align: end"><span style="cursor: pointer" data-toggle="tooltip" data-placement="bottom" title="Son los cupos generados manualmente o generados desde alguna solicitud">Consumidos</span></td>
                            @foreach (var d in m.GroupBy(x => x.Fecha))
                            {
                                <td>@m.Where(x => x.Fecha == d.Key).DefaultIfEmpty(new DiaCupo { ConsumidosConDescarga = 0 }).Sum(x => x.ConsumidosConDescarga)</td>
                            }

                        </tr>
                        @*Disponibles *@
                        <tr>
                            <td style="text-align: end"><span style="cursor: pointer" data-toggle="tooltip" data-html="true" data-placement="bottom" title="Es la <strong>Disponibilidad en Administrador</strong> mas las <strong>Solicitudes Devueltas</strong> hechas por el comercial, menos los <strong>Cupos Consumidos</strong>">Disponibles</span></td>
                            @foreach (var d in m.GroupBy(x => x.Fecha))
                            {
                                <td>@m.Where(x => x.Fecha == d.Key).DefaultIfEmpty(new DiaCupo { DisponibleConDescarga = 0 }).Sum(x => x.DisponibleConDescarga)</td>
                            }

                        </tr>









                        @*Disponibilidad Algoritmo*@
                        <tr class="ColorBackgroundTr">
                            <td style="text-align: initial">
                                <strong><span style="cursor: pointer" data-toggle="tooltip" data-placement="bottom" title="Limite del algoritmo">Disponibilidad Algoritmo </span></strong>
                                <i class="fa fa-chevron-right" style="font-size: 11px" aria-hidden="true"></i>
                            </td>
                            @foreach (var d in m.GroupBy(x => x.Fecha))
                            {
                                <td>@m.Where(x => x.Fecha == d.Key).DefaultIfEmpty(new DiaCupo { CantidadAlgoritmo = 0 }).Sum(x => x.CantidadAlgoritmo)</td>
                            }

                        </tr>
                        @*Consumidos*@
                        <tr>
                            <td style="text-align: end"><span style="cursor: pointer" data-toggle="tooltip" data-placement="bottom" title="Todos los cupos que se consumieron dentro del algoritmo">Consumidos</span></td>
                            @foreach (var d in m.GroupBy(x => x.Fecha))
                            {
                                <td>@m.Where(x => x.Fecha == d.Key).DefaultIfEmpty(new DiaCupo { ConsumidosDentroDelAlgoritmo = 0 }).Sum(x => x.ConsumidosDentroDelAlgoritmo)</td>
                            }

                        </tr>
                        @*Pendientes*@
                        <tr>
                            <td style="text-align: end"><span style="cursor: pointer" data-toggle="tooltip" data-placement="bottom" title="Sugerencia de cantidad de cupos que aún no han sido confirmadas">Pendientes</span></td>
                            @foreach (var d in m.GroupBy(x => x.Fecha))
                            {
                                <td>@m.Where(x => x.Fecha == d.Key).DefaultIfEmpty(new DiaCupo { CantidadSugerenciaPendiente = 0 }).Sum(x => x.CantidadSugerenciaPendiente)</td>
                            }

                        </tr>
                        @*Devueltas*@
                        <tr>
                            <td style="text-align: end"><span style="cursor: pointer" data-toggle="tooltip" data-placement="bottom" title="Sugerencia de cantidad de cupos que el comercial devolvió">Devueltas</span></td>
                            @foreach (var d in m.GroupBy(x => x.Fecha))
                            {
                                <td>@m.Where(x => x.Fecha == d.Key).DefaultIfEmpty(new DiaCupo { CantidadCuposDevueltos = 0 }).Sum(x => x.CantidadCuposDevueltos)</td>
                            }

                        </tr>
                        @*Solicitudes*@
                        <tr class="ColorBackgroundTr">
                            <td style="text-align: initial">
                                <strong>
                                    <span style="cursor: pointer" data-toggle="tooltip" data-placement="bottom" title="">Solicitudes</span>
                                    <i class="fa fa-chevron-right" style="font-size: 11px" aria-hidden="true"></i>
                                </strong>
                            </td>
                            @foreach (var d in m.GroupBy(x => x.Fecha))
                            {
                                <td></td>
                            }
                        </tr>

                        @*Del Algoritmo pendientes*@
                        <tr>
                            <td style="text-align: end"><span style="cursor: pointer" data-toggle="tooltip" data-placement="bottom" title="Solicitudes realizadas por el comercial dentro del algoritmo que se encuentran pendientes">Pendientes (Algoritmo)</span></td>
                            @foreach (var d in m.GroupBy(x => x.Fecha))
                            {
                                <td>@m.Where(x => x.Fecha == d.Key).DefaultIfEmpty(new DiaCupo { CantidadSolicitudesPendientes = 0 }).Sum(x => x.CantidadSolicitudesPendientes)</td>
                            }

                        </tr>
                        @*Extraordinarias pendientes*@
                        <tr>
                            <td style="text-align: end"><span style="cursor: pointer" data-toggle="tooltip" data-placement="bottom" title="Solicitudes realizadas de forma extraordinaria que se encuentran pendientes">Pendientes (Extraordinarias)</span></td>
                            @foreach (var d in m.GroupBy(x => x.Fecha))
                            {
                                <td>@m.Where(x => x.Fecha == d.Key).DefaultIfEmpty(new DiaCupo { CantidadSolicitudesPendientesExtra = 0 }).Sum(x => x.CantidadSolicitudesPendientesExtra)</td>
                            }

                        </tr>
                        @*Aceptadas*@
                        <tr>
                            <td style="text-align: end"> <span style="cursor: pointer" data-toggle="tooltip" data-placement="bottom" title="Cantidad de solicitudes aceptadas realizadas desde el algoritmo o de forma extraordinaria">Aceptadas (Algoritmo y Extraordinarias)</span></td>
                            @foreach (var d in m.GroupBy(x => x.Fecha))
                            {
                                <td>@m.Where(x => x.Fecha == d.Key).DefaultIfEmpty(new DiaCupo { CantidadSolicitudesAceptadas = 0 }).Sum(x => x.CantidadSolicitudesAceptadas)</td>
                            }

                        </tr>
                        @*Cupos No Tomados*@
                        <tr class="ColorBackgroundTr">
                            <td style="text-align: initial">
                                <strong><span style="cursor: pointer" data-toggle="tooltip" data-placement="bottom" title="Es la cantidad de cupos libres y se calcula en base al total de la planta menos todos los cupos consumidos">Cupos No Tomados</span></strong>
                                <i class="fa fa-chevron-right" style="font-size: 11px" aria-hidden="true"></i>
                            </td>
                            @foreach (var d in m.GroupBy(x => x.Fecha))
                            {
                                <td>@m.Where(x => x.Fecha == d.Key).DefaultIfEmpty(new DiaCupo { CantidadCuposLibres = 0 }).Sum(x => x.CantidadCuposLibres)</td>
                            }

                        </tr>
                    </tbody>
                </table>
            </div>
            <br />
            <div id="@(m.Key.Replace(" ","") + "panel")" class="table-editable table-responsive">
                <table class="table table-bordered table-responsive-md table-striped text-center tabla" id="@(m.Key.Replace(" ","") + "tablaComercial")">
                    <caption style="padding: 10px;border: 1px solid #dddddd;"><strong>Sugerencias Pendientes</strong></caption>
                    <thead>
                        @{
                            var dias = noAceptadas.Where(x => x.Material.Replace(" ", "") == m.Key.Replace(" ", "")).SelectMany(x => x.Diacupo.Select(y => y.Fecha)).Distinct().OrderBy(x => x).ToList();
                        }
                        <tr>
                            <th style="width: 25%"></th>
                            @foreach (var r in dias)
                            {
                                var fecha = r.ToString("dd/MM/yyyy");
                                <th class="text-center">
                                    <span>@fecha</span>
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>

                        @foreach (var c in noAceptadas.Where(x => x.Material.Replace(" ", "") == m.Key.Replace(" ", "")).ToList())
                        {
                            <tr>
                                <td>@c.NombreComercial</td>
                                @foreach (var d in dias)
                                {
                                    <td>@c.Diacupo.Where(x => x.Fecha == d).DefaultIfEmpty(new DiaCupo { Cantidad = 0 }).Sum(x => x.Cantidad)</td>
                                }

                            </tr>
                        }
                        <tr>
                            <td><strong>Total</strong></td>

                            @foreach (var d in dias)
                            {
                                <td>@noAceptadas.Where(x => x.Material.Replace(" ", "") == m.Key.Replace(" ", "")).SelectMany(x => x.Diacupo).Where(x => x.Fecha == d).DefaultIfEmpty(new DiaCupo { Cantidad = 0 }).Sum(x => x.Cantidad)</td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>

        </div>
    }
</div>

<style>
    .ColorBackgroundTr {
        color: white;
        background-color: seagreen;
    }

    .ColorBackgroundThead {
        color: white;
        background-color: gray;
    }
</style>
