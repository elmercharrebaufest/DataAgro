@model WebDataAgro.Models.ConfiguracionCupoModel
@using Molinos.DataAgro.Entities.Dto
@{
    ViewBag.Title = "Panel de Cupos";
    var panel = (List<DiaCupo>)ViewBag.Panel;
    var noAceptadas = (List<SugerenciaNoAceptada>)ViewBag.SugerenciasNoAceptadas;
    var fechas = (List<DateTime>)ViewBag.Fechas;
    var activo = panel.FirstOrDefault() != null ? panel.FirstOrDefault().Material.Replace(" ", "") : "";

}

@section Styles {
    <link href="~/Content/bootstrap-toggle.min.css" rel="stylesheet" />
    <link href="~/Content/compraNet.css" rel="stylesheet" />
}
<style>
    .tipoExtraordinario {
        background-color: #bde6b5;
    }
</style>

<script src="~/Scripts/KendoExtensions.js"></script>
<script src="~/Scripts/App/AdministracionCupoGrilla.js"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
<script src="~/Scripts/bootstrap-toggle.min.js"></script>
<script>
    $(document).ready(function () {
        pantalla = true;
    });
</script>

<ul class="nav nav-tabs" id="myTab">
    <li class="active"><a data-target="#payment" data-toggle="tab">Panel Cupos</a></li>
    <li><a data-target="#method" data-toggle="tab">Solicitud de Cupos</a></li>

    <div class="row-fluid">
        <div class="col-md-offset-10">
            <button style="background: #1C7CD5 0% 0% no-repeat padding-box; border-radius: 4px !important; opacity: 1; color: white; height: 34px;" onclick="Recargar()">Recargar grilla</button>
            <label>Autorecargar</label>
            <input id="checkRecarga" class="campo-input-input" data-bind="" type="checkbox" />
        </div>
    </div>
</ul>
<div class="row-fluid" style="margin-left: 10px; margin-right: 10px;">
    <div class="tab-content">
        <div class="tab-pane" id="method">
            <div class="row alinear-derecha">
                <div class="col-xs-12 col-md-1 col-sm-4" style="margin-left: 15px; margin-right: -32px;">
                    <div id="finalizarVariosDiv" data-toggle="tooltip" onclick="AbrilConfirmarModalMasivo()">
                        <span class="botonVarios">
                            <i class="fa fa-check" aria-hidden="true"></i>
                        </span>
                        <span>Aceptar</span>
                    </div>
                </div>
                <div class="col-xs-12 col-md-2 col-sm-4 alinear-derecha">
                    <div id="finalizarVariosDiv" data-toggle="tooltip" onclick="AbrilModalMasivo()">
                        <span class="botonVarios">
                            <i class="fa  fa-trash" aria-hidden="true"></i>
                        </span>
                        <span>Rechazar</span>
                    </div>
                </div>
            </div>
            <div class="row-fluid" id="Tabla">
                <div class="col-xs-12">
                    <div id="gridInformeCompraNet" class="table-responsive"></div>
                    <input id="CantidadDeCupoAceptado" type="hidden" />
                    <input id="CantidadCupoFleteAceptado" type="hidden" />
                    <input id="CantidadDeCupoFleteOriginal" type="hidden" />
                    <input id="CantidadDeCupoOriginal" type="hidden" />
                </div>
            </div>
        </div>
        <div class="tab-pane active" id="payment">
            <div id="panel">
                @Html.Partial("PartialPanel")
            </div>

        </div>
    </div>
</div>


<div class="modal fade" id="resultadoCupo" tabindex="-1" role="dialog" aria-labelledby="resultadoCupoLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content" style="width:65%">
            <div class="modal-header">
                <button type="button" class="cerrar close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h1 class="modal-title" id="resultadoCupo"></h1>
                <div class="status confirmado-modal">
                    <div>Cupos Creados</div>
                </div>
            </div>
            <div class="modal-body">
                <div id="error-modal" hidden></div>
                <div id="cupos-generados-modal" style="text-align:center"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn k-button" data-dismiss="modal" onclick="recargarAceptar()">Aceptar</button>
                <button type="button" class="btn k-button" onclick="copiarGenerados()"><i class="fa fa-copy"></i> Copiar</button>
            </div>
        </div>
    </div>
</div>
@*Modal Aceptar*@
@Html.Partial("ModalAceptarSolicitud")

@*Modal Aceptar Masivo*@
@Html.Partial("ModalAceptarSolicitudMasivo")

@*Modal Rechazar*@
@Html.Partial("ModalRechazarSolicitud")
@*Modal Rechazar Masivo*@
@Html.Partial("ModalRechazarSolicitudMasivo")
<style>
    #gridInformeCompraNet td {
        text-align: center !important;
    }

    .modal-content {
        padding: 7px 16px 52px 15px !important;
    }

    .popover-content {
        color: dimgray;
        font-size: 9px !important;
        font-family: "Helvetica Neue","Helvetica","Arial","sans-serif" !important;
    }

    #finalizarVariosDiv {
        width: 130px
    }
</style>


