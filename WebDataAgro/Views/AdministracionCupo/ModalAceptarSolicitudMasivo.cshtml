@{
    Layout = null;
}

@*<link href="~/Content/bootstrap-toggle.min.css" rel="stylesheet" />
    <link href="~/Content/compraNet.css" rel="stylesheet" />*@

<div class="modal fade" id="modalAceptarSolicitudMasivo" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header ">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span><span class="sr-only">Close</span></button>
            </div>
            <div class="campo clearfix">
                <div class="espaciolineas">¿Está seguro de que desea confirmar esta solicitud?</div>
            </div>
            <div id="div-motivo-rechazoSolictud"><label><b>Motivo:&nbsp;</b></label><input class="form-control" id="motivo-confirmarSolictudMasivo"></div>
            <div id="solicitudId" hidden></div>
            <br />
            <div class="col-xs-6 noPaddingRight">
                <button type="button" id="aceptar" class="myBtn btnSubmit" onclick="AceptarMasivo()" data-dismiss="modal">Si</button>
            </div>
            <div class="col-xs-6 noPaddingRight">
                <button type="button" id="cancelarRechazar" class="myBtn" data-dismiss="modal">No</button>
            </div>
        </div>
    </div>
</div>

<style>
    .modal-content {
        padding: 12px 17px 55px 15px !important;
    }

    #aceptar, #cancelarRechazar {
        width: 100%
    }
</style>