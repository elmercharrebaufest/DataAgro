@{
    //Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Reporte de cupos";
}

@section Scripts {
    @Scripts.Render("~/bundles/ReporteCupo")
}

@section Styles {
    <link href="~/Content/ReporteCupo.css" rel="stylesheet" />
}
@{  
    var externo = PermisosHelper.Is(PermisosDataAgro.IngresoExterno);   
}
<script>
   
    externo = '@externo';
    
</script>
<div class="Titulo">
    <h5>Reporte de Cupos</h5>
</div>

<div class="filtro-desplegable" data-toggle="collapse" data-target="#filtrar" onclick="mostrarocultar('#mostrar')">
    <div class="k-button"><span class="filtro">Filtro</span> <strong><span id="mostrar" class="mostrar" style="font-size: 12px !important;">Mostrar</span></strong></div>
</div>




<div id="filtrar" class="container collapse">
    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Fecha de Ingreso</label>
        </div>
        <div class="col-md-2">
            <span id="fechaIngresoDesde">
                <input id="fechaIngresoDesdeId" class="filtroFecha" name="FechaIngreso-desde" type="date" style="width: 100%" />
            </span>
        </div>
        <div class="col-md-2">
            <span id="fechaIngresoHasta">
                <input id="fechaIngresoHastaId" class="filtroFecha" name="FechaIngreso-hasta" type="date" style="width: 100%" />
            </span>
        </div>

        <div class="col-md-2">
            <label>Fecha de Registro</label>
        </div>
        <div class="col-md-2">
            <span id="fechaGeneracionDesde">
                <input id="fechaGeneracionDesdeId" class="filtroFecha" name="FechaRegistro-desde" type="date" style="width: 100%" />
            </span>
        </div>
        <div class="col-md-2">
            <span id="fechaGeneracionHasta">
                <input id="fechaGeneracionHastaId" class="filtroFecha" name="FechaRegistro-hasta" type="date" style="width: 100%" />
            </span>
        </div>

    </div>
    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Proveedor</label>
        </div>
        <div class="col-md-4">
            <input id="buscadorProveedor" name="ProveedorId" class="multiselect" style="width:100%" type="text" placeholder="Buscar por CUIT, razón social" required="required" />
        </div>

        <div class="col-md-2">
            <label>Zona</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownList("ZonaCupoId", new SelectList(ViewBag.Zona, "Value", "Text"), "Seleccione el Zona", new { @class = "form-control filtroBusquedaPorId", @id = "ZonaId" })
        </div>
    </div>
    <br />

    <div class="row">
        <div class="col-md-2">
            <label>Material</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownList("MaterialId", new SelectList(ViewBag.Material, "Value", "Text"), "Seleccione el Material", new { @class = "form-control filtroBusquedaPorId", @id = "MaterialId" })
        </div>

        <div class="col-md-2">
            <label>Estado</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownList("EstadoCupoId", new SelectList(ViewBag.Estado, "Value", "Text"), "Seleccione el Estado", new { @class = "form-control filtroBusquedaPorId", @id = "EstadoId" })
        </div>

    </div>
    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Cupo SAP</label>
        </div>
        <div class="col-md-4">
            <div class="row">
                <div class="col-xs-9 noRightPadding">
                    @Html.TextBox("CupoSap", "", new { @class = "form-control filtroAgregarValorPopUp", style = "width:100%", @id = "ContratoSAPId" })
                </div>
                <div class="col-xs-2 noLeftPadding">
                    <button type="button" id="abrirPopUpCargarValores" class="k-button k-button-icontext fa fa-list" style="height:34px"></button>
                </div>
                <div class="modal fade" id="popUpCargarValores" tabindex="-1" role="dialog" aria-labelledby="CargaContratosLabel" aria-hidden="true">
                </div>
            </div>
        </div>


        <div class="col-md-2">
            <label>Destinatario</label>
        </div>
        <div class="col-md-4">
            @Html.TextBox("Destinatario", "", new { @class = "form-control filtroBusquedaTextBox", style = "width:100%", @id = "Destinatario" })
        </div>
    </div>
    <br />

    <div class="row">

        <div class="col-md-2">
            <label>Comercial</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownList("ComercialId", new SelectList(ViewBag.Comercial, "Value", "Text"), "Seleccione un Comercial", new { @class = "form-control filtroBusquedaPorId", @id = "ComercialId" })
        </div>


        <div class="col-md-2">
            <label>Planta</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownList("CentroId", new SelectList(ViewBag.Centro, "Value", "Text"), "Seleccione una Planta", new { @class = "form-control filtroBusquedaPorId", @id = "CentroId" })
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Flete</label>
        </div>
        <div class="col-md-4 filtroBoleano" id="FleteProcedenciaId" name="FleteProcedencia">
            Sí: @Html.RadioButton("FleteProcedencia", true, new { @class = "filtroBoleano", @id = "FleteProcedencia" })
            No: @Html.RadioButton("FleteProcedencia", false)
            <i class="fa fa-close" onclick="deseleccionarRadioButton()" style="margin-left:3%; font-size:20px;color:red"></i>
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-12" style="text-align:right">
            <button type="button" id="filtrar" class="k-button k-button-icontext sideMargin-15 limpiar" style="width: 14%" onclick="Filtrar()">Filtrar</button>
        </div>
    </div>

    <br />
</div>

<br />
<div>
    <div id="grid" class="table-responsive">
    </div>
</div>


