@{
    //Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Reporte de cupos";
}

@section Scripts {
    @Scripts.Render("~/bundles/ReporteCupo")
}

@section Styles {
    <link href="~/Content/ReporteCupo.css" rel="stylesheet" />
}
@{
    var externo = PermisosHelper.Is(PermisosDataAgro.IngresoExterno);
    var anulacion = PermisosHelper.Is(PermisosDataAgro.VisualizarAnulacionEnReporteCupo);
}
<script>

    externo = '@externo';
    anulacion = '@anulacion';

</script>
<div class="Titulo">
    <h5>Reporte de Cupos</h5>
</div>

<div class="filtro-desplegable" data-toggle="collapse" data-target="#filtrar" onclick="mostrarocultar('#mostrar')">
    <div class="k-button"><span class="filtro">Filtro</span> <strong><span id="mostrar" class="mostrar" style="font-size: 12px !important;">Mostrar</span></strong></div>
</div>

<div id="filtrar" class="container collapse">
    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Fecha de Ingreso</label>
        </div>
        <div class="col-md-2">
            <span id="fechaIngresoDesde">
                <input id="fechaIngresoDesdeId" class="filtroFecha ocultarAnular" name="FechaIngreso-desde" type="date" style="width: 100%" />
            </span>
        </div>
        <div class="col-md-2">
            <span id="fechaIngresoHasta">
                <input id="fechaIngresoHastaId" class="filtroFecha ocultarAnular" name="FechaIngreso-hasta" type="date" style="width: 100%" />
            </span>
        </div>

        <div class="col-md-2">
            <label>Fecha de Registro</label>
        </div>
        <div class="col-md-2">
            <span id="fechaGeneracionDesde">
                <input id="fechaGeneracionDesdeId" class="filtroFecha ocultarAnular" name="FechaRegistro-desde" type="date" style="width: 100%" />
            </span>
        </div>
        <div class="col-md-2">
            <span id="fechaGeneracionHasta">
                <input id="fechaGeneracionHastaId" class="filtroFecha ocultarAnular" name="FechaRegistro-hasta" type="date" style="width: 100%" />
            </span>
        </div>

    </div>
    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Proveedor</label>
        </div>
        <div class="col-md-4">
            <input id="buscadorProveedor" name="ProveedorId" class="multiselect ocultarAnular" style="width:100%" type="text" placeholder="Buscar por CUIT o razón social" required="required" />
        </div>

        <div class="col-md-2">
            <label>Zona</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownList("ZonaCupoId", new SelectList(ViewBag.Zona, "Value", "Text"), new { @class = "multiselect ocultarAnular", @id = "ZonaId" })
        </div>
    </div>
    <br />

    <div class="row">
        <div class="col-md-2">
            <label>Material</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownList("MaterialId", new SelectList(ViewBag.Material, "Value", "Text"), new { @class = "multiselect ocultarAnular", @id = "MaterialId" })
        </div>

        <div class="col-md-2">
            <label>Estado</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownList("EstadoCupoId", new SelectList(ViewBag.Estado, "Value", "Text"), new { @class = "multiselect ocultarAnular", @id = "EstadoId" })
        </div>

    </div>
    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Código de Cupo</label>
        </div>
        <div class="col-md-4">
            <div class="row">
                <div class="col-xs-9 noRightPadding">
                    @Html.TextBox("CupoSap", "", new { @class = "form-control filtroAgregarValorPopUp ocultarAnular", style = "width:100%", @id = "ContratoSAPId" })
                </div>
                <div class="col-xs-2 noLeftPadding">
                    <button type="button" id="abrirPopUpCargarValores" class="k-button k-button-icontext fa fa-list" style="height:34px"></button>
                </div>
                <div class="modal fade" id="popUpCargarValores" tabindex="-1" role="dialog" aria-labelledby="CargaContratosLabel" aria-hidden="true">
                </div>
            </div>
        </div>


        <div class="col-md-2">
            <label>Destinatario</label>
        </div>
        <div class="col-md-4">
            @Html.TextBox("Destinatario", "", new { @class = "form-control filtroBusquedaTextBox ocultarAnular", style = "width:100%", @id = "Destinatario" })
        </div>
    </div>
    <br />

    <div class="row">

        <div class="col-md-2">
            <label>Comercial</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownList("ComercialId", new SelectList(ViewBag.Comercial, "Value", "Text"), new { @class = "multiselect ocultarAnular", @id = "ComercialId" })
        </div>


        <div class="col-md-2">
            <label>Planta</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownList("CentroId", new SelectList(ViewBag.Centro, "Value", "Text"), new { @class = "multiselect ocultarAnular", @id = "CentroId" })
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Flete</label>
        </div>
        <div class="col-md-4 filtroBoleano" id="FleteProcedenciaId" name="FleteProcedencia">
            Sí: @Html.RadioButton("FleteProcedencia", true, new { @class = "filtroBoleano ocultarAnular", @id = "FleteProcedencia" })
            No: @Html.RadioButton("FleteProcedencia", false, new { @class = "ocultarAnular" })
            <i class="fa fa-close ocultarAnular" onclick="deseleccionarRadioButton()" style="margin-left:3%; font-size:20px;color:red"></i>
        </div>

        <div class="col-md-2">
            <label>Soja Sustentable</label>
        </div>
        <div class="col-md-4 filtroBoleano" id="SustentableId" name="Sustentable">
            Sí: @Html.RadioButton("Sustentable", true, new { @class = "filtroBoleano ocultarAnular", @id = "Sustentable" })
            No: @Html.RadioButton("Sustentable", false, new { @class = "ocultarAnular" })
            <i class="fa fa-close ocultarAnular" onclick="deseleccionarRadioButtonSustentable()" style="margin-left:3%; font-size:20px;color:red"></i>
        </div>
    </div>
    <br />

    <div class="row">
        <div class="col-md-2">
            <label>Con Descarga</label>
        </div>
        <div class="col-md-4 filtroBoleano" id="ConDescargaId" name="ConDescarga">
            Sí: @Html.RadioButton("ConDescarga", true, new { @class = "filtroBoleano ocultarAnular", @id = "ConDescarga" })
            No: @Html.RadioButton("ConDescarga", false, new { @class = "ocultarAnular" })
            <i class="fa fa-close ocultarAnular" onclick="deseleccionarRadioButtonConDescarga()" style="margin-left:3%; font-size:20px;color:red"></i>
        </div>

        <div class="col-md-2">
            <label>Soja EPA</label>
        </div>
        <div class="col-md-4 filtroBoleano" id="EPAId" name="EPA">
            Sí: @Html.RadioButton("EPA", true, new { @class = "filtroBoleano ocultarAnular", @id = "EPA" })
            No: @Html.RadioButton("EPA", false, new { @class = "ocultarAnular" })
            <i class="fa fa-close ocultarAnular" onclick="deseleccionarRadioButtonEPA()" style="margin-left:3%; font-size:20px;color:red"></i>
        </div>
    </div>

    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Cumplimiento</label>
        </div>
        <div class="col-md-4 filtroBoleano" id="CumplimientoId" name="Cumplimietno">
            Sí: @Html.RadioButton("Cumplimiento", true, new { @class = "filtroBoleano ocultarAnular", @id = "Cumplimiento" })
            No: @Html.RadioButton("Cumplimiento", false, new { @class = "ocultarAnular" })
            <i class="fa fa-close ocultarAnular" onclick="deseleccionarRadioButtonCumplimiento()" style="margin-left:3%; font-size:20px;color:red"></i>
        </div>

        <div class="col-md-2">
            <label>Soja EUDR</label>
        </div>
        <div class="col-md-4 filtroBoleano" id="EUDRId" name="EUDR">
            Sí: @Html.RadioButton("EUDR", true, new { @class = "filtroBoleano ocultarAnular", @id = "EUDR" })
            No: @Html.RadioButton("EUDR", false, new { @class = "ocultarAnular" })
            <i class="fa fa-close ocultarAnular" onclick="deseleccionarRadioButtonEUDR()" style="margin-left:3%; font-size:20px;color:red"></i>
        </div>
    </div>
    <br />

    @*<div class="row">
            <div class="col-md-12" style="text-align:right">
                <button type="button" id="filtrar" class="k-button k-button-icontext sideMargin-15 limpiar" style="width: 14%" onclick="Filtrar()">Filtrar</button>
            </div>
        </div>*@
    <div class="row">

        <div class="col-md-4">
            <span>Elementos por página</span>
        </div>
        <div class="col-md-2">
            <select id="pageSize" onchange="setPageSize()">
                <option value="20" selected>20</option>
                <option value="50">50</option>
                <option value="100">100</option>
                <option value="300">300</option>
                <option value="all">Todos</option>
            </select>
        </div>
        <div class="col-md-2"></div>
        <div class="col-md-2" style="text-align:right">
            <button type="button" id="filtrar" class="k-button k-button-icontext sideMargin-15 limpiar" style="width: 100%" onclick="Filtrar()">Filtrar</button>
        </div>
        <div class="col-md-2" style="text-align:right" hidden id="anulacionMasivaDiv">
            <button type="button" id="anulacionMasiva" class="k-button k-button-icontext sideMargin-15 limpiar" onclick="AnulacionMasiva()">Anulación Masiva</button>
        </div>
    </div>

    <br />
</div>

<br />
<!--Fin Filtrar-->

<div class="row">
    <div id="grid" class="table-responsive col-md-12">
    </div>
</div>



<div class="modal fade" id="modalConfirmarAnulacion" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header ">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span><span class="sr-only">Close</span></button>
                <h1 class="modal-title-confirmadoTilde" id="lineModalLabel"></h1>
                <div class="status confirmado-modal">
                    <div> Anulación Masiva</div>
                </div>
            </div>
            <div class="modal-body clearfix ">
                <div class="col-xs-12 noPadding">
                    <div id="mensajeModalConTilde"></div>
                    <div class="col-xs-12"> Se anularán los siguientes cupos: </div>
                    <div class="col-xs-12 noPadding" id="cuposSeleccionados"></div>
                    <div id="gridNoEliminar"></div>
                </div>
            </div>
            <br />
            <input type="hidden" id="contratoModalConTilde" />
            <input type="hidden" id="tipoNegocioModalConTilde" />
            <div class="modal-footer clearfix ">
                <div class="col-xs-2"></div>
                <div class="col-xs-4 noPaddingLeft">
                    <span id="idBolsa"></span>
                    <button type="button" id="finalizarConfirmado" onclick="AnulacionMasivaConfirmacion()" class="k-button k-button-icontext sideMargin-15 limpiar" data-dismiss="modal">Confirmar</button>
                </div>
                <div class="col-xs-6 noPaddingRight">
                    <button type="button" data-dismiss="modal" class="k-button k-button-icontext sideMargin-15 limpiar">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
</div>
