@{
    ViewBag.Title = "Tareas Programadas";
}

@section Scripts {
    @Scripts.Render("~/bundles/AbmTareaProgramada")
}
<style>
    .k-icon.k-i-warning {
        display:none;
    }
</style>

<h3>Tareas Programadas</h3>
<br />
<div id="rootwizard">

    <div id="Abm">

        <ul>
            <li style="display:none"><a href="#tab1" data-toggle="tab"></a></li>
            <li style="display:none"><a href="#tab2" data-toggle="tab"></a></li>
        </ul>

        <div class="tab-content">

            <div class="tab-pane" id="tab1">

                <div class="row">
                    <div class="col-md-12">
                        <div id="gridIniRango" data-bind="source: Resultados" style="height:227px;"></div>
                    </div>
                </div>

                <br />

                <div class="row">
                    <div class="col-md-12">
                        <button id="butAgregar" class="k-button" type="button" data-role="button" data-bind="disabled: isAddNewDisabled">Agregar</button>
                        <button id="butEliminar" class="k-button" type="button" data-role="button" data-bind="disabled: isDeleteDisabled" style="margin-left:15px;">Eliminar</button>
                    </div>
                </div>

            </div>

            <div class="tab-pane" id="tab2">

                <div class="row">
                    <div class="col-md-2">
                        <label> Nombre </label>
                    </div>
                    <div class="col-md-4">
                        <input id="Name" type="text" class="k-textbox" data-bind="value: TareaProgramada.Name, disabled: isControlDisabled" style="width:100%" />
                        <img id="errPrecio" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-6">
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-2">
                        <label>Url de la acción</label>
                    </div>
                    <div class="col-md-4">
                        <input id="ActionURL" type="text" class="k-textbox" data-bind="value: TareaProgramada.ActionURL, disabled: isControlDisabled" placeholder="http://localhost:9000/TareasProgramadas/ejemplo" style="width:100%" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-2">
                        <label>Repetición en minutos</label>
                    </div>
                    <div class="col-md-4">
                        <input id="RepeticionEnMinutos" type="text" class="k-textbox" data-bind="value: TareaProgramada.RepeticionEnMinutos, disabled: isControlDisabled" style="width:100%" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-2">
                        <label>Fecha de inicio</label>
                    </div>
                    <div class="col-md-4">
                        <input id="Inicio" type="text" data-bind="value: TareaProgramada.Inicio, disabled: isControlDisabled" style="width:100%" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>
                <br />
                <div class="row">
                    <div class="col-md-12">
                        <button id="butAceptar" class="k-button" type="button" data-role="button">Aceptar</button>
                        <button id="butCancelar" class="k-button" type="button" data-role="button" style="margin-left:15px;">Cancelar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
