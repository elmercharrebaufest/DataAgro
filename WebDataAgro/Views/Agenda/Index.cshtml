
@{
    ViewBag.Title = "Agenda";
}


@section Scripts {
    @Scripts.Render("~/bundles/Agenda")
}

<link rel="stylesheet" href="~/Content/home.css" />
<script type="text/javascript" src="~/Scripts/App/Agenda.js"></script>

    <div id="Agenda">      

        <div class="tab-content">            

                <h2>Agenda de Actividades</h2>
                <br />

                <div class="row">
                    <div class="col-md-2">
                        <label>Detalle Actividad</label>
                    </div>
                    <div class="col-md-4">
                        <input id="ParamDetalle" type="text" class="k-textbox" data-bind="value: Parametros.ActividadDetalle" maxlength="20" style="max-width:311px" />
                        <img id="errParamDetalle" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-2">
                        <label>Tipo de Actividad</label>
                    </div>
                    <div class="col-md-4">
                        <input id="TiposActividades" type="text" class="k-combobox" data-bind="source: TipoActividadCombo ,value: Parametros.TipoActividadId" style="max-width:311px" />
                        <img id="errParamTipoActividad" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-2">
                        <label>Proveedor</label>
                    </div>
                    <div class="col-md-4">
                        <input id="Proveedores" type="text" class="k-combobox" data-bind="source: ProveedorCombo ,value: Parametros.ProveedorId" style="max-width:311px" />
                        <img id="errParamProveedor" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>

            <div class="row">
                <div class="col-md-2">
                    <label>Fecha de Recordatorio:</label>
                </div>
                <div class="col-md-4">                  
                </div>
                <div class="col-md-6">
                </div>
            </div>         

            <div class="row">
                <div class="col-md-2">
                    <label>Desde</label>
                </div>
                <div class="col-md-3">                  
                    <input id="fechaDesde" type="date" data-bind="value: Parametros.FechaDesde"/>
                </div>               
           </div>

            <div class="row">
                <div class="col-md-2">
                    <label>Hasta</label>
                </div>
                <div class="col-md-3">              
                    <input id="fechaHasta" type="date" data-bind="value: Parametros.FechaHasta" />
                </div>
            </div>

                <br />
                <div class="row">
                    <div class="col-md-6 botones-agenda">
                        <button id="butCancelar" class="k-button" type="button" data-role="button">Cancelar</button>
                        <button id="butPrevia" class="k-button" type="button" data-role="button" style="margin-left:15px;">Vista Previa</button>
                        <button id="butExport" class="k-button" type="button" data-role="button" style="margin-left:15px;">Exportar a PDF</button>                        
                    </div>
                </div>

            </div>
    </div>
    <div class="resultado-reporteagenda">
        <div id="grid" class="tabla-result">
            <!--<div class="cabeceras-tabla">
            <div class="cabecera id">
                Id
            </div>
            <div class="cabecera cuit">
