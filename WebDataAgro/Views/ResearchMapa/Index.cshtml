
@{
    ViewBag.Title = "Mapa Research";
}

@section Styles {
    <link href="~/Content/ResearchMapa.css" rel="stylesheet" />
}

@section Scripts{
    @Scripts.Render("~/bundles/ResearchMapa");

    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.3.1/dist/leaflet.css" integrity="sha512-Rksm5RenBEKSKFjgI3a41vrjkw4EVPlJ3+OiI65vTjIdo9brlAacEuKOiQ5OFh7cOI1bkDwLqdLw3Zg0cRJAAQ==" crossorigin="" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.3.0/dist/MarkerCluster.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.3.0/dist/MarkerCluster.Default.css" />

    <script src="https://unpkg.com/leaflet@1.3.1/dist/leaflet.js" integrity="sha512-/Nsx9X4HebavoBvEBuyp3I7od5tA0UzAxs+j83KgC8PU0kgB4XiK4Lfe4y4cgBtaRJQEIFCW+oC506aPT2L1zw==" crossorigin=""></script>
    <script src="https://unpkg.com/leaflet.markercluster@1.3.0/dist/leaflet.markercluster.js"></script>

    <link rel="stylesheet" href="https://unpkg.com/photoswipe@5.4.2/dist/photoswipe.css">

    <script src="~/Scripts/App/ResearchMapa.js" type="module"></script>
}

<h2>Mapa Research</h2>

<div class="container">
    <div id="filter-panel" class="leaflet-control">
        <button id="filter-button">Filtros</button>
        <div id="filter-form" style="display: none;">
            <!-- Aquí puedes agregar tus filtros -->
            <label for="marker-filter">Material:</label>
            <select id="grano-filter">
                <option value="Todos">Todos</option>
                <option value="Soja">Soja</option>
                <option value="Maiz">Maiz</option>
                <option value="Trigo">Trigo</option>
                <option value="Girasol">Girasol</option>
            </select>
            <label for="marker-filter">Campaña:</label>
            <select id="grano-filter">
                <option value="Todos">Todos</option>
                <option value="Soja">Soja</option>
                <option value="Maiz">Maiz</option>
                <option value="Trigo">Trigo</option>
                <option value="Girasol">Girasol</option>
            </select>
        </div>
    </div>
    <div id="map"></div>
    <div name="info-carousel" id="info-carousel" class="leaflet-popup-content"></div>
</div>