@{
    ViewBag.Title = "Manuales Originación";
}

<link href="~/Content/FAQ.css" rel="stylesheet" type="text/css" />

@section Scripts {
    @Scripts.Render("~/bundles/FAQ")
    <script src="~/Scripts/html2canvas.js"></script>
}

@section Styles {
    <link href="~/Content/compraNet.css" rel="stylesheet" />
}

<div id="divFAQ">
    <h3 class="centrarFAQ">Manuales de Originación</h3>
    <br />
    <div class="col-xs-12 col-sm-12 col-md-12 centrarFAQ">
        <div class="input">
            <input type="text" id="myInput" onkeyup="myFunction()" placeholder="Buscar..">
        </div>
    </div>
    <br />
    <div class="contenedorManuales"></div>

    @Html.Partial("~/Views/Shared/_PleaseWait.cshtml")
</div>

<!-- Modal Cupos con Descarga -->
@Html.Partial("_ModalEnviarSugerencia")