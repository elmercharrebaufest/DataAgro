@{
    Layout = null;
}
<div class="modal fade" id="modalEnviarSugerencia" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true" data-backdrop="static" data-keyboard="false">
    <div class="modal-dialog con-descarga" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title" id="CargaCupos"></h1>
                <div class="status confirmado-modal">
                    <div>Sugerencia de Manual</div>
                </div>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <p>Manual: <span id="nombreManual"></span></p>
                    <span>Sugerencia:</span>
                    <textarea id="sugerenciaManual" name="sugerencia" placeholder="Escribe tu sugerencia aquí..." rows="4" cols="50" style="resize: none;"></textarea>
                </div>
            </div>
            <br>
            <div class="modal-footer">
                <button type="button" class="myBtn btn aceptar" id="aceptar" onclick="enviarSugerencia()">Guardar</button>
                <button type="button" class="myBtn btn cancelar" id="cancelar-carga" onclick="cancelarCuposConDescarga()">Cancelar</button>
            </div>
        </div>
    </div>
</div>