@model WebDataAgro.Models.HedgeModel

<div id="modalCierreDia" class="modal fade" role="dialog">
    <div class="modal-dialog">

        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Cierre del Día</h4>
            </div>
            <div class="modal-body">
                <p id="cierreDelDia"> </p>
                <div id="ObservacionesDiv">
                    Observaciones
                    @Html.TextArea("cierreDelDiaObservaciones", new { @class = "k-textbox" })
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="formulario-footer-cancelar k-button k-button-icontext" onclick="cierreDelDiaClick();" id="fin-dia-con-mail">Aceptar</button>
                @Html.ActionLink("Cerrar sin enviar", "CerrarDia", "Hedge", new { mail = false }, new { @class = "formulario-footer-cancelar k-button k-button-icontext", @id = "fin-dia-sin-mail" })
                <button type="button" class="formulario-footer-cancelar k-button k-button-icontext" data-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>