@model WebDataAgro.Models.HedgeModel
@{
    ViewBag.Title = "Hedge";
}

@section Styles {
    <link href="~/Content/compraNet.css" rel="stylesheet" />
    <link href="~/Content/hedge.css" rel="stylesheet" />
}
@section Scripts{
    <script type="text/javascript" src="~/Scripts/App/hedge.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
    <script>diaCerrado = '@ViewBag.DiaCerrado';</script>
}


<div class="container">
    <div class="row bordertopbottom">
        <div class="col-xs-4 wizard-header-group" id="HedgeMaterialTab">
            <div class="wizard-header-contenedor whc-selected">
                Hedge Material
            </div>
        </div>
        <div class="col-xs-4 wizard-header-group" id="ObjetivosTab">
            <div class="wizard-header-contenedor">
                Carga Objetivos
            </div>
        </div>
        <div class="col-xs-4 wizard-header-group" id="HedgeTCTab">
            <div class="wizard-header-contenedor">
                Hedge TC
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div id="hedgeMaterial">
        @Html.Action("HedgeMaterialPartial", "Hedge", new { hedgeMaterial = Model })
    </div>

    <div id="objetivos" hidden>
        @Html.Action("HedgeObjetivoPartial", "Hedge", new { hedgeMaterial = Model })
    </div>
    <div id="hedgeTC" hidden>
        @Html.Action("HedgeTCPartial", "Hedge", new { hedgeMaterial = Model })
    </div>
    <div class="row">
        <div class="text-right pd-r">
            @Html.ActionLink("Cerrar Día", "CerrarDia", "Hedge", null, new { @class = "formulario-footer-cancelar k-button k-button-icontext", @id = "fin-dia" })
            @Html.ActionLink("Reabrir Día", "ReabrirDia", "Hedge", null, new { @class = "formulario-footer-cancelar k-button k-button-icontext", @id = "reabrir-dia" })
        </div>
    </div>
</div>