@model WebDataAgro.Models.HedgeModel
@{
    ViewBag.Title = "Hedge";
}

@section Styles {
    <link href="~/Content/compraNet.css" rel="stylesheet" />
    <link href="~/Content/hedge.css" rel="stylesheet" />
}
@section Scripts{
    <script type="text/javascript" src="~/Scripts/App/hedge.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
    <script>

    diaCerrado = '@ViewBag.DiaCerrado';
    diferencial = '@ViewBag.Diferencial';</script>
}

<div class="container">
    <div class="row bordertopbottom">
        <div class="col-xs-3 wizard-header-group" id="HedgeMaterialTab">
            <div class="wizard-header-contenedor whc-selected">
                Hedge Material
            </div>
        </div>
        <div class="col-xs-3 wizard-header-group" id="ObjetivosTab">
            <div class="wizard-header-contenedor">
                Carga Objetivos
            </div>
        </div>
        <div class="col-xs-3 wizard-header-group" id="HedgeTCTab">
            <div class="wizard-header-contenedor">
                Hedge TC
            </div>
        </div>
        <div class="col-xs-3 wizard-header-group" id="MargenMoliendaTab">
            <div class="wizard-header-contenedor">
                Margen de Molienda - GCM
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div id="hedgeMaterial">
        @Html.Action("HedgeMaterialPartial", "Hedge", new { hedgeMaterial = Model })
    </div>

    <div id="objetivos" hidden>
        @Html.Action("HedgeObjetivoPartial", "Hedge", new { hedgeMaterial = Model })
    </div>

    <div id="hedgeTC" hidden>
        @Html.Action("HedgeTCPartial", "Hedge", new { hedgeMaterial = Model })
    </div>

    <div id="margenMolienda" hidden>
        @Html.Action("HedgeMargenMoliendaPartial", "Hedge", new { hedgeMaterial = Model })
    </div>

    <div class="row">
        <div class="text-right pd-r">
            <a id="reabrir-dia" onclick="ShowModal()" class="formulario-footer-cancelar k-button k-button-icontext">Reabrir Día</a>
            @*<a id="diferencial-dia" onclick="ShowModal()">Diferencial</a>*@
            <a id="fin-dia" class="formulario-footer-cancelar k-button k-button-icontext" onclick="ShowCerrarDia()">Cerrar Día</a>
        </div>
    </div>
</div>

@Html.Partial("ModalDiferencial")
@Html.Partial("ModalCierreDia")