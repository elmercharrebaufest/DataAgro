@model WebDataAgro.Models.HedgeModel
<script>
    matLen = @Model.HedgeMaterial.Count;
</script>
<div class="container">
    @using (Ajax.BeginForm("GrabarHedgeMaterial", null, new AjaxOptions { UpdateTargetId = "hedgeMaterial", InsertionMode = InsertionMode.Replace, OnSuccess = "materialInput" }, new { }))
    {

        @Html.AntiForgeryToken();
        <div id="formularioHedgeMaterial" class="table-container">
            @if (Model.Resultado.HayError)
            {
                if (Model.Resultado.Errores[0].ErrorCode != 200)
                {
                    <div class="alert alert-danger alert-dismissible" role="alert">
                        <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                        @Model.Resultado.Errores[0]
                    </div>
                }
                else
                {
                    <div class="alert alert-success alert-dismissible" role="alert">
                        <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                        @Model.Resultado.Errores[0]
                    </div>
                }
            }
            <table id="tabla-mat" class="table table-bordered">
                <thead>
                    <tr>
                        <th></th>
                        <th>Disponible</th>
                        <th>Forward</th>
                        <th>New Crop</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.HedgeMaterial.Count; i++)
                    {
                        <tr>
                            <th>
                                @Html.DisplayFor(model => Model.HedgeMaterial[i].MaterialDescripcion)
                                @Html.HiddenFor(model => Model.HedgeMaterial[i].MaterialId)
                            </th>
                            <td class="td-input">
                                @Html.TextBoxFor(model => Model.HedgeMaterial[i].Disponible, new { @class = "number-input number-input-material", @id = "disponible" + i })
                            </td>
                            <td class="td-input">
                                @Html.TextBoxFor(model => Model.HedgeMaterial[i].Forward, new { @class = "number-input number-input-material", @id = "forward" + i })
                            </td>
                            <td class="td-input">
                                @Html.TextBoxFor(model => Model.HedgeMaterial[i].NewCrop, new { @class = "number-input number-input-material", @id = "new-crop" + i })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            <div id="row-botones-material">
                <input id="guardarHedgeMatBtn" type="submit" class="formulario-footer-guardar-contrato k-button k-button-icontext" value="Guardar" />
                @Ajax.ActionLink("Cancelar", "HedgeMaterialPartial", null, new AjaxOptions { UpdateTargetId = "hedgeMaterial", InsertionMode = InsertionMode.Replace, OnSuccess = "materialInput" }, new { @class = "formulario-footer-cancelar k-button k-button-icontext" })
            </div>
        </div>
        <div class="row">
            <div class="col-xs-8 m-grid-col-xs-offset-2">
                <div class="historial-desplegable" data-toggle="collapse" data-target="#historialMaterial" onclick="mostrarocultar('#mostrar-material')">
                    <span class="historial">Historial</span><span id="mostrar-material" class="mostrar-historial">Mostrar</span>
                </div>
                <div id="historialMaterial" class="collapse">
                    <table class="tabla-historial table">
                        <tr>
                            <th>Material</th>
                            <th>Tipo</th>
                            <th>Cantidad</th>
                            <th>Comercial</th>
                            <th>Hora</th>
                        </tr>
                        @foreach (var mat in Model.HistorialMaterial)
                        {
                            <tr>
                                <td>@Html.DisplayFor(model => mat.MaterialDesc)</td>
                                <td>@Html.DisplayFor(model => mat.TipoHedgeMaterialDesc)</td>
                                <td class="text-right">@Html.DisplayFor(model => mat.Cantidad)</td>
                                <td>@Html.DisplayFor(model => mat.Comercial)</td>
                                @{var fecha = mat.Fecha.ToShortTimeString();}
                                <td>@Html.DisplayFor(model => fecha)</td>
                            </tr>
                        }
                    </table>
                </div>
            </div>
        </div>
    }
</div>