@model WebDataAgro.Models.HedgeModel
<script>
    objLen = @Model.HedgeObjetivo.Count;
</script>

<div class="container">
    @using (Ajax.BeginForm("GrabarHedgeObjetivo", null, new AjaxOptions { UpdateTargetId = "objetivos", InsertionMode = InsertionMode.Replace, OnSuccess = "objetivoInput" }, new { }))
    {
      
        <div id="formularioObjetivo" class="table-container">
            @if (Model.Resultado.HayError)
            {
                if (Model.Resultado.Errores[0].ErrorCode != 200)
                {
                    <div class="alert alert-danger alert-dismissible" role="alert">
                        <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                        @Model.Resultado.Errores[0]
                    </div>
                }
                else
                {
                    <div class="alert alert-success alert-dismissible" role="alert">
                        <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                        @Model.Resultado.Errores[0]
                    </div>
                }
            }
            <table id="tabla-obj" class="table table-bordered">
                <thead>
                    <tr>
                        <th></th>
                        <th>Pricing</th>
                        <th>A Remitir</th>
                    </tr>
                </thead>
                <tbody>
                    @for (var i = 0; i < Model.HedgeObjetivo.Count; i++)
                    {
                        <tr>
                            <th>
                                @Html.DisplayFor(model => Model.HedgeObjetivo[i].MaterialDescripcion)
                                @Html.HiddenFor(model => Model.HedgeObjetivo[i].MaterialId)
                            </th>
                            <td>
                                @Html.TextBoxFor(model => Model.HedgeObjetivo[i].Pricing, new { @class = "number-input number-input-objetivo", @id = "pricing" + i })
                            </td>
                            <td>
                                @Html.TextBoxFor(model => Model.HedgeObjetivo[i].ARemitir, new { @class = "number-input number-input-objetivo", @id = "remitir" + i })
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div id="row-botones-objetivo">
                <input id="guardarHedgeObjBtn" type="submit" class="formulario-footer-guardar-contrato k-button k-button-icontext" value="Guardar" />
                @Ajax.ActionLink("Cancelar", "HedgeObjetivoPartial", null, new AjaxOptions { UpdateTargetId = "objetivos", InsertionMode = InsertionMode.Replace, OnSuccess = "objetivoInput" }, new { @class = "formulario-footer-cancelar k-button k-button-icontext" })
            </div>
        </div>
        <div class="row">
            <div class="col-xs-8 m-grid-col-xs-offset-2">
                <div class="historial-desplegable" data-toggle="collapse" data-target="#historialObjetivo" onclick="mostrarocultar('#mostrar-objetivo')">
                    <span class="historial">Historial</span><span id="mostrar-objetivo" class="mostrar-historial">Mostrar</span>
                </div>
                <div id="historialObjetivo" class="collapse">
                    <table class="tabla-historial table">
                        <tr>
                            <th>Material</th>
                            <th>Tipo</th>
                            <th>Cantidad</th>
                            <th>Comercial</th>
                            <th>Hora</th>
                        </tr>
                        @foreach (var mat in Model.HistorialObjetivo)
                        {
                            @Html.HiddenFor(model => mat.MaterialId)
                            @Html.HiddenFor(model => mat.TipoObjetivoId)
                            <tr>
                                <td>@Html.DisplayFor(model => mat.MaterialDesc)</td>
                                <td>@Html.DisplayFor(model => mat.TipoHedgeMaterialDesc)</td>
                                <td class="text-right">@Html.DisplayFor(model => mat.Cantidad)</td>
                                <td>@Html.DisplayFor(model => mat.Comercial)</td>
                                @{var fecha = mat.Fecha.ToShortTimeString();}
                                <td>@Html.DisplayFor(model => fecha)</td>
                            </tr>
                        }
                    </table>
                </div>
            </div>
        </div>

    }
</div>
