@using Molinos.DataAgro.Entities.Dto

@model List<BoletoCompraNetProvinciaDto>
@{
    var boletos = Model;
}

<script src="~/Scripts/App/HabilitacionBoleto.js"></script>
<div class="col-md-12">
    <table class="tabla-historial table">
        <thead>
            <tr>
                <th>Provincia</th>
                <th>Tipo de Boleto</th>
                <th>Acción</th>
            </tr>
        </thead>
        @{ var i = 0; }
        @foreach (var boleto in boletos)
        {
            <input name="BoletoCompraNetProvincia[@i].Id" value="@boleto.Id" hidden />
            <tr>
                <td>@boleto.ProvinciaNombre</td>
                <td>@boleto.BoletoDescripcion</td>
                <td>
                    <button class="btn-danger" id="eliminarBoletoProvincia" type="button" data-id="@boleto.Id" style="padding: 3px 15px;">
                        <i class="fa fa-trash" style="margin-right: 8px;"></i> Eliminar
                    </button>
                </td>
            </tr>
            i++;
        }
    </table>
</div>
