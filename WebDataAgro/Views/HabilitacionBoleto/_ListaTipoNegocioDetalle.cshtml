@using Molinos.DataAgro.Entities.Dto

@model List<TipoNegocioDetalleDto>
@{
    var habilitados = Model;
}

<script src="~/Scripts/App/HabilitacionBoleto.js"></script>
<div class="col-md-12">
    <table class="tabla-historial table">
        <thead>
            <tr>
                <th>Tipo</th>
                <th>Descripción</th>
                <th>Físico</th>
                <th>Carta Oferta</th>
                <th>Confirma</th>
                <th></th>
            </tr>
        </thead>
        @{var i = 0; }
        @foreach (var mat in habilitados)
        {
            <input name="TipoNegocioDetalles[@i].Id" value="@mat.Id" hidden />
            <tr>
                <td>@mat.TipoNegocioDescripcion</td>
                <td>@mat.Descripcion</td>
                <td>
                    <span>
                        <label class="content-input">
                            <input type="checkbox" class="check" name="TipoNegocioDetalles[@i].BoletoFisico" id="@("Fisico" + mat.Id)" @(mat.BoletoFisico ? "checked" : "") onchange="actualizarListado(@("Fisico" + mat.Id))">
                            <i></i>
                        </label>
                    </span>
                </td>
                <td>
                    <span>
                        <label class="content-input">
                            <input type="checkbox" class="check" name="TipoNegocioDetalles[@i].CartaOferta" id="@("Carta" + mat.Id)" @(mat.CartaOferta ? "checked" : "") onchange="actualizarListado(@("Carta" + mat.Id))">
                            <i></i>
                        </label>
                    </span>
                </td>
                <td>
                    <span>
                        <label class="content-input">
                            <input type="checkbox" class="check" name="TipoNegocioDetalles[@i].Confirma" id="@("Confirma" + mat.Id)" @(mat.Confirma ? "checked" : "") onchange="actualizarListado(@("Confirma" + mat.Id))">
                            <i></i>
                        </label>
                    </span>
                </td>
            </tr>
            i += 1;
        }
    </table>
</div>
<style>
    td, th {
        text-align: center !important;
    }

    i {
        margin-top: 6px;
    }

    .tableFixHead {
        overflow: auto;
        height: 500px;
    }

        .tableFixHead thead th {
            position: sticky;
            top: 0;
            z-index: 30;
        }

    table {
        border-collapse: collapse;
        width: 100%;
    }

    th, td {
        padding: 8px 16px;
    }

    th {
        background: #eee;
    }
</style>
