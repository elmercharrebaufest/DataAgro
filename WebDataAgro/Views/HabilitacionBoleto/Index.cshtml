@{
    ViewBag.Title = "Habilitación Boleto";
}
@section Styles {
    <link href="~/Content/ConfiguracionInterna.css" rel="stylesheet" />
    <link href="~/Content/cupo.css" rel="stylesheet" />
    <link href="~/Content/compraNet.css" rel="stylesheet" />
}
@section Scripts{
    <script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
}
@model WebDataAgro.Models.HabilitacionBoletoViewModel
<div style="padding: 22px;">
    <h3>Habilitación de Boletos</h3>
    <br />

    <div>
        <div id="TipoNegocioBoleto" class="btnagregar btnAzul widthButton" type="button">
            <i class="fa fa-plus"></i> Por Tipo de Negocio
        </div>
    </div>

    <div id="tipoNegocioDetalle" class="hidden">
        <div class="row">
            <div class="col-md-9"></div>
            <div class="col-md-2">
                <div style="width:fit-content">
                    <span class="btnVerde btn-block" type="button" onclick="AbrirModal()">
                        Agregar Tipo de Negocio
                    </span>
                </div>
            </div>
        </div>

        <div>
            @using (Ajax.BeginForm("ActualizarTipoNegocioDetalle", null, new AjaxOptions { UpdateTargetId = "listado", InsertionMode = InsertionMode.Replace }, new { @id = "actualizarListado" }))

            {
                <div id="listado" class="tableFixHead row">
                    @Html.Partial("_ListaTipoNegocioDetalle", Model.TipoNegocioDetalle)
                </div>
            }
        </div>
        <div id="modal-agregar">
            @Html.Partial("AgregarModal")
        </div>
    </div>
    <br />
    <div>
        <div id="BoletoProvincia" class="btnagregar btnAzul widthButton" type="button">
            <i class="fa fa-plus"></i> Por Provincia
        </div>
    </div>
    <div id="boletoCompraNetProvincia" class="hidden">
        <div class="row">
            <div class="col-md-9"></div>
            <div class="col-md-2">
                <div style="width:fit-content">
                    <span class="btnVerde btn-block" type="button" onclick="AbrirModalBoletoProvincia()">
                        Agregar Boleto
                    </span>
                </div>
            </div>
        </div>
        <div>
            @using (Ajax.BeginForm("ActualizarBoletoCompraNetProvincia", null, new AjaxOptions { UpdateTargetId = "listaBoletoProvincia", InsertionMode = InsertionMode.Replace }, new { @id = "actualizarBoletoProvincia" }))
            {
                <div id="listaBoletoProvincia" class="tableFixHead row">
                    @Html.Partial("_ListaBoletoCompraNetProvincia", Model.BoletoCompraNetProvincia)
                </div>
            }
        </div>

        <div id="modal-agregar-boleto">
            @Html.Partial("AgregarBoletoProvinciaModal")
        </div>
    </div>
</div>

<style>
    .btnVerde {
        background: #017940 !important;
        color: #fff;
        padding: 8px;
        border-radius: 5px !important;
        margin-bottom: 10px;
        width: 190px;
        text-align: center;
    }

    .hidden {
        display: none;
    }
</style>