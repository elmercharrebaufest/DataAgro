@model Molinos.DataAgro.Entities.Dto.DiferencialDto
<div class="container">
    @using (Ajax.BeginForm("GrabarDiferencial", null, new AjaxOptions { UpdateTargetId = "diferencialActual", InsertionMode = InsertionMode.Replace, OnSuccess = "desplegarHistorial" }, new { }))
    {

        <div id="formulariodiferencialActual" class="table-container">

            <table id="tabla-mat" class="table table-bordered">
                <thead>
                    <tr>
                        <th>Diferencial Activo</th>
                    </tr>
                </thead>
                <tbody>

                    <tr>
                        <td class="td-input">
                            @Html.TextBoxFor(model => Model.DiferencialDefault, new { @class = "number-input number-input-diferencial" })
                            @{ if (Model.Resultado!= null && Model.Resultado.Errores.Count != 0)
                                {
                                    @Model.Resultado.Errores[0];
                                }
                            }
                        </td>
                    </tr>

                </tbody>
            </table>
            <div id="row-botones-material">
                <input id="guardarDiferencialBtn" type="submit" class="formulario-footer-guardar-contrato k-button k-button-icontext" value="Guardar" />
            </div>
        </div>


        <div class="row">
            <div class="col-xs-8 m-grid-col-xs-offset-2">
                <div class="historial-desplegable" data-toggle="collapse" data-target="#historialMaterial" onclick="mostrarocultar('#mostrar-historial')">
                    <span class="historial">Historial</span><span id="mostrar-historial" class="mostrar-historial">Mostrar</span>
                </div>
                <div id="historialMaterial" class="collapse">
                    <table class="tabla-historial table">
                        <tr>
                            <th>Diferencial</th>
                            <th>Fecha</th>
                            <th>Comercial</th>
                        </tr>
                        @{ if (Model.historialDiferencial != null)
                            {
                                foreach (var mat in Model.historialDiferencial)
                                {
                                    <tr>
                                        <td>@Html.DisplayFor(model => mat.DiferencialDefault)</td>
                                        <td>@Html.DisplayFor(model => mat.Fecha)</td>
                                        <td>@Html.DisplayFor(model => mat.Comercial)</td>

                                    </tr>
                                }
                            }
                        }
                    </table>
                </div>
            </div>
        </div>


    }
</div>