@{
    ViewBag.Title = "Gestión de Cláusulas";
}

@section Scripts{
    @Scripts.Render("~/bundles/GestionarClausulasConfirma")
}

<script>
    @using Newtonsoft.Json;
    var clausulas = @Html.Raw(JsonConvert.SerializeObject(ViewBag.Clausulas));
    var negocioSAP = '@ViewBag.NegocioSAP';
    var tipoNegocio = '@ViewBag.TipoNegocio'
</script>

<!DOCTYPE html>
<html lang="es">
<head>
    <style>
        body {
            padding: 20px;
        }

        .contrato-header {
            font-size: 24px;
            margin-bottom: 20px;
            text-align: center;
        }

        .clausulas-table {
            width: 80%;
            margin: 0 auto;
        }

            .clausulas-table th,
            .clausulas-table td {
                text-align: center;
                vertical-align: middle;
            }

            .clausulas-table .numero-clausula {
                background-color: #ffddb3;
                font-weight: bold;
                width: 7%;
            }

            .clausulas-table .texto-clausula {
                width: 60%;
            }

            .clausulas-table .acciones {
                width: 16%;
                align-content: center;
            }

        .clausula-input {
            width: 80%;
            min-height: 200px;
            margin: 20px auto;
            resize: vertical;
            display: block;
        }

        .botones-acciones {
            text-align: center;
            margin-top: 10px;
        }

            .botones-acciones button {
                margin: 5px;
            }

        .botones-finales {
            text-align: center;
            margin-top: 30px;
        }

        .separador {
            border-top: 1px solid #ccc;
            margin: 20px 0;
        }
        .dialogTabla br {
            display: none;
        }
    </style>
</head>
<body>
    <div class="contrato-header" id="numero-contrato"></div>

    <table class="table table-bordered clausulas-table">
        <thead>
            <tr>
                <th class="numero-clausula">#</th>
                <th class="texto-clausula">Cláusula</th>
                <th class="acciones">Acciones</th>
            </tr>
        </thead>
        <tbody id="clausulas-body">
            <!-- Se cargan las cláusulas -->
        </tbody>
    </table>

    <textarea id="clausula-input" class="form-control clausula-input" placeholder="Agregar o modificar cláusula"></textarea>
    <div class="botones-acciones">
        <button id="cancelar-clausula" class="btn btn-default">Cancelar</button>
        <button id="guardar-clausula" class="btn btn-success">Guardar Cláusula</button>
    </div>

    <div class="separador"></div>

    <div class="botones-finales">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="serviceConfirma" checked>
            <label style="text-align: end" class="form-check-label ml-3" for="serviceConfirma">
                Servicio Web Confirma
            </label>
            <input class="form-check-input" type="checkbox" id="checkDescargar" style="margin-left:1em" checked>
            <label style="text-align: end" class="form-check-label ml-3" for="checkDescargar">
                Descargar Archivo
            </label>
        </div>
        <br />
        <button id="volver" class="btn btn-default">Volver</button>
        <button id="generar-confirma" class="btn btn-primary">Generar Confirma</button>
    </div>

</body>
</html>

<div class="modal fade" id="confirmarEliminarClausula" tabindex="-1" role="dialog" aria-labelledby="confirmarEliminacionLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar eliminación</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                ¿Desea eliminar la cláusula número <span id="numeroClausulaModal"></span>?
                <br />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="confirmarEliminacionBtn">Confirmar</button>
            </div>
        </div>
    </div>
</div>