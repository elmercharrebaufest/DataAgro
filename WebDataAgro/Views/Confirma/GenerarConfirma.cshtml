@{
    ViewBag.Title = "Generar Confirma";
}

@section styles{
    <link href="~/Content/control-boletos.css" rel="stylesheet" />
    <link href="~/Content/generarboleto.css" rel="stylesheet" />
}

@section Scripts{
    @Scripts.Render("~/bundles/GenerarConfirma")
}

@* Codificación UTF-8 para caracteres especiales *@
<meta charset="utf-8" />

<div class="container-fluid" style="margin-left:2em; margin-right:2em;">

    <!-- Header -->
    <div class="row header-section">
        <div class="col-12">
            <h2 class="page-title">
                <i class="fa fa-file-text-o"></i>
                Generaci&oacute;n de Confirma
            </h2>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card filter-card fade-in">
        <div class="card-header">
            <h6 class="card-title mb-0">
                Gesti&oacute;n y generaci&oacute;n de confirmas de contratos
            </h6>
        </div>

        <div class="card-body">

            <!-- fila 1 -->
            <div class="row form-row">
                <div class="col-md-6 col-sm-4">
                    <div class="form-group">
                        <label class="form-label">Contratos SAP</label>
                        <input type="text"
                               id="NegocioSAP"
                               class="form-control"
                               placeholder="Contratos SAP" />
                    </div>
                </div>
                <div class="col-md-3 col-sm-4">
                    <div class="form-group">
                        <label class="form-label">Material</label>
                        <select id="materialId" class="form-control">
                            <option value="">Seleccione Material</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3 col-sm-4">
                    <div class="form-group">
                        <label class="form-label">Proveedor</label>
                        <select id="proveedorId" class="form-control">
                            <option value="">Seleccione Proveedor</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- fila 2 -->
            <div class="row form-row">
                <div class="col-md-3 col-sm-4">
                    <div class="form-group">
                        <label class="form-label">Comercial</label>
                        <select id="comercialId" class="form-control">
                            <option value="">Seleccione Comercial</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3 col-sm-4">
                    <div class="form-group">
                        <label class="form-label">Bolsa</label>
                        <select id="bolsaCompraNetId" class="form-control">
                            <option value="">Seleccione Bolsa</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3 col-sm-4">
                    <label class="form-label">Fecha Confirmaci&oacute;n SAP Desde</label>
                    <div class="form-group">
                        <input id="fechaConfirmacionDesde" class="form-control" type="date" style="width: stretch" />
                    </div>
                </div>
                <div class="col-md-3 col-sm-4">
                    <label class="form-label">Fecha Confirmaci&oacute;n SAP Hasta</label>
                    <div class="form-group">
                        <input id="fechaConfirmacionHasta" class="form-control" type="date" style="width: stretch" />
                    </div>
                </div>
            </div>
            <br />
            <!-- fila 3 -->
            <div class="row form-row">

                <div class="col-md-4">
                    <div class="custom-control custom-checkbox mt-3">
                        <input type="checkbox" class="custom-control-input" id="ContratosPendientesCheck">
                        <label class="custom-control-label" for="ContratosPendientesCheck">
                            Solo contratos pendientes
                        </label>
                    </div>
                </div>

                <div class="col-md-8 text-right">

                    <button type="button" id="filtrarConfirmas" class="btn btn-primary">
                        <i class="fa fa-search"></i>
                        Filtrar Confirmas
                    </button>

                </div>

            </div>

        </div>
    </div>

    <!-- Resultados -->
    <div class="card results-card mt-3 fade-in">

        <div class="card-header d-flex justify-content-between align-items-center">
            <div class="results-summary">
                <span class="badge badge-info">
                    Contratos encontrados
                </span>
            </div>
        </div>

        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-8"></div>
                <div class="col-md-4 text-right">
                    <input type="checkbox" id="checkDescargar" checked>
                    <label for="checkDescargar">Descargar Archivo</label>
                    <input type="checkbox" id="servicioConfirmaId" checked style="margin-left:10px">
                    <label for="servicioConfirmaId">Web Services</label>
                    <button type="button"
                            id="generarConfirma"
                            class="btn btn-success"
                            onclick="GenerarConfirmas()">

                        <i class="fa fa-play"></i>
                        Generar Confirma
                    </button>
                </div>
            </div>
			<div class="row form-row">
				<div id="contratos-grid"></div>
			</div>
        </div>
    </div>

</div>
<style>
    .k-grid-header-wrap {
        overflow: hidden !important;
    }

    .k-grid-content {
        overflow-x: auto !important;
        overflow-y: auto !important;
    }
</style>
@Html.Partial("ModalConfirmaGenerado")
