@{
    ViewBag.Title = "Generar Confirma";
}

@section Scripts{
    @Scripts.Render("~/bundles/GenerarConfirma")
}
<div class="container-fluid" style="margin-left: 4em !important; margin-right: 4em !important;">
    <div class="row" style="padding: 10px 10px 0px 10px !important;">
        <div class="col"><h3>Generación de Confirma</h3></div>
    </div>
    <br />
    <div class="row">
        <div class="col-sm-1 col-lg-2"></div>
        <div class="col-sm-2 col-lg-1">
            <label>Tipo de Negocio</label>
        </div>
        <div class="col-sm-2" style="margin-bottom:0.5em;">
            @Html.DropDownList("ClaseNegocioId", new SelectList(ViewBag.ClaseNegocio, "Value", "Text"), new { @class = "form-control", @id = "ClaseNegocio" })
        </div>
        <div class="col-sm-2" style="margin-bottom:0.5em;">
            @Html.TextBox("Negocio", "", new { placeholder = "Número/s SAP", @class = "form-control", style = "width:100%", @id = "ContratoDesde" })
        </div>
        <div class="col-sm-2" style="margin-bottom:0.5em;">
            @Html.TextBox("NegocioHasta", "", new { placeholder = "Número SAP Hasta", @type = "number", @class = "form-control", style = "width:100%", @id = "ContratoHasta" })
        </div>
        <div class="col-md-2" style="text-align: start">
            <button type="button" id="filtrarConfirmas" class="k-button k-button-icontext" style="height:34px">Filtrar Confirmas</button>
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-sm-1 col-lg-2"></div>
        <div class="col-sm-2 col-lg-1">
            <label>Fecha de confirmación</label>
        </div>
        <div class="col-sm-2">
            <input id="FechaConfirmacionDesde" class="filtroFecha" type="date" style="width: unset">
        </div>
        <div class="col-sm-2 col-md-1">
            <label>Hasta</label>
        </div>
        <div class="col-sm-2">
            <input id="FechaConfirmacionHasta" class="filtroFecha" type="date" style="width: unset">
        </div>
        <div class="col-sm-2">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="checkDescargar" checked>
                <label style="text-align: end" class="form-check-label ml-3" for="checkDescargar" style="overflow: hidden;">
                    Descargar Archivo
                </label>
            </div>
        </div>
    </div>
    <br />
    <div class="row" style="border-top: 2px solid #017940; position:relative; padding-top:20px;">
        <div class="col-sm-12" style="display: flex; justify-content: flex-end; align-items: center;">
            <div style="display: flex; align-items: center;">
                <input class="form-check-input" type="checkbox" id="servicioConfirmaId" checked style="margin: 0;">
                <label class="form-check-label" for="servicioConfirmaId" style="margin-left: 5px;">
                    Web Services
                </label>
            </div>
            <button type="button" id="generar" class="k-button k-button-icontext" style="height:34px; margin-left: 20px; width: auto;" onclick="GenerarConfirmas()">
                Generar Confirma
            </button>
        </div>
    </div>
    <div class="row">
        <div class="col-xs-12">
            <div id="contratos-grid"></div>
        </div>
    </div>
</div>

<style>

    .modal .confirmado-modal div {
        background: #008e61 !important;
        color: white;
    }

    #generar {
        height: 37px;
        BACKGROUND: green;
        background: #017940 !important;
        color: white;
        color: #fff;
        padding: 4px;
        border-radius: 5px !important;
        margin-bottom: 10px;
        width: 100%;
    }

    #filtrarConfirmas {
        height: 37px;
        BACKGROUND: green;
        background: #017940 !important;
        color: white;
        color: #fff;
        padding: 4px;
        border-radius: 5px !important;
        margin-bottom: 10px;
        width: 100%;
    }

    .modal .confirmado-modal div {
        background: #008e61 !important;
        color: white;
    }

    .k-grid .row-checkbox {
        cursor: pointer;
    }

    .k-header {
        font-size: 12px;
        font-family: "G-Open Sans-n4", Arial;
    }

    #contratos-grid .k-grid-content td {
        font-family: "G-Open Sans-n4", Arial;
        font-size: 12px;
    }

    .k-filter-row > th:first-child, .k-grid tbody td:first-child, .k-grid tfoot td:first-child, .k-grid-header th.k-header:first-child {
        padding-left: 6px !important;
        padding-right: 6px !important;
    }

    .k-grid-header {
        padding-right: 0px !important;
    }
</style>

@Html.Partial("ModalConfirmaGenerado")