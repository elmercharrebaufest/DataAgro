@{
    ViewBag.Title = "Generar Boleto";
}

@section Scripts{
    @Scripts.Render("~/bundles/GenerarBoletos")
}

<link rel="stylesheet" href="~/Content/generarboleto.css" />

<div class="container-fluid" style="margin-left: 4em !important; margin-right: 4em !important;">
    <div class="row" style="padding: 10px 10px 0px 10px !important;">
        <div class="col"><h3>Generación de Boletos</h3></div>
    </div>
    <br />
    <div class="row">
        <div class="" id="GenerarBoletos">
            <div class="row">
                <div class="col-md-2">
                    <label>Tipo de Negocio</label>
                </div>
                <div class="col-sm-2" style="margin-bottom:0.5em;">
                    @Html.DropDownList("TipoNegocioId", new SelectList(ViewBag.TipoNegocio, "Value", "Text"), new { @class = "form-control", @id = "tipoId" })
                </div>
                <div class="col-md-2 noRightPadding">
                    @Html.TextBox("Negocio", "", new { placeholder = "Número/s SAP", @class = "form-control", style = "width:100%", @id = "contratoDesde" })
                </div>
                <div class="col-sm-2" style="margin-bottom:0.5em">
                    @Html.TextBox("ContratoSAPHasta-NoimportaElNombre", "", new { placeholder = "Número SAP Hasta", @type = "number", @class = "form-control", style = "width:100%", @id = "contratoHasta" })
                </div>
                <div class="col-sm-2" style="text-align: start">

                </div>
                <div class="col"></div>
            </div>
            <br />
            <div class="row">
                <div class="col-md-2">
                    <label>Fecha de confirmación</label>
                </div>
                <div class="col-sm-2">
                    <input id="FechaConfirmacionDesdeId" class="filtroFecha" name="FechaConfirmacion-desde" type="date" style="width:100%" />
                </div>
                <div class="col-md-2 noRightPadding">
                    <label>Hasta</label>
                </div>
                <div class="col-sm-2">
                    <input id="FechaConfirmacionHastaId" class="filtroFecha" name="FechaConfirmacion-hasta" type="date" style="width: 100%" />
                </div>
                <div class="col"></div>
            </div>
            <br />

            <div class="row">
                <div class="col-md-2">
                    <label>Fecha de Carga desde</label>
                </div>
                <div class="col-md-2">
                    <input id="FechaCargaId" class="filtroFecha" name="FechaCarga-desde" type="date" style="width: 100%" />
                </div>
                <div class="col-md-2 noRightPadding">
                    <label>Hasta</label>
                </div>
                <div class="col-md-2">
                    <input id="FechaCargaHastaId" class="filtroFecha" name="FechaCarga-desde" type="date" style="width: 100%" />
                </div>
            </div>
            <br />
            <div class="row">
                <div class="col-md-2">
                    <label>Material</label>
                </div>
                <div class="col-md-2">
                    @Html.DropDownList("MaterialId", new SelectList(ViewBag.Material, "Value", "Text"), "Seleccione el Material", new { @class = "form-control filtroBusquedaPorId", @id = "materialId" })
                </div>
                @*<div class="col-md-9"></div>*@
                <div class="col-md-2" style="text-align: start">
                    <button type="button" id="filtrarBoletos" class="k-button k-button-icontext" style="height:34px; width:218px">Filtrar Boletos</button>
                </div>
                <div class="col"></div>
            </div>
            <br />
            <div class="row" style="border-top: 2px solid #017940; position:relative; padding-top:20px;">
                <div class="col-sm-12" style="display: flex; justify-content: flex-end; align-items: center;">
                    <div style="display: flex; align-items: center;">
                        <input class="form-check-input" type="checkbox" id="mailId" checked style="margin: 0;">
                        <label class="form-check-label" for="mailId" style="margin-left: 5px;">
                            Enviar Mail
                        </label>
                    </div>
                    <button type="button" id="generar" class="k-button k-button-icontext" style="height:34px; margin-left: 20px; width: auto;" onclick="GenerarBoletos()">
                        Generar Boletos
                    </button>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12">
                    <div id="contratos-grid"></div>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    .grid-scroll-container {
        overflow: auto;
    }
</style>
@Html.Partial("ModalBoletoGenerado")