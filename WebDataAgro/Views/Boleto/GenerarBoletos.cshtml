
@{
    ViewBag.Title = "Generar Boleto";
}

@section Scripts{
    <script src="~/Scripts/App/GenerarBoleto.js"></script>
    <script src="~/Scripts/App/Filtros.js"></script>
    <script src="~/Scripts/App/FiltrarBoletos.js"></script>
}
<link rel="stylesheet" href="~/Content/generarboleto.css" />

<div class="row" style="padding: 10px 10px 0px 10px !important;"><h3>Generación Boletos</h3></div>
<br />
<div class="container">
    <div class="" id="GenerarBoletos">
        <div class="row">
            <div class="col-sm-2 col-md-1">
                <label>Negocio</label>
            </div>
            <div class="col-sm-3">
                @Html.DropDownList("TipoNegocioId", new SelectList(ViewBag.TipoNegocio, "Value", "Text"), new { @class = "form-control", @id = "tipoId" })
            </div>
            <div class="col-xs-12 col-md-2">
                @Html.TextBox("Negocio", "", new { placeholder = "Numero SAP", @class = "form-control", style = "width:100%", @id = "ContratoSAPId" })
            </div>
            <div class="col-xs-12 col-md-2">
                @Html.TextBox("ContratoSAPHasta-NoimportaElNombre", "", new { @type = "number", @class = "form-control", style = "width:100%", @id = "ContratoSAPHastaId" })
            </div>
            <div class="col-xs-12 col-md-2" style="text-align: left">
                <button type="button" id="abrirPopUpCargarValores" class="k-button k-button-icontext fa fa-list" style="height:34px; text-align: left"></button>
                <div class="modal fade in" id="popUpCargarValores" tabindex="-1" role="dialog" aria-labelledby="CargaContratosLabel" aria-hidden="true">
                </div>
            </div>
            <div class="col-sm-5 col-md-2" style="text-align: end">
                <div class="form-check">
                    <input class="form-check-input" type="checkbox" id="mailId">
                    <label style="text-align: end" class="form-check-label ml-3" for="mailId">
                        Enviar Mail
                    </label>
                </div>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-sm-2 col-md-1">
                <label>Desde</label>
            </div>
            <div class="col-sm-3">
                <input class="form-control" style = "width:100%" type="date" id="desde" value="null">
            </div>
            <div class="col-sm-2 col-md-1">
                <label>Hasta</label>
            </div>
            <div class="col-sm-3">
                <input class="form-control" style = "width:100%" type="date" id="hasta" value="null">
            </div>
            <div class="col-xs-12 col-md-2" style="text-align: left">
                <button type="button" id="filtrarBoletos" class="k-button k-button-icontext fa fa-filter" style="height:34px; text-align:left"></button>
            </div>
        </div>
        <br />
        <div class="row" style="border-top: 2px solid #017940; position:relative; padding-top:20px;">
            <div class="col-sm-5 col-md-10"></div>
            <div class="col-sm-5 col-md-2">
                <button type="button" id="filtrar" class="k-button k-button-icontext" style="height:34px" onclick="Filtrar()">
                    Generar Boletos
                </button>
            </div>
        </div>

        <div class="form-group my-4">

        </div>
        @*<div class="row" id="nuevotab" style="padding-top:20px">
                <div class="col-xs-12">
                    <div id="gridInformeBoleto" hidden></div>
                </div>
            </div>*@
    </div>
</div>

<style>
    #filtrar {
        height: 37px;
        BACKGROUND: green;
        background: #017940 !important;
        color: white;
        color: #fff;
        padding: 4px;
        border-radius: 5px !important;
        margin-bottom: 10px;
        width: 100%;
    }

    .modal .confirmado-modal div {
        background: #008e61 !important;
        color: white;
    }
</style>

@Html.Partial("ModalBoletoGenerado")

