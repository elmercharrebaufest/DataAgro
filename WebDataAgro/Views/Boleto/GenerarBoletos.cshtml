@{
    ViewBag.Title = "Generar Boleto";
}

@section styles{
    <link href="~/Content/control-boletos.css" rel="stylesheet" />
    <link href="~/Content/generarboleto.css" rel="stylesheet" />
}

@section Scripts{
    @Scripts.Render("~/bundles/GenerarBoletos")
}

@* Codificación UTF-8 para caracteres especiales *@
<meta charset="utf-8" />

<div class="container-fluid" style="margin-left:2em;margin-right:2em;" id="GenerarBoletos">

    <!-- HEADER -->
    <div class="row header-section">
        <div class="col-12">
            <h2 class="page-title">
                <i class="fa fa-file-text-o"></i>
                Generaci&oacute;n de Boletos
            </h2>
        </div>
    </div>


    <!-- FILTROS -->
    <div class="card filter-card fade-in">

        <div class="card-header">
            <h6 class="card-title mb-0">
                Gesti&oacute;n y generaci&oacute;n de boletos a partir de contratos
            </h6>
        </div>

        <div class="card-body">

            <!-- FILA 1 -->
            <div class="row form-row">
                <div class="col-md-6 col-sm-4">
                    <div class="form-group">
                        <label class="form-label">Contratos SAP</label>
                        <input type="text"
                               id="NegocioSAP"
                               class="form-control"
                               placeholder="Contratos SAP" />
                    </div>
                </div>
                <div class="col-md-3 col-sm-4">
                    <div class="form-group">
                        <label class="form-label">Material</label>
                        <select id="materialId" class="form-control">
                            <option value="">Cargando materiales...</option>
                        </select>
                    </div>
                </div>

                <div class="col-md-3 col-sm-4">
                    <div class="form-group">
                        <label class="form-label">Proveedor</label>
                        <select id="proveedorId" class="form-control">
                            <option value="">Cargando proveedores...</option>
                        </select>
                    </div>
                </div>
            </div>


            <!-- FILA 2 -->
            <div class="row form-row">
                <div class="col-md-3 col-sm-4">
                    <div class="form-group">
                        <label class="form-label">Comercial</label>
                        <select id="comercialId" class="form-control">
                            <option value="">Cargando comerciales...</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3 col-sm-4">
                    <div class="form-group">
                        <label class="form-label">Bolsa</label>
                        <select id="bolsaCompraNetId" class="form-control">
                            <option value="">Cargando Bolsas...</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3 col-sm-4">
                    <label class="form-label">Fecha Confirmaci&oacute;n SAP Desde</label>
                    <div class="form-group">
                        <input id="fechaConfirmacionDesde" class="form-control" type="date" style="width: stretch" />
                    </div>
                </div>
                <div class="col-md-3 col-sm-4">
                    <label class="form-label">Fecha Confirmaci&oacute;n SAP Hasta</label>
                    <div class="form-group">
                        <input id="fechaConfirmacionHasta" class="form-control" type="date" style="width: stretch" />
                    </div>
                </div>
            </div>
            <br />

            <!-- FILA 3 -->
            <div class="row form-row">
                <div class="col-md-4">
                    <div class="custom-control custom-checkbox mt-3">
                        <input type="checkbox" class="custom-control-input" id="ContratosPendientesCheck">
                        <label class="custom-control-label" for="ContratosPendientesCheck">
                            Solo contratos pendientes
                        </label>
                    </div>
                </div>

                <div class="col-md-8 text-right">

                    <button type="button" id="filtrarBoletosCarOferta" class="btn btn-primary">
                        <i class="fa fa-search"></i>
                        Filtrar Boletos
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- RESULTADOS -->
    <div class="card results-card mt-3 fade-in">

        <div class="card-header d-flex justify-content-between align-items-center">

            <div class="results-summary">
                <span class="badge badge-info">
                    Contratos encontrados
                </span>
            </div>

        </div>

        <div class="card-body">
		
            <!-- ACCIONES -->
            <div class="row mb-3">
                <div class="col-md-8"></div>
                <div class="col-md-4 text-right">
                    <input class="form-check-input" type="checkbox" id="mailId" checked>
                    <label class="form-check-label" for="mailId"> Enviar Mail </label>
                    <button type="button"
                            id="generarBoleto"
                            class="btn btn-success"
                            onclick="GenerarBoletos()">
                        <i class="fa fa-play"></i>
                        Generar Boletos
                    </button>
                </div>
            </div>

            <!-- GRID -->
            <div id="contratos-grid" class="grid-container"></div>

        </div>
    </div>
</div>

<style>
    .grid-scroll-container {
        overflow: auto;
    }
</style>
<style>
    .k-grid-header-wrap {
        overflow: hidden !important;
    }

    .k-grid-content {
        overflow-x: auto !important;
        overflow-y: auto !important;
    }
</style>
@Html.Partial("ModalBoletoGenerado")
