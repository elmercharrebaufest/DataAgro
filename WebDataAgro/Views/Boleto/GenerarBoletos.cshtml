@{
    ViewBag.Title = "Generar Boleto";
}

@section Scripts{
    @Scripts.Render("~/bundles/GenerarBoletos")
}

<link rel="stylesheet" href="~/Content/generarboleto.css" />

<div class="container-fluid" style="margin-left: 4em !important; margin-right: 4em !important;">
    <div class="row" style="padding: 10px 10px 0px 10px !important;">
        <div class="col"><h3>Generación de Boletos</h3></div>
    </div>
    <br />
    <div class="row">
        <div class="" id="GenerarBoletos">
            <div class="row">
                <div class="col-sm-1 col-lg-2"></div>
                <div class="col-sm-2 col-lg-1">
                    <label>Negocio</label>
                </div>
                <div class="col-sm-2" style="margin-bottom:0.5em;">
                    @Html.DropDownList("TipoNegocioId", new SelectList(ViewBag.TipoNegocio, "Value", "Text"), new { @class = "form-control", @id = "tipoId" })
                </div>
                <div class="col-sm-2" style="margin-bottom:0.5em">
                    @Html.TextBox("Negocio", "", new { placeholder = "Número/s SAP", @class = "form-control", style = "width:100%", @id = "contratoDesde" })
                </div>
                <div class="col-sm-2" style="margin-bottom:0.5em">
                    @Html.TextBox("ContratoSAPHasta-NoimportaElNombre", "", new { placeholder = "Número SAP Hasta", @type = "number", @class = "form-control", style = "width:100%", @id = "contratoHasta" })
                </div>
                <div class="col-sm-2" style="text-align: start">
                    <button type="button" id="filtrarBoletos" class="k-button k-button-icontext" style="height:34px">
                        Filtrar Boletos
                    </button>
                </div>
                <div class="col"></div>
            </div>
            <br />
            <div class="row" style="border-bottom: 2px solid #017940; position:relative; padding-bottom:20px;">
                <div class="col-sm-1 col-lg-2"></div>
                <div class="col-sm-2 col-lg-1">
                    <label>Fecha de confirmación</label>
                </div>
                <div class="col-sm-2">
                    <input id="FechaConfirmacionDesdeId" class="filtroFecha" name="FechaConfirmacion-desde" type="date" style="width:unset" />
                </div>
                <div class="col-sm-2 col-lg-1">
                    <label>Hasta</label>
                </div>
                <div class="col-sm-2">
                    <input id="FechaConfirmacionHastaId" class="filtroFecha" name="FechaConfirmacion-hasta" type="date" style="width:unset" />
                </div>
                <div class="col-sm-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="mailId" checked>
                        <label style="text-align: end" class="form-check-label ml-3" for="mailId">
                            Enviar Mail
                        </label>
                    </div>
                </div>
                <div class="col"></div>
            </div>
            <br />
            <div class="row">
                <div class="col-sm-5 col-md-10"></div>
                <div class="col-sm-5 col-md-2">
                    <button type="button" id="generar" class="k-button k-button-icontext" style="height:34px" onclick="GenerarBoletos()">
                        Generar Boletos
                    </button>
                </div>
            </div>
            <div class="row">
                <div class="col-xs-12">
                    <div id="contratos-grid"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    #generar {
        height: 37px;
        BACKGROUND: green;
        background: #017940 !important;
        color: white;
        color: #fff;
        padding: 4px;
        border-radius: 5px !important;
        margin-bottom: 10px;
        width: 100%;
    }

    #filtrarBoletos {
        height: 37px;
        BACKGROUND: green;
        background: #017940 !important;
        color: white;
        color: #fff;
        padding: 4px;
        border-radius: 5px !important;
        margin-bottom: 10px;
        width: 100%;
    }

    .modal .confirmado-modal div {
        background: #008e61 !important;
        color: white;
    }

    .k-grid .row-checkbox {
        cursor: pointer;
    }
</style>

@Html.Partial("ModalBoletoGenerado")