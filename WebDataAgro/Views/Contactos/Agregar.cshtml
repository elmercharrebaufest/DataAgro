
@{
    ViewBag.Title = "Nuevo Contacto";
}

<link rel="stylesheet" href="~/Content/agregarcontacto.css" />
<script type="text/javascript" src="~/Scripts/App/agregarcontacto.js"></script>



<div class="container">
    <div class="row bordertopbottom">
        <div class="wizard-header-contenedor-grupo">
            <div class="wizard-header-contenedor whc-selected" id="basico">
                Datos básicos
            </div>
            <div class="wizard-header-contenedor" id="contacto">
                Datos contacto
            </div>
            <div class="wizard-header-contenedor" id="produccion">
                Producción
            </div>
        </div>
    </div>
</div>

<div class="formulario">
    <div id="formulario-basico">
        <h2>Datos básicos</h2>
        <div class="formulario-campo">
            <span class="campo-span">CUIT (*)</span>
            <input type="text" class="campo-input-text" id="cuit"  />
        </div>
        <div class="formulario-campo">
            <span class="campo-span">Razón Social</span>
            <input type="text" disabled class="campo-input-text" id="razonsocial" />
            <div class="campo-estadoafip">
                <span class="campo-estadoafip-span">Estado Registro AFIP </span> <img src="~/Content/Images/operableafip.png" /><span class="campo-estadoafip-span-operable">Operable</span>
            </div>
        </div>
        <div class="formulario-campo">
            <span class="campo-span">Segmentación (*)</span>
            <select class="campo-input-select" id="segmentacion">
                <option value="" disabled selected>Seleccione...</option>
                <optgroup label="Productores">
                    <option value="1">Productores grandes (pooles/administradores)</option>
                    <option value="2">Productores medianos</option>
                    <option value="3">Productores pequeños</option>
                </optgroup>
                <optgroup label="Corredores">
                    <option value="4">Correacopios</option>
                    <option value="5">Corredores con acopio</option>
                </optgroup>
                <optgroup label="Acopiadores">
                    <option value="6">Acopios generales</option>
                    <option value="7">Acopios fidelizados</option>
                    <option value="8">Cooperativas</option>
                </optgroup>
                <optgroup label="Grandes Cuentas">
                    <option value="9">ACA/AFA</option>
                </optgroup>
                <optgroup label="Exportadores">
                    <option value="10">Resto corredores</option>
                    <option value="11">Proveedores de insumos</option>
                    <option value="12">Exportadores (colegas)</option>
                    <option value="13">Grandes cuentas</option>
                </optgroup>
            </select>
        </div>
        <div class="datos-del-contacto">
            Datos del Contacto
        </div>
        <div class="formulario-campo">
            <span class="campo-span">Nombre Referente (*)</span>
            <input type="text" class="campo-input-text" id="nomReferente" />
        </div>
        <div class="contacto-basico-emails">
            <div class="formulario-campo">
                <span class="campo-span">Email</span>
                <input type="text" class="campo-input-text" id="Email1" />
                <img src="~/Content/Images/agregar-tel-mail.png" id="agregarMail" />
            </div>
        </div>
        <div class="contacto-basico-telefonos">
            <div class="formulario-campo">
                <select class="campo-input-select" id="TipoTelefono1">
                    <option value="1">Oficina</option>
                    <option value="2">Movil</option>
                </select>
                <input type="text" placeholder="Telefono" class="campo-input-text" id="Telefono1" />
                <img src="~/Content/Images/agregar-tel-mail.png" id="agregarTelefono" />
            </div>
        </div>
        <div class="datos-basicos-comentario">
            Comentario
        </div>
        <div class="formulario-campo">
            <textarea id="comentario"></textarea>
        </div>
    </div>

    <div id="formulario-contacto">
        <h2>Datos proveedor</h2>
        <div class="datos-basicos-comentario">
            Domicilio Actividad
        </div>
        <div class="formulario-campo">
            <select class="campo-input-select campo-sin-span" id="provincia">
                <option value="0">Provincia</option>
                <option value="1">Buenos Aires</option>
                <option value="2">Catamarca</option>
                <option value="3">Chaco</option>
                <option value="4">Chubut</option>
                <option value="5">Córdoba</option>
                <option value="6">Corrientes</option>
                <option value="7">Entre Ríos</option>
                <option value="8">Formosa</option>
                <option value="9">Jujuy</option>
                <option value="10">La Pampa</option>
                <option value="11">La Rioja</option>
                <option value="12">Mendoza</option>
                <option value="13">Misiones</option>
                <option value="14">Neuquén</option>
                <option value="15">Río Negro</option>
                <option value="16">Salta</option>
                <option value="17">San Juan</option>
                <option value="18">San Luis</option>
                <option value="19">Santa Cruz</option>
                <option value="20">Santa Fe</option>
                <option value="21">Santiago del Estero</option>
                <option value="22">Tierra del Fuego</option>
                <option value="23">Tucumán</option>
            </select>
        </div>
        <div class="formulario-campo">
            <select class="campo-input-select campo-sin-span" id="localidad">
                <option value="0">Localidad</option>
                <option value="1">Haedo</option>
                <option value="2">Morón</option>
                <option value="3">San Justo</option>
                <option value="4">Chivilcoy</option>
            </select>
        </div>
        <div class="formulario-campo">
            <input type="text" placeholder="Dirección" class="campo-input-text" id="direccion" />
            <input type="text" placeholder="Código postal" class="campo-input-text" id="codpost" />
        </div>
        <div class="datos-basicos-comentario">
            Información comercial
        </div>
        <div class="formulario-campo">
            <span class="campo-span">Canales de operación</span>
            <select class="campo-input-select" id="canopera">
                <option value="" selected>Seleccione...</option>
                <option value="1">Acopio local</option>
                <option value="2">Corredor</option>
                <option value="3">Directo</option>
            </select>
        </div>
        <div class="formulario-campo">
            <span class="campo-span">Entrega a</span>
            <select class="campo-input-select" id="entregaA">
                <option value="" selected>Seleccione...</option>
                <option value="1">Bunge</option>
                <option value="2">Cagsa</option>
                <option value="3">Cargill</option>
                <option value="4">AGD</option>
                <option value="5">Cooperativas</option>
                <option value="6">LDC</option>
                <option value="7">Vicentin</option>
            </select>
        </div>
        <div class="formulario-campo">
            <span class="campo-span">Condiciones preferentes</span>
            <select class="campo-input-select" id="condPrefer">
                <option value="" selected>Seleccione...</option>
                <option value="1">A fijar</option>
                <option value="2">Canje</option>
                <option value="3">Disponible</option>
                <option value="4">Forward</option>
                <option value="5">Post-cosecha</option>
            </select>
        </div>
        <div class="formulario-campo">
            <span class="campo-span">Intermediario</span>
            <input type="text" class="campo-input-text" id="intermediario" />
        </div>
        <div class="formulario-campo">
            <span class="campo-span">Area de influencia</span>
            <div class="formulario-campo-radio">
                <label for="influencia-zona-unica"><input id="influencia-zona-unica" type="radio" name="influencia" value="1"> Zona única</label>
                <label for="influencia-multizona"><input id="influencia-multizona" type="radio" name="influencia" value="2"> Multizona</label>
            </div>
        </div>
        <div class="datos-basicos-comentario">
            Comentario
        </div>
        <div class="formulario-campo-contacto">
            <textarea id="comentario-contacto"></textarea>
        </div>
    </div>

    <div id="formulario-produccion">
        <h2>Producción</h2>
        <div class="datos-produccion-cap-prod">
            Capacidad Productiva
        </div>
        <div class="datos-produccion-cap-prod-guardados">

        </div>
        <div class="datos-produccion-cap-prod-editor-contenedor">
            <div class="datos-produccion-cap-prod-editor-titulo">
                Agregar detalle de capacidad productiva
            </div>
            <div class="formulario-campo">
                <span class="campo-span">Ubicación</span><span style="float:none;" class="campo-span">KMZ</span>
                <input type="text" placeholder="Coordenadas..." class="campo-input-text" id="coordenadas" />
                <img />
            </div>
            <div class="formulario-campo">
                <select class="campo-input-select campo-sin-span" id="provincia-produccion">
                    <option value="0">Provincia</option>
                    <option value="1">Buenos Aires</option>
                    <option value="2">Catamarca</option>
                    <option value="3">Chaco</option>
                    <option value="4">Chubut</option>
                    <option value="5">Córdoba</option>
                    <option value="6">Corrientes</option>
                    <option value="7">Entre Ríos</option>
                    <option value="8">Formosa</option>
                    <option value="9">Jujuy</option>
                    <option value="10">La Pampa</option>
                    <option value="11">La Rioja</option>
                    <option value="12">Mendoza</option>
                    <option value="13">Misiones</option>
                    <option value="14">Neuquén</option>
                    <option value="15">Río Negro</option>
                    <option value="16">Salta</option>
                    <option value="17">San Juan</option>
                    <option value="18">San Luis</option>
                    <option value="19">Santa Cruz</option>
                    <option value="20">Santa Fe</option>
                    <option value="21">Santiago del Estero</option>
                    <option value="22">Tierra del Fuego</option>
                    <option value="23">Tucumán</option>
                </select>
            </div>
            <div class="formulario-campo">
                <select class="campo-input-select campo-sin-span" id="localidad-produccion">
                    <option value="0">Localidad</option>
                    <option value="1">Haedo</option>
                    <option value="2">Morón</option>
                    <option value="3">San Justo</option>
                    <option value="4">Chivilcoy</option>
                </select>
            </div>
            <div class="formulario-campo">
                <span class="campo-span">Hectareas</span>
                <div class="formulario-campo-radio">
                    <label for="hectareas-arrendadas"><input id="hectareas-arrendadas" type="radio" name="hectareas" value="1"> Arrendadas</label>
                    <label for="hectareas-propias"><input id="hectareas-propias" type="radio" name="hectareas" value="2"> Propias</label>
                </div>
            </div>
            <div class="datos-produccion-cap-prod-editor-granos-contenedor">
                <div class="datos-produccion-cap-prod-editor-granos-titulos">
                    <div class="produccion-titulo-grano">Grano</div>
                    <div class="produccion-titulo-hastn">Has</div>
                    <div class="produccion-titulo-hastn">TNs</div>
                </div>
                <div class="datos-produccion-cap-prod-editor-granos-cantidades-contenedor">
                    <div class="datos-produccion-cap-prod-editor-granos-cantidades-grupo">
                        <div class="linea0">
                            <select class="campo-input-select campo-sin-span grano" id="grano0">
                                <option disabled selected value="">Seleccionar...</option>
                                <option value="1">Cebada</option>
                                <option value="2">Girasol</option>
                                <option value="3">Maiz</option>
                                <option value="4">Soja</option>
                                <option value="5">Trigo</option>
                                <option value="6">Otros</option>
                            </select>
                            <input type="text" class="campo-input-text hectareas" id="hectareas0" />
                            <input type="text" class="campo-input-text toneladas" id="toneladas0" />
                        </div>
                        <img src="../Content/Images/eliminar-tel-mail.png" id="eliminarGrano" />
                    </div>
                    <div class="agregargrano">
                        + Agregar grano a este campo
                    </div>
                </div>
            </div>
            <div style="text-align:right;">
                <div class="datos-produccion-cap-prod-editor-contenedor-guardar" id="guardarCapProd">
                    Guardar
                </div>
            </div>
        </div>
        <div class="linea-separador-agenda"></div>
        <div class="datos-produccion-cap-prod">
            Almacenamiento
        </div>
        <div class="datos-contacto-cap-prod-subt">
            Capacidad
        </div>
        <div class="formulario-campo">
            <span class="campo-span">Volumen Anual Total (TNs)</span>
            <input type="text" class="campo-input-text" id="volumen-anual-total-tns" />
        </div>
        <div class="formulario-campo">
            <span class="campo-span">Capacidad de almacenamiento propia</span>
            <input type="text" class="campo-input-text" id="capacidad-almacenamiento-prop" />
        </div>
        <div class="formulario-campo">
            <span class="campo-span">Habilitado para Soja Sustentable</span>
            <div class="formulario-campo-radio">
                <label for="sojasust-si"><input id="sojasust-si" type="radio" name="sojasustentable" value="1"> Si</label>
                <label for="sojasust-no"><input id="sojasust-no" type="radio" name="sojasustentable" value="0"> No</label>
            </div>
        </div>
        <div class="formulario-campo">
            <span class="campo-span">Tons. Máx. Aprobadas Soja Sustentable</span>
            <input type="text" class="campo-input-text" id="tons-max-aprob-sojasust" />
        </div>
        <div class="formulario-campo">
            <span class="campo-span">Has. Aprobadas Soja Sustentable </span>
            <input type="text" class="campo-input-text" id="has-aprob-sojasust" />
        </div>
        <div class="datos-contacto-cap-prod-subt">
            Detalle volumen (movimiento físico)
        </div>
        <div class="agregar-detalle-volumen">
            + Agregar Detalle de volumen
        </div>
        <div class="linea-separador-agenda"></div>
        <div class="datos-produccion-cap-prod">
            Insumos
        </div>
        <div class="datos-contacto-cap-prod-subt">
            Compra anual insumos
        </div>
        <div class="formulario-campo">
            <span class="campo-span"> Fertilizantes (TNs) </span>
            <input type="text" class="campo-input-text" id="fertilizante" />
        </div>
        <div class="formulario-campo">
            <span class="campo-span">Glifosato líquido (Lts) </span>
            <input type="text" class="campo-input-text" id="glifosato-liquido" />
        </div>
        <div class="formulario-campo">
            <span class="campo-span">Glifosato granulado (Kgs) </span>
            <input type="text" class="campo-input-text" id="glifosato-granulado" />
        </div>
        <div class="formulario-campo">
            <span class="campo-span">Silobolsa (Unidades) </span>
            <input type="text" class="campo-input-text" id="silobolsa" />
        </div>

    </div>






    <div class="formulario-footer">
        <div class="formulario-footer-cancelar">
            Cancelar
        </div>
        <div class="formulario-footer-guardar-contacto">
            Guardar contacto
        </div>
        <div class="formulario-footer-siguiente">
            Siguiente
        </div>
    </div>
</div>



<div id="modalSalir" class="modal fade" role="dialog">
    <div class="modal-dialog">

        <!-- Modal content-->
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="close" data-dismiss="modal">&times;</button>
                <h4 class="modal-title">Agregar contacto</h4>
            </div>
            <div class="modal-body">
                <p>Quiere guardar los cambios antes de salir?</p>
            </div>
            <div class="modal-footer">
                <div class="modal-salir-sin-guardar">
                    Salir sin Guardar
                </div>
                <div class="modal-guardar-contacto">
                    Guardar
                </div>
                <div class="modal-cancelar">
                    Cancelar
                </div>
            </div>
        </div>

    </div>
</div>

