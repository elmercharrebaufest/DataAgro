@using Molinos.DataAgro.Entities.Common.Enums
@model WebDataAgro.Models.ReporteCompraNetModel

@{
    var dispAFijar = Model.PosicionCompras.Any(x => x.PosicionKilos.Any(y => y.DispAFijar>0));
    var dispAPrecio = Model.PosicionCompras.Any(x => x.PosicionKilos.Any(y => y.DispAPrecio>0));
    var dispFijacion = Model.PosicionCompras.Any(x => x.PosicionKilos.Any(y => y.DispFijac>0));
    var dispAgente = Model.ToneladasGranoTipo.Any(x => x.DispAgente != 0);
    var disp = 4 - (dispAFijar ? 0 : 1) - (dispAPrecio ? 0 : 1) - (dispFijacion ? 0 : 1) - (dispAgente ? 0 : 1);
    var forwAFijar = Model.PosicionCompras.Any(x => x.PosicionKilos.Any(y => y.FrwAFijar>0));
    var forwAPrecio = Model.PosicionCompras.Any(x => x.PosicionKilos.Any(y => y.FrwAPrecio>0));
    var forwFijacion = Model.PosicionCompras.Any(x => x.PosicionKilos.Any(y => y.FrwFijac>0));
    var forwAgente = Model.ToneladasGranoTipo.Any(x => x.FrwAgente != 0);
    var forw = 4 - (forwAFijar ? 0 : 1) - (forwAPrecio ? 0 : 1) - (forwFijacion ? 0 : 1) - (forwAgente ? 0 : 1);
    var newcAFijar = Model.PosicionCompras.Any(x => x.PosicionKilos.Any(y => y.NewAFijar>0));
    var newcAPrecio = Model.PosicionCompras.Any(x => x.PosicionKilos.Any(y => y.NewAPrecio>0));
    var newcFijacion = Model.PosicionCompras.Any(x => x.PosicionKilos.Any(y => y.NewFijac>0));
    var newcAgente = Model.ToneladasGranoTipo.Any(x => x.NewAgente != 0);
    var newc = 4 - (newcAFijar ? 0 : 1) - (newcAPrecio ? 0 : 1) - (newcFijacion ? 0 : 1) - (newcAgente ? 0 : 1);

    var hedgeMat = Model.HedgeMaterial.Any(x => x.Disponible != 0 || x.Forward != 0 || x.NewCrop != 0) ? 1 : 0;
    var hedgeObj = Model.HedgeObjetivo.RemitirObjetivo != 0 && Model.HedgeObjetivo.PricingObjetivo != 0 ? 1 : 0;
    var pricing = Model.PricingCampania.Count != 0 ? 1 : 0;
}

<div id="ReportesCompraNet">
    <div class="row">
        <div class="table-responsive col-md-4 @(hedgeMat == 1 ? "":"hide")">
            <table class="table-condensed" id="HedgeMaterial">
                <tbody>
                    <tr class="titulos hedgemat">
                        <th colspan="4">HEDGE</th>
                    </tr>
                    <tr class="titulos hedgemat">
                        <th>Producto</th>
                        <th>Disponible</th>
                        <th>Forward</th>
                        <th>New Crop</th>
                    </tr>
                    @foreach (var mat in Model.HedgeMaterial)
                    {
                        if (mat.Disponible != 0 || mat.Forward != 0 || mat.NewCrop != 0)
                        {
                            <tr>
                                <td>@mat.MaterialDescripcion</td>
                                <td>@mat.Disponible.ToString("N0")</td>
                                <td>@mat.Forward.ToString("N0")</td>
                                <td>@mat.NewCrop.ToString("N0")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
        <div>
            <div class="table-responsive col-md-4 @(hedgeObj == 1 ? "":"hide")">
                <table class="table-condensed" id="HedgeObjetivo">
                    <tr class="titulos hedgeobj">
                        <th></th>
                        <th>DÍA</th>
                        <th>OBJETIVO</th>
                    </tr>
                    <tr>
                        <th class="titulos hedgeobj">Pricing</th>
                        <td>@Model.HedgeObjetivo.PricingCumplido.ToString("N0")</td>
                        <td>@Model.HedgeObjetivo.PricingObjetivo.ToString("N0")</td>
                    </tr>
                    <tr>
                        <th class="titulos hedgeobj">A remitir</th>
                        <td>@Model.HedgeObjetivo.RemitirCumplido.ToString("N0")</td>
                        <td>@Model.HedgeObjetivo.RemitirObjetivo.ToString("N0")</td>
                    </tr>
                </table>
                <canvas id="graficoHedge" height="40"></canvas>
                <table class="table-condensed" id="HedgeTC">
                    <tr>
                        <td>Hedge TC $@Model.TCPromedioDto.PromedioTC.ToString("N2")</td>
                        <td>$@(Model.TCPromedioDto.TotalTC.ToString("N2"))</td>
                    </tr>
                </table>
            </div>
            <div class="table-responsive col-md-4 @(pricing == 1 ? "":"hide")">
                <table class="table-condensed" id="Pricing">
                    <tr class="titulos pricing">
                        <th>MATERIAL</th>
                        <th>CAMPAÑA</th>
                        <th>PRICING</th>
                    </tr>
                    @foreach (var datos in Model.PricingCampania)
                    {
                        string sumaPricing;
                        switch (datos.Id)
                        {
                            case 11:
                                sumaPricing = (Model.PosicionCompras.Where(x=>x.MaterialId==1).Select(x => x.PosicionKilos.Sum(y=>y.DispAPrecio+y.DispFijac+y.FrwAPrecio+y.FrwFijac)).Sum()+Model.ToneladasGranoTipo.Where(x=>x.Material=="Maiz").Sum(x=>x.DispAgente+x.FrwAgente)).ToString("N0");
                                break;
                            case 12:
                                sumaPricing = (Model.PosicionCompras.Where(x=>x.MaterialId==1).Select(x => x.PosicionKilos.Sum(y=>y.NewAPrecio+y.NewFijac)).Sum()+Model.ToneladasGranoTipo.Where(x=>x.Material=="Maiz").Sum(x=>x.NewAgente)).ToString("N0");
                                break;
                            case 21:
                                sumaPricing = (Model.PosicionCompras.Where(x=>x.MaterialId==2).Select(x => x.PosicionKilos.Sum(y=>y.DispAPrecio+y.DispFijac+y.FrwAPrecio+y.FrwFijac)).Sum()+Model.ToneladasGranoTipo.Where(x=>x.Material=="Trigo Cámara"||x.Material=="Trigo Calidad").Sum(x=>x.DispAgente+x.FrwAgente)).ToString("N0");
                                break;
                            case 22:
                                sumaPricing = (Model.PosicionCompras.Where(x=>x.MaterialId==2).Select(x => x.PosicionKilos.Sum(y=>y.NewAPrecio+y.NewFijac)).Sum()+Model.ToneladasGranoTipo.Where(x=>x.Material=="Trigo Cámara"||x.Material=="Trigo Calidad").Sum(x=>x.NewAgente)).ToString("N0");
                                break;
                            case 31:
                                sumaPricing = (Model.PosicionCompras.Where(x=>x.MaterialId==3).Select(x => x.PosicionKilos.Sum(y=>y.DispAPrecio+y.DispFijac+y.FrwAPrecio+y.FrwFijac)).Sum()+Model.ToneladasGranoTipo.Where(x=>x.Material=="Soja").Sum(x=>x.DispAgente+x.FrwAgente)).ToString("N0");
                                break;
                            case 32:
                                sumaPricing = (Model.PosicionCompras.Where(x=>x.MaterialId==3).Select(x => x.PosicionKilos.Sum(y=>y.NewAPrecio+y.NewFijac)).Sum()+Model.ToneladasGranoTipo.Where(x=>x.Material=="Soja").Sum(x=>x.NewAgente)).ToString("N0");
                                break;
                            case 41:
                                sumaPricing = (Model.PosicionCompras.Where(x=>x.MaterialId==4).Select(x => x.PosicionKilos.Sum(y=>y.DispAPrecio+y.DispFijac+y.FrwAPrecio+y.FrwFijac)).Sum()+Model.ToneladasGranoTipo.Where(x=>x.Material=="Girasol").Sum(x=>x.DispAgente+x.FrwAgente)).ToString("N0");
                                break;
                            case 42:
                                sumaPricing = (Model.PosicionCompras.Where(x=>x.MaterialId==4).Select(x => x.PosicionKilos.Sum(y=>y.NewAPrecio+y.NewFijac)).Sum()+Model.ToneladasGranoTipo.Where(x=>x.Material=="Girasol").Sum(x=>x.NewAgente)).ToString("N0");
                                break;
                            case 51:
                                sumaPricing = (Model.PosicionCompras.Where(x=>x.MaterialId==5).Select(x => x.PosicionKilos.Sum(y=>y.DispAPrecio+y.DispFijac+y.FrwAPrecio+y.FrwFijac)).Sum()+Model.ToneladasGranoTipo.Where(x=>x.Material=="Girasol Alto Oleico").Sum(x=>x.DispAgente+x.FrwAgente)).ToString("N0");
                                break;
                            case 52:
                                sumaPricing = (Model.PosicionCompras.Where(x=>x.MaterialId==5).Select(x => x.PosicionKilos.Sum(y=>y.NewAPrecio+y.NewFijac)).Sum()+Model.ToneladasGranoTipo.Where(x=>x.Material=="Girasol Alto Oleico").Sum(x=>x.NewAgente)).ToString("N0");
                                break;
                            default:
                                sumaPricing = "0";
                                break;
                        }
                        <tr>
                            <td>@datos.Material</td>
                            <td>@datos.Campania</td>
                            <td>@sumaPricing</td>
                        </tr>
                    }
                </table>
            </div>
        </div>
    </div>
    <div class="row @(disp+forw+newc==0?"hide":"")">
        <div class="table-responsive col-md-12">
            <table class="table-condensed noSideMargin" id="ComprasToneladasTipo">
                <tbody>
                    <tr class="titulos">
                        <td id="" class="borde-izquierdo"></td>
                        <th id="disponible" class="borde-derecho @(disp==0?"hide":"")" colspan="@(disp)">DISPONIBLE</th>
                        <th id="disponibleTotal" class="@(disp==0?"hide":"") borde-derecho-oscuro" rowspan="2">TOTAL DISPONIBLE</th>
                        <td class="espacio @(disp==0?"hide":"")"> </td>
                        <th id="forward" class="borde-derecho @(forw==0?"hide":"")" colspan="@(forw)">FORWARD</th>
                        <th id="forwardTotal" class="@(forw==0?"hide":"") borde-derecho-oscuro" rowspan="2">TOTAL FORWARD</th>
                        <td class="espacio @(forw==0?"hide":"")"> </td>
                        <th id="newCrop" class="borde-derecho @(newc==0?"hide":"")" colspan="@(newc)">NEW CROP</th>
                        <th id="newCropTotal" class="@(newc==0?"hide":"") borde-derecho-oscuro" rowspan="2">TOTAL NEW CROP</th>

                    </tr>
                    <tr class="titulos">
                        <th class="producto borde-izquierdo">PRODUCTO</th>
                        <th class="valores @(dispAFijar ? "" : "hide")">A Fijar</th>
                        <th class="valores @(dispAPrecio ? "" : "hide")">A Precio</th>
                        <th class="valores @(dispFijacion ? " " : " hide")">Fijación</th>
                        <th class="valores @(dispAgente ? " " : "hide")">MAT</th>
                        <td class="espacio @(disp==0?"hide":"")"></td>
                        <th class="valores @(forwAFijar ? "" : "hide")">A Fijar</th>
                        <th class="valores @(forwAPrecio ? "" : "hide")">A Precio</th>
                        <th class="valores @(forwFijacion ? " " : " hide")">Fijación</th>
                        <th class="valores @(forwAgente ? " " : "hide")">MAT</th>
                        <td class="espacio @(forw==0?"hide":"")"> </td>
                        <th class="valores @(newcAFijar ? "" : "hide")">A Fijar</th>
                        <th class="valores @(newcAPrecio ? "" : "hide")">A Precio</th>
                        <th class="valores @(newcFijacion ? " " : " hide")">Fijación</th>
                        <th class="valores @(newcAgente ? " " : "hide")">MAT</th>

                    </tr>
                    @foreach (var toneladaPrecio in Model.ToneladasGranoTipo)
                    {
                        var posicion = Model.PosicionCompras.Where(x => x.Material.ToLower() == toneladaPrecio.Material.ToLower());
                        var totalDisp = posicion.Select(x => x.PosicionKilos.Sum(y => y.DispFijac + y.DispAFijar + y.DispAPrecio)).Sum() + toneladaPrecio.DispAgente;
                        var totalForw = posicion.Select(x => x.PosicionKilos.Sum(y => y.FrwAFijar + y.FrwAPrecio + y.FrwFijac)).Sum() + toneladaPrecio.FrwAgente;
                        var totalNewC = posicion.Select(x => x.PosicionKilos.Sum(y => y.NewAFijar + y.NewAPrecio + y.NewFijac)).Sum() + toneladaPrecio.NewAgente;

                        if (totalDisp != 0 || totalForw != 0 || totalNewC != 0)
                        {
                            <tr>
                                <th class="borde-izquierdo">@toneladaPrecio.Material</th>
                                <td class="@(dispAFijar ? "" : "hide")">@(posicion.Select(x => x.PosicionKilos.Sum(y => y.DispAFijar)).Sum().ToString("N0"))</td>
                                <td class="@(dispAPrecio ? "" : "hide")">@(posicion.Select(x => x.PosicionKilos.Sum(y => y.DispAPrecio)).Sum().ToString("N0"))</td>
                                <td class="@(dispFijacion ? "" : "hide")">@(posicion.Select(x => x.PosicionKilos.Sum(y => y.DispFijac)).Sum().ToString("N0"))</td>
                                <td class="@(dispAgente ? "" : "hide")">@toneladaPrecio.DispAgente.ToString("N0")</td>
                                <td class="@(disp == 0 ? "hide" : "") borde-derecho-oscuro">@totalDisp.ToString("N0")</td>

                                <td class="espacio @(disp == 0 ? "hide" : "")"></td>
                                <td class="@(forwAFijar ? "" : "hide")">@(posicion.Select(x => x.PosicionKilos.Sum(y => y.FrwAFijar)).Sum().ToString("N0"))</td>
                                <td class="@(forwAPrecio ? "" : "hide")">@(posicion.Select(x => x.PosicionKilos.Sum(y => y.FrwAPrecio)).Sum().ToString("N0"))</td>
                                <td class="@(forwFijacion ? "" : "hide")">@(posicion.Select(x => x.PosicionKilos.Sum(y => y.FrwFijac)).Sum().ToString("N0"))</td>
                                <td class="@(forwAgente ? "" : "hide")">@toneladaPrecio.FrwAgente.ToString("N0")</td>
                                <td class="@(forw == 0 ? "hide" : "") borde-derecho-oscuro">@totalForw.ToString("N0")</td>

                                <td class="espacio @(forw == 0 ? "hide" : "")"> </td>
                                <td class="@(newcAFijar ? "" : "hide")">@(posicion.Select(x => x.PosicionKilos.Sum(y => y.NewAFijar)).Sum().ToString("N0"))</td>
                                <td class="@(newcAPrecio ? "" : "hide")">@(posicion.Select(x => x.PosicionKilos.Sum(y => y.NewAPrecio)).Sum().ToString("N0"))</td>
                                <td class="@(newcFijacion ? "" : "hide")">@(posicion.Select(x => x.PosicionKilos.Sum(y => y.NewFijac)).Sum().ToString("N0"))</td>
                                <td class="@(newcAgente ? "" : "hide")">@toneladaPrecio.NewAgente.ToString("N0")</td>
                                <td class="@(newc == 0 ? "hide" : "") borde-derecho-oscuro">@totalNewC.ToString("N0")</td>

                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="row">
        @foreach (var material in Model.PosicionCompras)
        {

            dispAFijar = material.PosicionKilos.Any(x => x.DispAFijar > 0);
            dispAPrecio = material.PosicionKilos.Any(x => x.DispAPrecio > 0);
            dispFijacion = material.PosicionKilos.Any(x => x.DispFijac > 0);
            forwAFijar = material.PosicionKilos.Any(x => x.FrwAFijar > 0);
            forwAPrecio = material.PosicionKilos.Any(x => x.FrwAPrecio > 0);
            forwFijacion = material.PosicionKilos.Any(x => x.FrwFijac > 0);
            newcAFijar = material.PosicionKilos.Any(x => x.NewAFijar > 0);
            newcAPrecio = material.PosicionKilos.Any(x => x.NewAPrecio > 0);
            newcFijacion = material.PosicionKilos.Any(x => x.NewFijac > 0);
            var totalPesos = material.PosicionKilos.Sum(y => y.KilosPesos);
            var totalDolares = material.PosicionKilos.Sum(y => y.KilosDolares);
            var fix = 3 - (dispFijacion ? 0 : 1) - (forwFijacion ? 0 : 1) - (newcFijacion ? 0 : 1);
            var aFijar = 3 - (dispAFijar ? 0 : 1) - (forwAFijar ? 0 : 1) - (newcAFijar ? 0 : 1);
            var aPrecio = 3 - (dispAPrecio ? 0 : 1) - (forwAPrecio ? 0 : 1) - (newcAPrecio ? 0 : 1);
            var suma = fix + aFijar + aPrecio + (totalPesos != 0 ? 1 : 0) + (totalDolares != 0 ? 1 : 0);
            var pondPesos = material.PosicionKilos.Any(x => x.PrecioPonderadoPesos > 0) ? 1 : 0;
            var pondDolares =material.PosicionKilos.Any(x => x.PrecioPonderadoDolares > 0) ? 1 : 0;
            var pond = pondPesos + pondDolares;
            <div id="@material.Material.Replace(" ", "")Table" class="col-xs-12 @(suma <= 5? "col-md-6":"col-md-12") @(suma>0? "":"hide")">
                <table id="@material.Material.Replace(" ", "")" class="table table-condensed">
                    <tbody>
                        <tr class="titulosPosicion"><th colspan="@(suma + pond + 3)">@material.Material.ToUpper()</th></tr>
                        <tr class="titulosPosicion @(suma>0?"":"hide")">
                            <th rowspan="2">Posición</th>
                            <th colspan="@fix" class="@(fix>0?"" :"hide") borde-izq-der">Fix</th>
                            <th colspan="@aFijar" class="@(aFijar>0?"" :"hide") borde-izq-der">A Fijar</th>
                            <th colspan="@aPrecio" class="@(aPrecio>0?"" :"hide") borde-izq-der">A Precio</th>
                            <th rowspan="2" class="@(totalPesos!= 0?"" :"hide")">Ton. $</th>
                            <th rowspan="2" class="@(totalDolares!= 0?"" :"hide")">Ton. USD</th>
                            <th rowspan="2" class="@(pondPesos>0?"":"hide")">$ Pond.</th>
                            <th rowspan="2" class="@(pondDolares>0?"":"hide")">USD Pond</th>
                            <th rowspan="2"></th>
                            <th rowspan="2"></th>
                        </tr>
                        <tr class="titulosPosicion">
                            <th class="@(dispFijacion? "":"hide") borde-izq-der">Disponible</th>
                            <th class="@(forwFijacion? "":"hide") borde-izq-der">Forward</th>
                            <th class="@(newcFijacion? "":"hide") borde-izq-der">New Crop</th>
                            <th class="@(dispAFijar? "":"hide") borde-izq-der">Disponible</th>
                            <th class="@(forwAFijar? "":"hide") borde-izq-der">Forward</th>
                            <th class="@(newcAFijar? "":"hide") borde-izq-der">New Crop</th>
                            <th class="@(dispAPrecio? "":"hide") borde-izq-der">Disponible</th>
                            <th class="@(forwAPrecio? "":"hide") borde-izq-der">Forward</th>
                            <th class="@(newcAPrecio? "":"hide") borde-izq-der">New Crop</th>
                        </tr>

                        @foreach (var mes in material.PosicionKilos.OrderBy(x => x.Anio).ThenBy(x => x.Mes))
                        {
                            int mesActual = (int)((EnumMeses)Enum.Parse(typeof(EnumMeses), mes.Mes.ToString()));
                    <tr>
                        <td> @mes.Mes - @mes.Anio</td>
                        <td class="@(dispFijacion? "":"hide") borde-izq-der">@mes.DispFijac.ToString("N0")</td>
                        <td class="@(forwFijacion? "":"hide") borde-izq-der">@mes.FrwFijac.ToString("N0")</td>
                        <td class="@(newcFijacion? "":"hide") borde-izq-der">@mes.NewFijac.ToString("N0")</td>
                        <td class="@(dispAFijar? "":"hide") borde-izq-der">@mes.DispAFijar.ToString("N0")</td>
                        <td class="@(forwAFijar? "":"hide") borde-izq-der">@mes.FrwAFijar.ToString("N0")</td>
                        <td class="@(newcAFijar? "":"hide") borde-izq-der">@mes.NewAFijar.ToString("N0")</td>
                        <td class="@(dispAPrecio? "":"hide") borde-izq-der">@mes.DispAPrecio.ToString("N0")</td>
                        <td class="@(forwAPrecio? "":"hide") borde-izq-der">@mes.FrwAPrecio.ToString("N0")</td>
                        <td class="@(newcAPrecio? "":"hide") borde-izq-der">@mes.NewAPrecio.ToString("N0")</td>
                        <td class="@(totalPesos!=0 ? "" :"hide")"> @(mes.KilosPesos.ToString("N0"))</td>
                        <td class="@(totalDolares!=0 ? "" :"hide")"> @(mes.KilosDolares.ToString("N0"))</td>
                        <td class="@(pondPesos>0?"":"hide")"> @(mes.PrecioPonderadoPesos.Value.ToString("N0"))</td>
                        <td class="@(pondDolares>0?"":"hide")"> @(mes.PrecioPonderadoDolares.Value.ToString("N0"))</td>
                        <td>
                            <a class="descargarDetallePosicion" data-toggle="tooltip" title="Descargar Excel" href="@Url.Action("DetalleExcel", "ReporteCompraNet", new { material.MaterialId, mes = mesActual, anio = mes.Anio, fechaString = ViewBag.Fecha, fechaHastaString = ViewBag.FechaHasta, centroId = ViewBag.CentroSeleccionado, clasificacion = (material.Material.ToUpper() == "TRIGO CALIDAD") })">
                                <span>
                                    <i class="fa fa-file-excel-o"></i>
                                </span>
                            </a>
                            @*@Html.ActionLink("Descarga", "DetalleExcel", "ReporteCompraNet", new { material.MaterialId, mes = mesActual, anio = mes.Anio, fechaString = ViewBag.Fecha, fechaHastaString = ViewBag.FechaHasta, centroId = ViewBag.CentroSeleccionado, clasificacion = (material.Material.ToUpper() == "TRIGO CALIDAD") }, new { @class = "Descarga" })*@
                        </td>
                        <td>
                            <a id="AbrirModal" data-toggle="tooltip" title="Visualizar detalle" class="abrirModalDetallePosicion" onclick="AbrirModal(@material.MaterialId, @mesActual, @mes.Anio, '@ViewBag.Fecha', '@ViewBag.FechaHasta', '@material.Material.ToUpper()', '@mes.Mes.ToString().ToUpper()')">
                                <span>
                                    <i class="fa fa-eye"></i>
                                </span>
                            </a>
                        </td>
                    </tr>
                        }
                    <tr class="titulosPosicion total">
                        <th>Total</th>
                        <td class="@(dispFijacion? "":"hide")">@material.PosicionKilos.Sum(y => y.DispFijac).ToString("N0")</td>
                        <td class="@(forwFijacion? "":"hide")">@material.PosicionKilos.Sum(y => y.FrwFijac).ToString("N0")</td>
                        <td class="@(newcFijacion? "":"hide")">@material.PosicionKilos.Sum(y => y.NewFijac).ToString("N0")</td>
                        <td class="@(dispAFijar? "":"hide")">@material.PosicionKilos.Sum(y => y.DispAFijar).ToString("N0")</td>
                        <td class="@(forwAFijar? "":"hide")">@material.PosicionKilos.Sum(y => y.FrwAFijar).ToString("N0")</td>
                        <td class="@(newcAFijar? "":"hide")">@material.PosicionKilos.Sum(y => y.NewAFijar).ToString("N0")</td>
                        <td class="@(dispAPrecio? "":"hide")">@material.PosicionKilos.Sum(y => y.DispAPrecio).ToString("N0")</td>
                        <td class="@(forwAPrecio? "":"hide")">@material.PosicionKilos.Sum(y => y.FrwAPrecio).ToString("N0")</td>
                        <td class="@(newcAPrecio? "":"hide")">@material.PosicionKilos.Sum(y => y.NewAPrecio).ToString("N0")</td>
                        <th class="@(totalPesos!= 0?"" :"hide")">@totalPesos.ToString("N0")</th>
                        <th class="@(totalDolares!= 0?"" :"hide")">@totalDolares.ToString("N0")</th>
                        <td class="@(pond>0?"":"hide")" colspan="@pond"></td>
                        <td></td>
                        <td></td>
                    </tr>
                    </tbody>
                </table>
            </div>
        }
        <div class="col-xs-12 col-md-6 @(Model.AgenteCompras.ListaAgenteCompras.Count > 0 ?"":"hide")">
            <table id="agenteCompras" class="table-condensed">
                <tr class="titulos agente">
                    <th colspan="@(Model.AgenteCompras.ListaOperadores.Count+3)">AGENTE DE COMPRA MAT</th>
                    <th style="display:inline-flex;">
                        @Html.ActionLink("Descarga", "ExcelAgente", "ReporteCompraNet", new { fechaString = ViewBag.Fecha }, new { @class = "Descarga" })
                        <a id="AbrirModalAgente" class="abrirModal" onclick="ModalAgenteCompras('@ViewBag.Fecha')">Ver</a>
                    </th>
                </tr>
                <tr class="titulos agente">
                    <th>Producto</th>
                    <th>Posición</th>
                    <th>Total</th>
                    <th>USD Pond.</th>
                    @foreach (var op in Model.AgenteCompras.ListaOperadores)
                    {
                        <th>@op.OperadorDesc</th>
                    }
                </tr>
                @foreach (var agente in Model.AgenteCompras.ListaAgenteCompras)
                {
                    var pos = agente.Posicion.Split('.');
                    <tr>
                        <td>@agente.MaterialDesc</td>

                        <td>@((EnumMeses)Enum.ToObject(typeof(EnumMeses), Int32.Parse(pos[0])) + " - " + pos[1])</td>
                        <td>@agente.Operador.Sum(x => x.Cantidad).ToString("N0")</td>
                        <td>@agente.PrecioPonderado.ToString("N2")</td>

                        @foreach (var op in Model.AgenteCompras.ListaOperadores)
                        {
                            var cantidad = agente.Operador.Where(x => x.OperadorId == op.OperadorId).Select(x => x.Cantidad.ToString("N0")).FirstOrDefault();
                            <td> @(cantidad != null ? cantidad : "0") </td>
                        }

                    </tr>
                }
            </table>
        </div>
        <div class="col-xs-6 col-md-3 @(Model.SojaSustentable.Total > 0 ?"":"hide")">
            <table class="table-condensed " id="SojaSustentable">
                <tbody>
                    <tr>
                        <th class="titulos" colspan="3">SOJA SUSTENTABLE</th>
                    </tr>
                    <tr>
                        <th class="@(Model.SojaSustentable.Precio > 0 ? "":"hide")">A Precio</th>
                        <th class="@(Model.SojaSustentable.Fijar > 0 ? "":"hide")">A Fijar</th>
                        <th>Total</th>
                    </tr>
                    <tr>
                        <td class="@(Model.SojaSustentable.Precio > 0 ? "":"hide")">@Model.SojaSustentable.Precio.ToString("N0")</td>
                        <td class="@(Model.SojaSustentable.Fijar > 0 ? "":"hide")">@Model.SojaSustentable.Fijar.ToString("N0")</td>
                        <th>@Model.SojaSustentable.Total.ToString("N0")</th>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="col-xs-6 col-md-3">
            <table class="table-condensed noSideMargin" id="MonedaKilo">
                <tbody>
                    @foreach (var moneda in Model.PrecioCantidad)
                    {
                        <tr class="total @(moneda.Cantidad>0?"":"hide")">
                            <th>@moneda.Moneda</th>
                            <td>@moneda.Cantidad.Value.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>

<script>
    var data = {PricingCumplido : Number(@Model.HedgeObjetivo.PricingCumplido.ToString().Replace(',','.')),
                RemitirCumplido : Number(@Model.HedgeObjetivo.RemitirCumplido.ToString().Replace(',','.')),
                PricingObjetivo : Number(@Model.HedgeObjetivo.PricingObjetivo.ToString().Replace(',','.')),
                RemitirObjetivo : Number(@Model.HedgeObjetivo.RemitirObjetivo.ToString().Replace(',','.'))}
    CrearGraficoHedgeObjetivo(data)
</script>