                                    list.AddRange(material.PosicionKilos.Select(a => a.ListNewFijac).Select(b => b.Select(c => c)).SelectMany(l => l).Distinct().ToList());
                                    list.AddRange(material.PosicionKilos.Select(a => a.ListDispAFijar).Select(b => b.Select(c => c)).SelectMany(l => l).Distinct().ToList());
                                    list.AddRange(material.PosicionKilos.Select(a => a.ListFrwAFijar).Select(b => b.Select(c => c)).SelectMany(l => l).Distinct().ToList());
