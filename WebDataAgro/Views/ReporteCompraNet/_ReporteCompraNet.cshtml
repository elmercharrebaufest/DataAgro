@using Molinos.DataAgro.Entities.Common.Enums
@model WebDataAgro.Models.ReporteCompraNetModel

<div id="ReportesCompraNet" class="Titulo">
    <h5> Compras Del Día </h5>

    <br />
    <div class="container">
        <div class="row">
            <div class="table-responsive col-md-12">
                <table class="table-condensed noSideMargin" id="ComprasToneladasTipo">
                    <tbody>
                        <tr class="titulos">
                            <td id="" class="borde-derecho"></td>
                            <th id="disponible" class="borde-derecho" colspan="3">DISPONIBLE</th>
                            <th id="forward" class="borde-derecho" colspan="3">FORWARD</th>
                            <th id="newCrop" class="borde-derecho" colspan="3">NEW CROP</th>
                            <td></td>
                        </tr>
                        <tr class="titulos">
                            <th class="producto borde-derecho">PRODUCTO</th>
                            <th class="valores">A FIJAR</th>
                            <th class="valores">A PRECIO</th>
                            <th class="valores borde-derecho">FIJACIÓN</th>
                            <th class="valores">A FIJAR</th>
                            <th class="valores">A PRECIO</th>
                            <th class="valores borde-derecho">FIJACIÓN</th>
                            <th class="valores">A FIJAR</th>
                            <th class="valores">A PRECIO</th>
                            <th class="valores borde-derecho">FIJACIÓN</th>
                            <th class="valores">TOTAL</th>
                        </tr>
                        @foreach (var toneladaPrecio in Model.ToneladasGranoTipo)
                        {
                            <tr>
                                <th class="borde-derecho">@toneladaPrecio.Material</th>
                                <td>@toneladaPrecio.DispAFijar.ToString("N0")</td>
                                <td>@toneladaPrecio.DispAPrecio.ToString("N0")</td>
                                <td class="borde-derecho">@toneladaPrecio.DispFijac.ToString("N0")</td>
                                <td>@toneladaPrecio.FrwAFijar.ToString("N0")</td>
                                <td>@toneladaPrecio.FrwAPrecio.ToString("N0")</td>
                                <td class="borde-derecho">@toneladaPrecio.FrwFijac.ToString("N0")</td>
                                <td>@toneladaPrecio.NewAFijar.ToString("N0")</td>
                                <td>@toneladaPrecio.NewAPrecio.ToString("N0")</td>
                                <td class="borde-derecho">@toneladaPrecio.NewFijac.ToString("N0")</td>
                                <th>@toneladaPrecio.Total.ToString("N0")</th>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                @foreach (var material in Model.PosicionCompras)
                {
                    <div class="col-xs-6 col-md-4">
                        <table id="@material.Material" class="table-condensed">
                            <tbody>

                                @if (material.Material == "Soja" || material.Material == "Maíz")
                                {
                                    <tr class="titulos"><th colspan="3">@material.Material</th></tr>
                                    <tr>
                                        <th>POSICIÓN</th>
                                        <th>KG</th>
                                        <th></th>
                                    </tr>

                                    foreach (var mes in (EnumMeses[])Enum.GetValues(typeof(EnumMeses)))
                                    {
                                        int mesActual = (int)((EnumMeses)Enum.Parse(typeof(EnumMeses), mes.ToString()));
                                        <tr>
                                            <td> @mes </td>
                                            <td> @(material.PosicionKilos.Where(x => x.Mes == mes).Select(x => x.Kilos).DefaultIfEmpty(0).FirstOrDefault().ToString("N0"))</td>
                                            <td>
                                                @Html.ActionLink("Descarga", "DetalleExcel", "ReporteCompraNet", new { material.MaterialId, mes = mesActual }, new { @class = "Descarga" })
                                            </td>
                                        </tr>
                                    }
                                    <tr class="total">
                                        <th>Total</th>
                                        <th>@material.Total.ToString("N0")</th>
                                        <td></td>
                                    </tr>
                                }
                                else
                                {
                                    var calidad = false;
                                    if (material.Material == "Trigo Calidad")
                                    {
                                        calidad = true;
                                    }
                                    <tr class="titulos"><th colspan="3">@material.Material</th></tr>
                                    <tr>
                                        <th>POSICIÓN</th>
                                        <th>KG</th>
                                        <th></th>
                                    </tr>
                                    <tr>
                                        <td>Noviembre</td>
                                        <td>@material.PosicionKilos.Where(x => x.Mes == EnumMeses.Noviembre).Select(x => x.Kilos).DefaultIfEmpty(0).FirstOrDefault().ToString("N0")</td>
                                        <td>
                                            @Html.ActionLink("Descarga", "DetalleExcel", "ReporteCompraNet", new { material.MaterialId, mes = 11, calidad }, new { @class = "Descarga" })
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Diciembre</td>
                                        <td>@material.PosicionKilos.Where(x => x.Mes == EnumMeses.Diciembre).Select(x => x.Kilos).DefaultIfEmpty().FirstOrDefault().ToString("N0")</td>
                                        <td>
                                            @Html.ActionLink("Descarga", "DetalleExcel", "ReporteCompraNet", new { material.MaterialId, mes = 12, calidad }, new { @class = "Descarga" })
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Enero</td>
                                        <td>@material.PosicionKilos.Where(x => x.Mes == EnumMeses.Enero).Select(x => x.Kilos).DefaultIfEmpty().FirstOrDefault().ToString("N0")</td>
                                        <td>
                                            @Html.ActionLink("Descarga", "DetalleExcel", "ReporteCompraNet", new { material.MaterialId, mes = 1, calidad }, new { @class = "Descarga" })
                                        </td>
                                    </tr>
                                    <tr>
                                        <td>Febrero</td>
                                        <td>@material.PosicionKilos.Where(x => x.Mes == EnumMeses.Febrero).Select(x => x.Kilos).DefaultIfEmpty().FirstOrDefault().ToString("N0")</td>
                                        <td>
                                            @Html.ActionLink("Descarga", "DetalleExcel", "ReporteCompraNet", new { material.MaterialId, mes = 2, calidad }, new { @class = "Descarga" })
                                        </td>
                                    </tr>
                                    <tr class="total">
                                        <th>Total</th>
                                        <th>@material.Total.ToString("N0")</th>
                                        <td></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            <div>
                <div class="col-md-12">
                    <table class="table-condensed col-xs-12 col-md-3 col-md-offset-2" id="SojaSustentable">
                        <tbody>
                            <tr>
                                <th class="titulos" colspan="3">SOJA SUSTENTABLE</th>
                            </tr>
                            <tr>
                                <th>A PRECIO</th>
                                <th>A FIJAR</th>
                                <th>TOTAL</th>
                            </tr>
                            <tr>
                                <td>@Model.SojaSustentable.Precio.ToString("N0")</td>
                                <td>@Model.SojaSustentable.Fijar.ToString("N0")</td>
                                <th>@Model.SojaSustentable.Total.ToString("N0")</th>
                            </tr>
                        </tbody>
                    </table>
                    <table class="table-condensed noSideMargin col-xs-12 col-md-3 col-md-offset-2" id="MonedaKilo">
                        <tbody>
                            @foreach (var moneda in Model.PrecioCantidad)
                            {
                                <tr class="total">
                                    <th>@moneda.Moneda</th>
                                    <td>@moneda.Cantidad.Value.ToString("N2")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
