                    <th colspan="@(Model.AgenteCompras.ListaOperadores.Count + 3)">AGENTE DE COMPRA MAT</th>
                    <th style="display:inline-flex;">
                        @Html.ActionLink("Descarga", "ExcelAgente", "ReporteCompraNet", new { fechaString = ViewBag.Fecha,materialId = ViewBag.Materiales }, new { @class = "Descarga" })
                        <a id="AbrirModalAgente" class="abrirModal" onclick="ModalAgenteCompras('@ViewBag.Fecha')">Ver</a>
                    </th>
                </tr>
                <tr class="titulos agente">
                    <th>Producto</th>
                    <th>Posición</th>
                    <th>Total</th>
                    <th>USD Pond.</th>
                    @foreach (var op in Model.AgenteCompras.ListaOperadores)
                    {
                        <th>@op.OperadorDesc</th>
                    }
                </tr>
                @foreach (var agente in Model.AgenteCompras.ListaAgenteCompras)
                {
                    var pos = agente.Posicion.Split('.');
                    <tr>
                        <td>@agente.MaterialDesc</td>

                        <td>@((EnumMeses)Enum.ToObject(typeof(EnumMeses), Int32.Parse(pos[0])) + " - " + pos[1])</td>
                        <td>
                            <a id="AbrirModal" data-toggle="tooltip" title="Visualizar detalle" class="" onclick="AbrirModalIds('@((EnumMeses)Enum.ToObject(typeof(EnumMeses), Int32.Parse(pos[0])) + " - " + pos[1])', '@agente.MaterialDesc', '','@String.Join(",", agente.Operador.Select(a => a.Ids).Select(b => b.Select(c => c)).SelectMany(l => l).Distinct().ToList())')">
                                @agente.Operador.Sum(x => x.Cantidad).ToString("N0")
                            </a>
                        </td>
                        <td>@agente.PrecioPonderado.ToString("N2")</td>

                        @foreach (var op in Model.AgenteCompras.ListaOperadores)
                        {
                            var cantidad = agente.Operador.Where(x => x.OperadorId == op.OperadorId).Select(x => x.Cantidad.ToString("N0")).FirstOrDefault();
                            var operador = agente.Operador.Where(x => x.OperadorId == op.OperadorId).FirstOrDefault();
                            if (operador == null)
                            {
                                operador = new Molinos.DataAgro.Entities.Dto.AgenteCompraDto.OperadorCantidad();
                            }
                            <td>

                                <a id="AbrirModal" data-toggle="tooltip" title="Visualizar detalle" class="" onclick="AbrirModalIds('@((EnumMeses)Enum.ToObject(typeof(EnumMeses), Int32.Parse(pos[0])) + " - " + pos[1])', '@agente.MaterialDesc', '','@String.Join(",", operador.Ids)')">
                                    @(cantidad != null ? cantidad : "0")
                                </a>
                            </td>
                        }

                    </tr>
                }
                <tr>
                    <th></th>
                    <th>Total</th>
                    <th>

                        @{List<int> values = new List<int>();
                            Model.AgenteCompras.ListaAgenteCompras.ForEach(agente => values.AddRange(agente.Operador.Select(a => a.Ids).Select(b => b.Select(c => c)).SelectMany(l => l).Distinct().ToList()));
                        }
                        <a id="AbrirModal" data-toggle="tooltip" title="Visualizar detalle" class="" onclick="AbrirModalIds('', '', '','@string.Join(",",values)')">
                            @Model.AgenteCompras.ListaAgenteCompras.Sum(x => x.Operador.Sum(y => y.Cantidad)).ToString("N0")
                        </a>
                    </th>
                    <th></th>
                    @foreach (var op in Model.AgenteCompras.ListaOperadores)
                    {
                        var cantidad = Model.AgenteCompras.ListaAgenteCompras.Sum(x => x.Operador.Where(y => y.OperadorId == op.OperadorId).Sum(y => y.Cantidad));
                        values = new List<int>();
                        Model.AgenteCompras.ListaAgenteCompras.ForEach(agente => values.AddRange(agente.Operador.Where(y => y.OperadorId == op.OperadorId).Select(a => a.Ids).Select(b => b.Select(c => c)).SelectMany(l => l).Distinct().ToList()));

                        <th>
                            <a id="AbrirModal" data-toggle="tooltip" title="Visualizar detalle" class="" onclick="AbrirModalIds('', '', '','@string.Join(",",values)','')">
                                @cantidad
                            </a>
                        </th>
                    }
                </tr>
            </table>
        </div>
