@{
    ViewBag.Title = "Reporte CompraNet";
}

@section Styles {
    <link href="~/Content/ReporteCompraNet.css" rel="stylesheet" />
}

<script type="text/javascript" src="~/Scripts/Chart.js"></script>
<script type="text/javascript" src="~/Scripts/App/ReporteCompranet.js"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>


<div class="Titulo">

    @using (Ajax.BeginForm("PartialReporteCompraNet", null, new AjaxOptions { HttpMethod = "GET", InsertionMode = InsertionMode.Replace, UpdateTargetId = "CuerpoCompraNet" }, null))
    {
        @Html.AntiForgeryToken();
        <div class="container-reporte">
            <div id="fecha-buscador-reporte" class="row">
                <div class="col-sm-1 noRightPadding">
                    <label>Fecha Desde</label>
                </div>
                <div class="col-sm-4 col-md-2">
                    <span id="fechaReporte">
                        <input id="fecha" name="fechaString" type="date" style="width: 100%" />
                    </span>
                </div>
                <div class="col-sm-1 noRightPadding">
                    <label>Fecha Hasta</label>
                </div>
                <div class="col-sm-4 col-md-2">
                    <span id="fechaHastaReporte">
                        <input id="fechaHasta" name="fechaHastaString" type="date" style="width: 100%" />
                    </span>
                </div>
                <button type="submit" id="buscar-reporte" class="k-button k-button-icontext sideMargin-15">Buscar</button>
                @Html.ActionLink("Descargar Reporte", "ReporteComprasDelDia", "ReporteCompraNet", new { }, new { @class = "k-button k-button-icontext sideMargin-15", @id = "descargaReporte" })
            </div>
        </div>
    }
    <div id="CuerpoCompraNet" class="container-reporte">
        @Html.Action("PartialReporteCompraNet", new { fechaString = DateTime.Now.Date.ToString(), fechaHastaString = DateTime.Now.Date.ToString() })
    </div>
</div>


<!-- Modal Detalle Posicion-->
@Html.Partial("ModalDetallePosicion")

<!-- Modal Agente-->
@Html.Partial("ModalAgente")

