@{
    ViewBag.Title = "Reporte CompraNet";
}

@section Styles {
    <link href="~/Content/ReporteCompraNet.css" rel="stylesheet" />
}
<script type="text/javascript">
    $(document).ready(function () {
        setInterval(Refrescar, 300000);
    });

    function Refrescar() {
        $.get("@Url.Action("_ReporteCompraNet")", function (data) {
            $("#ReportesCompraNet").html(data);
        });
    };
</script>
<div id="CuerpoCompraNet">
       @Html.Action("_ReporteCompraNet")
</div>

