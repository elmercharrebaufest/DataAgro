@{
    Layout = null;
}
@section Styles {
    <link href="~/Content/ReporteCompraNet.css" rel="stylesheet" />
}
<div class="modal fade" id="ModalDetalleFijacion" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog modal-mio">
        <div class="modal-content">
            <div class="modal-header ">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span><span class="sr-only">Close</span></button>
                <h1 class="modal-title-confirmado" id="lineModalLabel"></h1>
                <div class="status confirmado-modal">
                    <div id="titulo" class="tituloPosicion"></div>
                </div>
            </div>
            <div class="modal-body clearfix scrollInside">
                <div class="wizard-header-contenedor-grupo">
                    <ul class="nav nav-tabs">
                        <li class="active"><a data-toggle="pill" href="#tabResumen">Resumen</a></li>
                        <li><a data-toggle="pill" href="#tabDetalle">Detalle</a></li>
                    </ul>

                    <div class="tab-content" style="padding: 30px">
                        <div id="tabResumen" class="row tab-pane fade in active">
                            <div class="row">
                                <div class="col-md-6">
                                    <div id="grillaFijacionLarga"  style="width: fit-content !important;">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div id="grillaFijacionCorta" style="width: fit-content !important;">
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div id="tabDetalle" class="row tab-pane fade in" hidden>
                            <div id="grillaDetalle" style="width: fit-content !important;"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer clearfix ">
                    <div class="align-right">
                        <button type="button" id="cancelarContratoPendiente" class="btn " data-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
