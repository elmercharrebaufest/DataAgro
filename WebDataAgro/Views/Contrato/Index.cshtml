@{
    //Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Reporte de contratos";
}

@section Scripts {
    @Scripts.Render("~/bundles/ContratoIndex")
}

@section Styles {
    <link href="~/Content/ReporteContrato.css" rel="stylesheet" />
}

<div class="Titulo">
    <h5> Reporte de Negocios CompraNet </h5>

    <br />
</div>
<div class="filtro-desplegable" data-toggle="collapse" data-target="#filtrar" onclick="mostrarocultar('#mostrar')">
    <div class="k-button"><span class="filtro">Filtro</span> <strong><span id="mostrar" class="mostrar" style="font-size: 12px !important;">Mostrar</span></strong></div>
</div>
<br />

<div id="filtrar" class="container collapse">
    <div class="row">
        <div class="col-md-2">
            <label>Corredor</label>
        </div>
        <div class="col-md-4">
            <input id="buscadorCorredor" name="CorredorId" class="multiselect" style="width:100%" type="text" placeholder="Buscar por CUIT..." required="required" />
        </div>

        <div class="col-md-2">
            <label>Proveedor</label>
        </div>
        <div class="col-md-4">
            <input id="buscadorProveedor" name="ProveedorId" class="multiselect" style="width:100%" type="text" placeholder="Buscar por CUIT, razón social" required="required" />
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Contrato SAP</label>
        </div>
        <div class="col-md-4">
            <div class="row">
                <div class="col-xs-5 noRightPadding">
                    @Html.TextBox("ContratoSAP", "", new { @class = "form-control filtroAgregarValorPopUp", style = "width:100%", @id = "ContratoSAPId" })
                </div>
                <div class="col-xs-5">
                    @Html.TextBox("ContratoSAPHasta-NoimportaElNombre", "", new { @type = "number", @class = "form-control", style = "width:100%", @id = "ContratoSAPHastaId" })
                </div>
                <div class="col-xs-2 noLeftPadding">
                    <button type="button" id="abrirPopUpCargarValores" class="k-button k-button-icontext fa fa-list" style="height:34px"></button>
                </div>
                <div class="modal fade" id="popUpCargarValores" tabindex="-1" role="dialog" aria-labelledby="CargaContratosLabel" aria-hidden="true">
                </div>
            </div>
        </div>
        <div class="col-md-2">
            <label>Tipo de Negocio</label>
        </div>
        <div class="col-md-4">
            @*@Html.DropDownList("TipoNegocioId", new SelectList(ViewBag.TipoNegocio, "Value", "Text"), "Negocio", new { @class = "form-control filtroBusquedaPorId", @id = "tipoNegocioId" })*@

            @Html.DropDownList("TipoNegocio", new SelectList(
                       new List<SelectListItem>
                {
                    new SelectListItem{ Value = "A FIJAR", Text = "A FIJAR"},
                    new SelectListItem{ Value = "A FIJAR PASE", Text = "A FIJAR PASE"},
                    new SelectListItem{ Value = "A PRECIO", Text = "A PRECIO"},
                    new SelectListItem{ Value = "FIJACION", Text = "FIJACION"},
                    new SelectListItem{ Value = "CONVENIO", Text = "CONVENIO"},
                    new SelectListItem{ Value = "FIJ. CONVENIO", Text = "FIJ. CONVENIO"},
                    new SelectListItem{ Value = "FASON", Text = "FASON"},
                    new SelectListItem{ Value = "AGENTE DE COMPRAS", Text = "AGENTE DE COMPRAS"},
                    new SelectListItem{ Value = "CONTRATO ACUERDO", Text = "CONTRATO ACUERDO"},
                    new SelectListItem{ Value = "FASON MP", Text = "FASON MP"},
                    new SelectListItem{ Value = "AGENTE DE COMPRAS MP", Text = "AGENTE DE COMPRAS MP"},
                    new SelectListItem{ Value = "ACUERDO AGENTE", Text = "ACUERDO AGENTE"},
                    new SelectListItem{ Value = "CANJE", Text = "CANJE"},
                    new SelectListItem{ Value = "PRÉSTAMO DEVOLUCIÓN", Text = "PRÉSTAMO DEVOLUCIÓN"},
                    new SelectListItem{ Value = "VENTA", Text = "VENTA"},
                    new SelectListItem{ Value = "FIJACION VIRTUAL", Text = "FIJACIÓN VIRTUAL"},
                    new SelectListItem{ Value = "FIJACION CANJE", Text = "FIJACIÓN CANJE"},
                    new SelectListItem{ Value = "FIJACION PASE", Text = "FIJACIÓN PASE"}
                }
           , "Value", "Text"), "Negocio", new { @class = "form-control filtroBusquedaTextBox", @id = "TipoNegocio" })
        </div>
        @*<div class="col-md-2">
                <label>Fasón MP</label>
                @Html.CheckBox("EsFason", false, new { @class = "filtroBoleano", style = "position:absolute; right:20px;top:8px", @id = "FasonMpId" })
                <label>Agente de Compra MP</label>
                @Html.CheckBox("EsAgenteDeCompra", false, new { @class = "filtroBoleano", style = "position:absolute; right:20px;top:8px", @id = "AgenteDeCompraMpId" })
            </div>*@
    </div>
    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Fecha de Carga</label>
        </div>
        <div class="col-md-2">
            <span id="fechaDeCarga">
                <input id="fechaCargaId" class="filtroFecha" name="Fecha-desde" type="date" style="width: 100%" />
            </span>
        </div>
        <div class="col-md-2">
            <span id="fechaDeCargaHasta">
                <input id="fechaCargaHastaId" class="filtroFecha" name="Fecha-hasta" type="date" style="width: 100%" />
            </span>
        </div>
        <div class="col-md-2">
            <label>Entrega Desde-Hasta</label>
        </div>
        <div class="col-md-2">
            <span id="fechaDesdeTopeDiv">
                <input id="fechaDesdeTopeId" class="filtroFecha" name="FechaDesde-desde" type="date" style="width: 100%" />
                <img id="errfechaDesdeTopeId" src="~/Content/Images/error.png" style="display:none" />
            </span>
        </div>
        <div class="col-md-2">
            <span id="fechaHastaTopeDiv">
                <input id="fechaHastaTopeId" class="filtroFecha" name="FechaHasta-hasta" type="date" style="width: 100%" />
                <img id="errfechaHastaTopeId" src="~/Content/Images/error.png" style="display:none" />
            </span>
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Fecha Fijación 'Hasta'</label>
        </div>
        <div class="col-md-4">
            <span id="fechaHastaFijacionDiv">
                <input id="fechaHastaFijacionId" class="filtroFecha" name="HastaFijacion-hasta" type="date" style="width: 100%" />
            </span>
        </div>
        <div class="col-md-2">
            <label>Campaña</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownList("CampanaId", new SelectList(ViewBag.Campania, "Value", "Text"), "Seleccione la Campaña", new { @class = "form-control filtroBusquedaPorId", @id = "campaniaId" })
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Material</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownList("MaterialId", new SelectList(ViewBag.Material, "Value", "Text"), "Seleccione el Material", new { @class = "form-control filtroBusquedaPorId", @id = "materialId" })
        </div>
        <div class="col-md-2">
            <label>Zona</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownList("ComercialZonaId", new SelectList(ViewBag.Zona, "Value", "Text"), "Seleccione la Zona", new { @class = "form-control filtroBusquedaPorId", @id = "ComercialZonaId" })
        </div>

    </div>
    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Estado</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownList("Estado", new SelectList(ViewBag.Estado, "Value", "Text"), "Seleccione el Estado", new { @class = "form-control filtroBusquedaPorId", @id = "estadoId" })
        </div>
        <div class="col-md-2">
            <label>Centro</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownList("DestinoId", new SelectList(ViewBag.Centro, "Value", "Text"), "Seleccione el Centro", new { @class = "form-control filtroBusquedaPorId", @id = "centroId" })
        </div>


    </div>
    <br />
    <div class="row">

        <div class="col-md-2">
            <label>Boleto</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownList("BoletoId", new SelectList(ViewBag.Boleto, "Value", "Text"), "Seleccione el Boleto", new { @class = "form-control filtroBusquedaPorId", @id = "BoletoId" })
        </div>
        <div class="col-md-2">
            <label>Comercial</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownList("ComercialId", new SelectList(ViewBag.Comercial, "Value", "Text"), "Seleccione el Comercial", new { @class = "form-control filtroBusquedaPorId", @id = "ComercialId" })
        </div>

    </div>
    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Clasificación</label>
        </div>
        <div class="col-md-4">
            @*@Html.DropDownList("ClasificacionId", new SelectList(ViewBag.Clasificacion, "Value", "Text"), new { @class = "multiselect", @id = "ClasificacionId" })*@
            <input id="ClasificacionId" name="ClasificacionId" class="multiselect" style="width:100%" type="text" placeholder="" required="required" />
        </div>
        <div class="col-md-2">
            <label>Fecha Cierta</label>
            @Html.CheckBox("FechaCiertaTilde", false, new { @class = "filtroBoleano", style = "position:absolute; right:30px;top:8px", @id = "FechaCiertaTildeId" })
        </div>
        <div class="col-md-2">
            <span id="fechaCiertaDesde">
                <input id="FechaCierta" class="filtroFecha" name="FechaCierta-desde" type="date" style="width: 100%" />
            </span>
        </div>
        <div class="col-md-2">
            <span id="fechaCiertaHasta">
                <input id="FechaCiertaHasta" class="filtroFecha" name="FechaCierta-hasta" type="date" style="width: 100%" />
            </span>
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Fecha Dolarizado</label>
            @Html.CheckBox("Dolarizado", false, new { @class = "filtroBoleano", style = "position:absolute; right:10px;top:8px", @id = "DolarizadoId" })
        </div>
        <div class="col-md-3">
            <span id="fechalimiteDiv">
                <input id="fechalimiteId" class="filtroFecha" name="Fecha_Dolarizado-igual" type="date" style="width: 100%" />
            </span>
        </div>
        <div class="col-md-2">
            <label>Días de Diferimiento</label>
            @Html.CheckBox("Pesificado", false, new { @class = "filtroBoleano", style = "position:absolute; right:10px;top:8px", @id = "PesificadoId" })
        </div>
        <div class="col-md-3">
            @Html.TextBox("Dias_Pesificado", "", new { @class = "number filtroBusquedaPorId", style = "width:100%", @id = "Dias_PesificadoId" })
        </div>
        <div class="col-md-2">
            <label>Dolarizado Express</label>
            @Html.CheckBox("DolarizadoExpress", false, new { @class = "filtroBoleano", style = "position:absolute; right:10px;top:8px", @id = "DolarizadoExpress" })
        </div>
    </div>
    <div class="row">
        <div class="col-md-2">
            <label>Sustentable</label>
            @Html.CheckBox("Sustentable", false, new { @class = "filtroBoleano", style = "position:absolute; right:10px;top:8px", @id = "SustentableId" })
        </div>
        <div class="col-md-2">
            <label>Soja EPA</label>
            @Html.CheckBox("EPA", false, new { @class = "filtroBoleano", style = "position:absolute; right:20px;top:8px", @id = "EPAId" })
        </div>
        <div class="col-md-1">
            <label></label>
        </div>
        <div class="col-md-2">
            <label>Importe Susten. o EPA</label>
        </div>
        <div class="col-md-3">
            @Html.TextBox("Importe_Sustentable", "", new { @class = "number filtroBusquedaPorId", style = "width:100%", @id = "Importe_SustentableId" })
        </div>
        <div class="col-md-2">
            <label>Usuario Externo</label>
            @Html.CheckBox("EsUsuarioExterno", false, new { @class = "filtroBoleano", style = "position:absolute; right:10px;top:8px", @id = "EsUsuarioExterno" })
        </div>
    </div>

    <div class="row">
        <div class="col-md-2">
            <label>Con Descarga</label>
            @Html.CheckBox("ConDescarga", false, new { @class = "filtroBoleano", style = "position:absolute; right:10px;top:8px", @id = "ConDescargaId" })
        </div>
        <div class="col-md-2">
            <label>Dolar Exportador</label>
            @Html.CheckBox("DolarExportador", false, new { @class = "filtroBoleano", style = "position:absolute; right:10px;top:8px", @id = "DolarExportadorId" })
        </div>
    </div>

    <br />
    <br />
    <div class="row">

        <div class="col-md-12" style="text-align:right">
            <button type="button" id="filtrar" class="k-button k-button-icontext sideMargin-15 limpiar" style="width: 14%" onclick="Filtrar()">Filtrar</button>
        </div>
    </div>

</div>

<br />
<script type="text/x-kendo-template" id="templateToolbar">
    <div class="">
        <a role="button" class="k-button k-button-icontext k-grid-excel" href="\\#"><span class="k-icon k-i-file-excel"></span>Export to Excel</a>
        <a class="k-button k-button-icontext" onclick="customExport()" href="\\#"><span class="k-icon k-i-file-excel"></span>Reporte Comercial</a>
    </div>
</script>
<div class="resultado">
    <div id="grid" class="tabla-result">
    </div>
</div>
