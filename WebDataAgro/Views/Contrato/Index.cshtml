@model Molinos.DataAgro.Entities.Dto.FiltroReporteNegocioDto
@{
    //Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Reporte de contratos";
}

@section Scripts {
    @Scripts.Render("~/bundles/ContratoIndex")
}

@section Styles {
    <link href="~/Content/ReporteContrato.css" rel="stylesheet" />
}

<div class="Titulo">
    <h5> Reporte de Negocios CompraNet </h5>

    <br />
</div>
<div class="filtro-desplegable" data-toggle="collapse" data-target="#filtrar" onclick="mostrarocultar('#mostrar')">
    <div class="k-button"><span class="filtro">Filtro</span> <strong><span id="mostrar" class="mostrar" style="font-size: 12px !important;">Mostrar</span></strong></div>
</div>
<br />

<div id="filtrar" class="container collapse">
    <div class="row">
        <div class="col-md-2">
            <label>Corredor</label>
        </div>
        <div class="col-md-4">
            <input id="buscadorCorredor" class="multiselect" style="width:100%" type="text" placeholder="Buscar por CUIT..." required="required" />
        </div>

        <div class="col-md-2">
            <label>Proveedor</label>
        </div>
        <div class="col-md-4">
            <input id="buscadorProveedor" class="multiselect" style="width:100%" type="text" placeholder="Buscar por CUIT, razón social" required="required" />
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Contrato SAP</label>
        </div>
        <div class="col-md-4">
            <div class="col-xs-5 noLeftPadding front">
                @Html.TextBoxFor(x => x.ContratoSAP, new { @class = "form-control", style = "width:100%" })
            </div>
            <div class="col-xs-5 noLeftPadding noRightPadding front">
                @Html.TextBoxFor(x => x.ContratoSAPHasta, new { @class = "form-control", style = "width:100%" })
            </div>
            <div id="lista-contratos" class="col-xs-2 front">
                <button type="button" id="contratos" class="k-button k-button-icontext fa fa-list" style="height:34px"></button>
            </div>
        </div>
        <div class="col-md-2">
            <label>Tipo de Negocio</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownListFor(m => m.TipoNegocioId, new SelectList(ViewBag.TipoNegocio, "Value", "Text"), "Seleccione el Negocio", new { @class = "form-control", @id = "tipoNegocioId" })
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Fecha de Carga</label>
        </div>
        <div class="col-md-2">
            <span id="fechaDeCarga">
                <input id="fechaCargaId" name="fechaString" type="date" style="width: 100%" />
            </span>
        </div>
        <div class="col-md-2">
            <span id="fechaDeCargaHasta">
                <input id="fechaCargaHastaId" name="fechaString" type="date" style="width: 100%" />
            </span>
        </div>
        <div class="col-md-2">
            <label>Entrega Desde-Hasta</label>
        </div>
        <div class="col-md-2">
            <span id="fechaDesdeTopeDiv">
                <input id="fechaDesdeTopeId" name="fechaStringDesde" type="date" style="width: 100%" />
                <img id="errfechaDesdeTopeId" src="~/Content/Images/error.png" style="display:none" />
            </span>
        </div>
        <div class="col-md-2">
            <span id="fechaHastaTopeDiv">
                <input id="fechaHastaTopeId" type="date" style="width: 100%" />
                <img id="errfechaHastaTopeId" src="~/Content/Images/error.png" style="display:none" />
            </span>
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Fecha Hasta Fijación</label>
        </div>
        <div class="col-md-4">
            <span id="fechaHastaFijacionDiv">
                <input id="fechaHastaFijacionId" type="date" style="width: 50%" />
            </span>
        </div>
        <div class="col-md-2">
            <label>Campaña</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownListFor(m => m.CampaniaId, new SelectList(ViewBag.Campania, "Value", "Text"), "Seleccione la Campaña", new { @class = "form-control", @id = "campaniaId" })
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Material</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownListFor(m => m.MaterialId, new SelectList(ViewBag.Material, "Value", "Text"), "Seleccione el Material", new { @class = "form-control", @id = "materialId" })
        </div>
        <div class="col-md-2">
            <label>Zona</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownListFor(m => m.GrupoDeCompraId, new SelectList(ViewBag.Zona, "Value", "Text"), "Seleccione la Zona", new { @class = "form-control", @id = "grupoDeCompraId" })
        </div>

    </div>
    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Estado</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownListFor(m => m.EstadoId, new SelectList(ViewBag.Estado, "Value", "Text"), "Seleccione el Estado", new { @class = "form-control", @id = "estadoId" })
        </div>
        <div class="col-md-2">
            <label>Centro</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownListFor(m => m.CentroId, new SelectList(ViewBag.Centro, "Value", "Text"), "Seleccione el Centro", new { @class = "form-control", @id = "centroId" })
        </div>


    </div>
    <br />
    <div class="row">
        
        <div class="col-md-2">
            <label>Boleto</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownListFor(m => m.BoletoCompraNetId, new SelectList(ViewBag.Boleto, "Value", "Text"), "Seleccione el Boleto", new { @class = "form-control", @id = "BoletoId" })
        </div>
        <div class="col-md-2">
            <label>Comercial</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownListFor(m => m.ComercialId, new SelectList(ViewBag.Comercial, "Value", "Text"), "Seleccione el Comercial", new { @class = "form-control", @id = "ComercialId" })
        </div>

    </div>
    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Fecha Dolarizado</label>
        </div>
        <div class="col-md-2">
            <span id="fechalimiteDiv">
                <input id="fechalimiteId" type="date" style="width: 100%" />
                <input type="checkbox" id="dolarizadoId" style="position:absolute; right:55px;top:8px">
            </span>
        </div>
        <div class="col-md-2">
            <label>Importe Sustentable</label>
        </div>
        <div class="col-md-2">
            @Html.TextBoxFor(x => x.ImporteSustentable, new { @class = "number", style = "width:100%" })
            <input type="checkbox" id="importeSustentableId" style="position:absolute; right:20px;top:8px">
        </div>
        <div class="col-md-2">
            <label>Días de Diferimiento</label>
        </div>
        <div class="col-md-2">
            @Html.TextBoxFor(x => x.DiasDiferimiento, new { @class = "number", style = "width:100%" })
            <input type="checkbox" id="diferimientoId" style="position:absolute; right:20px;top:8px">
        </div>
    </div>
    <br />
    <div class="row">
       
        <div class="col-md-12" style="text-align:right">
            <button type="button" id="filtrar" class="k-button k-button-icontext sideMargin-15 limpiar" style="width: 14%" onclick="Filtrar()">Filtrar</button>
        </div>
    </div>

</div>

<br />
<div class="resultado">
    <div id="grid" class="tabla-result">
    </div>
</div>

<div class="modal fade" id="CargaContratos" tabindex="-1" role="dialog" aria-labelledby="CargaContratosLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="cerrar close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h1 class="modal-title" id="CargaCupos"></h1>
                <div class="status confirmado-modal">
                    <div>Seleccione Contratos</div>
                </div>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table id="contratos-table" class="table table-striped">                        
                    </table>
                    <div class="row">
                        <div class="col-xs-4">
                            <input type="number" class="form-control nuevoNumContrato">
                        </div>
                        <div class="col-xs-2">
                            <button class="k-button k-button-icontext fa fa-plus agregarContrato" style="height: 34px;" type="button"></button>
                        </div>
                    </div>
                </div>
            </div>            
        </div>
    </div>
</div>