@{
    ViewBag.Title = "ABM de Centros";
}

@section Scripts {
    @Scripts.Render("~/bundles/AbmCentro")
}

<h3>ABM de Centros</h3>
<br />

<div id="rootwizard">

    <div id="Abm">

        <ul>
            <li style="display:none"><a href="#tab1" data-toggle="tab"></a></li>
            <li style="display:none"><a href="#tab2" data-toggle="tab"></a></li>
        </ul>

        <div class="tab-content">

            <div class="tab-pane" id="tab1">

                <div class="row">
                    <div class="col-md-12">
                        <div id="gridIni" data-bind="source: Resultados" style="height:320px;"></div>
                    </div>
                </div>

                <br />

                <div class="row">
                    <div class="col-md-12">
                        <button id="butAgregar" class="k-button" type="button" data-role="button" data-bind="disabled: isAddNewDisabled">Agregar</button>
                        <button id="butModificar" class="k-button" type="button" data-role="button" data-bind="disabled: isDeleteDisabled" style="margin-left:15px;">Modificar</button>
                        <button id="butEliminar" class="k-button" type="button" data-role="button" data-bind="disabled: isDeleteDisabled" style="margin-left:15px;">Eliminar</button>
                    </div>
                </div>

            </div>

            <div class="tab-pane" id="tab2">

                <div class="row">
                    <div class="col-md-2">
                        <label>Descripcion</label>
                    </div>
                    <div class="col-md-4">
                        <input id="Descripcion" type="text" class="k-textbox" data-bind="value: Centro.Descripcion, disabled: isControlDisabled" maxlength="50" style="max-width:310px" />
                        <img id="errApellido" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2">
                        <label>Codigo SAP</label>
                    </div>
                    <div class="col-md-4">
                        <input id="CodigoSAP" type="text" class="k-textbox" data-bind="value: Centro.CodigoSap, disabled: isControlDisabled" maxlength="50" style="max-width:310px" />
                        <img id="errNombres" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2">
                        <label>Orden</label>
                    </div>
                    <div class="col-md-4">
                        <input id="Orden" type="text" class="k-textbox" data-bind="value: Centro.Orden, disabled: isControlDisabled" maxlength="50" style="max-width:310px" oninput="this.value = this.value.replace(/[^0-9.]/g, '').replace(/(\..*)\./g, '$1');" />
                        <img id="errNombres" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2">
                        <label>STOP</label>
                    </div>
                    <div class="col-md-2">
                        <input id="Acopio" type="checkbox" data-bind="checked: Centro.Acopio, disabled: isControlDisabled" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2">
                        <label>No Propio</label>
                    </div>
                    <div class="col-md-2">
                        <input id="NoPropio" type="checkbox" data-bind="checked: Centro.NoPropio, disabled: isControlDisabled" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2">
                        <label>Validar Redespacho</label>
                    </div>
                    <div class="col-md-2">
                        <input id="ValidaRedespacho" type="checkbox" data-bind="checked: Centro.ValidaRedespacho, disabled: isControlDisabled" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2">
                        <label>Comision</label>
                    </div>
                    <div class="col-md-2">
                        <input id="Comision" type="checkbox" data-bind="checked: Centro.Comision, disabled: isControlDisabled" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2">
                        <label>Carga Negocios</label>
                    </div>
                    <div class="col-md-2">
                        <input id="CargaNegocios" type="checkbox" data-bind="checked: Centro.CargaNegocios, disabled: isControlDisabled" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2">
                        <label>Carga Cupos</label>
                    </div>
                    <div class="col-md-2">
                        <input id="CargaCupos" type="checkbox" data-bind="checked: Centro.CargaCupos, disabled: isControlDisabled" />
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2">
                        <label>Localidad</label>
                    </div>
                    <div class="col-md-2">
                        <input id="Localidad" placeholder="Buscar por Localidad" type="text" class="k-textbox" data-bind="value: Centro.Localidad, disabled: isControlDisabled" style="width:310px" />
                        <input id="LocalidadId" type="hidden" class="k-textbox" data-bind="value: Centro.LocalidadId, disabled: isControlDisabled" style="width:310px" />
                        <img id="errLocalidadId" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-2">
                        <label>Codigo Postal</label>
                    </div>
                    <div class="col-md-4">
                        <input id="CodigoPostal" type="text" class="k-textbox" data-bind="value: Centro.CodigoPostal, disabled: isControlDisabled" maxlength="50" style="max-width:310px" />
                        <img id="errNombres" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2">
                        <label>Direccion</label>
                    </div>
                    <div class="col-md-4">
                        <input id="Direccion" type="text" class="k-textbox" data-bind="value: Centro.Direccion, disabled: isControlDisabled" maxlength="50" style="max-width:310px" />
                        <img id="errNombres" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2">
                        <label>CUIT</label>
                    </div>
                    <div class="col-md-4">
                        <input id="CUIT" type="text" class="k-textbox" data-bind="value: Centro.CUIT, disabled: isControlDisabled" maxlength="50" style="max-width:310px" />
                        <img id="errNombres" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2">
                        <label>Razón Social</label>
                    </div>
                    <div class="col-md-4">
                        <input id="RazonSocial" type="text" class="k-textbox" data-bind="value: Centro.RazonSocial, disabled: isControlDisabled" maxlength="50" style="max-width:310px" />
                        <img id="errNombres" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-12">
                        <button id="butAceptar" class="k-button" type="button" data-role="button">Aceptar</button>
                        <button id="butCancelar" class="k-button" type="button" data-role="button" style="margin-left:15px;">Cancelar</button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>
