@{
    Layout = null;
}
@model DiffPlex.DiffBuilder.Model.SideBySideDiffModel

<div id="diffBox">
    <div id="leftPane">
        <div class="diffHeader">Dato Anterior</div>

        @Html.Partial("DiffPane", Model.OldText)
    </div>
    <div id="rightPane">
        <div class="diffHeader">Dato Nuevo</div>
        @Html.Partial("DiffPane", Model.NewText)
    </div>
    <div class="clear">
    </div>
</div>

