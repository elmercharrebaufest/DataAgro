@{
    Layout = null;
}
@model DiffPlex.DiffBuilder.Model.SideBySideDiffModel

<input type="button" onclick="OcultarUnchangedLine()" value="Mostrar Cambios" class="k-button" />
<input type="button" onclick="MostrarTodo()" value="Mostrar todo" class="k-button" />
<div id="diffBox">
    <div id="leftPane">
        <div class="diffHeader">Dato Anterior</div>

        @Html.Partial("DiffPane", Model.OldText)
    </div>
    <div id="rightPane">
        <div class="diffHeader">Dato Nuevo</div>
        @Html.Partial("DiffPane", Model.NewText)
    </div>
    <div class="clear">
    </div>
</div>

<script type="text/javascript">
    $(".UnchangedLine").hide();
    $(".lineNumber").hide();
    function OcultarUnchangedLine() {
        $(".UnchangedLine").hide();
        $(".lineNumber").hide();
    }

    function MostrarTodo() {
        $(".UnchangedLine").show();
        $(".lineNumber").show();
    }
</script>