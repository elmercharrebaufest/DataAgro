@using Molinos.DataAgro.Entities.Common.Enums
<!DOCTYPE html>

<html lang="en">
<head>
    <title>DataAgro</title>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta content="width=device-width, initial-scale=1" name="viewport" />
    <meta content="Preview page of Metronic Admin Theme #4 for windows 8 style tiles examples" name="description" />
    <meta content="" name="author" />
    <link rel="shortcut icon" href="/favicon.png" />

    @Styles.Render("~/Content/bootstrap/css")
    @Styles.Render("~/Content/plugins/css")
    @Styles.Render("~/Content/layouts/css")
    @Styles.Render("~/Content/kendo/css")
    @Styles.Render("~/Content/mastersoft/css")

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/plugins")
    @Scripts.Render("~/bundles/layouts")
    @Scripts.Render("~/bundles/kendo")
    @Scripts.Render("~/bundles/mastersoft")

    <link href="~/Content/Site.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/SiteResponsive.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/jquery.multiselect.css" rel="stylesheet" type="text/css" />
    <link href="~/Scripts/jquery-ui-1.12.1/jquery-ui.css" rel="stylesheet" type="text/css" />
    <link href="~/Content/font-awesome-4.7.0/css/font-awesome.min.css" rel="stylesheet" type="text/css" />


    @RenderSection("styles", required: false)

    <script type="text/javascript" src="~/Scripts/App/layout.js"></script>
    <script type="text/javascript" src="~/Scripts/jquery-ui-1.12.1/jquery-ui.js"></script>
    <script type="text/javascript" src="~/Scripts/jquery.multiselect.js"></script>
    <script type="text/javascript" src="~/Scripts/jquery.multiselect.filter.js"></script>
    @Scripts.Render("~/bundles/bootstrap")
    <script src="~/Scripts/App/PCFToken.js"></script>
    <!-- Global site tag (gtag.js) - Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=UA-125418413-1"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag() { dataLayer.push(arguments); }
        gtag('js', new Date());

        gtag('config', 'UA-125418413-1', { 'user_id' : '@global_asax.GlobalVariables.IdActiveDirectory'});
    </script>

    <!--Firebase -->
    <script src="https://www.gstatic.com/firebasejs/5.4.2/firebase.js"></script>

</head>

<body id="theBody">
    @using (Html.BeginForm(null, null, FormMethod.Post, new { id = "__AjaxAntiForgeryForm" }))
    {
        @Html.AntiForgeryToken()
    }
    <div class="navbar navbar-inverse" id="navbarPrincipal">
        <div class="container-fluid">
            <div class="navbar-header ">
                <button type="button" class="navbar-toggle" data-toggle="collapse" data-target="#myNavbar">
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                    <span class="icon-bar"></span>
                </button>
                <a href="~/Home" id="logo">
                    <span class="logoheader-nav "><img src="~/Content/Images/agro2.png" id="imgLogo" alt="DataAgro" style="height:50px" /></span>
                </a>
            </div>

            <div class="collapse navbar-collapse" id="myNavbar">
                <ul class="nav navbar-nav left">
                    <li class="mis-contactos">
                        <a href="~/Home" class="nav-no-padding background-hover">
                            <span> Mis Contactos</span>
                        </a>
                    </li>
                    <li class="dropdown">
                        <a onclick="return false" id="reportes-a" class="dropdown-toggle nav-text1 nav-no-padding background-hover" data-toggle="dropdown" href="#">Mis Reportes <span class="caret"></span></a>
                        <ul class="dropdown-menu opacidad" id="reportes">
                            <li>
                                <a href="/Cubproveedores" class="nav-link misreporteslink">
                                    <i class="icon-bar-chart font-color"></i> Reporte Dinámico
                                </a>
                            </li>
                            @if (global_asax.GlobalVariables.Perfil != EnumPerfil.Administrativo && global_asax.GlobalVariables.Perfil != EnumPerfil.Visualizador)
                            {
                                <li>
                                    <a href="/Agenda" class="nav-link misreporteslink">
                                        <i class="icon-bar-chart font-color"></i> Reporte de Agenda
                                    </a>
                                </li>
                            }
                            <li>
                                <a href="/Proveedor/ReporteProveedor" class="nav-link misreporteslink">
                                    <i class="icon-bar-chart"></i> Reporte de Proveedor
                                </a>
                            </li>
                            <li>
                                <a href="/Contrato" class="nav-link misreporteslink">
                                    <i class="icon-bar-chart"></i> Negocios CompraNet
                                </a>
                            </li>
                            @if (global_asax.GlobalVariables.Perfil == EnumPerfil.Mesa || global_asax.GlobalVariables.Perfil == EnumPerfil.Jefe)
                            {
                                <li>
                                    <a href="/ReporteCompraNet" class="nav-link misreporteslink">
                                        <i class="icon-bar-chart"></i> Compras Diarias
                                    </a>
                                </li>
                            }
                            <li>
                                <a href="/Reportes/Index" class="nav-link misreporteslink">
                                    <i class="icon-bar-chart"></i> Indicadores
                                </a>
                            </li>
                        </ul>
                    </li>

                    <li class="agregar-contacto-mobile">
                        <img src="~/Content/Images/Users-Add-user.png" style="width:16px;" />
                    </li>
                    <li class="buscar-mobile">
                        <i class="fa fa-search" aria-hidden="true"></i>
                    </li>
                    <li class="dropdown">
                        <a onclick="return false" id="informes-a" class="dropdown-toggle nav-text2 padding-left nav-no-padding background-hover" data-toggle="dropdown" href="#">Informes <span class="caret"></span></a>
                        <ul class="dropdown-menu opacidad" id="informes">

                            @if (global_asax.GlobalVariables.Perfil != EnumPerfil.Administrativo && global_asax.GlobalVariables.Perfil != EnumPerfil.Visualizador)
                            {
                                <li>
                                    <a href="/InformeComercial/Index" class="nav-link misreporteslink">
                                        <i class="icon-bar-chart"></i> Informe Comercial
                                    </a>
                                </li>
                            }
                            @if (global_asax.GlobalVariables.Perfil == EnumPerfil.Administrativo)
                            {
                                <li>
                                    <a href="/InformeComercial/InformeAdministrativo" class="nav-link misreporteslink">
                                        <i class="icon-bar-chart"></i> Informe Administrativo
                                    </a>
                                </li>
                            }
                            <li>
                                <a href="/InformeComercial/Reporte" class="nav-link misreporteslink">
                                    <i class="icon-bar-chart"></i> Reporte Comercial
                                </a>
                            </li>
                        </ul>
                    </li>

                    @if (global_asax.GlobalVariables.EsAdministrador || global_asax.GlobalVariables.Perfil == EnumPerfil.Mesa)
                    {
                        <li class="dropdown">
                            <a onclick="return false" id="tablas-a" class="dropdown-toggle nav-text3 padding-left nav-no-padding background-hover" data-toggle="dropdown" href="#">Configuraciones <span class="caret"></span></a>
                            <ul class="dropdown-menu opacidad" id="tablas">

                                @if (global_asax.GlobalVariables.EsAdministrador)
                                {
                                    <li>
                                        <a href="~/CanalOperacion" class="nav-link misreporteslink">
                                            <i class="icon-bar-chart"></i> Canal de Operación
                                        </a>
                                    </li>
                                    <li>
                                        <a href="~/Destinatario" class="nav-link misreporteslink">
                                            <i class="icon-bar-chart"></i> Entrega A
                                        </a>
                                    </li>
                                    <li>
                                        <a href="~/Condicion" class="nav-link misreporteslink">
                                            <i class="icon-bar-chart"></i> Condición Preferente
                                        </a>
                                    </li>
                                    <li>
                                        <a href="~/Comercial" class="nav-link misreporteslink">
                                            <i class="icon-bar-chart"></i> ABM Usuarios
                                        </a>
                                    </li>
                                    <li>
                                        <a href="~/Centro" class="nav-link misreporteslink">
                                            <i class="icon-bar-chart"></i> ABM Centros
                                        </a>
                                    </li>
                                    <li>
                                        <a href="~/RangoPrecio" class="nav-link misreporteslink">
                                            <i class="icon-bar-chart"></i> Rangos de precio por material
                                        </a>
                                    </li>
                                    <li>
                                        <a href="~/Operador" class="nav-link misreporteslink">
                                            <i class="icon-bar-chart"></i> ABM Operador
                                        </a>
                                    </li>
                                    <li>
                                        <a href="~/TareaProgramada" class="nav-link misreporteslink">
                                            <i class="icon-bar-chart"></i> Tareas Programadas
                                        </a>
                                    </li>
                                }
                                @if (global_asax.GlobalVariables.Perfil == EnumPerfil.Mesa)
                                {
                                    <li>
                                        <a href="~/RangoConfirmacionAutomatica" class="nav-link misreporteslink">
                                            <i class="icon-bar-chart"></i> Rangos para confirmacion automatica
                                        </a>
                                    </li>
                                    <li>
                                        <a href="~/Diferencial" class="nav-link misreporteslink">
                                            <i class="icon-bar-chart"></i> Diferencial
                                        </a>
                                    </li>
                                }
                                <li>
                                    <a href="~/Zona" class="nav-link misreporteslink">
                                        <i class="icon-bar-chart"></i> Zona
                                    </a>
                                </li>

                                <li>
                                    <a href="~/Material" class="nav-link misreporteslink">
                                        <i class="icon-bar-chart"></i> Material
                                    </a>
                                </li>
                                @if (global_asax.GlobalVariables.EsAdministrador)
                                {
                                    <li>
                                        <a href="~/Log" class="nav-link misreporteslink">
                                            <i class="icon-bar-chart"></i> Logs
                                        </a>
                                    </li>
                                    <li>
                                        <a href="/NotificacionResearch" class="nav-link misreporteslink">
                                            <i class="icon-bar-chart"></i> Notificaciones Research
                                        </a>
                                    </li>
                                }
                            </ul>
                        </li>
                    }
                    @if (global_asax.GlobalVariables.Perfil != EnumPerfil.Administrativo && global_asax.GlobalVariables.Perfil != EnumPerfil.Visualizador)
                    {
                        <li class="dropdown">
                            <a onclick="return false" id="negocios-a" class="dropdown-toggle nav-text4 padding-left nav-no-padding background-hover" data-toggle="dropdown" href="#">CompraNet <span class="caret"></span></a>
                            <ul class="dropdown-menu opacidad" id="negocios">
                                <li>
                                    <a href="/CompraNet" class="nav-link misreporteslink">
                                        <i class="icon-bar-chart"></i> Negocios
                                    </a>
                                </li>
                                @if (global_asax.GlobalVariables.Perfil == EnumPerfil.Mesa)
                                {
                                    <li>
                                        <a href="/Hedge" class="nav-link misreporteslink">
                                            <i class="icon-bar-chart"></i> Otros Negocios
                                        </a>
                                    </li>
                                }
                                @*<li>
                        <a href="/ContratoAcuerdo" class="nav-link misreporteslink">
                            <i class="icon-bar-chart"></i> Contrato Acuerdo
                        </a>
                    </li>*@
                            </ul>
                        </li>
                    }
                    @if (global_asax.GlobalVariables.Perfil != EnumPerfil.Administrativo && global_asax.GlobalVariables.Perfil != EnumPerfil.Visualizador)
                    {
                        <li class="dropdown">
                            <a onclick="return false" id="research-a" class="dropdown-toggle nav-text4 padding-left nav-no-padding background-hover" data-toggle="dropdown" href="#">Research <span class="caret"></span></a>
                            <ul class="dropdown-menu opacidad" id="research">
                                <li>
                                    <a href="/Research" class="nav-link misreporteslink">
                                        <i class="icon-bar-chart"></i> Datos Research
                                    </a>
                                </li>
                                <li>
                                    <a href="/ReporteResearch" class="nav-link misreporteslink">
                                        <i class="icon-bar-chart"></i> Reporte Research
                                    </a>
                                </li>
                                
                            </ul>
                        </li>
                    }
                </ul>
                <ul id="segundo" class="nav navbar-nav navbar-right" style="float: right;">
                    <li class="float-left dropdown icons mis-postit" id="notas">
                        <a @*class="mis-postit imgs"*@>
                            <img class="usuario-nav" src="~/Content/Images/postit.png" />
                        </a>
                    </li>
                    <li class="float-left dropdown icons">
                        <a id="notificaciones-a" @*class="imgs"*@>
                            <img class="notificaciones-nav" src="~/Content/Images/menu-notificaciones.png" />
                            <div class="cant-notif"><span class="cant-notif-span"> </span></div>
                        </a>
                    </li>
                    <li class="float-left dropdown icons">
                        <a id="buscar-proveedor" @*class="imgs"*@>
                            <div style="display:inline-block;">
                                <img class="usuario-nav" src="~/Content/Images/buscar-proveedor.png" />
                            </div>
                        </a>
                    </li>
                </ul>
            </div>

        </div>
    </div>

    @RenderSection("LinksContacto", required: false)

    <div class="page-container">
        <div class="page-sidebar-wrapper"></div>

        <div class="page-content-wrapper">
            <div class="page-content">
                <div class="">
                    @RenderBody()
                </div>
            </div>
        </div>
    </div>

    <div class="page-footer">
        <div class="container"></div>
    </div>

    <div class="notificaciones-contenedor"></div>

    <div id="modalPostit" class="modal fade" role="dialog">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="close" data-dismiss="modal">&times;</button>
                    <h4 class="modal-title">Notas</h4>
                </div>
                <div class="modal-body">
                    <textarea id="texto-postit"></textarea>
                </div>
                <div class="modal-footer">
                    <div class="modal-guardar-contacto" id="guardar-postit">Guardar</div>
                    <div class="modal-cancelar salir-postit">Cancelar</div>
                </div>
            </div>
        </div>
    </div>

    @RenderSection("scripts", required: false)

</body>
</html>