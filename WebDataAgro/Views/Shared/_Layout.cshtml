<script type="text/javascript">
    $(document).keydown(function (e) {
        e = e || event;
        if (e.ctrlKey && e.altKey && String.fromCharCode(e.keyCode) == 'B') $("#aboutScreen").modal("show");
    });

    function closeAboutScreen() {
        $("#aboutScreen").modal("hide");
    }
</script>

