@{
    ViewBag.Title = "Algoritmo de Cupos";
}
@section Scripts {
    @Scripts.Render("~/bundles/AbmFormula")
    <script src="~/Scripts/App/KendoExtensions.js"></script>
    <script src="~/Scripts/App/Filtros.js"></script>
}

<h3>Algoritmo de Cupos</h3>
<br />
<script src="~/Scripts/umd/popper.js"></script>

<form>
    <div class="form-group row">
        <div class="col-sm-3">
            <label>Bloquear cupera para sugerencias</label>
        </div>
        <div class="col-sm-1">
            <input id="deshabilitar" class="campo-input-input" type="checkbox" onclick="Deshabilitar()" />
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-2">
            <label> Material</label>
        </div>
        <div class="col-md-2">
            <input id="MaterialId">
        </div>
    </div>
    <div class="form-group row">
        <div class="col-md-6">
            <div class="col-md-6">
                <label for="cuposDesde" class=" col-form-label" @*data-toggle="popover" data-placement="bottom" data-trigger="hover" data-content="Cantidad de días que el algoritmo va a empezar a buscar negocios."*@>Cupos Desde</label>
                <div class="">
                    <input class="form-control-plaintext" id="cuposDesde">
                </div>
            </div>
            <div class="col-md-6">
                <label for="cuposHasta" class="col-form-label" @*data-html="true" data-toggle="popover" data-placement="bottom" data-trigger="hover" data-content="<i>Cantidad de días desde el <strong>Inicio</strong> a tener en cuenta para buscar los negocios.<i>"*@>Cupos Hasta</label>
                <div class="">
                    <input class="form-control-plaintext" id="cuposHasta">
                </div>
            </div>

        </div>

        <div class="col-md-6">
            <div class="col-md-6">
                <label for="negociosDesde" class=" col-form-label" @*data-toggle="popover" data-placement="bottom" data-trigger="hover" data-content="Cantidad de días que el algoritmo va a empezar a buscar negocios."*@>Negocios Desde</label>
                <div class="">
                    <input class="form-control-plaintext" id="negociosDesde">
                </div>
            </div>
            <div class="col-md-6">
                <label for="negociosHasta" class=" col-form-label" @*data-html="true" data-toggle="popover" data-placement="bottom" data-trigger="hover" data-content="<i>Cantidad de días desde el <strong>Inicio</strong> a tener en cuenta para buscar los negocios.<i>"*@>Negocios Hasta</label>
                <div class="">
                    <input class="form-control-plaintext" id="negociosHasta">
                </div>
            </div>

        </div>



    </div>
</form>

<div id="treelist"></div>

<div id="popUpAgregarCriterio" style="text-align: center;">
    <input type="hidden" id="padreid" />
    <input type="hidden" id="maximo" />

    <input type="text" required id="dropdown" style="margin-bottom: 10%; width: 200px" />
    <input type="number" id="prioridad" placeholder="Prioridad" /> <b>Puntos</b>

    <br />
    <input type='button' id="agregarCriterio" class="k-primary" onclick="agregar()" value='Agregar' />
</div>

<div class="row">
    <div class="col-md-2">
        <label style="margin-top: 11.875px !important;">Tipos de Negocios excluidos</label>
    </div>
    <div class="col-md-4">
        @Html.ListBox("TipoNegocioId", new SelectList(ViewBag.TipoNegocio, "Value", "Text"), new { @class = "form-control filtroBusquedaPorId", @id = "TipoNegocioId" })
    </div>
    <div class="col-md-2"></div>
    <div class="col-md-4"></div>
</div>

<style>
    .popover-content {
        color: dimgray;
        font-size: 9px !important;
        font-family: "Helvetica Neue","Helvetica","Arial","sans-serif" !important;
    }

    div.k-window-content {
        overflow: hidden;
        text-align: center;
    }

    .k-grid tbody .k-button {
        min-width: 40px;
        width: auto;
    }

    .k-button.k-state-hover, .k-button:hover {
        border-color: white;
    }

    .k-window-titlebar .k-window-action {
        width: auto;
        height: auto;
        opacity: 1;
    }

    .k-window-title {
        text-align: center;
        background-color: #017940;
        font-size: 12px;
        text-align: left;
        margin: 10px 0;
        border: 0;
        color: #FFF;
        padding: 3px;
        font-weight: 700;
    }

    .k-button, .k-widget {
        margin-top: 2%;
    }

    .k-edit-field, .k-edit-form-container .editor-field {
        margin-top: 3.7%;
        font-weight: bold;
        font-size: 15px;
    }

    .dias {
        font-weight: bold;
        color: grey;
        margin-left: 20px;
        margin-right: 20px;
        width: 120px;
    }

    .editor-label, .k-edit-label {
        text-align: center;
    }
    /*.k-textbox {
        width: 100px;
        text-align: center;
    }*/


    input.k-textbox, textarea.k-textbox {
        width: 100px;
        text-align: center;
    }

    k-icon k-i-loading k-hidden {
        display: none !important;
    }

    .k-i-loading {
        display: none;
    }
</style>

