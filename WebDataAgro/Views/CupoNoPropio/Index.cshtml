
@{
    ViewBag.Title = "Cupo No Propio";
}


@*@section Scripts {
        @Scripts.Render("~/bundles/ContratoIndex")
    }*@

<script src="~/Scripts/App/CupoNoPropio.js"></script>
<script src="~/Scripts/KendoExtensions.js"></script>
<script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
<script src="~/Scripts/App/Filtros.js"></script>
@section Styles {
    <link href="~/Content/cupoNoPropio.css" rel="stylesheet" />
    <link href="~/Content/compraNet.css" rel="stylesheet" />
}
<div class="">
    <div class="row">

    </div>
    <div class="row">
        <div class="col-md-10" data-toggle="collapse" data-target="#filtrar" onclick="mostrarocultar('#mostrar')">
            <div class="k-button"><span class="filtro">Filtro</span> <strong><span id="mostrar" class="mostrar" style="font-size: 12px !important;">Mostrar</span></strong></div>
        </div>
        <div class="col-md-2 col-sm-4">
            <div style="width:100%;text-align:center;">
                <span id="crearContrato" class="btnAzul btn-block" style="background-color:#76ae7e  !important" type="button" onclick="AbrirModalCrearCupo()">
                    Nuevo Cupo No Propio
                </span>
            </div>
        </div>
        <div class="filtro-desplegable row"></div>


        <div id="filtrar" class="container collapse">
            <br />
            <div class="row">
                <div class="col-md-2">
                    <label>Cupo</label>
                </div>
                <div class="col-md-4 ">
                    @Html.TextBox("Codigo", "", new { placeholder = "", @class = "form-control filtroAgregarValorPopUp", style = "width:100%", @id = "Codigo" })
                </div>
                <div class="col-xs-2 noLeftPadding">
                    <button type="button" id="abrirPopUpCargarValores" class="k-button k-button-icontext fa fa-list" style="height:34px"></button>
                </div>
                <div class="modal fade" id="popUpCargarValoresCodigo" tabindex="-1" role="dialog" aria-labelledby="CargaContratosLabel" aria-hidden="true">
                </div>
            </div>
            <br/>
            <div class="row">
                <div class="col-md-2">
                    <label>Fecha de Ingreso</label>
                </div>
                <div class="col-md-2">
                    <span id="fechaDeCarga">
                        <input id="fechaIngresoId" class="filtroFecha" name="FechaIngreso-desde" type="date" style="width: 100%" />
                    </span>
                </div>
                <div class="col-md-2">
                    <span id="fechaDeCargaHasta">
                        <input id="fechaIngresoHastaId" class="filtroFecha" name="FechaIngreso-hasta" type="date" style="width: 100%" />
                    </span>
                </div>

            </div>
            <br />

            <div class="row">
                <div class="col-md-2">
                    <label>Material</label>
                </div>
                <div class="col-md-4">
                    @Html.DropDownList("MaterialId", new SelectList(ViewBag.Material, "Value", "Text"), "Seleccione el Material", new { @class = "form-control filtroBusquedaPorId", @id = "materialId" })
                </div>


            </div>
            <br />
            <div class="row">
                <div class="col-md-2">
                    <label>Planta</label>
                </div>
                <div class="col-md-4">
                    @Html.DropDownList("CentroId", new SelectList(ViewBag.CentroFiltro, "Value", "Text"), "Seleccione la Planta", new { @class = "form-control filtroBusquedaPorId", @id = "centroId" })
                </div>


            </div>
            <br />
            <br />
            <div class="row">

                <div class="col-md-12" style="text-align:right">
                    <button type="button" id="filtrar" class="k-button k-button-icontext sideMargin-15 limpiar" style="width: 14%" onclick="Filtrar()">Filtrar</button>
                </div>
            </div>

        </div>

        <br />
    </div>
    <script type="text/x-kendo-template" id="templateToolbar">
        <div class="">
            <a role="button" class="k-button k-button-icontext k-grid-excel" href="\\#"><span class="k-icon k-i-file-excel"></span>Export to Excel</a>
        </div>
    </script>
    <div class="resultado">
        <div id="gridCupoNoPropio" class="tabla-result">
        </div>
    </div>

    @Html.Partial("ModalCrearCupoNoPropio")

    <style>
        .filtro-desplegable {
            border-bottom: 3px solid #017940;
            margin-bottom: 10px;
            padding: 0 0 5px 20px;
            cursor: pointer;
        }
    </style>
