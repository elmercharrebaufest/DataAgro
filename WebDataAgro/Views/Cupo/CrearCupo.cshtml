@model WebDataAgro.Models.CupoModel
@{
    ViewBag.Title = "Cupo";
    var zonas = (List<SelectListItem>)ViewBag.Zona;
}

<script>
    BlockUi("Cargando...");
</script>

@section Scripts {
    @Scripts.Render("~/bundles/Cupos")
}
<script> fecha = @Model.FechaEntrega.ToString("dd-MM-yyyy");
    </script>
@section Styles {
    <link href="~/Content/cupo.css" rel="stylesheet" />
}
@if (!Html.ViewData.ModelState.IsValid)
{
<div id="errorModal">
    <div class="alert alert-danger alert-dismissible" role="alert">
        <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
        @Html.ValidationSummary()
    </div>
</div>}
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken();
    <div id="CrearCupo" class="container">

        <br />
        <div class="row">
            <div>
                <div class="col-sm-2" id="proveedorLabelId">
                    <label id="proveedorLabel">Proveedor</label>
                </div>
                <div class="col-sm-4">
                    @Html.TextBoxFor(x => x.ProveedorDescripcion, new { @placeholder="Buscar por CUIT, razón social", @id="buscadorProveedor",@class="w100"})
                    @Html.HiddenFor(x => x.Proveedor)
                </div>
            </div>
            <div>
                <div class="col-sm-2">
                    <label>Planta</label>
                </div>
                <div class="col-sm-4">
                    @Html.DropDownListFor(x => x.Planta, new SelectList(ViewBag.Centro, "Value", "Text"),  new { @class = "form-control", @id = "planta" })
                </div>
            </div>
        </div>
        <div class="row">
            <div>
                <div class="col-sm-2 ">
                    <label>Material</label>
                </div>
                <div class="col-sm-4">
                    <div>
                        @Html.DropDownListFor(x => x.MaterialId, new SelectList(ViewBag.Material, "Value", "Text"), "Seleccione Material", new { @class = "form-control", @id = "material" })
                    </div>
                </div>
            </div>
            <div>
                <div class="col-sm-2 ">
                    <label>Fecha Entrega</label>
                </div>
                <div class="col-sm-4">
                    <span id="fechaDiv">
                        @Html.TextBoxFor(x => x.FechaEntrega,"{0:yyyy-MM-dd}", new { @class = "w100" })
                    </span>
                </div>
            </div>
        </div>
        <div class="row">
            <div>
                <div class="col-sm-2">
                    <label>Cantidad</label>
                </div>
                <div class="col-sm-4 ">
                    @Html.TextBoxFor(x => x.CantidadCupos, new { type = "number", @class = "w100", @placeholder="SELECCIONE CANTIDAD DE CUPOS...", @id = "cantidad" })
                </div>
            </div>
            <div>
                <div class="col-sm-2 ">
                    <label>Zona</label>
                </div>
                
                <div class="col-sm-4">
                    <div>
                        @Html.DropDownListFor(x => x.ZonaId, zonas, new { @class = "form-control" })
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div>
                <div class="col-sm-2 noRightPadding">
                    <label>Flete procedencia/Acarreo </label>
                </div>
                    <div class="col-sm-4 ">
                        @Html.CheckBoxFor(x => x.FleteAcarreo, new { @id = "flete" })
                    </div>
            </div>
            <div id="calidadDiv" hidden>
                <div class="col-sm-2">
                    <label>Calidad</label>
                </div>
                <div class="col-sm-4">
                    @Html.DropDownListFor(x => x.Calidad, new SelectList(ViewBag.Calidad, "Value", "Text"), "Seleccione Calidad", new { @class = "form-control", @id = "calidad" })
                </div>
            </div>
        </div>
        <div class="row">
            <div>
                <div class="col-sm-2">
                    Observación
                </div>
                <div class="col-sm-10">
                    @Html.TextAreaFor(x => x.Observacion, new { @class = "form-control", @id = "observacion" })
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-sm-2">
                <label>Fasón/Préstamo devolución</label>
            </div>
            <div class="col-sm-4">
                <span style="height:34px"></span>
                @Html.CheckBoxFor(x => x.Fason, new { @id = "fason" })
                @Html.TextBoxFor(x => x.CUIT, new { @class = "w95", @style = "display:none;", @id = "cuit" })
            </div>
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-offset-3 col-md-4" style="padding-left: 67px;">
            <input id="guardarBtn" type="submit" class="formulario-footer-guardar-contrato k-button k-button-icontext" value="Guardar Cupo" />
            @Html.ActionLink("Volver","Index",null ,new { @class = "formulario-footer-guardar-contrato k-button k-button-icontext" })
            @*<span class="formulario-footer-cancelar k-button k-button-icontext" type="button">
                Volver
            </span>*@
        </div>
    </div>
}
