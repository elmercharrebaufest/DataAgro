@model WebDataAgro.Models.CupoModel
@{
    ViewBag.Title = "Cupo";
    var zonas = (List<SelectListItem>)ViewBag.Zona;
    var fleteProcedencia = PermisosHelper.Is(PermisosDataAgro.ReasignarFlete);
    var reasignarCupo = PermisosHelper.Is(PermisosDataAgro.ReasignarProveedorPantallaCupo);
}
<script src="~/Scripts/html2canvas.js"></script>

<script>
    BlockUi("Cargando...");
    fleteProcedencia = '@fleteProcedencia';
    reasignarCupo = '@reasignarCupo';
</script>

<h3 id="titulo">@ViewBag.Titulo</h3>
<script src="~/Scripts/jquery.mask.js"></script>
<script src="~/Scripts/App/CrearCupo.js"></script>

<script>
 fecha = @Model.FechaEntrega.ToString("dd-MM-yyyy");
</script>
@section Styles {
    <link href="~/Content/cupo.css" rel="stylesheet" />
}
@if (Html.ViewData.ModelState.Any(x => x.Key == "CantidadCuposSAP") || (Model.Resultado != null && Model.Resultado.ListaCupos != null && Model.Resultado.ListaCupos.Count > 0))
{
    <script>
        var model = '@Html.Raw(Json.Encode(Model.Resultado.ListaCupos))';
        var data = JSON.parse(model);
        var error = '@(Html.ViewData.ModelState.ContainsKey("CantidadCuposSAP")? Html.Raw(Json.Encode(Html.ViewData.ModelState["CantidadCuposSAP"].Errors.Select(x => x.ErrorMessage))) : Html.Raw(Json.Encode(new List<string>())))';
        //Html.ViewData.ModelState.Values.Select(x=>x.Errors)
        cuposCreados(error, data);
    </script>
}
else if (!Html.ViewData.ModelState.IsValid)
{
    <div id="errorModal">
        <div class="alert alert-danger alert-dismissible" role="alert">
            <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
            @Html.ValidationSummary()
        </div>
    </div>
    <script>
        var cantidadDias = '@Html.Raw(Json.Encode(Model.Dias))';
        ActualizarCantidad(JSON.parse(cantidadDias));
    </script>
}
<div id="errorDiv" hidden>
    <div class="alert alert-danger alert-dismissible" role="alert">
        <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
        <div id="errorDiv1"></div>
    </div>
</div>

@using (Html.BeginForm())
{
    <div id="CrearCupo" class="container">
        <div id="boton-carga-masiva" class="margen-15" hidden>
            <span class="btnVarios" onclick="MostrarCarga()">
                Carga Masiva
            </span>
        </div>
        <br />
        @Html.HiddenFor(x => x.Id)
        @Html.HiddenFor(x => x.NoPropio)
        @Html.HiddenFor(x => x.Siguientes)
        <div class="row">
            <div>
                <div class="col-sm-2" id="proveedorLabelId">
                    <label id="proveedorLabel">Proveedor</label>
                </div>
                <div class="col-sm-4">
                    @Html.TextBoxFor(x => x.ProveedorDescripcion, new { @placeholder = "Buscar por CUIT, razón social", @id = "buscadorProveedor", @class = "w100" })
                    @Html.HiddenFor(x => x.Proveedor)
                </div>
            </div>
            <div>
                <div class="col-sm-2">
                    <label>Planta</label>
                </div>
                <div class="col-sm-4">
                    @Html.DropDownListFor(x => x.PlantaId, new SelectList(ViewBag.Centro, "Value", "Text"), new { @class = "form-control", @id = "planta" })
                    @Html.HiddenFor(x => x.PlantaId)
                </div>
            </div>
        </div>
        <div class="row">
            <div>
                <div class="col-sm-2 ">
                    <label>Material</label>
                </div>
                <div class="col-sm-4">
                    <div>
                        @Html.DropDownListFor(x => x.MaterialId, new SelectList(ViewBag.Material, "Value", "Text"), "Seleccione Material", new { @class = "form-control", @id = "material" })
                        @Html.HiddenFor(x => x.MaterialId)
                    </div>
                </div>
            </div>
            <div>
                <div class="col-sm-2 ">
                    <label>Fecha Entrega</label>
                </div>
                <div class="col-sm-4">
                    <div id="fechaDiv">
                        <div class="col-xs-6 noLeftPadding">
                            @Html.TextBoxFor(x => x.FechaEntrega, "{0:yyyy-MM-dd}", new { @class = "w100", @id = "fechaEntrega" })
                        </div>
                        @Html.HiddenFor(x => x.FechaEntrega)
                        <div class="col-xs-6 noRightPadding">
                            @Html.TextBoxFor(x => x.FechaHastaEntrega, "{0:yyyy-MM-dd}", new { @class = "w100", @id = "fechaHasta" })
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div>
                <div class="col-sm-2">
                    <label>Cantidad</label>
                </div>
                <div class="col-sm-4 ">
                    @Html.TextBoxFor(x => x.CantidadCupos, new { type = "number", @class = "w100", @placeholder = "SELECCIONE CANTIDAD DE CUPOS...", @id = "cantidad" })
                </div>
            </div>
            <div>
                <div class="col-sm-2 ">
                    <label>Zona</label>
                </div>

                <div class="col-sm-4">
                    <div>
                        @Html.DropDownListFor(x => x.ZonaId, zonas, new { @class = "form-control", @id = "zona" })
                        @Html.HiddenFor(x => x.ZonaId)
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            @*<div class="col-sm-2">
                    <label>Contrato</label>
                </div>
                <div class="col-sm-4">
                    @Html.TextBoxFor(x => x.NegocioId, new { @id = "contratoId", @class = "w100" })
                    @Html.HiddenFor(x => x.Negocio)
                </div>*@
            <div id="calidadDiv" hidden>
                <div class="col-sm-2">
                    <label>Calidad</label>
                </div>
                <div class="col-sm-4">
                    @Html.DropDownListFor(x => x.CalidadId, new SelectList(ViewBag.Calidad, "Value", "Text"), "Seleccione Calidad", new { @class = "form-control", @id = "calidad" })
                </div>
            </div>
            <div id="stock" hidden>
                <div class="col-sm-2">
                    <label>Establecimiento</label>
                </div>
                <div class="col-sm-4">
                    <button class="k-button k-button-icontext" type="button" onclick="VisualizarStock()" style="width: 100%">Visualizar Stock</button>
                </div>
            </div>

        </div>
        <div class="row">
            <div>
                <div class="col-sm-2">
                    <label>Observación</label>
                </div>
                <div class="col-sm-10">
                    @Html.TextAreaFor(x => x.Observacion, new { @class = "form-control", @id = "observacion" })
                </div>
            </div>
        </div>
        <div class="row">
            <div>
                <div class="col-sm-2 noRightPadding">
                    <label>Flete procedencia/Acarreo </label>
                </div>
                <div class="col-sm-4 ">
                    @Html.CheckBoxFor(x => x.FleteAcarreo, new { @id = "flete" })
                </div>
            </div>
            <div class="col-sm-2">
                <label>Fasón/Préstamo devolución</label>
            </div>
            <div class="col-sm-1">
                <span style="height:34px"></span>
                @Html.CheckBoxFor(x => x.FasonId, new { @id = "fason" })
                @Html.TextBoxFor(x => x.CuitId, new { @class = "form-control w95", @style = "display:none;", @id = "cuit" })
            </div>
        </div>

        <div class="row">
            <div id="sustentableDiv" hidden>
                <div class="col-sm-2 noRightPadding">
                    <label>Sustentable </label>
                </div>
                <div class="col-sm-4 ">
                    @Html.CheckBoxFor(x => x.Sustentable, new { @id = "Sustentable" })
                </div>
            </div>

            <div id="EPADiv" hidden>
                <div class="col-sm-2 noRightPadding">
                    <label>EPA </label>
                </div>
                <div class="col-sm-4 ">
                    @Html.CheckBoxFor(x => x.EPA, new { @id = "EPA" })
                </div>
            </div>
        </div>

        @*<div class="row" id="descargaRowId" hidden>
            <div class="col-sm-6">

            </div>
            <div class="col-sm-2">
                <label>Con Descarga</label>
            </div>
            <div class="col-sm-2">
                @Html.CheckBoxFor(x => x.ConDescarga, new { @id = "ConDescarga" })
            </div>
        </div>*@
    </div>
    <br />
    <div class="row">
        <div class="col-md-offset-3 col-md-4" style="padding-left: 67px;">
            <span id="guardarBtn" @*type="submit"*@ class="formulario-footer-guardar-contrato k-button k-button-icontext">
                Guardar Cupo
            </span>
            @Html.ActionLink("Volver", "Index", null, new { @class = "formulario-footer-guardar-contrato k-button k-button-icontext" })
        </div>
    </div>

    <div class="modal fade" id="fleteProcedenciaModal" tabindex="-1" role="dialog" aria-labelledby="resultadoCupoLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="cerrar close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <div class="status confirmado-modal">
                        <div id="msjConfirmacion">¿Desea reasignar un cupo con flete procedencia?</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="myBtn btn" id="boton-si">Si</button>
                    <button type="button" class="myBtn btn" id="boton-no">No</button>
                    <button type="button" class="myBtn btn" id="boton-cancelar">Cancelar</button>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="CargaCupos" tabindex="-1" role="dialog" aria-labelledby="CargaCuposLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <button type="button" class="cerrar close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                    <h1 class="modal-title" id="CargaCupos"></h1>
                    <div class="status confirmado-modal">
                        <div>Carga de Cupos</div>
                    </div>
                </div>
                <div class="modal-body">
                    <div class="table-responsive">
                        <table id="carga-cupos-table" class="table table-striped">
                            <tr>
                                <th>Día</th>
                                <th>Cantidad</th>
                            </tr>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="myBtn btn" data-dismiss="modal">Aceptar</button>
                    <button type="button" class="myBtn btn" id="cancelar-carga" data-dismiss="modal">Cancelar</button>
                </div>
            </div>
        </div>
    </div>

}

<div class="modal fade" id="resultadoCupo" tabindex="-1" role="dialog" aria-labelledby="resultadoCupoLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="cerrar close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
                <h1 class="modal-title" id="resultadoCupo"></h1>
                <div class="status confirmado-modal">
                    <div>Cupos Creados</div>
                </div>
            </div>
            <div class="modal-body">
                <div id="error-modal" hidden></div>
                <div id="cupos-generados-modal"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="myBtn btn" data-dismiss="modal">Aceptar</button>
                <button type="button" class="myBtn btn" onclick="copiarGenerados()"><i class="fa fa-copy"></i>Copiar Cupos</button>
                <button type="button" class="myBtn btn" id="copy_btn2" onclick="VisualizarStock()">Visualizar Stock </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade " id="modalEstablecimientos" tabindex="-1" role="dialog" aria-labelledby="establecimiento" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="table table-striped table-responsive modal-body tabla " id="divTablaEstablecimientos">
                <table id="cargarDatosEstablecimiento" style="width:100%"></table>
            </div>
            <div class="modal-footer">
                <button type="button" class="myBtn btn" data-dismiss="modal">Aceptar</button>
                <button type="button" title="Copiar como imagen" class="myBtn btn" id="copy_btn" onclick="copiarTablaEstablecimiento()"><i class="fa fa-copy"></i> Copiar</button>

            </div>
        </div>
    </div>
</div>


<div class="hide" id="out_image"></div>

<style>
    .tabla {
        width: 100%;
        max-height: 335px;
        overflow-y: auto;
    }
</style>

<div id="copiar-cupos-generados-modal" style="background-color:white;"></div>