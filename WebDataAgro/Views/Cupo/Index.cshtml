@using Molinos.DataAgro.Entities.Common.Enums

@{
    ViewBag.Title = "Cupos";
}

@section Scripts {
    @Scripts.Render("~/bundles/Cupos")
}
@{
    var anularCupo = PermisosHelper.Is(PermisosDataAgro.AnularCupos);
    var modificarCupo = PermisosHelper.Is(PermisosDataAgro.ModificarCupos);
}

<script>
    comercialId = '@ViewBag.comercialId';
    anularCupo = '@anularCupo';
    modificarCupo = '@modificarCupo';
</script>
@section Styles {
    <link href="~/Content/cupo.css" rel="stylesheet" />
   
}

<input type="hidden" id="TieneEmpleadosACargo" value="@(ViewBag.TieneEmpleadosACargo.ToString())" />
<!--container-->
<div class="panelflotante">
    <div class="row">
        <div class="float-left">
            <span id="crearCupo" class="btnAzul btn-block @(PermisosHelper.Is(PermisosDataAgro.AltaCupos)?"":"hide")" type="button">
                <i class="fa fa-file-o"></i>
                Crear Nuevo Cupo
            </span>

        </div>
        <div class="float-left" id="cupoPropiosDiv" style="width:100px; margin-left:12px" data-toggle="tooltip" onclick="filtrarMesa()">
            <span class="botonVarios">
                <i id="cupoPropio" class="fa fa-user varios" aria-hidden="true"></i>
            </span>
            <span>Propios</span>
        </div>
        <div class="float-right margen-15">
            @if (anularCupo)
            {
                <span id="anularVarios" class="btnVarios" onclick="AnularSeleccionados()">
                    <i class="fa fa-trash"></i>
                    Anular
                </span>
            }
        </div>
        <div class="float-right margen-15">
            @if (modificarCupo)
            {
                <span id="modificarVarios" class="btnVarios" onclick="ModificarSeleccionados()">
                    <i class="fa fa-pencil"></i>
                    Modificar
                </span>
            }
        </div>
        <div class="float-right margen-15">
            <span id="copiar" class="btnVarios" onclick="CopiarSeleccionados()">
                <i class="fa fa-copy"></i>
                Copiar
            </span>
        </div>
        <div class="float-right margen-15">
            <span id="retransmitir" class="btnVarios" onclick="RetransmitirSeleccionados()">
                <i class="fa fa-mail-forward"></i>
                Transmitir
            </span>
        </div>
    </div>
</div>

