@using Molinos.DataAgro.Entities.Common.Enums

@{
    ViewBag.Title = "Cupos";
}

@section Scripts {
    @Scripts.Render("~/bundles/Cupos")
}
@{
    var altaCupo = PermisosHelper.Is(PermisosDataAgro.AltaCupos, PermisosDataAgro.AltaCupo_Externo);
    var anularCupo = PermisosHelper.Is(PermisosDataAgro.AnularCupos);
    var modificarCupo = PermisosHelper.Is(PermisosDataAgro.ModificarCupos);
    var modificarCentro = PermisosHelper.Is(PermisosDataAgro.ModificarOrigenCentro);
    var modificarOtrasZonas = PermisosHelper.Is(PermisosDataAgro.ModificarOtrasZonas);
    var modificarSur = PermisosHelper.Is(PermisosDataAgro.ModificarOrigenSur);
    var modificarNorte = PermisosHelper.Is(PermisosDataAgro.ModificarOrigenNorte);
    var modificarRosario = PermisosHelper.Is(PermisosDataAgro.ModificarCorredoresRosario);
    var modificarBsAs = PermisosHelper.Is(PermisosDataAgro.ModificarCorredoresBsAs);
    var anularCentro = PermisosHelper.Is(PermisosDataAgro.AnularOrigenCentro);
    var anularOtrasZonas = PermisosHelper.Is(PermisosDataAgro.AnularOtrasZonas);
    var anularSur = PermisosHelper.Is(PermisosDataAgro.AnularOrigenSur);
    var anularNorte = PermisosHelper.Is(PermisosDataAgro.AnularOrigenNorte);
    var anularRosario = PermisosHelper.Is(PermisosDataAgro.AnularCorredoresRosario);
    var anularBsAs = PermisosHelper.Is(PermisosDataAgro.AnularCorredoresBsAs);
    var externo = PermisosHelper.Is(PermisosDataAgro.IngresoExterno);
    var materialDisponible = ViewBag.mostrarMaterial;

}

<script>
    comercialId = '@ViewBag.comercialId';
    anularCupo = '@anularCupo';
    modificarCupo = '@modificarCupo';
    modificarCentro = '@modificarCentro';
    modificarOtrasZonas = '@modificarOtrasZonas';
    modificarSur = '@modificarSur';
    modificarNorte = '@modificarNorte';
    modificarRosario = '@modificarRosario';
    modificarBsAs = '@modificarBsAs';
    anularCentro = '@anularCentro';
    anularOtrasZonas = '@anularOtrasZonas';
    anularSur = '@anularSur';
    anularNorte = '@anularNorte';
    anularRosario = '@anularRosario';
    anularBsAs = '@anularBsAs';
    externo = '@externo';
    materialDisponible =  '@materialDisponible';
</script>
@section Styles {
    <link href="~/Content/cupo.css" rel="stylesheet" />
}

<input type="hidden" id="TieneEmpleadosACargo" value="@(ViewBag.TieneEmpleadosACargo.ToString())" />
<!--container-->
<div class="panelflotante">
    <div class="row">
        <div class="float-left">
            <span id="crearCupo" class="btnAzul btn-block @(altaCupo?"":"hide")" type="button">
                <i class="fa fa-file-o"></i>
                @if (externo)
                {
                    <span>Solicitar Nuevo Cupo</span>
                }
                else
                {
                    <span>Crear Nuevo Cupo</span>
                }

            </span>
        </div>
        @if (!externo)
        {
            <div>
                <div class="float-left" id="cupoPropiosDiv" style="width:100px; margin-left:12px" data-toggle="tooltip" onclick="filtrarMesa()">
                    <span class="botonVarios">
                        <i id="cupoPropio" class="fa fa-user varios" aria-hidden="true"></i>
                    </span>
                    <span>Propios</span>
                </div>
                <div class="float-left" style="width:100px; margin-left:12px">
                    <span style="width:100px;">Elementos por pagina</span>
                </div>
                <div class="float-left" style="width:100px; margin-left:12px">
                    <select id="pageSize" onchange="setPageSize()" style="width:100px;">
                        <option value="5">5</option>
                        <option value="10">10</option>
                        <option value="20" selected>20</option>
                        <option value="40">40</option>
                    </select>
                </div>
                <div class="float-right margen-15">
                    @if (anularCupo || anularCentro || anularOtrasZonas || anularRosario ||
            anularSur || anularNorte || anularSur)
                    {
                        <span id="anularVarios" class="btnVarios" onclick="AnularSeleccionados()">
                            <i class="fa fa-trash"></i>
                            Anular
                        </span>
                    }
                </div>
                <div class="float-right margen-15">
                    @if (modificarCupo || modificarCentro || modificarOtrasZonas || modificarRosario ||
            modificarSur || modificarNorte || modificarSur)
                    {
                        <span id="modificarVarios" class="btnVarios" onclick="ModificarSeleccionados()">
                            <i class="fa fa-pencil"></i>
                            Modificar
                        </span>
                    }
                </div>
                <div class="float-right margen-15">
                    <span id="copiar" class="btnVarios" onclick="CopiarSeleccionados()">
                        <i class="fa fa-copy"></i>
                        Copiar
                    </span>
                </div>
                <div class="float-right margen-15">
                    <span id="retransmitir" class="btnVarios" onclick="RetransmitirSeleccionados()">
                        <i class="fa fa-mail-forward"></i>
                        Transmitir
                    </span>
                </div>
            </div>

        }
        else
        {
            <div id="materialHabilitado" class="float-right margen-15 text-xs-center table-responsive">
                <table id="tabla-cupo"></table>
            </div>
        }

    </div>
    <div class="linea col-12" data-toggle="collapse" data-target="#demo">
    </div>
    <button type="button" class="botonFiltrar btn" data-toggle="collapse" data-target="#demo">
        <span class="icono"> <i class="fa fa-plus-square-o" aria-hidden="true"></i></span>
    </button>

    <div id="demo" class="row no-margin collapse" style="margin-top: -25px;">
        <div class="col-md-8"></div>
        <div class="col-xs-12 col-md-2">
            @Html.TextBox("CupoSap", "", new { placeholder = "Código de Cupo", @class = "form-control filtroBusquedaTextBoxContieneTexto", style = "width:100%", @id = "CupoSAPId" })
        </div>
        <div class="col-xs-12 col-md-2">
            <button type="button" id="filtrar" class="k-button k-button-icontext fa fa-filter" style="height:34px" onclick="Filtrar()">
            </button>
            <button type="button" id="borrarFiltro" class="k-button k-button-icontext fa fa-times" style="height:34px" onclick="BorrarFiltro()">
            </button>

        </div>
    </div>

</div>




<br />
<div id="cupos">
    <div class="row" id="nuevotab">
        <div class="col-xs-12" id="parent">
            <div style="height:450px;">
                <div id="gridCupo"></div>
            </div>
        </div>
    </div>
</div>


<!-- Modal Borrar-->
@Html.Partial("ModalBorrar")
@Html.Partial("ModalBorrarVarios")
@Html.Partial("ModalRechazarCupoConMotivo")
