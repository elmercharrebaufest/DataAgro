@*<link href="~/Content/rol.css" rel="stylesheet" />*@
<link href="~/Content/compraNet.css" rel="stylesheet" />

<div class="modal fade" id="modalHabilitarMaterial" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            @*<div class="modal-header ">
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span><span class="sr-only">Close</span></button>
                <h1 class="modal-title-confirmadoTilde" id="lineModalLabel"></h1>
                <div class="status confirmado-modal">
                    <div>Habilitacion Material</div>
                </div>
            </div>*@
            <div class="modal-body clearfix ">
                <div class="col-xs-12 noPadding">
                    <table class="table-striped tabla" id="tabla">
                        <thead>
                            <tr>
                                <th>Habilitar Todos</th>
                                <th>
                                    <label class="content-input">
                                        <input type="checkbox" id="selectall" @(ViewBag.Habilitado != false ? "checked" : "")>
                                        <i></i>
                                    </label>
                                </th>
                            </tr>
                        </thead>
                        @foreach (var mat in ViewBag.MaterialDesc)
                        {
                            var i = 0;
                            <tr>
                                <td>@mat.Descripcion</td>
                                <td style="width: 10px">
                                    <label class="content-input">
                                        <input type="checkbox" class="case" name="case[]" id="@mat.MaterialId"  @(mat.Habilitado == true ? "checked" : "") value="@i">
                                        <i></i>
                                    </label>
                                </td>
                            </tr>
                            i++;
                        }
                    </table>
                </div>
            </div>
            <br />
            <div class="modal-footer clearfix ">
                <div class="col-xs-6 noPaddingLeft">
                    <span id="idBolsa"></span>
                    <button type="button" id="finalizarConfirmado" onclick="ObtenerDatosMaterialHabilitado()" class="myBtn" data-dismiss="modal">Confirmar</button>
                </div>
                <div class="col-xs-6 noPaddingRight">
                    <button type="button" class="myBtn btnCancelar" data-dismiss="modal">Cancelar</button>
                </div>
            </div>
        </div>
    </div>
</div>
