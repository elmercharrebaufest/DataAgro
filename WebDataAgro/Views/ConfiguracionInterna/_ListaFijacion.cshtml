@model WebDataAgro.Models.ConfiguracionInternaModel

<div id="formulario" class="table-container">

    @if (Model.ResultadoFijacion != null && Model.ResultadoFijacion.HayError)
    {
        if (Model.ResultadoFijacion.Errores[0].ErrorCode != 200)
        {
            <div class="alert alert-danger alert-dismissible" role="alert">
                <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                @Model.ResultadoFijacion.Errores[0]
            </div>
        }
        else
        {
            <div class="alert alert-success alert-dismissible" role="alert">
                <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                @Model.ResultadoFijacion.Errores[0]
            </div>
            <script>LimpiarFijacionForm()</script>
        }
    }
</div>
<div class="row">
    <div class="col-xs-12">
        <div class="historial-desplegable" data-toggle="collapse" data-target="#historialFijacion" onclick="mostrarocultar('#mostrarFijacion')">
            <span class="historial">Historial</span> <span id="mostrarFijacion" class="mostrar">Mostrar</span>
        </div>
        <div id="historialFijacion" class="collapse tabla-research">
            <table class="tabla-historial table">
                <tr>
                    <th>Material</th>
                    <th>Dia</th>
                    <th></th>
                </tr>
                @foreach (var hf in Model.HabilitacionFijacion)
                {
                    <tr>
                        <td>@Html.DisplayFor(model => hf.Material)</td>
                        @{
                            var dia = hf.Dia.ToString("dd/MM/yyyy");
                        }
                        <td>@Html.DisplayFor(model => dia)</td>
                        <td>
                            @Ajax.ActionLink(" ", "EliminarFijacion", new { @id = hf.Id }, new AjaxOptions { UpdateTargetId = "listaFijacion", InsertionMode = InsertionMode.Replace }, new { @class = "fa fa-minus-circle danger" })
                        </td>
                    </tr>
                }
            </table>
        </div>
    </div>
</div>