@model WebDataAgro.Models.ConfiguracionInternaModel

<div id="formulario" class="table-container">

    @if (Model.ResultadoCampaña != null && Model.ResultadoCampaña.HayError)
    {
        if (Model.ResultadoCampaña.Errores[0].ErrorCode != 200)
        {
            <div class="alert alert-danger alert-dismissible" role="alert">
                <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                @Model.ResultadoCampaña.Errores[0]
            </div>
        }
        else
        {
            <div class="alert alert-success alert-dismissible" role="alert">
                <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                @Model.ResultadoCampaña.Errores[0]
            </div>
            <script>LimpiarCampañaForm()</script>
        }
    }
</div>
<div class="row">
    <div class="col-xs-12">
        <div class="historial-desplegable" data-toggle="collapse" data-target="#historialCampaña" onclick="mostrarocultar('#mostrarCampaña')">
            <span class="historial">Activos</span> <span id="mostrarCampaña" class="mostrar">Mostrar</span>
        </div>
        <div id="historialCampaña" class="collapse tabla-research">
            <table class="tabla-historial table">
                <tr>
                    <th>Material</th>
                    <th>Campaña</th>
                    
                    <th></th>
                </tr>
                @foreach (var pr in Model.HabilitacionCampaña)
                {
            <tr>
                <td>@Html.DisplayFor(model => pr.Material)</td>
                <td>@Html.DisplayFor(model => pr.Campaña)</td>

                <td>
                    @Ajax.ActionLink(" ", "EliminarCampaña", new { @id = pr.Id }, new AjaxOptions { UpdateTargetId = "listaCampaña", InsertionMode = InsertionMode.Replace }, new { @class = "fa fa-minus-circle danger" })
                </td>
            </tr>
                }
            </table>
        </div>
    </div>
</div>