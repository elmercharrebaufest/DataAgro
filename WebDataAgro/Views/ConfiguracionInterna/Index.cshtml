@using Molinos.DataAgro.Entities.Dto
@model WebDataAgro.Models.ConfiguracionInternaModel
@{
    ViewBag.Title = "Configuracion";
}
@section Styles {
    <link href="~/Content/ConfiguracionInterna.css" rel="stylesheet" />
}
@section Scripts{
    <script src="~/Scripts/KendoExtensions.js"></script>
    @Scripts.Render("~/bundles/ConfiguracionInterna")
    <script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>

}
<script>
    pausado = '@ViewBag.Habilitado';
    $(document).ready(function () {
       var model = '@Html.Raw(Json.Encode(((List<EstadoPrecioMOADto>)ViewBag.MaterialDesc).GroupBy(x=> x.MaterialId).Select(x=> new { Id = x.FirstOrDefault().MaterialId, Descripcion= x.FirstOrDefault().Descripcion})))';
    material = JSON.parse(model);

    });

</script>
<h3 class="padding"> Configuración Interna</h3>
