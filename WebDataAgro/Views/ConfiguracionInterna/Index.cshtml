@model WebDataAgro.Models.ConfiguracionInternaModel
@{
    ViewBag.Title = "Configuracion";
}
@section Styles {
    <link href="~/Content/ConfiguracionInterna.css" rel="stylesheet" />
}
@section Scripts{
    @Scripts.Render("~/bundles/ConfiguracionInterna")
    <script src="~/Scripts/jquery.unobtrusive-ajax.js"></script>
}

<h3 class="padding"> Configuración Interna</h3>

<div class="container">
    <div class="row">
        <div class="col-xs-6 wizard-header-group col-md-4" id="PrecioTab">
            <div class="wizard-header-contenedor whc-selected">
                Precio MOA
            </div>
        </div>
        <div class="col-xs-6 wizard-header-group col-md-4" id="PizarraTab">
            <div class="wizard-header-contenedor">
                Habilitación Pizarra
            </div>
        </div>

        <div class="col-xs-6 wizard-header-group col-md-4" id="FijacionTab">
            <div class="wizard-header-contenedor">
               Habilitacion Fijación
            </div>
        </div>
    </div>
    <br/>
    <div id="PrecioMoa">
        @Html.Action("GrabarPrecioPartial", "ConfiguracionInterna")
    </div>
    <div id="HabilitacionPizarra" hidden>
        @Html.Action("GrabarPizarraPartial", "ConfiguracionInterna")
    </div>
    <div id="HabilitacionFijacion" hidden>
        @Html.Action("GrabarFijacionPartial", "ConfiguracionInterna")
    </div>
</div>