                <span>Deshabilitación General de Precios</span>
                <input id="pausar" class="campo-input-input pausado" value="9" data-bind="" type="checkbox" @(ViewBag.Habilitado != false ? "checked" : "") onclick="Pausar()" />
                <i></i>
            </label>*@
