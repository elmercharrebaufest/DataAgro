            <div class="col-sm-3">
                @Html.DropDownListFor(x => x.TipoNegocioId, new SelectList(ViewBag.TipoNegocioPizarra, "Value", "Text"), "Seleccione Tipo de Negocio", new { @class = "form-control", @id = "TipoNegocioIdPago"})
            </div>
