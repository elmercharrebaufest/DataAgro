@model WebDataAgro.Models.ConfiguracionInternaModel

<div id="formulario" class="table-container">

    @if (Model.ResultadoPrecio != null && Model.ResultadoPrecio.HayError)
    {
        if (Model.ResultadoPrecio.Errores[0].ErrorCode != 200)
        {
            <div class="alert alert-danger alert-dismissible" role="alert">
                <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                @Model.ResultadoPrecio.Errores[0]
            </div>
        }
        else
        {
            <div class="alert alert-success alert-dismissible" role="alert">
                <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                @Model.ResultadoPrecio.Errores[0]
            </div>
            <script>LimpiarPrecioForm()</script>
        }
    }
</div>
<div class="row">
    <div class="col-xs-10 m-grid-col-xs-offset-1">
        <div class="historial-desplegable" data-toggle="collapse" data-target="#historialPrecio" onclick="mostrarocultar('#mostrarPrecio')">
            <span class="historial">Historial</span> <span id="mostrarPrecio" class="mostrar">Mostrar</span>
        </div>
        <div id="historialPrecio" class="collapse tabla-research">
            <table class="tabla-historial table">
                <tr>
                    <th>Material</th>
                    <th>Precio</th>
                    <th>Moneda</th>
                    <th>Desde</th>
                    <th>Hasta</th>
                    <th></th>
                </tr>
                @foreach (var pr in Model.PrecioMoa)
                {
                    <tr>
                        <td>@Html.DisplayFor(model => pr.Material)</td>
                        <td>@Html.DisplayFor(model => pr.Precio)</td>
                        <td>@Html.DisplayFor(model => pr.MonedaId)</td>
                        @{
                            var fechaDesde = pr.DesdeVigencia.ToString("dd/MM/yyyy hh\\:mm tt");
                            var fechaHasta = pr.HastaVigencia.ToString("dd/MM/yyyy hh\\:mm tt");
                        }
                        <td>@Html.DisplayFor(model => fechaDesde)</td>
                        <td>@Html.DisplayFor(model => fechaHasta)</td>
                        <td>
                            @Ajax.ActionLink(" ", "EliminarPrecio", new { @id = pr.Id }, new AjaxOptions { UpdateTargetId = "listaPrecio", InsertionMode = InsertionMode.Replace }, new { @class = "fa fa-minus-circle danger" })
                        </td>
                    </tr>
                }
            </table>
        </div>
    </div>
</div>