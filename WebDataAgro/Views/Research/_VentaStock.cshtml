@model WebDataAgro.Models.ResearchVentaStockModel
<br />
<br />

<div class="container">
    @using (Ajax.BeginForm("GrabarVentaStock", null, new AjaxOptions { UpdateTargetId = "listaVentaStock", InsertionMode = InsertionMode.Replace }, new { }))
    {

        <div class="row">
            <div class="col-sm-2 col-md-2">
                <label>Procedencia</label>
            </div>
            <div class="col-sm-3 col-md-4">
                <input class="w100" id="LocalidadVentaStock" placeholder="Buscar por Localidad" />
                @Html.HiddenFor(x => x.LocalidadId, new { @Id = "LocalidadVentaStockId" })
            </div>
            <div class="col-sm-2 col-md-2">
                <label>Partido</label>
            </div>
            <div class="col-sm-3 col-md-4">
                @Html.TextBox("Partido", "", new { disabled = "disabled", @id = "PartidoVentaStock", @class = "form-control limpiar" })
            </div>
        </div>

        <div class="row">
            <div class="col-sm-2 col-md-2">
                <label>Cultivo</label>
            </div>
            <div class="col-sm-3 col-md-4">
                @Html.DropDownListFor(m => m.MaterialId, new SelectList(ViewBag.Material, "Value", "Text"), "Seleccione Cultivo",new { @class = "form-control", @Id = "MaterialVentaStockId" })
            </div>
            <div class="col-sm-2 col-md-2">
                <label>Almacenado %</label>
            </div>
            <div class="col-sm-3 col-md-4">
                @Html.TextBoxFor(m => m.Almacenado, new { @class = "number-input w100  required-box required-box-parent limpiar" })
            </div>
        </div>

        <div class="row">
            <div class="col-sm-2 col-md-2">
                <label>Vendido a Precio %</label>
            </div>
            <div class="col-sm-3 col-md-4">
                @Html.TextBoxFor(m => m.VendidoAPrecio, new { @class = "number-input w100 limpiar" })
            </div>
        </div>

        <div class="row">
            <div class="col-sm-2 col-md-2">
                <label>Observaciones</label>
            </div>
            <div class="col-sm-8 col-md-10">
                @Html.TextBoxFor(m => m.Observaciones, new { @class = "w100 form-control limpiar" })
            </div>
        </div>
        <br />

        <div id="row-botones-material">
            <button type="submit" class="formulario-footer-cancelar k-button k-button-icontext guardar">Guardar</button>
            <button type="button" class="formulario-footer-cancelar k-button k-button-icontext cancelar">Cancelar</button>
        </div>
    }
    <div id="listaVentaStock">
        @Html.Partial("_ListaVentaStock", Model)
    </div>
</div>

