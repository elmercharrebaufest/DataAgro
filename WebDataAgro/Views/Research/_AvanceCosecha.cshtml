@model WebDataAgro.Models.ResearchAvanceCosechaModel
<br />
<br />

<div class="container">
    @using (Ajax.BeginForm("GrabarAvanceCosecha", null, new AjaxOptions { UpdateTargetId = "listaAvanceCosecha", InsertionMode = InsertionMode.Replace }, new { }))
    {

        <div class="row">
            <div class="col-sm-2 col-md-2">
                <label>Procedencia</label>
            </div>
            <div class="col-sm-3 col-md-4">
                <input class="w100" id="LocalidadCosecha" placeholder="Buscar por Localidad" />
                @Html.HiddenFor(x => x.LocalidadId, new { @Id = "LocalidadIdCosecha" })
            </div>
            <div class="col-sm-2 col-md-2">
                <label>Partido</label>
            </div>
            <div class="col-sm-3 col-md-4">
                @Html.TextBox("Partido", "", new { disabled = "disabled", @id = "PartidoCosecha", @class = "form-control" })
            </div>
        </div>

        <div class="row">
            <div class="col-sm-2 col-md-2">
                <label>Cultivo</label>
            </div>
            <div class="col-sm-3 col-md-4">
                @Html.DropDownListFor(m => m.MaterialId, new SelectList(ViewBag.Material, "Value", "Text"), "Seleccione Material",new { @class = "form-control" })
            </div>
            <div class="col-sm-2 col-md-2">
                <label>Avance %</label>
            </div>
            <div class="col-sm-3 col-md-4">
                @Html.TextBoxFor(m => m.Avance, new { @class = "number-input w100  required-box required-box-parent" })
            </div>
        </div>

        <div class="row">           
                <div class="col-sm-2 col-md-2">
                    <label>Rendimiento</label>
                </div>
                <div class="col-sm-3 col-md-4">
                    @Html.TextBoxFor(m => m.Rendimiento, new { @class = "number-input w100" })
                </div>             
                <div class="col-sm-2 col-md-2">
                    <label>Rango Desde/Hasta</label>
                </div>
                <div class="col-sm-3 col-md-4">
                    <div class="col-xs-6" style = "padding-left:0" >
                    @Html.TextBoxFor(m => m.RangoDesde, new { @class = "number w100"})
                    </div>
                    <div class="col-xs-6" style = "padding-right:0" >
                    @Html.TextBoxFor(m => m.RangoHasta, new { @class = "number w100"})
                    </div>                      
                </div>
            </div>
        <div class="row">
            <div class="col-sm-2 col-md-2">
                <label>Observaciones</label>
            </div>
            <div class="col-sm-10 col-md-10">
                @Html.TextBoxFor(m => m.Observaciones, new { @class = "w100 form-control" })
            </div>
        </div>
        <br />

        <div id="row-botones-material">
            <button type="submit" class="formulario-footer-cancelar k-button k-button-icontext">Guardar</button>
            @Ajax.ActionLink("Cancelar", "AvanceCosechaPartial", null, new AjaxOptions { UpdateTargetId = "AvanceCosecha", InsertionMode = InsertionMode.Replace, OnSuccess = "Input" }, new { @class = "formulario-footer-cancelar k-button k-button-icontext" })

        </div>
    }
    <div id="listaAvanceCosecha">
        @Html.Partial("_ListaAvanceCosecha", Model)
    </div>
</div>

