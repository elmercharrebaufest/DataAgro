@model WebDataAgro.Models.ResearchVentaStockModel

@Html.AntiForgeryToken()

    <div id="formulario" class="table-container">

        @if (Model.Resultado != null && Model.Resultado.HayError)
        {
            if (Model.Resultado.Errores[0].ErrorCode != 200)
            {
                <div class="alert alert-danger alert-dismissible" role="alert">
                    <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                    @Model.Resultado.Errores[0]
                </div>
            }
            else
            {
                <div class="alert alert-success alert-dismissible" role="alert">
                    <a href="#" class="close" data-dismiss="alert" aria-label="close">&times;</a>
                    @Model.Resultado.Errores[0]
                </div>
                <script>LimpiarForm()</script>
            }
        }
    </div>
<div class="row">
    <div class="col-xs-10 m-grid-col-xs-offset-1">
        <div class="historial-desplegable" data-toggle="collapse" data-target="#historialVentaStock" onclick="mostrarocultar('#mostrarVentaStock')">
            <span class="historial">Historial</span> <span id="mostrarVentaStock" class="mostrar">Mostrar</span>
        </div>
        <div id="historialVentaStock" class="collapse">
            <table class="tabla-historial table">
                <tr>
                    <th>Cultivo</th>
                    <th>Localidad</th>
                    <th>Comercial</th>
                    <th>Vendido a Precio %</th>
                    <th>Almacenado %</th>
                    <th>Fecha/Hora</th>

                </tr>
                @foreach (var mat in Model.HistorialVentaStock)
                {
                    <tr>
                        <td>@Html.DisplayFor(model => mat.Material)</td>
                        <td>@Html.DisplayFor(model => mat.Localidad)</td>
                        <td>@Html.DisplayFor(model => mat.Comercial)</td>
                        <td>@Html.DisplayFor(model => mat.VendidoAPrecio)</td>
                        <td>@Html.DisplayFor(model => mat.Almacenado)</td>
                        @{var fecha = mat.FechaHora.ToString("dd/MM/yyyy hh\\:mm tt");}
                        <td>@Html.DisplayFor(model => fecha)</td>
                        <td>
                            @Ajax.ActionLink(" ", "EliminarVentaStock", new { @id = mat.Id }, new AjaxOptions { UpdateTargetId = "listaVentaStock", InsertionMode = InsertionMode.Replace }, new { @class = "fa fa-minus-circle danger" })
                        </td>
                    </tr>
                }
            </table>
        </div>
    </div>
</div>

