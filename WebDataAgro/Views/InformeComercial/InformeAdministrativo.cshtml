@{
    ViewBag.Title = "Informe Administrativo";
}

@section Scripts {
    @Scripts.Render("~/bundles/InformeAdministrativoIndex")
}

@section Styles {
    <link href="~/Content/InformeAdministrativo.css" rel="stylesheet" />
}

<div class="Titulo">
    <h5> Informe Administrativo </h5>
    <br />
</div>
<div class="filtro-desplegable" data-toggle="collapse" data-target="#filtrar" onclick="mostrarocultar('#mostrar')">
    <div class="k-button"><span class="filtro">Filtro</span> <strong><span id="mostrar" class="mostrar" style="font-size: 12px !important;">Mostrar</span></strong></div>
</div>
<br />

<div id="filtrar" class="container collapse">
    <div class="row">
        <div class="col-md-2">
            <label>Proveedor</label>
        </div>
        <div class="col-md-4">
            <input id="buscadorProveedor" name="ProveedorId" class="multiselect" style="width:100%" type="text" placeholder="Buscar por CUIT, razón social" required="required" />
        </div>

        <div class="col-md-2">
            <label>Campaña</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownList("CampanaId", new SelectList(ViewBag.Campania, "Value", "Text"), "Seleccione la Campaña", new { @class = "form-control filtroBusquedaPorId", @id = "campaniaId" })
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Material</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownList("MaterialId", new SelectList(ViewBag.Material, "Value", "Text"), "Seleccione el Material", new { @class = "form-control filtroBusquedaPorId", @id = "materialId" })
        </div>

        <div class="col-md-2">
            <label>Comercial</label>
        </div>
        <div class="col-md-4">
            @Html.DropDownList("ComercialId", new SelectList(ViewBag.Comercial, "Value", "Text"), "Seleccione el Comercial", new { @class = "form-control filtroBusquedaPorId", @id = "ComercialId" })
        </div>
    </div>
    <br />
    <div class="row">
        <div class="col-md-2">
            <label>Fecha de Generación</label>
        </div>
        <div class="col-md-2">
            <span id="fechaDeCarga">
                <input id="fechaCargaId" class="filtroFecha" name="FechaAlta-desde" type="date" style="width: 100%" />
            </span>
        </div>
        <div class="col-md-2">
            <span id="fechaDeCargaHasta">
                <input id="fechaCargaHastaId" class="filtroFecha" name="FechaAlta-hasta" type="date" style="width: 100%" />
            </span>
        </div>
        <div class="col-md-2">
            <label>Fecha de Descarga</label>
        </div>
        <div class="col-md-2">
            <span id="fechaDeDescarga">
                <input id="fechaDescargaId" class="filtroFecha" name="FechaDescarga-desde" type="date" style="width: 100%" />
            </span>
        </div>
        <div class="col-md-2">
            <span id="fechaDeDescargaHasta">
                <input id="fechaDescargaHastaId" class="filtroFecha" name="FechaDescarga-hasta" type="date" style="width: 100%" />
            </span>
        </div>
    </div>
    <br />
    <br />
    <div class="row">
        <div class="col-md-12" style="text-align:right">
            <button type="button" id="filtrar" class="k-button k-button-icontext sideMargin-15 limpiar" style="width: 14%" onclick="Filtrar()">Filtrar</button>
        </div>
    </div>
</div>

<br />
<div class="resultado">
    <div id="grilla-informes" class="tabla-result">
    </div>
</div>
<script type="text/x-kendo-template" id="templateToolbar">
    <div>
    @if (PermisosHelper.Is(PermisosDataAgro.DescargarInformeAdministrativo))
     {
       <a class="k-button k-button-icontext" onclick="customExport()" href="\\#"><span class="k-icon k-i-file-csv"></span> <b>Exportar CSV</b> </a>

       <a class="k-button k-button-icontext" onclick="EnviarCapProdSAP()" href="\\#"><span class="k-icon k-i-arrow-right"></span> <b>Enviar a SAP</b> </a>
     }

    <a class="k-button k-button-icontext k-grid-excel" title="Descargue la grilla completa o las filas seleccionadas" href="\\#"><span class="k-icon k-i-file-excel"></span> <b>Exportar a Excel</b></a>
    </div>
</script>