@{
    ViewBag.Title = "Informe Comercial";
}

@section Scripts {
    @Scripts.Render("~/bundles/InformeComercial")
}

<link href="~/Content/InformeComercial.css" rel="stylesheet" type="text/css" />

<div id="InformeComercial">


    <h3>Informe Comercial</h3>

    <div class="tab-pane" id="tab1">

        <br />

        <div class="row">
            <div class="col-md-1">
                <label>Proveedor</label>
            </div>
            <div class="col-md-6">
                <div class="buscador-nav-Proveedor">
                    <input class="proveedor-input" type="text" placeholder="Buscar por CUIT, razón social" />
                    <img class="buscar-nav-Prov" id="limpiarinput" src="~/Content/Images/eliminar-tel-mail.png" />
					<img class="buscar-nav-Prov" src="~/Content/Images/menusegundo-buscar.png" />
                    <div class="buscar-result-proveedor">
                    </div>
                </div>
            </div>
        </div>

        <br />

        <div id="tabstrip">
            <ul>
                <li class="k-state-active" id="ninforme">
                    Nuevo Informe
                </li>
                <li id="informer">
                    Informes Realizados
                </li>
            </ul>
        </div>

        <div class="row" id="tabactual">
            <div class="col-md-12">
                <div id="gridInformeComercial" data-bind="source: Resultados" style="height:200px;"></div>
            </div>
        </div>

        <div class="row" id="nuevotab">
            <div class="col-md-12">
                <div id="gridInformeComercialNuevo" style="height:200px;"></div>
            </div>
        </div>

        <br />



    </div>


    <div class="tab-pane" id="tab2">
        <div class="formulario">
            <div class="formulario-campo">
                <div class="formulario-label">
                    Domicilio Legal
                </div>
                <div class="formulario-input">
                    <input type="text" id="Domicilio" placeholder="Domicilio (50 caracteres)" maxlength="50" />
                </div>
            </div>
            <div class="formulario-campo">
                <div class="formulario-label">
                    Empleados en relación de dependencia
                </div>
                <div class="formulario-input">
                    <div>
                        <div>
                            <label for="si"><input type="radio" id="si" value="si" name="depen">Si</label>
                            <input type="text" id="EmplRelDepCant" placeholder="Cantidad (50 caracteres)" maxlength="50" disabled/>
                        </div>
                        <label for="no"><input type="radio" id="no" value="no" name="depen">No</label>
                    </div>
                    
                </div>
            </div>
            <div class="formulario-campo">
                <div class="formulario-label">
                    Rodados / Equipos aptos para la actividad rural
                </div>
                <div class="formulario-input">
                    <div>
                        <div><label for="equipro"><input type="radio" id="equipro" value="equipro" name="rodado">Equipamiento Propio</label></div>
                        <div><label for="equialq"><input type="radio" id="equialq" value="equialq" name="rodado">Alquilado</label>          </div>
                        <div><label for="proyalq"><input type="radio" id="proyalq" value="proyalq" name="rodado">Propio y alquilado</label> </div>
                        <div>
                            <label for="otrosro"><input type="radio" id="otrosro" value="otrosro" name="rodado">Otros</label>
                            <input type="text" id="RodadosOtros" placeholder="Otros (50 caracteres)" maxlength="50" disabled/>
                        </div>
                    </div>
                    
                </div>
            </div>
            <div class="formulario-campo">
                <div class="formulario-label">
                    Servicios de chacra
                </div>
                <div class="formulario-input">
                    <div>
                        <div><label for="persprop"><input type="radio" id="persprop" value="persprop" name="servicios">Personal propio</label></div>
                        <div><label for="perscont"><input type="radio" id="perscont" value="perscont" name="servicios">Personal contratado</label></div>
                        <div><label for="persprco"><input type="radio" id="persprco" value="persprco" name="servicios">Personal propio y contratado</label></div>
                        <div>
                            <label for="otros"><input type="radio" id="otros" value="otros" name="servicios">Otros</label>
                            <input type="text" id="ChacraOtros" placeholder="Otros (50 caracteres)" maxlength="50" disabled/>
                        </div>
                    </div>
                </div>
            </div>
            <div class="titulo">
                Antecedentes de la siembra
            </div>
            <div class="formulario-campo">
                <div class="formulario-label">
                    Antigüedad en la actividad
                </div>
                <div class="formulario-input">
                    <input type="text" id="AntigActividad" placeholder="Antigüedad (100 caracteres)" maxlength="100" />
                </div>
            </div>
            <div class="formulario-campo">
                <div class="formulario-label">
                    Actuación como productor / siembras anteriores
                </div>
                <div class="formulario-input">
                    <input type="text" id="ActuacionProd" placeholder="Actuación (100 caracteres)" maxlength="100" />
                </div>
            </div>

            <div class="titulo">
                Antecedentes comerciales
            </div>
            <div class="formulario-campo">
                <div class="formulario-label">
                    Clientes anteriores
                </div>
                <div class="formulario-input">
                    <input type="text" id="ClienteAnt" placeholder="Clientes (100 caracteres)" maxlength="100" />
                </div>
            </div>
            
            <div class="formulario-campo">
                <div class="formulario-label">
                    Otros comentarios
                </div>
                <div class="formulario-input">
                    <textarea id="Comentarios" placeholder="Comentarios (300 caracteres)" maxlength="300"></textarea>
                </div>
            </div>

        </div>
    </div>

    <div class="row" id="botones">
        <div class="col-md-2">
        </div>
        <div class="col-md-10">
            <button id="butSiguiente" class="k-button margen-cubo" type="button" data-role="button"><img src="~/Content/Images/Aceptar.png" /> Aceptar</button>
            <button id="butVolver" class="k-button margen-cubo" type="button" data-role="button"><img src="~/Content/Images/Cancelar.png" /> Volver</button>
            
            <button id="butAceptar" class="k-button margen-cubo" type="button" data-role="button">Generar Informe</button>
        </div>
    </div>

    @Html.Partial("~/Views/Shared/_PleaseWait.cshtml")

</div>
    


<style>
    #pivotgrid {
        display: inline-block;
        vertical-align: top;
        width: 100%;
    }

    #configurator {
        display: inline-block;
        vertical-align: top;
        width: 2500px;
    }

    .k-pivot-table .k-grid-content td {
        text-align: right;
    }
</style>
