<form id="frmCertificacion">

    <div class="row">
        <div class="col-md-4">
            <label>Bolsa</label>
            <select id="Bolsa" class="form-control">
                <option value="">Cargando Bolsas...</option>
            </select>
        </div>
        <div class="col-md-4">
            <label>Fecha Certificación</label>
            <input type="text" id="FechaCertificacion" class="form-control" style="width: stretch"/>
        </div>
        <div class="col-md-4">
            <label>Fecha Vencimiento</label>
            <input type="text" id="FechaVencimientoCertificacion" class="form-control" style="width: stretch"/>
        </div>
    </div>

    <div class="row mt-2">
        <div class="col-md-4">
            <label>Oblea</label>
            <input type="text" id="Oblea" class="form-control" maxlength="10" />
        </div>
        <div class="col-md-4">
            <label>Tipo Oblea</label>
            <select id="TipoOblea" class="form-control">
                <option value="">Cargando Tipo Oblea...</option>
            </select>
        </div>
        <div class="col-md-4">
            <label>Rechazado</label>
            <div>
                <input id="Rechazado" class="form-control" role="switch" type="checkbox"
                       style="width:20px; margin-top:0 !important; margin-left:0 !important;" />
            </div>
        </div>
    </div>

</form>
