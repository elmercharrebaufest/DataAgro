<form id="frmCertificacion">

    <!-- Datos de Precertificación de la Bolsa -->
    <div class="row">
        <div class="col-md-12">
            <label><strong>Oblea Bolsa</strong></label>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <label>Rechazado</label>
            <div>
                <input id="Rechazado" class="form-control" role="switch" type="checkbox"
                       style="width:20px; margin-top:0 !important; margin-left:0 !important;" />
            </div>
        </div>
        <div class="col-md-4">
            <label>Oblea</label>
            <input type="text" id="Oblea" class="form-control" maxlength="18" />
        </div>
        <div class="col-md-4">
            <label>Bolsa</label>
            <select id="Bolsa" class="form-control">
                <option value="">Cargando Bolsas...</option>
            </select>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <label>Fecha Certificación</label>
            <input type="text" id="FechaCertificacion" class="form-control" style="width: stretch" />
        </div>
        <div class="col-md-4">
            <label>Fecha Vencimiento</label>
            <input type="text" id="FechaVencimiento" class="form-control" style="width: stretch" />
        </div>
    </div>


    <!-- Registracion AFIP -->
    <hr style="margin-top: 10px; margin-bottom: 3px;" />
    <div class="row">
        <div class="col-md-12">
            <label><strong>Registración Arca</strong></label>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <label>Rechazado Arca</label>
            <div>
                <input id="RechazadoAfip" class="form-control" role="switch" type="checkbox"
                       style="width:20px; margin-top:0 !important; margin-left:0 !important;" />
            </div>
        </div>
        <div class="col-md-4">
            <label>Codigo Registración Arca</label>
            <input type="text" id="CodigoRegistracionAfip" class="form-control" style="width: stretch" maxlength="20" />
        </div>
        <div class="col-md-4">
            <label>Fecha Registración Arca</label>
            <input type="text" id="FechaRegistracionAfip" class="form-control" style="width: stretch" />
        </div>
    </div>

    <!-- Oblea Provisoria -->
    <hr style="margin-top: 10px; margin-bottom: 3px;" />
    <div class="row">
        <div class="col-md-12">
            <label><strong>Oblea Provisoria</strong></label>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <label>Fecha Vencimiento</label>
            <input type="text" id="FechaVencimientoObleaProvisoria" class="form-control" style="width: stretch" />
        </div>
    </div>

    <!-- Oblea Plan Canje -->
    <hr style="margin-top: 10px; margin-bottom: 3px;" />
    <div class="row">
        <div class="col-md-12">
            <label><strong>Oblea Plan Canje</strong></label>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <label>Oblea</label>
            <input type="text" id="ObleaPlanCanje" class="form-control" maxlength="18" />
        </div>
        <div class="col-md-4">
            <label>Bolsa</label>
            <select id="BolsaPlanCanje" class="form-control">
                <option value="">Cargando Bolsas...</option>
            </select>
        </div>
        <div class="col-md-4">
            <label>Fecha Certificaci&oacute;n</label>
            <input type="text" id="FechaCertificacionPlanCanje" class="form-control" style="width: stretch" />
        </div>
        <div class="col-md-4">
            <label>Fecha Vencimiento</label>
            <input type="text" id="FechaVencimientoPlanCanje" class="form-control" style="width: stretch" />
        </div>
    </div>

</form>

<style>
    .fecha-invalida {
        border: 1px solid #dc3545 !important;
        background-color: #fff5f5;
    }
</style>
<span id="notification"></span>
