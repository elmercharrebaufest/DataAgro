<div id="modalSeguimientoControlBoleto" class="modal fade" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content clearfix modal-seguimiento">

            <div class="modal-header">
                <button type="button" class="modal-close" data-dismiss="modal">
                    <span aria-hidden="true">×</span>
                    <span class="sr-only">Close</span>
                </button>
                <div class="header-top">
                    <h5 class="titulo-modal modal-titulo-contrato">
                        Datos de Certificación
                    </h5>
                </div>
            </div>
            <div class="modal-body">
                @Html.Partial("_FormSeguimientoControlBoleto")

            <div class="modal-footer">
                <button class="btn btn-secondary" data-dismiss="modal">
                    Cancelar
                </button>
                <button class="btn btn-primary"
                        onclick="ControlDeBoletosSeguimiento.guardar()">
                    Guardar
                </button>
            </div>

        </div>
    </div>
</div>

<style>
    .modal-seguimiento {
        background-color: white !important;
    }

    .modal-close {
        float: right;
        font-size: 21px;
        font-weight: bold;
        line-height: 1;
        color: #000000;
        text-shadow: 0 1px 0 #ffffff;
        opacity: 0.2;
        background: none !important;
        text-indent: 0;
        border-color: transparent !important;
        cursor: pointer;
    }

    h6 {
        margin-top: 10px;
        font-weight: 600;
    }
</style>
