<div id="modalSeguimientoControlBoleto" class="modal fade" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content clearfix modal-seguimiento">

            <div class="modal-header">
                <button type="button" class="modal-close" data-dismiss="modal">
                    <span aria-hidden="true">×</span>
                    <span class="sr-only">Close</span>
                </button>
                <div class="header-top">
                    <h5 class="titulo-modal modal-titulo-contrato">
                        Datos de Certificación
                    </h5>
                </div>
            </div>

            <div class="modal-body">

                <form id="frmSeguimientoControlBoleto">

                    <!-- DATOS GENERALES -->
                    <div class="row">
                        <div class="col-md-4">
                            <label>Tipo Boleto</label>
                            <select id="Boleto" class="form-control">
                                <option value="">Cargando Boleto...</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label>Bolsa</label>
                            <select id="Bolsa" class="form-control">
                                <option value="">Cargando Bolsa...</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label>Bolsa Sellado</label>
                            <input id="BolsaSellado" class="form-control" disabled />
                        </div>
                    </div>

                    <!-- 1️⃣ FECHA BASE -->
                    <div class="row">
                        <div class="col-md-4">
                            <label>Fecha Recepción Boleto</label>
                            <input type="date" id="FechaRecepBoleto" class="form-control" />
                        </div>
                    </div>

                    <!-- 2️⃣ ENVÍOS -->
                    <div class="row">
                        <div class="col-md-4">
                            <label>Fecha Envío Firmas</label>
                            <input type="date" id="FechaEnvio" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label>Fecha Envío Obleado Bolsa</label>
                            <input type="date" id="FechaEnvioBolsa" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label>Fecha Envío Certificación AFIP</label>
                            <input type="date" id="FechaEnvioAfip" class="form-control" />
                        </div>
                    </div>

                    <!-- 3️⃣ RECEPCIONES -->
                    <div class="row">
                        <div class="col-md-4">
                            <label>Fecha Recepción Obleado Bolsa</label>
                            <input type="date" id="FechaVueltaBolsa" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label>Fecha Recepción Certificación AFIP</label>
                            <input type="date" id="FechaVueltaAfip" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label>Fecha Recepción Firmas</label>
                            <input type="date" id="FechaRecibFirma" class="form-control" />
                        </div>
                    </div>

                    <!-- 4️⃣ CIERRE -->
                    <div class="row">
                        <div class="col-md-4">
                            <label>Fecha Envío Sellado</label>
                            <input type="date" id="FechaEnviadoFirma" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label>Fecha Acopio</label>
                            <input type="date" id="FechaAcopio" class="form-control" />
                        </div>
                        <div class="col-md-4">
                            <label>Rechazado AFIP</label>
                            <input id="RechazadoAfip" class="form-control" />
                        </div>
                    </div>
                    <!-- OBSERVACIONES -->
                    <div class="row">
                        <div class="col-md-12">
                            <label>Observación</label>
                            <textarea id="ObsCtrlBoleto" class="form-control"></textarea>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-12">
                            <label>Observación 2</label>
                            <textarea id="ObsCtrlBoleto2" class="form-control"></textarea>
                        </div>
                    </div>

                </form>

            </div>

            <div class="modal-footer">
                <button class="btn btn-secondary" data-dismiss="modal">
                    Cancelar
                </button>
                <button class="btn btn-primary"
                        onclick="ControlDeBoletosSeguimiento.guardar()">
                    Guardar
                </button>
            </div>

        </div>
    </div>
</div>

<style>
    .modal-seguimiento {
        background-color: white !important;
    }

    .modal-close {
        float: right;
        font-size: 21px;
        font-weight: bold;
        line-height: 1;
        color: #000000;
        text-shadow: 0 1px 0 #ffffff;
        opacity: 0.2;
        background: none !important;
        text-indent: 0;
        border-color: transparent !important;
        cursor: pointer;
    }

    h6 {
        margin-top: 10px;
        font-weight: 600;
    }
</style>
