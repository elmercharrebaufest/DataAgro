@section Scripts{
    @Scripts.Render("~/bundles/ControlDeBoletosGestion")
}
@section styles{
    <link href="~/Content/control-boletos.css" rel="stylesheet" />
    <link href="~/Content/control-boletos-contrato.css" rel="stylesheet" />
}
<div id="modalGestionControlBoleto" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">

            <div class="modal-header">
                <button type="button" class="modal-close" data-dismiss="modal">
                    <span aria-hidden="true">&times;</span>
                    <span class="sr-only">Cerrar</span>
                </button>
                <div class="header-top">
                    <h5 class="titulo-modal modal-titulo-contrato">
                        <i class="fa fa-clipboard-check" aria-hidden="true"></i>
                        Gesti&oacute;n de Control de Boletos
                    </h5>
                </div>
            </div>

            <div class="modal-body">
                <div id="accordionGestionBoleto">

                    <form id="frmGestionarContrato">

                        <div class="row">
                            <div class="col-md-4">
                                <label class="d-block"><strong>Contrato</strong></label>
                                <label id="ContratoSAP" class="d-block ancho-campos-fijo"></label>
                            </div>

                            <div class="col-md-4">
                                <label class="d-block"><strong>CUIT Vendedor</strong></label>
                                <label id="CuitVendedor" class="d-block ancho-campos-fijo"></label>
                            </div>

                            <div class="col-md-4">
                                <label class="d-block"><strong>CUIT Corredor</strong></label>
                                <label id="CuitCorredor" class="d-block ancho-campos-fijo"></label>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <label class="d-block"><strong>Material</strong></label>
                                <label id="Material" class="d-block ancho-campos-fijo"></label>
                            </div>

                            <div class="col-md-4">
                                <label class="d-block"><strong>Provincia</strong></label>
                                <label id="Provincia" class="d-block ancho-campos-fijo"></label>
                            </div>

                            <div class="col-md-4">
                                <label class="d-block"><strong>Kilos</strong></label>
                                <label id="Kilos" class="d-block ancho-campos-fijo"></label>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <label class="d-block"><strong>Procedencia</strong></label>
                                <label id="Procedencia" class="d-block ancho-campos-fijo"></label>
                            </div>

                            <div class="col-md-4">
                                <label><strong>Precio x Tonelada</strong></label>

                                <div style="display:flex">
                                    <label id="PrecioXTonelada" class="ancho-campos-fijo"></label>
                                    <label id="Moneda" class="ancho-campos-fijo"></label>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label class="d-block"><strong>Destino</strong></label>
                                <label id="Destino" class="ancho-campos-fijo"></label>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <label class="d-block"><strong>Clasificación Proveedor</strong></label>
                                <label id="ClasificacionProveedor" class="d-block ancho-campos-fijo"></label>
                            </div>

                            <div class="col-md-4">
                                <label class="d-block"><strong>Estándar Calidad</strong></label>
                                <label id="StandardCalidad" class="d-block ancho-campos-fijo"></label>
                            </div>

                            <div class="col-md-4">
                                <label class="d-block"><strong>Período Entrega</strong></label>
                                <label id="PeriodoEntrega" class="d-block ancho-campos-fijo"></label>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4">
                                <label class="d-block"><strong>Campaña</strong></label>
                                <label id="Campania" class="d-block ancho-campos-fijo"></label>
                            </div>

                            <div class="col-md-4">
                                <label class="d-block"><strong>Tipo Boleto</strong></label>
                                <label id="TipoBoleto" class="d-block ancho-campos-fijo"></label>
                            </div>

                            <div class="col-md-4">
                                <label class="d-block"><strong>Período Operación</strong></label>
                                <label id="PeriodoOperacion" class="d-block ancho-campos-fijo"></label>
                            </div>
                        </div>
                        @*<div class="row">
                            <div class="col-md-4">
                            </div>
                            <div class="col-md-4">
                                <label id="btnEliminarControlBoleto" style="cursor: pointer; color: orangered"><strong>Eliminar control del boleto <i class="fa fa-trash-o" /></strong></label>
                            </div>
                            <div class="col-md-4">
                            </div>
                        </div>*@
                    </form>

                    <!-- ════════ 1. SEGUIMIENTO CONTROL BOLETO ════════ -->
                    <div class="panel panel-default" style="margin-bottom:10px;">
                        <div class="panel-heading" id="headingSeguimiento">
                            <h5 style="margin-bottom:0;">
                                <button class="btn btn-link" data-toggle="collapse"
                                        data-target="#collapseSeguimiento"
                                        aria-expanded="true"
                                        aria-controls="collapseSeguimiento">
                                    <i class="fa fa-list-alt" aria-hidden="true"></i>
                                    Seguimiento de Boleto
                                </button>
                            </h5>
                        </div>
                        <div id="collapseSeguimiento" class="panel-collapse collapse"
                             data-parent="#accordionGestionBoleto">
                            <div class="panel-body" style="padding-top: 2px;">
                                @Html.Partial("_FormSeguimientoControlBoleto")
                                <div class="text-right" style="margin-top: 5px; padding-top: 5px;">
                                    <button class="btn btn-danger"
                                            onclick="ControlDeBoletosSeguimiento.eliminar()">
                                        <i class="fa fa-trash" aria-hidden="true"></i> Eliminar Seguimiento
                                    </button>
                                    <button class="btn btn-primary"
                                            onclick="ControlDeBoletosSeguimiento.guardar()">
                                        <i class="fa fa-save" aria-hidden="true"></i> Guardar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ════════ 2. DATOS DE CERTIFICACIÓN ════════ -->
                    <div class="panel panel-default" style="margin-bottom:10px;">
                        <div class="panel-heading" id="headingCertificacion">
                            <h5 style="margin-bottom:0;">
                                <button class="btn btn-link" data-toggle="collapse"
                                        data-target="#collapseCertificacion"
                                        aria-expanded="false"
                                        aria-controls="collapseCertificacion">
                                    <i class="fa fa-certificate" aria-hidden="true"></i>
                                    PreCertificación de Boleto
                                </button>
                            </h5>
                        </div>
                        <div id="collapseCertificacion" class="panel-collapse collapse"
                             data-parent="#accordionGestionBoleto">
                            <div class="panel-body" style="padding-top: 2px;">
                                @Html.Partial("_FormDatosCertificacion")
                                <div class="text-right" style="margin-top: 5px; padding-top: 5px; ">
                                    <button class="btn btn-danger"
                                            onclick="ControlDeBoletosDatosCertificacion.eliminar()">
                                        <i class="fa fa-trash" aria-hidden="true"></i> Eliminar PreCertificación
                                    </button>
                                    <button class="btn btn-primary"
                                            onclick="ControlDeBoletosDatosCertificacion.guardar()">
                                        <i class="fa fa-save" aria-hidden="true"></i> Guardar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ════════ 3. MODIFICAR DATOS DEL CONTRATO ════════ -->
                    <div class="panel panel-default" style="margin-bottom:10px; margin-top: 10px">
                        <div class="panel-heading" id="headingModificar">
                            <h5 style="margin-bottom:0;">
                                <button class="btn btn-link" data-toggle="collapse"
                                        data-target="#collapseModificar"
                                        aria-expanded="false"
                                        aria-controls="collapseModificar">
                                    <i class="fa fa-edit" aria-hidden="true"></i>
                                    Datos del Contrato
                                </button>
                            </h5>
                        </div>
                        <div id="collapseModificar" class="panel-collapse collapse"
                             data-parent="#accordionGestionBoleto">
                            <div class="panel-body" style="padding-top: 2px;">
                                @Html.Partial("_FormModificarDatosDelContrato")
                                <div class="text-right" style="margin-top: 5px; padding-top: 5px; ">
                                    <button class="btn btn-primary"
                                            onclick="ControlDeBoletosModificarContrato.guardar()">
                                        <i class="fa fa-save" aria-hidden="true"></i> Guardar
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<style>
    .ancho-campos-fijo {
        width: auto;
        margin-right: 5px;
        margin-bottom: 0px;
        margin-top: 0px;
    }
    .col-md-4 > label {
        display: block;
    }
    #modalGestionControlBoleto .modal-content {
        background-color: #fff;
    }

    #modalGestionControlBoleto .modal-close {
        float: right;
        font-size: 21px;
        font-weight: bold;
        line-height: 1;
        color: #000;
        text-shadow: 0 1px 0 #fff;
        opacity: .2;
        background: none !important;
        text-indent: 0;
        border-color: transparent !important;
        cursor: pointer;
    }

    #accordionGestionBoleto .panel-heading {
        background-color: #26337B;
        border-bottom: 0px;
    }

    #accordionGestionBoleto .panel-heading .btn-link {
        font-size: 14px;
        font-weight: 600;
        color: #fff;
        text-decoration: none;
    }

    #accordionGestionBoleto .panel-heading .btn-link:hover {
        color: #fff;
    }
</style>
