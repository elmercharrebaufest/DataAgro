@section Scripts{
    @Scripts.Render("~/bundles/ControlDeBoletosGestion")
}
@section styles{
    <link href="~/Content/control-boletos.css" rel="stylesheet" />
    <link href="~/Content/control-boletos-contrato.css" rel="stylesheet" />
}
<div id="modalGestionControlBoleto" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content clearfix modal-cargar-boleto">
            <div class="modal-header">
                <button type="button" class="modal-close" data-dismiss="modal">
                    <span aria-hidden="true">&times;</span>
                    <span class="sr-only">Cerrar</span>
                </button>
                <div class="header-top">
                    <h5 class="titulo-modal modal-titulo-contrato">
                        <i class="fa fa-clipboard-check" aria-hidden="true"></i>
                        Gesti&oacute;n de Control de Boletos
                    </h5>
                </div>
            </div>

            <div class="modal-body">
                <div id="tabsGestionBoleto">
                    <ul class="nav gestion-tabs" role="tablist">
                        <li role="presentation" class="active">
                            <a href="#tabInformacionContrato" aria-controls="tabInformacionContrato" role="tab" data-toggle="tab">
                                Informacion Contrato
                            </a>
                        </li>
                        <li role="presentation">
                            <a href="#tabSeguimiento" aria-controls="tabSeguimiento" role="tab" data-toggle="tab">
                                Seguimiento
                            </a>
                        </li>
                        <li role="presentation">
                            <a href="#tabCertificacion" aria-controls="tabCertificacion" role="tab" data-toggle="tab">
                                PreCertificación
                            </a>
                        </li>
                        <li role="presentation">
                            <a href="#tabContrato" aria-controls="tabContrato" role="tab" data-toggle="tab">
                                Contrato
                            </a>
                        </li>
                    </ul>

                    <div class="tab-content gestion-tab-content" style="margin-top: 10px;border:none;">
                        <div role="tabpanel" class="tab-pane active" id="tabInformacionContrato">
                            <form id="frmGestionarContrato">
                                <!-- Información del Boleto -->
                                <div class="row">
                                    <div class="col-md-12">
                                        <label class="d-block"><strong><u>Información del Boleto</u></strong></label>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>Tipo Boleto</strong></label>
                                        <label id="TipoBoleto" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>Version Boleto</strong></label>
                                        <label id="VersionBoleto" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>FechaGeneracion</strong></label>
                                        <label id="FechaGeneracion" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                </div>

                                <!-- Información del Contrato -->
                                <div class="row">
                                    <div class="col-md-12">
                                        <label class="d-block"><strong><u>Información del Contrato</u></strong></label>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>Contrato</strong></label>
                                        <label id="ContratoSAP" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>Material</strong></label>
                                        <label id="Material" class="d-block ancho-campos-fijo"></label>

                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>Campaña</strong></label>
                                        <label id="Campania" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>Período Operación</strong></label>
                                        <label id="PeriodoOperacion" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>Período Entrega</strong></label>
                                        <label id="PeriodoEntrega" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>Kilos</strong></label>
                                        <label id="Kilos" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label><strong>Precio</strong></label>

                                        <div style="display:flex">
                                            <label id="PrecioXTonelada" class="ancho-campos-fijo"></label>
                                            <label id="Moneda" class="ancho-campos-fijo"></label>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>Provincia</strong></label>
                                        <label id="Provincia" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>Destino</strong></label>
                                        <label id="Destino" class="ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>Procedencia</strong></label>
                                        <label id="Procedencia" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>Clasificación Proveedor</strong></label>
                                        <label id="ClasificacionProveedor" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>Estándar Calidad</strong></label>
                                        <label id="StandardCalidad" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>Numero Sio</strong></label>
                                        <label id="NumeroSio" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                </div>

                                <!-- Información Comercial -->
                                <div class="row">
                                    <div class="col-md-12">
                                        <label class="d-block"><strong><u>Información Comercial</u></strong></label>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>CUIT Vendedor</strong></label>
                                        <label id="CuitVendedor" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-8">
                                        <label class="d-block"><strong>Vendedor</strong></label><br />
                                        <label id="Vendedor" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>CUIT Corredor</strong></label>
                                        <label id="CuitCorredor" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-8">
                                        <label class="d-block"><strong>Corredor</strong></label><br />
                                        <label id="Corredor" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                </div>

                                <!-- Información Adicional -->
                                <div class="row">
                                    <div class="col-md-12">
                                        <label class="d-block"><strong><u>Información Adicional</u></strong></label>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>FechaCierta</strong></label>
                                        <label id="FechaCierta" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>CantidadFijacionMaxima</strong></label>
                                        <label id="CantidadFijacionMaxima" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>CantidadFijacionMinima</strong></label>
                                        <label id="CantidadFijacionMinima" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>Cesion</strong></label>
                                        <label id="Cesion" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>Compensacion</strong></label>
                                        <label id="Compensacion" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>Dolarizado Express</strong></label>
                                        <label id="DolarizadoExpress" class="d-block ancho-campos-fijo"></label>
                                    </div>        
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>EUDR</strong></label>
                                        <label id="EUDR" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>EPA</strong></label>
                                        <label id="EPA" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>Sustentable</strong></label>
                                        <label id="Sustentable" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>CD</strong></label>
                                        <label id="CD" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>Pago Directo Vendedor</strong></label>
                                        <label id="PagoDirectoVendedor" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="d-block"><strong>Plan de Canje</strong></label>
                                        <label id="Canje" class="d-block ancho-campos-fijo"></label>
                                    </div>
                                </div>

                            </form>
                        </div>

                        <div role="tabpanel" class="tab-pane" id="tabSeguimiento">
                            @Html.Partial("_FormSeguimientoControlBoleto")
                            <div class="text-right" style="margin-top: 5px; padding-top: 5px;">
                                <button class="btn btn-danger"
                                        onclick="ControlDeBoletosSeguimiento.eliminar()">
                                    <i class="fa fa-trash" aria-hidden="true"></i> Eliminar
                                </button>
                                <button class="btn btn-primary"
                                        onclick="ControlDeBoletosSeguimiento.guardar()">
                                    <i class="fa fa-save" aria-hidden="true"></i> Guardar
                                </button>
                            </div>
                        </div>

                        <div role="tabpanel" class="tab-pane" id="tabCertificacion">
                            @Html.Partial("_FormDatosCertificacion")
                            <div class="text-right" style="margin-top: 5px; padding-top: 5px; ">
                                <button class="btn btn-danger"
                                        onclick="ControlDeBoletosDatosCertificacion.eliminar()">
                                    <i class="fa fa-trash" aria-hidden="true"></i> Eliminar
                                </button>
                                <button class="btn btn-primary"
                                        onclick="ControlDeBoletosDatosCertificacion.guardar()">
                                    <i class="fa fa-save" aria-hidden="true"></i> Guardar
                                </button>
                            </div>
                        </div>

                        <div role="tabpanel" class="tab-pane" id="tabContrato">
                            @Html.Partial("_FormModificarDatosDelContrato")
                            <div class="text-right" style="margin-top: 5px; padding-top: 5px; ">
                                <button class="btn btn-primary"
                                        onclick="ControlDeBoletosModificarContrato.guardar()">
                                    <i class="fa fa-save" aria-hidden="true"></i> Guardar
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<style>
    .ancho-campos-fijo {
        width: auto;
        margin-right: 5px;
        margin-bottom: 0px;
        margin-top: 0px;
    }

    .col-md-4 > label {
        display: block;
    }

    #modalGestionControlBoleto .modal-content {
        background-color: #fff;
    }

    #modalGestionControlBoleto .modal-close {
        float: right;
        font-size: 21px;
        font-weight: bold;
        line-height: 1;
        color: #000;
        text-shadow: 0 1px 0 #fff;
        opacity: .2;
        background: none !important;
        text-indent: 0;
        border-color: transparent !important;
        cursor: pointer;
    }

    #tabsGestionBoleto .gestion-tabs {
        margin: 0 0 10px 0;
        border: 1px solid #1f2c67;
        border-radius: 6px;
        overflow: hidden;
        display: flex;
        flex-wrap: wrap;
        gap: 0;
    }

        #tabsGestionBoleto .gestion-tabs > li {
            margin: 0;
            flex: 1 1 0;
        }

            #tabsGestionBoleto .gestion-tabs > li + li {
                border-left: 1px solid #1f2c67;
            }

            #tabsGestionBoleto .gestion-tabs > li > a {
                border: 0;
                border-radius: 0;
                background-color: #26337B;
                color: #fff;
                font-size: 13px;
                font-weight: 600;
                padding: 8px 10px;
                text-align: center;
                text-decoration: none;
                margin: 0;
            }

                #tabsGestionBoleto .gestion-tabs > li > a:hover,
                #tabsGestionBoleto .gestion-tabs > li > a:focus {
                    background-color: #1f2c67;
                    border-color: #1f2c67;
                    color: #fff;
                }

            #tabsGestionBoleto .gestion-tabs > li.active > a,
            #tabsGestionBoleto .gestion-tabs > li.active > a:hover,
            #tabsGestionBoleto .gestion-tabs > li.active > a:focus {
                background-color: #0f1b4a;
                border-color: #0f1b4a;
                color: #fff;
            }

    #tabsGestionBoleto .gestion-tab-content {
        border-top: 1px solid #dfe3f0;
        padding-top: 8px;
    }
</style>
