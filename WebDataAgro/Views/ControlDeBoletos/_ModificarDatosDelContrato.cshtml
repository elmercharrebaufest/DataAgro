<div id="modalModificarBoleto" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg">
        <div class="modal-content clearfix modal-contrato">

            <div class="modal-header">
                <button type="button" class="modal-close" data-dismiss="modal">
                    <span aria-hidden="true">×</span>
                    <span class="sr-only">Close</span>
                </button>
                <div class="header-top">
                    <h5 class="titulo-modal modal-titulo-contrato">
                        Modificar Control de Boleto
                    </h5>
                </div>
            </div>

            <div class="modal-body">
                @Html.Partial("_FormModificarDatosDelContrato")

            <div class="modal-footer">
                <button class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                <button class="btn btn-primary" onclick="ControlDeBoletosModificarContrato.guardar()">Guardar</button>
            </div>

        </div>
    </div>
</div>
<style>
    .modal-contrato {
        background-color: white !important;
    }

    .modal-close {
        float: right;
        font-size: 21px;
        font-weight: bold;
        line-height: 1;
        color: #000000;
        text-shadow: 0 1px 0 #ffffff;
        opacity: 0.2;
        background: none !important;
        text-indent: 0;
        border-color: transparent !important;
        cursor: pointer;
    }
</style>
