@{
    ViewBag.Title = "Control de Boletos";
}

@section styles{
    <link href="~/Content/control-boletos.css" rel="stylesheet" />
    <link href="~/Content/control-boletos-contrato.css" rel="stylesheet" />
}

@section Scripts{
    @Scripts.Render("~/bundles/ControlDeBoletos")
}

<div class="container-fluid" style="margin-left:2em; margin-right:2em;" id="frmPendienteControl">
    <!-- Header Section -->
    <div class="row header-section">
        <div class="col-12">
            <h2 class="page-title">
                <i class="fa fa-clipboard-check" aria-hidden="true"></i>
                Control de Boletos
            </h2>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="card filter-card fade-in">
        <div class="card-body">
            <!-- First Row -->
            <div class="row form-row">
                <div class="col-md-6 col-sm-4">
                    <div class="form-group">
                        <label class="form-label">Contratos SAP</label>
                        <div class="filter-espacio-input">
                            <input type="text" id="NegocioSAP" class="form-control" placeholder="Contratos SAP" />
                        </div>
                    </div>
                </div>
                <div class="col-md-3 col-sm-4">
                    <div class="form-group">
                        <label class="form-label">Material</label>
                        <select id="materialId" class="form-control">
                            <option value="">Cargando materiales...</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3 col-sm-4">
                    <div class="form-group">
                        <label class="form-label">Estado de Control</label>
                        <select id="estadoControlId" class="form-control">
                            <option value="">Cargando estados...</option>
                        </select>
                    </div>
                </div>

            </div>

            <!-- Second Row -->
            <div class="row form-row">
                <div class="col-md-3 col-sm-4">
                    <div class="form-group">
                        <label class="form-label">Fecha de Envío Desde</label>
                        <input id="fechaCargaDesde" class="form-control" type="date" style="width: stretch" />
                    </div>
                </div>
                <div class="col-md-3 col-sm-4">
                    <div class="form-group">
                        <label class="form-label">Fecha de Envío Hasta</label>
                        <input id="fechaCargaHasta" class="form-control" type="date" style="width: stretch" />
                    </div>
                </div>
                <div class="col-md-3 col-sm-4">
                    <div class="form-group">
                        <label class="form-label">Bolsa</label>
                        <select id="bolsaCompraNetId" class="form-control">
                            <option value="">Cargando Bolsas...</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3 col-sm-4">
                    <div class="form-group">
                        <label class="form-label">Proveedor</label>
                        <select id="proveedorId" class="form-control">
                            <option value="">Cargando proveedores...</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3 col-sm-4">
                    <div class="form-group">
                        <label class="form-label">Comercial</label>
                        <select id="comercialId" class="form-control">
                            <option value="">Cargando comerciales...</option>
                        </select>
                    </div>
                </div>
                <div class="col-md-3 col-sm-4">
                    <div class="form-group">
                        <label class="form-label">Tipo de Boletos</label>
                        <div style="display: flex;">
                            <input class="form-control" role="switch" type="checkbox" id="esConfirma" style="width:20px; margin-top:0 !important; margin-left:0 !important;">
                            <label style="margin-left: 5px;" for="esConfirma">Confirma</label>
                            <input class="form-control" role="switch" type="checkbox" id="esBoletoFisico" style="width:20px; margin-top:0 !important; margin-left:5px !important;">
                            <label style="margin-left: 5px;" for="esBoletoFisico">Fisico</label>
                            <input class="form-control" role="switch" type="checkbox" id="esCartaOferta" style="width: 20px; margin-top: 0 !important; margin-left: 5px !important;">
                            <label style="margin-left: 5px;" for="esCartaOferta">Carta Oferta</label>
                            <input class="form-control" role="switch" type="checkbox" id="esNinguno" style="width: 20px; margin-top: 0 !important; margin-left: 5px !important;">
                            <label style="margin-left: 5px;" for="esNinguno">Ninguno</label>
                            <input class="form-control" role="switch" type="checkbox" id="esSinBoleto" style="width: 20px; margin-top: 0 !important; margin-left: 5px !important;">
                            <label style="margin-left: 5px;" for="esSinBoleto">Sin Boleto</label>
                        </div>
                    </div>
                </div>
                <!-- Espacio -->
                <div class="col-md-3 col-sm-6">
                </div>

                <!-- Botones -->
                <div class="col-md-3 col-sm-6 filter-actions filter-actions-bottom" style="margin-top: 30px">
                    <div class="form-group">

                        <button type="button"
                                id="filtrarBoletos"
                                class="btn btn-primary">
                            <i class="fa fa-search" aria-hidden="true"></i>
                            <span class="d-none d-sm-inline">Buscar</span>
                        </button>

                        <button type="button"
                                id="limpiarFiltros"
                                class="btn btn-secondary">
                            <i class="fa fa-eraser" aria-hidden="true"></i>
                            <span class="d-none d-sm-inline">Limpiar</span>
                        </button>

                        <button type="button"
                                id="agregarContratoHijo"
                                class="btn btn-success">
                            <i class="fa fa-plus-square" aria-hidden="true"></i>
                            <span class="d-none d-sm-inline">Agregar Contrato Hijo</span>
                        </button>

                        <button type="button"
                                id="exportarExcel"
                                class="btn btn-success"
                                disabled>
                            <i class="fa fa-file-excel-o" aria-hidden="true"></i>
                            <span class="d-none d-sm-inline">Excel</span>
                        </button>

                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Results Section -->
    <div class="card results-card mt-3 fade-in">
        <div class="card-header d-flex justify-content-between align-items-center">
        </div>
        <br />
        <div class="card-body p-0">
            <!-- Quick Actions Bar -->
            <div class="quick-actions-bar">
                <div class="row align-items-center">
                    <div class="col-md-6">
                    </div>
                    <div class="col-md-6 text-right">
                    </div>
                </div>
            </div>

            <!-- Grid Container -->
            <div id="boletos-grid" class="grid-container">
                <div class="loading-spinner" id="loadingSpinner">
                    <div class="spinner-border-custom" role="status">
                        <span class="sr-only">Cargando datos...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para mensajes -->
<div class="modal fade" id="mensajeModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="mensajeModalTitle">Información</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body" id="mensajeModalBody">
                <!-- Mensaje dinámico -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@* Renderizar vistas parciales de modales *@
@Html.Partial("_BuscarContratosHijo")
@Html.Partial("_VisualizarContrato")
@Html.Partial("_TrackingControlDeBoletos")
@Html.Partial("_GestionControlBoleto")

<script>
    function cargarModalDinamico(url, modalId, callback) {
        $.get(url, function (html) {
            $('body').append(html);
            if (callback) callback();
        });
    }
</script>
