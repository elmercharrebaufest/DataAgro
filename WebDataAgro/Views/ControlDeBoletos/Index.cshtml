@{
    ViewBag.Title = "Control de Boletos";
}

@section Scripts{
    @Scripts.Render("~/bundles/ControlDeBoletos")
}

<div class="container-fluid" style="margin-left: 2em !important; margin-right: 2em !important;">
    <!-- Header Section -->
    <div class="row header-section" style="padding: 15px 0px; border-bottom: 2px solid #017940; margin-bottom: 20px;">
        <div class="col-12">
            <h2 class="page-title">
                <i class="fa fa-clipboard-check" aria-hidden="true"></i>
                Control de Boletos
            </h2>
            <p class="page-subtitle">Gestión y seguimiento de boletos pendientes de control</p>
        </div>
    </div>

    <!-- Filters Section -->
    <div class="card filter-card">
        <div class="card-header">
            <h5 class="card-title mb-0">
                <i class="fa fa-filter" aria-hidden="true"></i>
                Filtros de Búsqueda
            </h5>
        </div>
        <div class="card-body">
            <!-- First Row -->
            <div class="row form-row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Contrato SAP</label>
                        <div class="input-group filter-espacio-input">
                            @Html.TextBox("NegocioSAP", "", new
                            {
                                placeholder = "Número SAP desde",
                                @class = "form-control filtroBusquedaNumeroRangoDesde",
                                @id = "NegocioSAP-desde"
                            })
                            @Html.TextBox("NegocioSAP", "", new
                            {
                                placeholder = "Número SAP hasta",
                                @type = "number",
                                @class = "form-control filtroBusquedaNumeroRangoHasta",
                                @id = "NegocioSAP-hasta"
                            })
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Material</label>
                        @*@Html.DropDownList("MaterialId", new SelectList(ViewBag.Material, "Value", "Text"), "Seleccione el Material", new
                            {
                                @class = "form-control filtroBusquedaPorId",
                                @id = "materialId"
                            })*@
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Estado de Control</label>
                        @*@Html.DropDownList("EstadoControlId", new SelectList(ViewBag.EstadosControl, "Value", "Text"), "Seleccione el Estado", new
                            {
                                @class = "form-control filtroBusquedaPorId",
                                @id = "estadoControlId"
                            })*@
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Tipo de Boleto</label>
                        <div class="custom-control custom-checkbox mt-2">
                            <input type="checkbox" class="custom-control-input" id="esConfirma">
                            <label class="custom-control-label" for="esConfirma">Solo Confirmas</label>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Second Row -->
            <div class="row form-row">
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Fecha de Envío (SAP/Confirma)</label>
                        <input id="fechaCargaId" class="form-control filtroFecha" name="FechaCarga-desde" type="date" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Fecha Hasta</label>
                        <input id="fechaCargaHastaId" class="form-control filtroFecha" name="FechaCarga-hasta" type="date" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Proveedor</label>
                        <input type="text" id="proveedorFiltro" class="form-control" placeholder="Buscar por CUIT o razón social" />
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="form-group">
                        <label class="form-label">Comercial</label>
                        @*@Html.DropDownList("ComercialId", new SelectList(ViewBag.Comerciales, "Value", "Text"), "Seleccione el Comercial", new
                            {
                                @class = "form-control filtroBusquedaPorId",
                                @id = "comercialId"
                            })*@
                    </div>
                </div>
            </div>

            <!-- Action Buttons Row -->
            <div class="row form-row">
                <div class="col-md-8"></div>
                <div class="col-md-4 filter-actions">
                    <button type="button" id="filtrarBoletos" class="btn btn-primary">
                        <i class="fa fa-search" aria-hidden="true"></i>
                        Buscar Boletos
                    </button>
                    <button type="button" id="limpiarFiltros" class="btn btn-secondary">
                        <i class="fa fa-eraser" aria-hidden="true"></i>
                        Limpiar Filtros
                    </button>
                    <button type="button" id="exportarExcel" class="btn btn-success">
                        <i class="fa fa-file-excel-o" aria-hidden="true"></i>
                        Exportar a Excel
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Results Section -->
    <div class="card results-card mt-3">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">
                <i class="fa fa-list" aria-hidden="true"></i>
                Boletos Pendientes de Control
            </h5>
            <div class="results-summary">
                <span class="badge badge-info" id="totalRegistros">0 registros</span>
            </div>
        </div>
        <div class="card-body p-0">
            <!-- Quick Actions Bar -->
            <div class="quick-actions-bar">
                <div class="row align-items-center">
                    <div class="col-md-6">
                        <div class="bulk-actions">
                            <input type="checkbox" id="selectAll" class="form-check-input">
                            <label for="selectAll" class="form-check-label mr-3">Seleccionar Todos</label>
                            <button type="button" id="iniciarControlMasivo" class="btn btn-sm btn-outline-primary" disabled>
                                <i class="fa fa-play" aria-hidden="true"></i>
                                Iniciar Control
                            </button>
                            <button type="button" id="finalizarControlMasivo" class="btn btn-sm btn-outline-success" disabled>
                                <i class="fa fa-check" aria-hidden="true"></i>
                                Finalizar Control
                            </button>
                        </div>
                    </div>
                    <div class="col-md-6 text-right">
                        <div class="view-options">
                            <div class="btn-group" role="group">
                                <button type="button" class="btn btn-sm btn-outline-secondary active" id="vistaTabla">
                                    <i class="fa fa-table" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="vistaCartas">
                                    <i class="fa fa-th-large" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Grid Container -->
            <div id="boletos-grid" class="grid-container"></div>
        </div>
    </div>

    <!-- Progress Indicators -->
    <div class="progress-indicators mt-3">
        <div class="row">
            <div class="col-md-3">
                <div class="progress-card pending">
                    <div class="progress-icon">
                        <i class="fa fa-clock-o" aria-hidden="true"></i>
                    </div>
                    <div class="progress-info">
                        <h6>Pendientes</h6>
                        <span id="countPendientes">0</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="progress-card in-progress">
                    <div class="progress-icon">
                        <i class="fa fa-cog fa-spin" aria-hidden="true"></i>
                    </div>
                    <div class="progress-info">
                        <h6>En Proceso</h6>
                        <span id="countEnProceso">0</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="progress-card completed">
                    <div class="progress-icon">
                        <i class="fa fa-check-circle" aria-hidden="true"></i>
                    </div>
                    <div class="progress-info">
                        <h6>Completados</h6>
                        <span id="countCompletados">0</span>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="progress-card certified">
                    <div class="progress-icon">
                        <i class="fa fa-certificate" aria-hidden="true"></i>
                    </div>
                    <div class="progress-info">
                        <h6>Certificados</h6>
                        <span id="countCertificados">0</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Estilos específicos para Control de Boletos - Solo estilos únicos */
    .page-title {
        color: steelblue;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .page-subtitle {
        color: #666;
        font-size: 14px;
        margin-bottom: 0;
    }

    .header-section {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 8px;
        margin-bottom: 20px;
        padding: 20px;
    }

    .filter-card, .results-card {
        border: 1px solid #e3e6f0;
        border-radius: 8px;
    }

        .filter-card .card-header {
            background: steelblue;
            color: white;
            border-radius: 8px 8px 0 0 !important;
            padding: 12px 20px;
        }

    .form-label {
        font-weight: 500;
        color: #374151;
        margin-bottom: 5px;
        display: block;
    }

    .form-control:focus {
        border-color: #017940;
        box-shadow: 0 0 0 0.2rem rgba(1, 121, 64, 0.25);
    }

    .filter-espacio-input {
        display: flex;
        gap: 10px;
    }

    .filter-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
    }

    .btn-primary {
        background-color: #017940;
        border-color: #017940;
    }

        .btn-primary:hover {
            background-color: #015a32;
            border-color: #015a32;
        }

    .quick-actions-bar {
        background: #f8f9fa;
        padding: 15px 20px;
        border-bottom: 1px solid #e5e7eb;
    }

    .bulk-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .grid-container {
        min-height: 400px;
    }

    .progress-indicators {
        margin-top: 20px;
    }

    .progress-card {
        background: white;
        border: 1px solid #e3e6f0;
        border-radius: 8px;
        padding: 20px;
        text-align: center;
        transition: transform 0.15s ease-in-out;
    }

        .progress-card:hover {
            transform: translateY(-2px);
        }

        .progress-card.pending {
            border-left: 4px solid #ffc107;
        }

        .progress-card.in-progress {
            border-left: 4px solid #17a2b8;
        }

        .progress-card.completed {
            border-left: 4px solid #28a745;
        }

        .progress-card.certified {
            border-left: 4px solid #6f42c1;
        }

    .progress-icon {
        font-size: 24px;
        margin-bottom: 10px;
    }

    .progress-card.pending .progress-icon {
        color: #ffc107;
    }

    .progress-card.in-progress .progress-icon {
        color: #17a2b8;
    }

    .progress-card.completed .progress-icon {
        color: #28a745;
    }

    .progress-card.certified .progress-icon {
        color: #6f42c1;
    }

    .progress-info h6 {
        margin: 0 0 5px 0;
        font-weight: 600;
        color: #374151;
        font-size: 14px;
    }

    .progress-info span {
        font-size: 24px;
        font-weight: 700;
        color: #1f2937;
    }

    .custom-control-input:checked ~ .custom-control-label::before {
        background-color: #017940;
        border-color: #017940;
    }
</style>