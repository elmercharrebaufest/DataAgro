@{
    ViewBag.Title = "Localidades";
}

@section Scripts {
    @Scripts.Render("~/bundles/AbmLocalidad")
}


<h3>Localidades</h3>

<div id="rootwizard">
    <div id="Abm">
        <ul>
            <li style="display:none"><a href="#tab1" data-toggle="tab"></a></li>
            <li style="display:none"><a href="#tab2" data-toggle="tab"></a></li>
        </ul>

        <div class="tab-content">

            <div class="tab-pane" id="tab1">

                <div class="row">
                    <div class="col-md-2">
                        <label>Localidad</label>
                    </div>
                    <div class="col-md-4">
                        <input id="ParamNombre" type="text" class="k-textbox" data-bind="value: Parametros.Nombre, disabled: isFilterDisabled" maxlength="100" style="max-width:311px" />
                        <img id="errParamNombre" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-2">
                        <label>Provincia</label>
                    </div>
                    <div class="col-md-4">
                        <select id="ParamProvinciaId" onchange="CargarPartidos(1)" data-bind="source: ProvinciaCombo, value: Parametros.ProvinciaId, disabled: isFilterDisabled" style="max-width:311px"></select>
                        <img id="errParamProvinciaId" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                </div>

                <div class="row" style="margin-top: 10px">
                    <div class="col-md-2">
                        <label>Partido</label>
                    </div>
                    <div class="col-md-4">
                        <select id="ParamPartidoId" data-bind="source: PartidoCombo, value: Parametros.PartidoId, disabled: isFilterDisabled" style="max-width:311px"></select>
                        <img id="errParamPartidoId" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-6">
                        <button id="butFiltrar" class="k-button" type="button" data-role="button" data-bind="disabled: isFilterDisabled">Buscar</button>
                    </div>
                </div>

                <br />

                <div class="row">
                    <div class="col-md-12">
                        <div id="gridIniLocalidad" data-bind="source: Resultados" style="height:245px;"></div>
                    </div>
                </div>

                <div class="row top5">
                    <div class="col-md-12">
                        <span class="ms-redlabel" data-bind="text: recordMessage"></span>
                    </div>
                </div>

                <br />

                <div class="row">
                    <div class="col-md-12">
                        <button id="butAgregar" class="k-button" type="button" data-role="button" data-bind="disabled: isAddNewDisabled">Agregar</button>
                        <button id="butModificar" class="k-button" type="button" data-role="button" data-bind="disabled: isDeleteDisabled" style="margin-left:15px;">Modificar</button>
                        <button id="butEliminar" class="k-button" type="button" data-role="button" data-bind="disabled: isDeleteDisabled" style="margin-left:15px;">Eliminar</button>
                    </div>
                </div>

            </div>

            <div class="tab-pane" id="tab2">

                <div class="row">
                    <div class="col-md-2">
                        <label>Código</label>
                    </div>
                    <div class="col-md-4">
                        <input id="CodLocalidad" type="text" class="k-textbox" data-bind="value: Localidad.CodLocalidad, disabled: isControlDisabled" maxlength="10" style="max-width:311px" />
                        <img id="errCodLocalidad" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-2">
                        <label>Localidad</label>
                    </div>
                    <div class="col-md-4">
                        <input id="Nombre" type="text" class="k-textbox" data-bind="value: Localidad.Nombre, disabled: isControlDisabled" maxlength="100" style="max-width:311px" />
                        <img id="errNombre" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-2">
                        <label>Provincia</label>
                    </div>
                    <div class="col-md-4">
                        <select id="ProvinciaId" onchange="CargarPartidos(2)" data-bind="source: ProvinciaCombo, value: Localidad.ProvinciaId, disabled: isControlDisabled" style="max-width:311px"></select>
                        <img id="errProvinciaId" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>

                <div class="row" style="margin-top: 10px">
                    <div class="col-md-2">
                        <label>Partido</label>
                    </div>
                    <div class="col-md-4">
                        <select id="PartidoId" data-bind="source: PartidoCombo, value: Localidad.PartidoId, disabled: isControlDisabled" style="max-width:311px"></select>
                        <img id="errPartidoId" src="~/Content/Images/error.png" style="display:none" />
                    </div>
                    <div class="col-md-6">
                    </div>
                </div>

                <br />

                <div class="row">
                    <div class="col-md-12">
                        <button id="butAceptar" class="k-button" type="button" data-role="button">Aceptar</button>
                        <button id="butCancelar" class="k-button" type="button" data-role="button" style="margin-left:15px;">Cancelar</button>
                    </div>
                </div>

            </div>

        </div>

    </div>
</div>
