    </protocolMapping>
    <serviceHostingEnvironment aspNetCompatibilityEnabled="true" multipleSiteBindingsEnabled="true" />
    <services>
      <service name="WebDataAgro.Services.DataAgroServices" behaviorConfiguration="serviceBehaviorSAP">
        <endpoint address="" binding="basicHttpBinding" bindingConfiguration="DataAgroServicesBinding" contract="WebDataAgro.Services.IDataAgroServices" />
        <endpoint address="mex" binding="mexHttpBinding" contract="IMetadataExchange" />
      </service>
    </services>
    <bindings>
      <basicHttpBinding>
        <!--<binding name="DataAgroServicesBinding" maxReceivedMessageSize="2147483647" />-->
        <binding name="DataAgroServicesBinding">
          <security mode="TransportCredentialOnly">
            <transport clientCredentialType="Basic" />
          </security>
        </binding>
      </basicHttpBinding>
      <customBinding>
        <binding name="SI_ZMPWS_DATAAGRO_DATOS_Binding" closeTimeout="00:05:00" openTimeout="00:05:00" receiveTimeout="00:20:00" sendTimeout="00:20:00">
          <textMessageEncoding messageVersion="Soap11" />
          <httpTransport authenticationScheme="Basic" bypassProxyOnLocal="false" hostNameComparisonMode="StrongWildcard" keepAliveEnabled="false" proxyAuthenticationScheme="Basic" realm="XISOAPApps" useDefaultWebProxy="true" maxReceivedMessageSize="2000000000" />
        </binding>
      </customBinding>
    </bindings>
